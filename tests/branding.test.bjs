#lang beagle/js
;; Regression test for tools/prep/branding.ts.
;;
;; Ensures Zen-browser-isms (and other upstream-template artifacts that
;; would leak proprietary URLs into our build) never appear in the
;; generated branding tree. This is the test that would have caught the
;; surfer leak we discovered.
;;
;; Runs only if `engine/browser/branding/gjoa/` exists — i.e. only after
;; `bun run init`. CI can either run init first OR skip these tests in
;; environments without network/disk for a full mozilla-central download.
;; ns is 3-segment (gjoa.tests.branding) to match the on-disk DIRECTORY depth
;; (.beagle-tools/gjoa/tests/) — the `.test` lives in the FILENAME convention, not
;; a directory, so a 4-segment ns made beagle emit relative imports one level too
;; deep (../../tools vs ../tools). bun:test still recognizes the `.test.js` file.
(ns gjoa.tests.branding
  (:require [fs :refer [existsSync readdirSync readFileSync statSync]]
            [path :refer [join]]
            [gjoa.tools.prep.config :refer [load-config!]]
            [gjoa.tools.prep.paths :refer [ENGINE-BRANDING-DIR]]))

;; bun:test's specifier contains a ':', which beagle rejects as a require
;; namespace (module paths must match ^[a-zA-Z0-9._/-]+$). Bun's test runner
;; does NOT auto-globalize describe/test/expect, so the generated JS needs this
;; import prepended manually (same pattern as test/harness.bjs's happy-dom):
;;   import { describe, expect, test } from "bun:test";
(declare-extern [describe expect test] Any)

(def cfg Any (load-config!))
(def BRANDING-OUT String (join ENGINE-BRANDING-DIR (js/get cfg .binaryName)))
(def HAS-ENGINE Any (existsSync BRANDING-OUT))

(defn walk! [(dir String)] Any
  (let [out []]
    (doseq [name (readdirSync dir)]
      (let [path (join dir name)]
        ;; Both branches must be plain expressions so the ternary emits cleanly:
        ;; push each recursive result rather than reassigning the accumulator —
        ;; `(set! out ...)` on this nested let-binding mis-emits as `const out`
        ;; (then `out = …` throws at runtime). forEach-push keeps `out` push-only
        ;; and both arms expressions. (beagle emit bug logged in beagle-workarounds.)
        (if (js/call (statSync path) .isDirectory)
          (js/call (walk! path) .forEach (fn [(p String)] Any (js/call out .push p)))
          (js/call out .push path))))
    out))

(def TEXT-EXT Any (js/new RegExp "\\.(js|dtd|ftl|properties|sh|nsi|xml|css|json|mn|svg|html|txt|md)$" "i"))

(defn isText [(path String)] Any
  (let [parts (js/call path .split "/")
        base (or (js/call parts .pop) "")]
    (if (js/call ["moz.build" "configure.sh" "branding.nsi" "jar.mn"] .includes base)
      true
      (js/call TEXT-EXT .test path))))

(let [suite (js/call describe .skipIf (not HAS-ENGINE))]
  (suite "branding regression"
    (fn [] Any
      (let [all-text (if HAS-ENGINE
                       (js/call (js/call (walk! BRANDING-OUT) .filter isText) .map (fn [p] Any (let [path p] {:path path :text (readFileSync path "utf8")})))
                       [])]

        (test "no zen-browser.app references anywhere in generated branding"
          (fn [] Any
            (let [hits (js/call all-text .filter (fn [e] Any (js/call (js/get e .text) .includes "zen-browser.app")))]
              (js/call (expect (js/call hits .map (fn [h] Any (js/get h .path)))) .toEqual []))))

        (test "no nightly.mozilla.org references (we replaced these in gjoa.json)"
          (fn [] Any
            (let [hits (js/call all-text .filter (fn [e] Any (js/call (js/get e .text) .includes "nightly.mozilla.org")))]
              (js/call (expect (js/call hits .map (fn [h] Any (js/get h .path)))) .toEqual []))))

        (test "no Nightly brand string left over"
          (fn [] Any
            ;; Brand short/shorter/full names should all be substituted out.
            (let [ftl (js/call all-text .find (fn [f] Any (js/call (js/get f .path) .endsWith "brand.ftl")))]
              (js/call (expect ftl) .toBeDefined)
              (js/call (js/get (expect (js/get ftl .text)) .not) .toMatch (js/new RegExp "= Nightly"))
              (js/call (expect (js/get ftl .text)) .toMatch (js/new RegExp (str "= " (js/get (js/get cfg .branding) .shortName)))))))

        (test "welcome URL pref is empty (no auto-opened first-run tabs)"
          (fn [] Any
            (let [branding! (js/call all-text .find (fn [f] Any (js/call (js/get f .path) .endsWith "firefox-branding.js")))]
              (js/call (expect branding!) .toBeDefined)
              (js/call (expect (js/get branding! .text)) .toMatch (js/new RegExp "pref\\(\"startup\\.homepage_welcome_url\",\\s*\"\"\\);")))))

        (test "update URLs point to gjoa.json's configured target"
          (fn [] Any
            (let [branding! (js/call all-text .find (fn [f] Any (js/call (js/get f .path) .endsWith "firefox-branding.js")))]
              (js/call (expect branding!) .toBeDefined)
              (js/call (expect (js/get branding! .text)) .toContain (js/get (js/get cfg .urls) .updateManual)))))

        (test "configure.sh display name matches gjoa.json"
          (fn [] Any
            (let [cfgsh (js/call all-text .find (fn [f] Any (js/call (js/get f .path) .endsWith "configure.sh")))]
              (js/call (expect cfgsh) .toBeDefined)
              (js/call (expect (js/get cfgsh .text)) .toContain (str "MOZ_APP_DISPLAYNAME=" (js/get (js/get cfg .branding) .displayName))))))))))
