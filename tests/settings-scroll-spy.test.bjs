#lang beagle/js
;; Static contract for the about:gjoa navigation scroll-spy.
(ns gjoa.tests.settings-scroll-spy
  (:require [fs :refer [readFileSync]]
            [path :refer [join]]))

;; bun:test is prepended to the generated module by the test build.
(declare-extern [describe expect test] Any)

(def SETTINGS-DIR String
  "src/gjoa/browser/components/gjoa/content/settings")
(def JS String (readFileSync (join SETTINGS-DIR "settings.js") "utf8"))
(def GUARD-RE Any (js/new RegExp "scrollHeight\\s*-\\s*(\\d+)"))

(describe "about:gjoa settings scroll-spy"
  (fn [] Any
    (test "activates the final section before the literal page end"
      (fn [] Any
        (let [m Any (js/call JS .match GUARD-RE)]
          (js/call (expect m) .toBeTruthy)
          (js/call (expect (parseInt (aget m 1) 10)) .toBeGreaterThanOrEqual 100))))))
