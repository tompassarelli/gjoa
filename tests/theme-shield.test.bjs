#lang beagle/js
;; Current Firefox theme-shield contract for the urlbar and its action boxes.
(ns gjoa.tests.theme-shield
  (:require [fs :refer [existsSync readFileSync]]
            [path :refer [join]]))
(define-mode strict)

(declare-extern [describe expect test process] Any)

(def REPO :- String (.cwd process))
(def SHIELD :- String (join REPO "src" "gjoa" "chrome" "css" "gjoa.uc.css"))

(describe "urlbar theme shield"
  (fn []
    (test "CSS source exists"
      (fn []
        (.toBe (expect (existsSync SHIELD)) true)))

    (test "declares the current Firefox urlbar variables"
      (fn []
        (let [css (readFileSync SHIELD "utf8")]
          (.toContain (expect css) "--toolbar-field-focus-background-color:")
          (.toContain (expect css) "--urlbar-box-background-color:"))))))
