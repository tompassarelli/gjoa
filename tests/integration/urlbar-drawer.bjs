#lang beagle/js
;; Urlbar-in-drawer regression lock (commit 264c94f, gjoa.uc.css).
;;
;; The in-sidebar urlbar is CHROME, not content, so a Marionette chrome-context
;; executeScript can read its DOM rects directly — no content-context discard
;; (that only bites content pages; see contrast.bjs / darkmode-render.bjs). All
;; three assertions run against the live chrome document, no network, DEFAULT
;; lane.
;;
;; Two regressions this guards (both from 264c94f reverting 5f57d8a / 29451f9):
;;
;;   #1 The Ctrl+L FLOATING palette must OVERLAY the page at spec width, and the
;;      RESTING urlbar must stay contained in the drawer. Two halves of one
;;      geometry contract, measured in one window:
;;
;;      RESTING (264c94f lock): the native urlbar is `position: absolute` with
;;      #navigator-toolbox as its containing block, so the bad `width: 100%`
;;      resolved against the toolbox and spanned the whole window. The fix
;;      restores `width: var(--urlbar-width)` (JS-pinned by drawer/layout.bjs
;;      sync-urlbar-width to sidebar inner width). ASSERT: width well under the
;;      WINDOW width and ~= #sidebar-container inner width (minus 2·inset). NOT
;;      against #navigator-toolbox — `expand` reparents the toolbox inside
;;      #sidebar-container, so that width just is the drawer width.
;;
;;      FLOATING (owner spec): Ctrl+L lifts #urlbar into the top layer and
;;      centers it over the CONTENT. An in-sidebar geometry rule that loses its
;;      `:root:not([gjoa-urlbar-floating])` guard out-specifies the floating
;;      rules and drags the palette back to the drawer slot, where
;;      #gjoa-urlbar-toolbar's `overflow: hidden` cuts it off. ASSERT the three
;;      properties that failure violates: the palette ESCAPES the
;;      #sidebar-container box, its width is inside the owner's zen-sized band,
;;      and its visual rect equals its layout rect. Plus the hint footer, which
;;      must be present + visible while floating and ABSENT in the resting bar.
;;
;;   #2 EXPANDED dropdown panel must be OPAQUE (non-collapsed). On focus the
;;      urlbar gets [breakout-extend]; the bad nova-only calc made
;;      .urlbar-background's inset-block-start fall back to `auto`, collapsing the
;;      panel to zero height -> the sidebar bled through. The fix uses
;;      inset-block-start: calc(-1 * 8px), keeping inset-block-end:0 so the panel
;;      stretches over input + results.
;;      ASSERT: #urlbar[breakout-extend] > .urlbar-background rect height > 0
;;      (tall enough to cover the input row), and its background-color is opaque.
;;
;;   #3 (29451f9 property) NO vertical jump: .urlbar-input-container's top (the
;;      security icon + URL text row) is the same (within ~1px) at rest vs
;;      [breakout-extend] — focusing the urlbar must not shift the text down.
;;
;;   #5 The palette is PROMOTION-INDEPENDENT: centred, zen-wide and hit-testable
;;      with #urlbar forcibly out of the top layer, through every eviction path
;;      (breakout blocker / raw hidePopover / uidensity change). See DEMOTE-AND-MEASURE.
;;
;;   #4 The resting-slot GHOST keeps the ENGINE CHIP. #gjoa-urlbar-ghost stands in
;;      for the resting bar while the palette floats, so anything the resting bar
;;      shows and the ghost doesn't reads as that element vanishing on Ctrl+L.
;;      ASSERT in BOTH urlbar states (default + searchmode-with-text): the ghost
;;      carries a box at the .searchmode-switcher's rect and a PAINTED replica at
;;      the engine icon's rect, both within 2px of the pre-summon geometry.
(ns gjoa.tests.integration.urlbar-drawer
  (:require [gjoa.tests.dsl :refer [deftest chrome-eval await-true wait-for expect expect-eq]]))
(define-mode strict)

(declare-extern [Number] Any)

;; Put the window into the EXPANDED vertical-tab layout that hosts the in-drawer
;; urlbar (#gjoa-urlbar-toolbar inside #sidebar-container), then settle. The runner's
;; per-test RESET already sets sidebar.verticalTabs=true and blurs the urlbar;
;; this additionally expands the launcher so #sidebar-container has its full width
;; (sync-urlbar-width needs a non-collapsed drawer to pin --urlbar-width).
(def ENSURE-EXPANDED-DRAWER :- String "
  Services.prefs.setBoolPref('sidebar.verticalTabs', true);
  Services.prefs.setBoolPref('sidebar.revamp', true);
  const sm = document.getElementById('sidebar-container');
  if (sm && !sm.hasAttribute('sidebar-launcher-expanded')) {
    sm.setAttribute('sidebar-launcher-expanded', '');
  }
  // gjoa forces nova OFF; assert the precondition the fix relies on so a future
  // nova flip doesn't silently change which CSS path is exercised.
  const nova = Services.prefs.getBoolPref('browser.nova.enabled', false);
  return { hasToolbar: !!document.getElementById('gjoa-urlbar-toolbar'),
           hasUrlbar: !!document.getElementById('urlbar'),
           hasSidebarMain: !!sm, nova };
")

;; Measure the RESTING urlbar (not focused, no breakout-extend). Reports the
;; #urlbar rect, the #navigator-toolbox rect, the #sidebar-container rect, and the
;; --gjoa-sidebar-inset so the assertion can compute the expected inner width.
(def MEASURE-RESTING :- String "
  const urlbar = document.getElementById('urlbar');
  const toolbox = document.getElementById('navigator-toolbox');
  const sm = document.getElementById('sidebar-container');
  if (!urlbar || !toolbox || !sm) return { error: 'missing element',
    urlbar: !!urlbar, toolbox: !!toolbox, sm: !!sm };
  const cs = getComputedStyle(document.documentElement);
  const inset = parseFloat(cs.getPropertyValue('--gjoa-sidebar-inset')) || 10;
  const ic = urlbar.querySelector('.urlbar-input-container');
  const u = urlbar.getBoundingClientRect();
  const t = toolbox.getBoundingClientRect();
  const s = sm.getBoundingClientRect();
  return {
    urlbarWidth: u.width, urlbarLeft: u.left, urlbarRight: u.right,
    toolboxWidth: t.width, toolboxLeft: t.left, toolboxRight: t.right,
    sidebarWidth: s.width, sidebarLeft: s.left, sidebarRight: s.right,
    windowWidth: window.innerWidth,
    inset,
    breakoutExtend: urlbar.hasAttribute('breakout-extend'),
    breakout: urlbar.hasAttribute('breakout'),
    popoverOpen: urlbar.matches(':popover-open'),
    urlbarHeightVar: getComputedStyle(urlbar).getPropertyValue('--urlbar-height'),
    inputContainerTop: ic ? ic.getBoundingClientRect().top : null,
    hints: !!document.getElementById('gjoa-urlbar-hints'),
  };
")

;; Measure the FLOATING (Ctrl+L) palette. `hit` is the visual-vs-layout check: a
;; box cut off by a clip ancestor stops hit-testing at the cut, so an edge point
;; that resolves outside #urlbar means the painted box is narrower than the rect.
(def MEASURE-FLOATING :- String "
  const urlbar = document.getElementById('urlbar');
  const sc = document.getElementById('sidebar-container');
  if (!urlbar || !sc) return { error: 'missing element' };
  const u = urlbar.getBoundingClientRect();
  const s = sc.getBoundingClientRect();
  const cy = Math.round(u.top + u.height / 2);
  const hit = x => { const e = document.elementFromPoint(Math.round(x), cy);
    return e ? { id: e.id || e.localName, inUrlbar: (e === urlbar || urlbar.contains(e)) }
             : { id: null, inUrlbar: false }; };
  const rects = urlbar.getClientRects();
  const hints = document.getElementById('gjoa-urlbar-hints');
  const hr = hints ? hints.getBoundingClientRect() : null;
  const view = urlbar.querySelector('.urlbarView');
  const vr = view ? view.getBoundingClientRect() : null;
  return {
    urlbarWidth: u.width, urlbarLeft: u.left, urlbarRight: u.right,
    sidebarLeft: s.left, sidebarRight: s.right,
    windowWidth: window.innerWidth,
    hints: !!hints,
    hintsInUrlbar: !!(hints && urlbar.contains(hints)),
    hintsVisible: !!(hr && hr.width > 0 && hr.height > 0
                     && getComputedStyle(hints).display !== 'none'
                     && getComputedStyle(hints).visibility !== 'hidden'),
    hintsBelowResults: !!(hr && (!vr || hr.top >= vr.bottom - 1)),
    hintsText: hints ? hints.textContent.trim() : null,
    floating: document.documentElement.hasAttribute('gjoa-urlbar-floating'),
    arming: document.documentElement.hasAttribute('gjoa-urlbar-arming'),
    breakoutExtend: urlbar.hasAttribute('breakout-extend'),
    popoverOpen: urlbar.matches(':popover-open'),
    clientRects: rects.length,
    clientRectWidth: rects.length ? rects[0].width : null,
    hitLeft: hit(u.left + 3), hitRight: hit(u.right - 3),
  };
")

;; Summon / dismiss the floating palette through the same CustomEvents the Ctrl+L
;; handler (drawer/index.bjs) dispatches into, so the test drives the real
;; activate path without synthesizing a widget key event.
(def SUMMON-FLOATING :- String "
  document.dispatchEvent(new CustomEvent('gjoa-urlbar-activate', { detail: { intent: 'current' } }));
  try { window.focus(); gURLBar.focus(); } catch (e) {}
  return true;
")
(def DISMISS-FLOATING :- String "
  document.dispatchEvent(new CustomEvent('gjoa-urlbar-deactivate'));
  return true;
")
;; Same deterministic [breakout-extend] drive as MEASURE-EXTENDED, but WITHOUT
;; leaving the floating state — a headless profile has no suggestions, so the
;; view never opens on its own and the palette would never reach the state a real
;; Ctrl+L lands in.
(def EXTEND-FLOATING :- String "
  const urlbar = document.getElementById('urlbar');
  if (!urlbar) return false;
  try {
    urlbar.toggleAttribute('open', true);
    if (window.gURLBar && window.gURLBar.startLayoutExtend) window.gURLBar.startLayoutExtend();
    else urlbar.toggleAttribute('breakout-extend', true);
  } catch (e) { urlbar.toggleAttribute('breakout-extend', true); }
  return true;
")

;; Drive the EXPANDED state the same way native Firefox does on focus, but
;; deterministically (no network / suggestion providers): focus the urlbar, mark
;; the view open (`view.isOpen` is just `input.hasAttribute('open')`,
;; UrlbarView.sys.mjs), then call the real `startLayoutExtend()`. In non-nova
;; that method early-returns unless the view is open — once it is, it toggles the
;; native [breakout-extend] attribute, the exact attribute the CSS keys off.
;; Then measure the .urlbar-background panel + the input row.
(def MEASURE-EXTENDED :- String "
  const urlbar = document.getElementById('urlbar');
  if (!urlbar) return { error: 'no urlbar' };
  try { if (window.gURLBar) {
    window.gURLBar.focus();
    urlbar.toggleAttribute('open', true);
    if (window.gURLBar.startLayoutExtend) window.gURLBar.startLayoutExtend();
    else urlbar.toggleAttribute('breakout-extend', true);
  } else {
    urlbar.toggleAttribute('open', true);
    urlbar.toggleAttribute('breakout-extend', true);
  } } catch (e) { return { error: 'extend failed: ' + (e && e.message || e) }; }
  if (!urlbar.hasAttribute('breakout-extend')) return { error: 'breakout-extend not applied' };
  const bg = urlbar.querySelector('.urlbar-background');
  const ic = urlbar.querySelector('.urlbar-input-container');
  const u = urlbar.getBoundingClientRect();
  const bgRect = bg ? bg.getBoundingClientRect() : null;
  const bgCS = bg ? getComputedStyle(bg) : null;
  return {
    hasBackground: !!bg,
    bgHeight: bgRect ? bgRect.height : null,
    bgTop: bgRect ? bgRect.top : null,
    bgBottom: bgRect ? bgRect.bottom : null,
    bgColor: bgCS ? bgCS.backgroundColor : null,
    urlbarHeight: u.height,
    inputContainerTop: ic ? ic.getBoundingClientRect().top : null,
    breakoutExtend: urlbar.hasAttribute('breakout-extend'),
  };
")

;; Restore the resting state (blur, drop the synthetic open/breakout-extend) so
;; the per-test order-independence the runner relies on isn't disturbed.
(def RESET-URLBAR :- String "
  const urlbar = document.getElementById('urlbar');
  try { if (window.gURLBar) { if (window.gURLBar.endLayoutExtend) window.gURLBar.endLayoutExtend(); window.gURLBar.blur(); } } catch (e) {}
  if (urlbar) { urlbar.removeAttribute('open'); urlbar.removeAttribute('breakout-extend'); }
  return true;
")

;; Floating teardown is ASYNC (fade → transitionend → finish-teardown), so a test
;; that summoned the palette must not return while the ghost still holds the
;; resting slot — it displaces the input row and fails the no-jump test (#3).
(def FLOATING-TORN-DOWN :- String "
  const d = document.documentElement;
  return !d.hasAttribute('gjoa-urlbar-floating')
      && !d.hasAttribute('gjoa-urlbar-teardown')
      && !document.getElementById('gjoa-urlbar-ghost')
      && !document.getElementById('gjoa-urlbar-backdrop')
      && !document.getElementById('gjoa-urlbar-hints');
")

;; finish-teardown deliberately takes #urlbar back OUT of the top layer, but the
;; drawer's steady resting state has it popover-promoted — and an in-flow urlbar
;; lays its breakout-extend box out 8px lower, which fails #3. Capture/restore so
;; summoning the palette here leaves the window as it was found.
(def CAPTURE-POPOVER :- String "
  const u = document.getElementById('urlbar');
  return { manual: u && u.getAttribute('popover') === 'manual',
           open: !!(u && u.matches(':popover-open')) };
")
(def RESTORE-POPOVER :- String "
  const u = document.getElementById('urlbar');
  const [manual, open] = arguments;
  try {
    if (u && manual && u.getAttribute('popover') !== 'manual') u.setAttribute('popover', 'manual');
    if (u && open && !u.matches(':popover-open') && u.showPopover) u.showPopover();
  } catch (e) {}
  return true;
")

;; Drive Firefox's OWN top-layer eviction: incrementBreakoutBlockerCount() calls
;; UrlbarInput.#stopBreakout(), which hidePopover()s #urlbar and drops [breakout]
;; from #urlbar + #urlbar-container. Without the watchdog the palette drops out of
;; the top layer and lands at the drawer's left edge (measured left=8 at 1424).
;; `__gjoaEvictSettled` is a real settle condition (two frames elapsed), not a
;; fixed sleep — the watchdog re-promotes off the popover `toggle` task.
(def EVICT-BREAKOUT :- String "
  window.__gjoaEvictSettled = false;
  window.gURLBar.incrementBreakoutBlockerCount();
  requestAnimationFrame(() => requestAnimationFrame(() => { window.__gjoaEvictSettled = true; }));
  return true;
")
(def RESTORE-BREAKOUT :- String "
  window.__gjoaEvictSettled = false;
  window.gURLBar.decrementBreakoutBlockerCount();
  requestAnimationFrame(() => requestAnimationFrame(() => { window.__gjoaEvictSettled = true; }));
  return true;
")
(def EVICT-SETTLED :- String "return window.__gjoaEvictSettled === true;")
(def MEASURE-PROMOTION :- String "
  const urlbar = document.getElementById('urlbar');
  const container = document.getElementById('urlbar-container');
  const u = urlbar.getBoundingClientRect();
  return {
    popoverOpen: urlbar.matches(':popover-open'),
    breakout: urlbar.hasAttribute('breakout'),
    containerBreakout: !!(container && container.hasAttribute('breakout')),
    left: u.left, width: u.width, windowWidth: window.innerWidth,
  };
")
(defn assert-promoted! [p :- Any phase :- String] :- Any
  (let [tag (str "top-layer watchdog (" phase "): ")
        centre-off (Math/abs (- (.-left p)
                                (/ (- (.-windowWidth p) (.-width p)) 2)))]
    (expect (.-popoverOpen p)
      (str tag "#urlbar evicted from the top layer (:popover-open false) — the "
           "floating palette is laid out inside the drawer. " (JSON/stringify p)))
    (expect (.-breakout p)
      (str tag "#urlbar lost [breakout] — .urlbar-background/.urlbarView stop "
           "rendering, so the palette paints nothing. " (JSON/stringify p)))
    (expect (.-containerBreakout p)
      (str tag "#urlbar-container lost [breakout]. " (JSON/stringify p)))
    (expect (<= centre-off 4)
      (str tag "palette off-centre by " (.toFixed centre-off 1)
           "px — it is positioned by the sidebar subtree, not the ICB. "
           (JSON/stringify p)))))

;; PROMOTION-INDEPENDENCE (2026-08-07). The palette used to be centred + painted
;; over the content ONLY while #urlbar was a top-layer popover; every eviction path
;; below dropped it back to the drawer's containing block and under the content deck
;; (the "content-edge cut-off" the owner hit five times). The fix parks #urlbar in
;; #gjoa-urlbar-stage, a direct child of documentElement, so neither property depends
;; on the promotion any more. Each path evicts and measures IN THE SAME TASK: the
;; watchdog's MutationObserver / `toggle` callbacks run at the microtask checkpoint
;; AFTER this script, so what comes back is the palette with NO healing applied.
(def DEMOTE-AND-MEASURE :- String "
  const [path] = arguments;
  const u = document.getElementById('urlbar');
  try {
    if (path === 'breakout blocker') gURLBar.incrementBreakoutBlockerCount();
    else if (path === 'uidensity change') gUIDensity.update(gUIDensity.MODE_COMPACT);
    if (u.matches(':popover-open') && u.hidePopover) u.hidePopover();
    u.removeAttribute('popover');
  } catch (e) { return { error: 'demote via ' + path + ' threw: ' + String(e), path }; }
  const stage = document.getElementById('gjoa-urlbar-stage');
  const ur = u.getBoundingClientRect();
  const cy = Math.round(ur.top + ur.height / 2);
  const hit = x => { const e = document.elementFromPoint(Math.round(x), cy);
    return e ? { id: e.id || e.localName, inUrlbar: (e === u || u.contains(e)) }
             : { id: null, inUrlbar: false }; };
  const rects = u.getClientRects();
  return {
    path,
    staged: !!(stage && u.parentNode === stage),
    stageOnRoot: !!(stage && stage.parentNode === document.documentElement),
    popoverOpen: u.matches(':popover-open'),
    left: ur.left, right: ur.right, width: ur.width, windowWidth: window.innerWidth,
    clientRects: rects.length,
    clientRectWidth: rects.length ? rects[0].width : null,
    hitLeft: hit(ur.left + 3), hitRight: hit(ur.right - 3),
  };
")
(def UNDEMOTE :- String "
  const [path] = arguments;
  try {
    if (path === 'breakout blocker') gURLBar.decrementBreakoutBlockerCount();
    else if (path === 'uidensity change') gUIDensity.update(gUIDensity.MODE_NORMAL);
  } catch (e) {}
  window.__gjoaEvictSettled = false;
  requestAnimationFrame(() => requestAnimationFrame(() => { window.__gjoaEvictSettled = true; }));
  return true;
")
(defn assert-promotion-independent! [d :- Any] :- Any
  (let [tag (str "staged palette (demoted via " (.-path d) "): ")
        centre-off (Math/abs (- (/ (+ (.-left d) (.-right d)) 2)
                                (/ (.-windowWidth d) 2)))]
    (expect (not (.-error d)) (str tag (.-error d)))
    ;; NON-VACUOUS: if the eviction didn't take, the case proves nothing.
    (expect (not (.-popoverOpen d))
      (str tag "still :popover-open — the forced demotion did not take. "
           (JSON/stringify d)))
    (expect (and (.-staged d) (.-stageOnRoot d))
      (str tag "#urlbar is not parked in #gjoa-urlbar-stage under documentElement, so "
           "it is back inside the drawer's containing block + stacking context. "
           (JSON/stringify d)))
    (expect (<= centre-off 4)
      (str tag "off-centre by " (.toFixed centre-off 1) "px WITHOUT the promotion — "
           "the stage is not holding the geometry. " (JSON/stringify d)))
    (expect (and (>= (.-width d) 660) (<= (.-width d) 760))
      (str tag "width " (.toFixed (.-width d) 1) "px left the zen-sized band — the "
           "drawer-scoped width rules took it back. " (JSON/stringify d)))
    (expect (and (= (.-clientRects d) 1)
                 (< (Math/abs (- (.-clientRectWidth d) (.-width d))) 1))
      (str tag "client rect disagrees with its bounding rect. " (JSON/stringify d)))
    (expect (and (.-inUrlbar (.-hitLeft d)) (.-inUrlbar (.-hitRight d)))
      (str tag "CUT OFF — an edge point hit-tests outside #urlbar (left→"
           (.-id (.-hitLeft d)) ", right→" (.-id (.-hitRight d)) "); the content deck "
           "is painting over the palette. " (JSON/stringify d)))))

;; The pre-summon engine chip: the .searchmode-switcher box and the engine icon
;; inside it (a moz-button renders that <img> in its open shadow root), both
;; relative to #urlbar so they can be compared against the ghost's own box.
(def MEASURE-CHIP :- String "
  const urlbar = document.getElementById('urlbar');
  const chip = urlbar.querySelector('.searchmode-switcher');
  if (!chip) return { error: 'no .searchmode-switcher in #urlbar' };
  const vis = el => { const r = el.getBoundingClientRect(); const c = getComputedStyle(el);
    return r.width > 0 && r.height > 0 && c.display !== 'none' && c.visibility !== 'hidden'; };
  const ur = urlbar.getBoundingClientRect();
  const cr = chip.getBoundingClientRect();
  const sr = chip.shadowRoot;
  const icon = (sr && sr.querySelector('img[src]')) || chip.querySelector('img[src]');
  const ir = icon ? icon.getBoundingClientRect() : null;
  return {
    searchmode: urlbar.hasAttribute('searchmode'),
    chipVisible: vis(chip),
    chip: { l: cr.left - ur.left, t: cr.top - ur.top, w: cr.width, h: cr.height },
    iconSrc: icon ? icon.src : null,
    iconVisible: !!(icon && vis(icon)),
    icon: ir ? { l: ir.left - ur.left, t: ir.top - ur.top, w: ir.width, h: ir.height } : null,
    urlbarWidth: ur.width,
  };
")

;; Every box the ghost draws, relative to the ghost, plus whether it actually
;; PAINTS an image — a replica at the right rect that paints nothing is invisible.
(def MEASURE-GHOST-BOXES :- String "
  const g = document.getElementById('gjoa-urlbar-ghost');
  if (!g) return { error: 'no #gjoa-urlbar-ghost while the palette floats' };
  const gr = g.getBoundingClientRect();
  const boxes = Array.from(g.querySelectorAll('*')).map(el => {
    const r = el.getBoundingClientRect(); const c = getComputedStyle(el);
    return { l: r.left - gr.left, t: r.top - gr.top, w: r.width, h: r.height,
             paints: c.backgroundImage !== 'none' || (!!c.maskImage && c.maskImage !== 'none') };
  });
  return { width: gr.width, count: boxes.length, boxes };
")

;; Type into a search mode. The headless test profile has no search service, so an
;; engine mode is not drivable here; a LOCAL mode renders the same compound chip
;; (engine icon + title + exit button) the owner's Google mode does.
(def ENTER-SEARCHMODE :- String "
  const urlbar = document.getElementById('urlbar');
  try {
    gURLBar.focus();
    gURLBar.value = 'amaz';
    gURLBar.searchMode = { source: 1 };
  } catch (e) { return { error: String(e) }; }
  return { searchmode: urlbar.hasAttribute('searchmode'), value: gURLBar.value };
")
(def EXIT-SEARCHMODE :- String "
  try { gURLBar.searchMode = null; gURLBar.value = ''; gURLBar.blur(); } catch (e) {}
  return !document.getElementById('urlbar').hasAttribute('searchmode');
")

;; GUARD against a vacuous pass on a dead-chrome binary: if GjoaLoader threw
;; (the $$bc-runtime mismatch class), NO gjoa stylesheet is registered and the
;; urlbar shows native FF behavior — under which the panel-height / no-jump
;; assertions could pass on Firefox defaults rather than on our CSS. `gjoa.uc.css`
;; defines `:root { --gjoa-urlbar-breathing: 8px }`; native FF does not. If that
;; var doesn't resolve, our CSS is NOT applied → fail loudly instead of green.
(defn require-gjoa-css! [mn :- Any] :- Any
  (let [applied (js/await (.executeScript mn
                  (str "const v = getComputedStyle(document.documentElement)"
                       ".getPropertyValue('--gjoa-urlbar-breathing').trim();"
                       "return v === '8px';")))]
    (when (not applied)
      (throw (Error.
        (str "gjoa.uc.css is NOT applied (--gjoa-urlbar-breathing unresolved) — "
             "GjoaLoader did not register the gjoa stylesheet (e.g. $$bc-runtime "
             "mismatch in a stale binary). This test would otherwise pass "
             "vacuously on native Firefox defaults; rebuild the bundle/binary."))))))

;; The owner-spec contract for the Ctrl+L palette, asserted in every floating
;; sub-state: it escapes the drawer, sits centred over the content, is zen-sized,
;; carries the hint footer, and its painted box matches its layout rect.
(defn assert-floating-overlay! [f :- Any phase :- String] :- Any
  (let [tag (str "floating palette (" phase "): ")]
    (expect (not (.-error f)) (str tag "MEASURE-FLOATING error: " (JSON/stringify f)))
    (expect (.-floating f)
      (str tag "gjoa-urlbar-floating not set — the Ctrl+L activate path never ran"))
    ;; (a) ESCAPE + CENTRE. Every known form of "an in-sidebar rule out-specified
    ;; the floating path" — width:var(--urlbar-width), left/right:auto, the
    ;; sidebar-positionend translateX — anchors the box to the drawer slot, and
    ;; some still spill a little past the drawer edge, so centring is the assertion
    ;; that actually pins the contract.
    (expect (or (< (.-urlbarLeft f) (- (.-sidebarLeft f) 1))
                (> (.-urlbarRight f) (+ (.-sidebarRight f) 1)))
      (str tag "CONTAINED in #sidebar-container ["
           (.toFixed (.-sidebarLeft f) 1) ".." (.toFixed (.-sidebarRight f) 1)
           "] — it must overlay the page content. " (JSON/stringify f)))
    (let [off (Math/abs (- (/ (+ (.-urlbarLeft f) (.-urlbarRight f)) 2)
                           (/ (.-windowWidth f) 2)))]
      (expect (<= off 8)
        (str tag "OFF-CENTRE by " (.toFixed off 1) "px — anchored to the drawer "
             "slot, not centred over the content. " (JSON/stringify f))))
    ;; (b) SPEC WIDTH: owner spec "zen-sized" — clamp(600px, 50vw, 820px) resolves
    ;; to 700px (half the window) at the 1400px window the test pins. The floor
    ;; also catches a revert to the superseded 400-600px band (560px there).
    (expect (and (>= (.-urlbarWidth f) 660) (<= (.-urlbarWidth f) 760))
      (str tag "width " (.toFixed (.-urlbarWidth f) 1)
           "px is outside the zen-sized 700px±40 band at a "
           (.toFixed (.-windowWidth f) 1) "px window. " (JSON/stringify f)))
    ;; (b2) HINT FOOTER: present, inside #urlbar, rendered, and below the results.
    (expect (and (.-hints f) (.-hintsInUrlbar f) (.-hintsVisible f) (.-hintsBelowResults f))
      (str tag "hint footer missing/hidden/misplaced — present=" (.-hints f)
           " inUrlbar=" (.-hintsInUrlbar f) " visible=" (.-hintsVisible f)
           " belowResults=" (.-hintsBelowResults f) " text=" (.-hintsText f)
           ". " (JSON/stringify f)))
    ;; (c) NOT CLIPPED: visual rect == layout rect. Top-layer promotion is the
    ;; escape mechanism; one unfragmented client rect at the full width, plus both
    ;; edges hit-testing into #urlbar, is the painted box agreeing with it.
    (expect (.-popoverOpen f)
      (str tag "NOT top-layer promoted (:popover-open false) — it is laid out "
           "inside the drawer's clip chain. " (JSON/stringify f)))
    (expect (and (= (.-clientRects f) 1)
                 (< (Math/abs (- (.-clientRectWidth f) (.-urlbarWidth f))) 1))
      (str tag "client rect disagrees with its bounding rect. " (JSON/stringify f)))
    (expect (and (.-inUrlbar (.-hitLeft f)) (.-inUrlbar (.-hitRight f)))
      (str tag "CLIPPED — an edge point hit-tests outside #urlbar (left→"
           (.-id (.-hitLeft f)) ", right→" (.-id (.-hitRight f))
           "), so the painted box is narrower than its layout rect. "
           (JSON/stringify f)))))

;; The ghost is a look-alike, not a clone, so it is compared by GEOMETRY: for each
;; real box, some ghost box at the same offset within the same-width container.
(defn assert-ghost-chip! [c :- Any gh :- Any phase :- String] :- Any
  (let [tag (str "ghost engine chip (" phase "): ")
        near? (fn [a :- Any b :- Any] (<= (Math/abs (- (Number a) (Number b))) 2))
        at-rect (fn [want :- Any painted? :- Any]
                (.find (.-boxes gh)
                  (fn [b] (and (near? (.-l b) (.-l want)) (near? (.-t b) (.-t want))
                               (near? (.-w b) (.-w want)) (near? (.-h b) (.-h want))
                               (or (not painted?) (.-paints b))))))]
    (expect (not (.-error c)) (str tag "MEASURE-CHIP error: " (JSON/stringify c)))
    (expect (.-chipVisible c)
      (str tag "the resting bar shows no engine chip — precondition gone, the "
           "assertion below would pass vacuously. " (JSON/stringify c)))
    (expect (and (.-icon c) (.-iconVisible c))
      (str tag "no engine icon inside the resting chip. " (JSON/stringify c)))
    (expect (not (.-error gh)) (str tag "MEASURE-GHOST-BOXES error: " (JSON/stringify gh)))
    (expect (near? (.-width gh) (.-urlbarWidth c))
      (str tag "ghost width " (.toFixed (.-width gh) 1) "px != pre-summon urlbar width "
           (.toFixed (.-urlbarWidth c) 1) "px, so the offsets below are not comparable."))
    (expect (at-rect (.-chip c) false)
      (str tag "no ghost box at the chip's rect " (JSON/stringify (.-chip c))
           " — the chip is missing from the resting slot while the palette floats. "
           "ghost=" (JSON/stringify gh)))
    (expect (at-rect (.-icon c) true)
      (str tag "no PAINTED ghost box at the engine icon's rect " (JSON/stringify (.-icon c))
           " (src=" (.-iconSrc c) ") — the engine icon vanishes from the drawer on "
           "Ctrl+L. ghost=" (JSON/stringify gh)))))

(js/export (def tests :- Any
  [(deftest "urlbar — Ctrl+L palette OVERLAYS the content at spec width; resting bar stays in the drawer (#1)" [mn]
     (js/await (.executeScript mn ENSURE-EXPANDED-DRAWER))
     (js/await (require-gjoa-css! mn))
     ;; Pin the window at 1400x900 so the width band below is a fixed number, not
     ;; a function of whatever size the previous test left. Restored at the end.
     (let [orig (js/await (.executeScript mn
                  "return { w: window.outerWidth, h: window.outerHeight };"))
           pop0 (js/await (.executeScript mn CAPTURE-POPOVER))]
       (js/await (.executeScript mn "window.resizeTo(1400, 900); return true;"))
       (js/await (await-true "return window.innerWidth === 1400;" 3000))
     ;; PRECONDITION: the gjoa drawer must have reparented #urlbar into
     ;; #gjoa-urlbar-toolbar (drawer/layout.bjs `expand`). Without it, #urlbar is
     ;; still in the native #nav-bar at full width — a width assertion there would
     ;; mis-blame the CSS for a dead-chrome bundle. Fail loudly + specifically.
     (let [in-drawer (js/await (.executeScript mn
                       (str "const u = document.getElementById('urlbar');"
                            "const tb = document.getElementById('gjoa-urlbar-toolbar');"
                            "return !!(u && tb && tb.contains(u) && window.gjoaTest);")))]
       (expect in-drawer
         (str "#urlbar is not inside #gjoa-urlbar-toolbar — the gjoa drawer chrome "
              "did not initialize (e.g. GjoaLoader $$bc-runtime mismatch in a stale "
              "binary). Rebuild the bundle/binary; this test needs live gjoa chrome.")))
     ;; Wait for sync-urlbar-width to pin --urlbar-width to the drawer inner
     ;; width: the resting #urlbar must be a drawer-sized box, not a window-sized one.
     (js/await (await-true
                 (str "const u = document.getElementById('urlbar');"
                      "if (!u) return false;"
                      "const ur = u.getBoundingClientRect();"
                      "return ur.width > 0 && ur.width < window.innerWidth * 0.6;")
                 5000))
     (let [r (chrome-eval MEASURE-RESTING)]
       (expect (not (.-error r)) (str "MEASURE-RESTING error: " (JSON/stringify r)))
       (expect (not (.-breakoutExtend r))
         "resting urlbar unexpectedly has [breakout-extend] — measure ran in the wrong state")
       ;; The hint footer belongs to the FLOATING palette only; the resting drawer
       ;; bar must not carry it (JS creates it on activate, drops it on teardown).
       (expect (not (.-hints r))
         (str "#gjoa-urlbar-hints present in the RESTING drawer urlbar — the hint "
              "footer leaked out of the floating palette. " (JSON/stringify r)))
       ;; The bug spanned the urlbar to the full window width. Containment:
       ;; the urlbar must stay a drawer-sized box.
       (expect (< (.-urlbarWidth r) (* (.-windowWidth r) 0.6))
         (str "resting urlbar not contained — width " (.toFixed (.-urlbarWidth r) 1)
              "px is ~the window width " (.toFixed (.-windowWidth r) 1) "px "
              "(the width:100%-vs-#navigator-toolbox regression). " (JSON/stringify r)))
       ;; And it must be ~ the drawer inner width (sidebar width − 2·inset), the
       ;; value sync-urlbar-width pins. Allow generous slack for sub-pixel / icon
       ;; reserve so this stays robust, not pixel-brittle.
       (let [expected-inner (- (.-sidebarWidth r) (* (.-inset r) 2))
             delta (Math/abs (- (.-urlbarWidth r) expected-inner))]
         (expect (< delta 40)
           (str "resting urlbar width " (.toFixed (.-urlbarWidth r) 1) "px not ~ drawer inner width "
                (.toFixed expected-inner 1) "px (sidebar " (.toFixed (.-sidebarWidth r) 1)
                " − 2·" (.-inset r) "); delta=" (.toFixed delta 1) "px. " (JSON/stringify r))))
       ;; Belt-and-suspenders: the urlbar must sit inside the toolbox horizontally.
       (expect (and (>= (.-urlbarLeft r) (- (.-toolboxLeft r) 2))
                    (<= (.-urlbarRight r) (+ (.-toolboxRight r) 2)))
         (str "resting urlbar overflows the toolbox horizontally. " (JSON/stringify r))))

     ;; --- FLOATING: the Ctrl+L palette over the content -----------------------
     (js/await (.executeScript mn SUMMON-FLOATING))
     ;; `gjoa-urlbar-arming` holds the palette at opacity:0 until the popover has
     ;; promoted and settled; measuring before it clears reads pre-promotion geometry.
     (js/await (await-true
                 (str "const d = document.documentElement;"
                      "return d.hasAttribute('gjoa-urlbar-floating')"
                      " && !d.hasAttribute('gjoa-urlbar-arming');")
                 3000))
     (assert-floating-overlay! (chrome-eval MEASURE-FLOATING) "on summon")
     ;; A real Ctrl+L lands in [focused][breakout-extend] as soon as the view
     ;; opens, and THAT is the state the in-sidebar expand rule competes for — the
     ;; summon-only state never matches it. Drive it and re-assert.
     (js/await (.executeScript mn EXTEND-FLOATING))
     (js/await (await-true
                 (str "const u = document.getElementById('urlbar');"
                      "return !!u && u.hasAttribute('breakout-extend');")
                 2000))
     (assert-floating-overlay! (chrome-eval MEASURE-FLOATING) "in breakout-extend")
     ;; The palette must SURVIVE Firefox's own top-layer eviction: gjoa asserts the
     ;; promotion once at summon time, but UrlbarInput writes [popover]/[breakout] too.
     ;; Position is asserted as CENTRED, not as equal to the pre-eviction left: the
     ;; blocker release re-runs Firefox's breakout measurement and the box resettles
     ;; a few px. Eviction is ~340px off at a 1400px window, so centring catches it.
     (js/await (.executeScript mn EVICT-BREAKOUT))
     (js/await (await-true EVICT-SETTLED 2000))
     (assert-promoted! (chrome-eval MEASURE-PROMOTION) "after breakout blocker")
     (js/await (.executeScript mn RESTORE-BREAKOUT))
     (js/await (await-true EVICT-SETTLED 2000))
     (assert-promoted! (chrome-eval MEASURE-PROMOTION) "after blocker release")
     ;; ...and it must be centred + painted even when the promotion is GONE, through
     ;; every path that evicts it in the wild. This is what the stage buys; the
     ;; watchdog above is belt-and-braces on top of it.
     (doseq [path ["breakout blocker" "raw hidePopover" "uidensity change"]]
       (assert-promotion-independent!
         (js/await (.executeScript mn DEMOTE-AND-MEASURE [path])))
       (js/await (.executeScript mn UNDEMOTE [path]))
       (js/await (await-true EVICT-SETTLED 2000)))
     (js/await (.executeScript mn DISMISS-FLOATING))

     (js/await (await-true FLOATING-TORN-DOWN 2000))
     (js/await (.executeScript mn RESET-URLBAR))
     (js/await (.executeScript mn RESTORE-POPOVER [(.-manual pop0) (.-open pop0)]))
     (js/await (.executeScript mn "window.resizeTo(arguments[0], arguments[1]); return true;"
                 [(.-w orig) (.-h orig)]))))

   (deftest "urlbar — expanded [breakout-extend] dropdown panel is OPAQUE (non-collapsed) (#2)" [mn]
     (js/await (.executeScript mn ENSURE-EXPANDED-DRAWER))
     (js/await (require-gjoa-css! mn))
     ;; Measure the expanded panel, then restore the resting state BEFORE
     ;; asserting (a thrown assertion would otherwise leave the urlbar focused +
     ;; [breakout-extend] for the next test; the captured `r` holds everything we
     ;; need). The runner's per-test RESET also blurs the urlbar, this is belt+
     ;; suspenders within the file.
     (let [r (chrome-eval MEASURE-EXTENDED)
           _ (js/await (.executeScript mn RESET-URLBAR))]
       (expect (not (.-error r)) (str "MEASURE-EXTENDED error: " (JSON/stringify r)))
       (expect (.-breakoutExtend r) "could not drive urlbar into [breakout-extend]")
       (expect (.-hasBackground r) ".urlbar-background not found under [breakout-extend]")
       ;; The collapse bug zeroed the panel height. It must be non-zero AND
       ;; tall enough to cover the input row (≥ the urlbar box height, minus
       ;; tolerance — the panel is raised 8px above the box top via the fix).
       (expect (> (.-bgHeight r) 0)
         (str ".urlbar-background collapsed to zero height (the nova-var fallback-to-auto "
              "regression) — height=" (.toFixed (.-bgHeight r) 1) "px. " (JSON/stringify r)))
       (expect (>= (.-bgHeight r) (- (.-urlbarHeight r) 2))
         (str ".urlbar-background too short to cover the input row — height "
              (.toFixed (.-bgHeight r) 1) "px vs urlbar box " (.toFixed (.-urlbarHeight r) 1)
              "px. " (JSON/stringify r)))
       ;; The panel must be opaque: a non-transparent background-color (the
       ;; whole point — it's the only opaque surface behind the input + the
       ;; transparent .urlbarView results in non-nova).
       (let [bg (.-bgColor r)]
         (expect (and bg (not= bg "transparent") (not= bg "rgba(0, 0, 0, 0)"))
           (str ".urlbar-background is transparent — sidebar would bleed through. "
                "background-color=" bg ". " (JSON/stringify r))))))

   (deftest "urlbar — focusing the urlbar does NOT shift the input row down (no jump) (#3)" [mn]
     (js/await (.executeScript mn ENSURE-EXPANDED-DRAWER))
     (js/await (require-gjoa-css! mn))
     (let [rest (chrome-eval MEASURE-RESTING)]
       (expect (not (.-error rest)) (str "MEASURE-RESTING error: " (JSON/stringify rest)))
       (expect (not= (.-inputContainerTop rest) nil) "no .urlbar-input-container at rest")
       ;; Measure the extended row top, then restore resting BEFORE asserting
       ;; (see #2 — keeps the test order-independent even on a thrown assertion).
       (let [ext (chrome-eval MEASURE-EXTENDED)
             _ (js/await (.executeScript mn RESET-URLBAR))]
         (expect (not (.-error ext)) (str "MEASURE-EXTENDED error: " (JSON/stringify ext)))
         (expect (not= (.-inputContainerTop ext) nil) "no .urlbar-input-container under [breakout-extend]")
         ;; The 29451f9 no-jump property: the security-icon + URL text row top
         ;; must be pixel-identical (≤1px) at rest vs expanded.
         (let [jump (Math/abs (- (Number (.-inputContainerTop ext)) (Number (.-inputContainerTop rest))))]
           (expect (<= jump 1.5)
             (str "input row JUMPED on focus by " (.toFixed jump 2) "px "
                  "(rest top=" (.toFixed (Number (.-inputContainerTop rest)) 2)
                  ", extend top=" (.toFixed (Number (.-inputContainerTop ext)) 2)
                  ") — breathing-room padding leaked onto the input again. "
                  "rest=" (JSON/stringify rest) " ext=" (JSON/stringify ext)))))))

   (deftest "urlbar — the resting ghost keeps the engine chip while the palette floats (#4)" [mn]
     (js/await (.executeScript mn ENSURE-EXPANDED-DRAWER))
     (js/await (require-gjoa-css! mn))
     ;; finish-teardown takes #urlbar back out of the top layer; restore the
     ;; resting promotion afterwards so this test leaves the window as it found it.
     (let [pop0 (js/await (.executeScript mn CAPTURE-POPOVER))
           ;; (a) DEFAULT state — the chip shows the default engine icon.
           c0 (chrome-eval MEASURE-CHIP)]
       (js/await (.executeScript mn SUMMON-FLOATING))
       (js/await (await-true
                   (str "const d = document.documentElement;"
                        "return d.hasAttribute('gjoa-urlbar-floating')"
                        " && !d.hasAttribute('gjoa-urlbar-arming');")
                   3000))
       (let [g0 (chrome-eval MEASURE-GHOST-BOXES)]
         (js/await (.executeScript mn DISMISS-FLOATING))
         (js/await (await-true FLOATING-TORN-DOWN 2000))
         (assert-ghost-chip! c0 g0 "default state"))
       ;; (b) SEARCHMODE with typed text — the owner's state: the chip is the
       ;; leading element and carries icon + engine name + exit button.
       (let [sm (chrome-eval ENTER-SEARCHMODE)]
         (expect (not (.-error sm)) (str "could not enter search mode: " (JSON/stringify sm)))
         (expect (.-searchmode sm) (str "#urlbar has no [searchmode]: " (JSON/stringify sm))))
       (let [c1 (chrome-eval MEASURE-CHIP)]
         (js/await (.executeScript mn SUMMON-FLOATING))
         (js/await (await-true
                     (str "const d = document.documentElement;"
                          "return d.hasAttribute('gjoa-urlbar-floating')"
                          " && !d.hasAttribute('gjoa-urlbar-arming');")
                     3000))
         (let [g1 (chrome-eval MEASURE-GHOST-BOXES)]
           (js/await (.executeScript mn DISMISS-FLOATING))
           (js/await (await-true FLOATING-TORN-DOWN 2000))
           ;; restore BEFORE asserting so a thrown assertion can't leave the next
           ;; test in search mode (see #2/#3 for the same ordering).
           (js/await (.executeScript mn EXIT-SEARCHMODE))
           (js/await (.executeScript mn RESET-URLBAR))
           (js/await (.executeScript mn RESTORE-POPOVER [(.-manual pop0) (.-open pop0)]))
           (expect (.-searchmode c1)
             (str "search mode did not reach #urlbar: " (JSON/stringify c1)))
           (assert-ghost-chip! c1 g1 "searchmode with text")))))]))

(js/export-default tests)
