#lang beagle/js
;; Horizontal tab mode must keep its FULL nav-bar toolbar — per OWNER ROW-ORDER
;; SPEC v3, the icons gjoa users expect on the row: back, forward, refresh,
;; urlbar, sidebar toggle, extensions, hamburger. A regression collapsed it to
;; just [urlbar][hamburger] in horizontal
;; mode (reported 2026-06-22, real gjoa-dev window). This guards the whole set so
;; it can't silently vanish again — asserted both freshly-horizontal AND after a
;; vertical→horizontal flip (the live niri-resize path where the drawer reparents
;; the urlbar; see task #122 transition instability).
(ns gjoa.tests.integration.horizontal-toolbar
  (:require [gjoa.tests.dsl :refer [deftest chrome-eval expect expect-eq await-true wait-for]]))

;; Returns {horizontal, missing:[...]} — `missing` names any expected toolbar icon
;; that is absent OR not visible (display:none / zero-width). Empty == healthy.
;; The sidebar slot accepts EITHER id: install! swaps the native #sidebar-button
;; for #gjoa-sidebar-button and display:none's the original, so asserting the
;; native node is visible would fail on every profile where the swap ran.
(def buttonsCheck String "
  const want = {
    'back-button': 'back', 'forward-button': 'forward', 'stop-reload-button': 'refresh',
    'urlbar-container': 'urlbar', 'gjoa-sidebar-button|sidebar-button': 'sidebar',
    'unified-extensions-button': 'extensions', 'PanelUI-button': 'hamburger'
  };
  const win = window;
  const missing = [];
  const visible = (e) => {
    if (!e) return false;
    const cs = win.getComputedStyle(e);
    return cs.display !== 'none' && cs.visibility !== 'hidden' &&
           e.getBoundingClientRect().width >= 1;
  };
  for (const key of Object.keys(want)) {
    const ids = key.split('|');
    if (ids.some(id => visible(document.getElementById(id)))) continue;
    const why = ids.map(id => {
      const e = document.getElementById(id);
      if (!e) return '#' + id + ' ABSENT';
      const cs = win.getComputedStyle(e);
      return '#' + id + ' hidden display=' + cs.display +
             ' w=' + Math.round(e.getBoundingClientRect().width);
    }).join(' / ');
    missing.push(want[key] + ' (' + why + ')');
  }
  return { horizontal: document.documentElement.hasAttribute('gjoa-horizontal-tabs'), missing: missing };
")

(defn assert-full-toolbar [(r Any) (ctx String)] Any
  (expect (js/get r .horizontal) (str ctx ": not in horizontal mode (gjoa-horizontal-tabs unset)"))
  (expect (= 0 (js/get (js/get r .missing) .length))
    (str ctx ": horizontal toolbar is missing expected icons: " (JSON/stringify (js/get r .missing)) ". "
         "Expected left→right: back forward refresh urlbar sidebar extensions hamburger.")))

(def tests Any
  [(deftest "horizontal nav-bar keeps back/forward/refresh/urlbar/sidebar/ext/hamburger" [mn]
     ;; Force horizontal from the current state; disable dynamic-orientation so the
     ;; window width can't flip it back mid-assert.
     (chrome-eval "Services.prefs.setBoolPref('gjoa.layout.dynamicOrientation', false); Services.prefs.setBoolPref('sidebar.verticalTabs', false); return true;")
     (await-true "return document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (assert-full-toolbar (chrome-eval buttonsCheck) "fresh-horizontal"))

   (deftest "sidebar-button menu shows Hide/Show Strip only in horizontal mode" [mn]
     (chrome-eval "Services.prefs.setBoolPref('gjoa.layout.dynamicOrientation', false); Services.prefs.setBoolPref('sidebar.verticalTabs', true); return true;")
     (await-true "return !document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (let [r1 (chrome-eval "const m = document.getElementById('gjoa-sidebar-button-menu'); m.dispatchEvent(new Event('popupshowing')); const s = document.getElementById('gjoa-toggle-strip'); return { hidden: s.hidden };")]
       (expect (js/get r1 .hidden) "strip menu item should be hidden in vertical mode"))
     (chrome-eval "Services.prefs.setBoolPref('sidebar.verticalTabs', false); Services.prefs.setBoolPref('gjoa.layout.horizontalSidebarStrip', false); return true;")
     (await-true "return document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (let [r2 (chrome-eval "const m = document.getElementById('gjoa-sidebar-button-menu'); m.dispatchEvent(new Event('popupshowing')); const s = document.getElementById('gjoa-toggle-strip'); return { hidden: s.hidden, label: s.getAttribute('label') };")]
       (expect (not (js/get r2 .hidden)) "strip menu item should be visible in horizontal mode")
       (expect-eq (js/get r2 .label) "Show Strip" "label should read Show Strip when the strip pref is off"))
     (chrome-eval "Services.prefs.setBoolPref('gjoa.layout.horizontalSidebarStrip', true); return true;")
     (let [r3 (chrome-eval "const m = document.getElementById('gjoa-sidebar-button-menu'); m.dispatchEvent(new Event('popupshowing')); const s = document.getElementById('gjoa-toggle-strip'); return { label: s.getAttribute('label') };")]
       (expect-eq (js/get r3 .label) "Hide Strip" "label should read Hide Strip when the strip pref is on"))
     (chrome-eval "Services.prefs.setBoolPref('sidebar.verticalTabs', true); Services.prefs.clearUserPref('gjoa.layout.horizontalSidebarStrip'); Services.prefs.clearUserPref('gjoa.layout.dynamicOrientation'); return true;"))

   (deftest "strip-hide button is horizontal-only and hides the strip on click" [mn]
     (chrome-eval "Services.prefs.setBoolPref('gjoa.layout.dynamicOrientation', false); Services.prefs.setBoolPref('sidebar.verticalTabs', true); return true;")
     (await-true "return !document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (let [r (chrome-eval "const b = document.getElementById('gjoa-strip-hide-button'); return { display: getComputedStyle(b).display };")]
       (expect-eq (js/get r .display) "none" "strip-hide button should be display:none in vertical mode"))
     (chrome-eval "Services.prefs.setBoolPref('sidebar.verticalTabs', false); Services.prefs.setBoolPref('gjoa.layout.horizontalSidebarStrip', true); return true;")
     (await-true "return document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (await-true "return getComputedStyle(document.getElementById('gjoa-strip-hide-button')).display !== 'none';" 4000)
     (chrome-eval "document.getElementById('gjoa-strip-hide-button').dispatchEvent(new MouseEvent('click', {bubbles: true})); return true;")
     (await-true "return Services.prefs.getBoolPref('gjoa.layout.horizontalSidebarStrip') === false;" 4000)
     (chrome-eval "Services.prefs.setBoolPref('sidebar.verticalTabs', true); Services.prefs.clearUserPref('gjoa.layout.horizontalSidebarStrip'); Services.prefs.clearUserPref('gjoa.layout.dynamicOrientation'); return true;"))

   (deftest "horizontal toolbar survives a vertical→horizontal flip" [mn]
     ;; vertical first, then flip to horizontal — the live-resize path that reparents
     ;; the urlbar (drawer) and must restore the full nav-bar, not leave [urlbar][☰].
     (chrome-eval "Services.prefs.setBoolPref('gjoa.layout.dynamicOrientation', false); Services.prefs.setBoolPref('sidebar.verticalTabs', true); return true;")
     (await-true "return !document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (chrome-eval "Services.prefs.setBoolPref('sidebar.verticalTabs', false); return true;")
     (await-true "return document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (assert-full-toolbar (chrome-eval buttonsCheck) "after-flip")
     ;; restore defaults so we don't pollute later tests (#102)
     (chrome-eval "Services.prefs.setBoolPref('sidebar.verticalTabs', true); Services.prefs.clearUserPref('gjoa.layout.dynamicOrientation'); return true;"))])

(js/export-default tests)
