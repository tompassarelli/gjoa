#lang beagle/js
;; Verify the gjoa sidebar's top/bottom icon Y-deltas are symmetric.
;;
;; The icons of the bottom sidebar buttons
;; must sit the same visual distance from #sidebar-container's BOTTOM edge as
;; the TOP nav-bar button icons sit from #sidebar-container's TOP edge.
;;
;; "Icons" means the actual rendered glyph (img/svg/.toolbarbutton-icon),
;; not the toolbarbutton/moz-button container, whose padding is excluded.
;;
;; The runtime adjuster lives in drawer/layout.bjs `sync-symmetric-footer`.
;; It writes --gjoa-symmetric-footer; CSS consumes that as padding-bottom
;; on `#sidebar-container > sidebar-main`.
(ns gjoa.tests.integration.sidebar-symmetric-icons
  (:require [gjoa.tests.dsl :refer [deftest chrome-eval expect]]))

;; `IntegrationTest` from ../../tools/test-driver/runner is a type-only
;; import in the original — used purely for annotation, no runtime value.
;; Beagle has no type-only import; we annotate with Any.

;; Walk light + shadow DOM looking for visible icon-like elements.
;; Returns the topmost (top=true) or bottommost (top=false) icon found.
;;
;; NOTE: this is a plain JS source string evaluated in the browser via
;; mn.executeScript — the ${...} tokens inside are literal JS for the
;; browser, NOT beagle interpolation, so it stays one string literal.
(def probe String "
  function walk(node, hits) {
    if (!node) return;
    // Recurse into shadow roots.
    if (node.shadowRoot) walk(node.shadowRoot, hits);
    const kids = node.children || node.childNodes || [];
    for (const child of kids) {
      const tag = (child.tagName || \"\").toLowerCase();
      const cls = child.classList;
      const isIcon =
        tag === \"img\" || tag === \"svg\" || tag === \"moz-icon\" ||
        (cls && (cls.contains(\"toolbarbutton-icon\") || cls.contains(\"button-icon\")));
      if (isIcon) {
        const r = child.getBoundingClientRect();
        if (r.width > 0 && r.height > 0 && r.top >= 0) {
          hits.push({
            tag,
            id: child.id || (child.parentElement && child.parentElement.id) || null,
            top: r.top, bottom: r.bottom, left: r.left, width: r.width, height: r.height,
          });
        }
      }
      walk(child, hits);
    }
  }
  const sidebarMain = document.getElementById(\"sidebar-container\");
  if (!sidebarMain) return { error: \"no #sidebar-container\" };
  const sidebarRect = sidebarMain.getBoundingClientRect();
  const navBar = sidebarMain.querySelector(\"#nav-bar\");
  const footerWebComponent = sidebarMain.querySelector(\":scope > sidebar-main\");
  const topHits = [];
  const bottomHits = [];
  if (navBar) walk(navBar, topHits);
  if (footerWebComponent) walk(footerWebComponent, bottomHits);
  topHits.sort((a, b) => a.top - b.top);
  bottomHits.sort((a, b) => a.bottom - b.bottom);
  return {
    sidebar: {
      top: sidebarRect.top, bottom: sidebarRect.bottom,
      height: sidebarRect.height, width: sidebarRect.width,
    },
    topIcon: topHits[0] || null,
    bottomIcon: bottomHits.length ? bottomHits[bottomHits.length - 1] : null,
    topCount: topHits.length,
    bottomCount: bottomHits.length,
    cssVar: getComputedStyle(document.documentElement).getPropertyValue(\"--gjoa-symmetric-footer\"),
  };
")

;; IconRect / ProbeResult were TS interfaces (compile-time only, erased at
;; runtime). Beagle's JS target has no nominal-interface declaration; the
;; probe result is a plain object accessed by field below.

(def TOLERANCE-PX Any 1)

(js/export (def tests Any
  [(deftest "sidebar — top/bottom icon Y-deltas symmetric within ±1px" [mn]
     ;; layout.ts schedules 30 setTimeout passes over 1.5s for the
     ;; feedback loop. Wait at least that long. Poll for convergence
     ;; up to 3s in case shadow DOM hydration was slow.
     ;;
     ;; The original used a mutable `r` + `while` loop that broke on
     ;; convergence. Beagle's JS target has no `while`/`break`; the
     ;; equivalent is a loop/recur that returns the latest probe result
     ;; on either convergence or deadline.
     (let [deadline Int (+ (Date/now) 3000)
          r Any (js/await (loop [acc Int {}]
               (if (>= (Date/now) deadline)
                 acc
                 (let [_ Any (js/await (js/new Promise (fn [res Any] Any (setTimeout res 200))))
                      nr Any (chrome-eval probe)]
                   (if (and (js/get nr .topIcon) (js/get nr .bottomIcon) (js/get nr .sidebar)
                            (let [top-icon-top Float (js/get (js/get nr .topIcon) .top)
                                 sidebar-top Float (js/get (js/get nr .sidebar) .top)
                                 sidebar-bottom Float (js/get (js/get nr .sidebar) .bottom)
                                 bottom-icon-bottom Float (js/get (js/get nr .bottomIcon) .bottom)
                                 tg Any (- top-icon-top sidebar-top)
                                 bg String (- sidebar-bottom bottom-icon-bottom)]
                              (<= (Math/abs (- tg bg)) TOLERANCE-PX)))
                     nr
                     (recur nr))))))]
       (do
           (expect (not (js/get r .error))
             (str "probe error: " (js/get r .error)))
           (expect (js/get r .sidebar)
             "probe returned no sidebar rect")
           (expect (js/get r .topIcon)
             (str "No top icon found in #sidebar-container #nav-bar (searched "
                  (js/get r .topCount) " candidates). "
                  "Result: " (JSON/stringify r nil 2)))
           (expect (js/get r .bottomIcon)
             (str "No bottom icon found in #sidebar-container > sidebar-main (searched "
                  (js/get r .bottomCount) " candidates). "
                  "Result: " (JSON/stringify r nil 2)))
           (let [top-icon-top Float (js/get (js/get r .topIcon) .top)
                sidebar-top Float (js/get (js/get r .sidebar) .top)
                sidebar-bottom Float (js/get (js/get r .sidebar) .bottom)
                bottom-icon-bottom Float (js/get (js/get r .bottomIcon) .bottom)
                topGap Float (- top-icon-top sidebar-top)
                bottomGap Float (- sidebar-bottom bottom-icon-bottom)
                 ;; src/drawer/layout.ts targets `bottomGap = topGap + BOTTOM_OFFSET`
                 ;; (default 4px). Bottom icons sit slightly farther from the edge.
                BOTTOM-OFFSET Int 4
                delta Float (Math/abs (- bottomGap (+ topGap BOTTOM-OFFSET)))]
             (expect (<= delta TOLERANCE-PX)
               (str "Asymmetric icon Y-deltas off target: topGap=" (js/call topGap .toFixed 2) "px "
                    "bottomGap=" (js/call bottomGap .toFixed 2) "px (expected bottom = top+" BOTTOM-OFFSET
                    ", diff=" (js/call delta .toFixed 2) "px, tolerance ±" TOLERANCE-PX ").\n"
                    "--gjoa-symmetric-footer=" (js/get r .cssVar) "\n"
                    "topIcon: " (JSON/stringify (js/get r .topIcon)) "\n"
                    "bottomIcon: " (JSON/stringify (js/get r .bottomIcon)) "\n"
                    "sidebar: " (JSON/stringify (js/get r .sidebar))))
             ;; Keep the top gap positive and tight rather than spacious.
             (expect (>= topGap 2)
               (str "Icons too close to top edge: topGap=" (js/call topGap .toFixed 1) "px (expected ≥2)."))))))]))

(js/export-default tests)
