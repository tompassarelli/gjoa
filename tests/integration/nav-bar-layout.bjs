#lang beagle/js
;; Verify the gjoa nav-bar layout contract:
;;   VERTICAL/expanded:  [☰ hamburger][🧩 extensions][□ sidebar-toggle]  ←GAP→  [← → ↻]
;;   HORIZONTAL/compact: [← → ↻] <urlbar> [□ sidebar-toggle][🧩 extensions][☰ hamburger]
;; Asserts visual left-to-right ordering AND a visible gap between groups.
(ns gjoa.tests.integration.nav-bar-layout
  (:require [gjoa.tests.dsl :refer [deftest chrome-eval expect await-true wait-for]]))

;; `IntegrationTest` from ../../tools/test-driver/runner is a type-only
;; import in the original — used purely for annotation, no runtime value.
;; Beagle has no type-only import; we annotate with Any.

;; Plain JS source strings evaluated in the browser via mn.executeScript —
;; the tokens inside are literal JS for the browser, NOT beagle, so each
;; stays one string literal.

;; One ordered left-to-right walk over an id sequence (not pairwise checks); `id|altId` picks whichever is visible.
(def orderCheckFn String "
  function checkOrder(ids) {
    const rects = [];
    for (const spec of ids) {
      let el = null, foundId = null;
      for (const id of spec.split('|')) {
        const e = document.getElementById(id);
        if (!e) continue;
        const cs = getComputedStyle(e);
        if (cs.display === 'none' || cs.visibility === 'hidden') continue;
        if (e.getBoundingClientRect().width < 1) continue;
        el = e; foundId = id; break;
      }
      if (!el) return { ok: false, msg: 'missing/hidden icon: ' + spec };
      const r = el.getBoundingClientRect();
      rects.push({ id: foundId, left: Math.round(r.left), right: Math.round(r.right) });
    }
    for (let i = 1; i < rects.length; i++) {
      const prev = rects[i - 1], cur = rects[i];
      if (!(cur.left > prev.left) || cur.left < prev.right - 2) {
        return { ok: false, msg: 'order violated at index ' + i + ' (' + prev.id + ' -> ' + cur.id + '): ' + JSON.stringify(rects) };
      }
    }
    return { ok: true, rects: rects };
  }
")

;; EXPANDED/vertical order per gjoa.uc.css `#sidebar-container #nav-bar` (owner spec v3).
(def verticalOrderIds String
  (str orderCheckFn
    "return checkOrder(['PanelUI-button', 'unified-extensions-button', "
    "'gjoa-sidebar-button|sidebar-button', 'back-button', 'forward-button', 'stop-reload-button']);"))

;; COMPACT/horizontal order per gjoa.uc.css unscoped block (owner spec v3).
(def horizontalOrderIds String
  (str orderCheckFn
    "return checkOrder(['back-button', 'forward-button', 'stop-reload-button', 'urlbar-container', "
    "'gjoa-sidebar-button|sidebar-button', 'unified-extensions-button', 'PanelUI-button']);"))

;; A default profile has no CustomizableUI springs in nav-bar, but a customized
;; one can keep `customizableui-special-spring1|2` flanking
;; #urlbar-container — and toolbarbuttons.css gives those `flex: 80 80; max-width:
;; 112px` inside #nav-bar. Inject the same element to put the row under the same
;; pressure, measure, and remove it in the same script so nothing can leak.
(def springPressureCheck String
  (str orderCheckFn "
  const target = document.getElementById('nav-bar-customization-target');
  const uc = document.getElementById('urlbar-container');
  if (!target || !uc || uc.parentElement !== target) {
    return { skip: true, reason: 'no #urlbar-container inside #nav-bar-customization-target' };
  }
  const mk = () => { const s = document.createXULElement('toolbarspring');
                     s.className = 'gjoa-test-spring'; return s; };
  const a = mk(), b = mk();
  let out;
  try {
    target.insertBefore(a, uc);
    uc.after(b);
    out = checkOrder(['back-button', 'forward-button', 'stop-reload-button', 'urlbar-container',
                      'gjoa-sidebar-button|sidebar-button', 'unified-extensions-button', 'PanelUI-button']);
    out.springWidths = [a.getBoundingClientRect().width, b.getBoundingClientRect().width];
    out.springFlexGrow = getComputedStyle(a).flexGrow;
  } finally { a.remove(); b.remove(); }
  return out;
"))

(def allIconYCheck String "
  // Collect every visible icon in nav-bar (any depth — including inside
  // customization-target). Report each by id+ancestry+top-position so a
  // failure can pinpoint the misaligned widget.
  const navBar = document.getElementById(\"nav-bar\");
  if (!navBar) return { error: \"no #nav-bar\" };
  const icons = navBar.querySelectorAll(\"toolbarbutton .toolbarbutton-icon, toolbarbutton image\");
  const hits = [];
  for (const ic of icons) {
    const r = ic.getBoundingClientRect();
    if (r.width <= 0 || r.height <= 0) continue;
    // Walk up to first parent with an id.
    let p = ic.parentElement;
    let id = \"\";
    while (p && p !== navBar) {
      if (p.id) { id = p.id; break; }
      p = p.parentElement;
    }
    hits.push({ id, top: r.top, bottom: r.bottom, left: r.left });
  }
  return { hits };
")

;; The horizontal row must keep ONE rhythm: the two gaps flanking #urlbar-container
;; (indices 3,4 of the horizontal id walk) stay near the tightest icon-cluster gap.
;; Slack covers the urlbar's own margin-inline; a regrown spring is ~112px.
(defn assert-even-rhythm! [(r Any) (phase String)] Any
  (let [rects (js/get r .rects)
        gap (fn [(i Int)] Float
              (let [(left Float) (js/get (aget rects i) .left)
                    (prev-right Float) (js/get (aget rects (- i 1)) .right)]
                (- left prev-right)))
        (max-tight Float) (js/call [(gap 1) (gap 2) (gap 5) (gap 6)] .reduce
                                   (fn [(a Float) (b Float)] Float (Math/max a b)) 0)
        ceiling (+ max-tight 15)]
    (doseq [i [3 4]]
      (expect (<= (gap i) ceiling)
        (str "nav-bar (" phase "): gap before " (js/get (aget rects i) .id) " is " (gap i)
             "px vs a " ceiling "px ceiling (tightest-cluster max " max-tight
             "px + 15) — a toolbarspring around #urlbar-container is uncapped. "
             (JSON/stringify r))))))

(def tests Any
  [(deftest "nav-bar — gjoa-sidebar-button (if present) lives in nav-bar, immediately right of extensions" [mn]
     (let [r (chrome-eval "
        const navBar = document.getElementById(\"nav-bar\");
        const pui = document.getElementById(\"PanelUI-button\");
        if (!pui) throw new Error(\"no PanelUI-button\");
        const gj = document.getElementById(\"gjoa-sidebar-button\");
        const ext = document.getElementById(\"unified-extensions-button\");
        const puiR = pui.getBoundingClientRect();
        const gjR = gj ? gj.getBoundingClientRect() : null;
        const extR = ext ? ext.getBoundingClientRect() : null;
        return {
          gjoaBtn: gj ? {
            parentId: gj.parentElement ? (gj.parentElement.id || gj.parentElement.tagName) : \"\",
            inNavBar: navBar ? navBar.contains(gj) : false,
            left: gjR.left, right: gjR.right, top: gjR.top,
          } : null,
          ext: extR ? { left: extR.left, right: extR.right } : null,
          panelUI: { left: puiR.left, right: puiR.right, top: puiR.top },
        };
      ")]
       ;; If gjoa-sidebar-button doesn't exist on this profile (no native
       ;; #sidebar-button to swap), this assertion is moot — skip (the body
       ;; only runs when gjoaBtn is present; otherwise the test passes).
       (when (js/get r .gjoaBtn)
         (expect (js/get (js/get r .gjoaBtn) .inNavBar)
           (str "#gjoa-sidebar-button must live inside the #nav-bar subtree, found under \""
                (js/get (js/get r .gjoaBtn) .parentId) "\". "
                "(install! in src/gjoa/chrome/bjs/drawer/sidebar-button.bjs didn't run)"))
         ;; install! inserts after #stop-reload-button (a customization-target
         ;; grandchild); the direct #nav-bar child slot is the no-refresh fallback.
         (expect (or (= (js/get (js/get r .gjoaBtn) .parentId) "nav-bar-customization-target")
                     (= (js/get (js/get r .gjoaBtn) .parentId) "nav-bar"))
           (str "#gjoa-sidebar-button parent must be #nav-bar-customization-target "
                "(or #nav-bar in the no-refresh fallback), got \"" (js/get (js/get r .gjoaBtn) .parentId) "\"."))
         ;; v3: sidebar-toggle joins the LEFT cluster right after extensions
         ;; (order -2, extensions -3), falling back to hugging the hamburger
         ;; when extensions is absent.
         (let [anchor (if (js/get r .ext) (js/get r .ext) (js/get r .panelUI))
               anchor-name (if (js/get r .ext) "unified-extensions-button" "PanelUI-button")
               (btn-left Float) (js/get (js/get r .gjoaBtn) .left)
               (anchor-right Float) (js/get anchor .right)
               gap (- btn-left anchor-right)]
           (expect (not (or (< gap -2) (> gap 50)))
             (str "#gjoa-sidebar-button not adjacent to #" anchor-name ": "
                  anchor-name ".right=" (js/get anchor .right) " gjoaBtn.left=" (js/get (js/get r .gjoaBtn) .left) " gap=" gap "px "
                  "(expected -2 to 50px)."))))))

   (deftest "nav-bar — all visible top-row icons share the same vertical CENTER (±2px)" [mn]
     (let [r (chrome-eval allIconYCheck)]
       (expect (not (js/get r .error)) (js/get r .error))
       ;; need ≥2 icons to compare; otherwise the body is skipped and the
       ;; test passes (the original early-returned here).
       (when (and (js/get r .hits) (>= (js/get (js/get r .hits) .length) 2))
         ;; Use center-Y, not top-Y. Icons can have different intrinsic sizes
         ;; (hamburger 16px vs back-button 32px) but visually align by CENTER.
         ;; Reference: PanelUI-button (or PanelUI-menu-button) — the hamburger.
         (let [center (fn [h] Float
                        (let [(top Float) (js/get h .top) (bottom Float) (js/get h .bottom)]
                          (/ (+ top bottom) 2)))
               ref (or (js/call (js/get r .hits) .find (fn [h] Any (or (= (js/get h .id) "PanelUI-button") (= (js/get h .id) "PanelUI-menu-button"))))
                       (aget (js/get r .hits) 0))
               refC (center ref)
               TOL 2]
           (doseq [h (js/get r .hits)]
             (let [c (center h)]
               (expect (not (> (Math/abs (- c refC)) TOL))
                 (str "Top-row icon center misaligned: id=\"" (js/get h .id) "\" center=" (js/call c .toFixed 1) " "
                      "vs ref=\"" (js/get ref .id) "\" center=" (js/call refC .toFixed 1) " "
                      "(diff=" (js/call (- c refC) .toFixed 1) "px, tolerance ±" TOL ").\n"
                      "All hits: " (JSON/stringify (js/get r .hits) nil 2)))))))))

   (deftest "nav-bar — full owner-spec icon order, fresh vertical init: hamburger,ext,sidebar,gap,back,forward,refresh" [mn]
     ;; RESET-JS sets sidebar.verticalTabs=true + clears dynamicOrientation before every test — this IS the fresh-vertical state; pin it explicitly for readability.
     (chrome-eval "Services.prefs.setBoolPref('gjoa.layout.dynamicOrientation', false); Services.prefs.setBoolPref('sidebar.verticalTabs', true); return true;")
     (await-true "return !document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (let [r (chrome-eval verticalOrderIds)]
       (expect (js/get r .ok) (js/get r .msg))))

   (deftest "nav-bar — full icon order, fresh horizontal init: back,forward,refresh,urlbar,sidebar,ext,hamburger" [mn]
     (chrome-eval "Services.prefs.setBoolPref('gjoa.layout.dynamicOrientation', false); Services.prefs.setBoolPref('sidebar.verticalTabs', false); return true;")
     (await-true "return document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (let [r (chrome-eval horizontalOrderIds)]
       (expect (js/get r .ok) (js/get r .msg))
       (assert-even-rhythm! r "default profile"))
     ;; Same row with the native springs present in a customized profile:
     ;; uncapped they take ~112px each and split the row into two loud gaps.
     (let [sp (chrome-eval springPressureCheck)]
       (when (not (js/get sp .skip))
         (expect (js/get sp .ok) (str "with toolbarsprings injected: " (js/get sp .msg)))
         (assert-even-rhythm! sp "toolbarsprings injected"))))

   (deftest "nav-bar — full icon order survives live vertical<->horizontal flips" [mn]
     (chrome-eval "Services.prefs.setBoolPref('gjoa.layout.dynamicOrientation', false); Services.prefs.setBoolPref('sidebar.verticalTabs', true); return true;")
     (await-true "return !document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (let [r1 (chrome-eval verticalOrderIds)]
       (expect (js/get r1 .ok) (str "before flip: " (js/get r1 .msg))))
     (chrome-eval "Services.prefs.setBoolPref('sidebar.verticalTabs', false); return true;")
     (await-true "return document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (let [r2 (chrome-eval horizontalOrderIds)]
       (expect (js/get r2 .ok) (str "after vertical->horizontal flip: " (js/get r2 .msg))))
     (chrome-eval "Services.prefs.setBoolPref('sidebar.verticalTabs', true); return true;")
     (await-true "return !document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (let [r3 (chrome-eval verticalOrderIds)]
       (expect (js/get r3 .ok) (str "after horizontal->vertical flip: " (js/get r3 .msg))))
     ;; restore defaults so we don't pollute later tests (#102)
     (chrome-eval "Services.prefs.clearUserPref('gjoa.layout.dynamicOrientation'); return true;"))])

(js/export-default tests)
