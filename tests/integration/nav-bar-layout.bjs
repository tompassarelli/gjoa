#lang beagle/js
;; Verify the gjoa nav-bar layout per the 2026-07-11 owner spec v2:
;;   [☰ hamburger][🧩 extensions]  ←GAP→  [← → ↻][□ sidebar-toggle]
;;
;; Hamburger pins LEFT via CSS `order`; extensions is glued to it. The
;; sidebar-toggle is DOM-inserted INSIDE nav-bar-customization-target right
;; after stop-reload (chrome/bjs/drawer/sidebar-button.bjs) and lands rightmost
;; via `order: 1` — i.e. immediately right of refresh in both modes.
;;
;; Asserts visual left-to-right ordering AND that there's a visible gap
;; between the left group and the right group.
(ns gjoa.tests.integration.nav-bar-layout
  (:require [gjoa.tests.dsl :refer [deftest chrome-eval expect await-true wait-for]]))
(define-mode strict)

;; `IntegrationTest` from ../../tools/test-driver/runner is a type-only
;; import in the original — used purely for annotation, no runtime value.
;; Beagle has no type-only import; we annotate with Any.

;; Plain JS source strings evaluated in the browser via mn.executeScript —
;; the tokens inside are literal JS for the browser, NOT beagle, so each
;; stays one string literal.

;; One ordered left-to-right walk over an id sequence (not pairwise checks); `id|altId` picks whichever is visible.
(def orderCheckFn :- String "
  function checkOrder(ids) {
    const rects = [];
    for (const spec of ids) {
      let el = null, foundId = null;
      for (const id of spec.split('|')) {
        const e = document.getElementById(id);
        if (!e) continue;
        const cs = getComputedStyle(e);
        if (cs.display === 'none' || cs.visibility === 'hidden') continue;
        if (e.getBoundingClientRect().width < 1) continue;
        el = e; foundId = id; break;
      }
      if (!el) return { ok: false, msg: 'missing/hidden icon: ' + spec };
      const r = el.getBoundingClientRect();
      rects.push({ id: foundId, left: Math.round(r.left), right: Math.round(r.right) });
    }
    for (let i = 1; i < rects.length; i++) {
      const prev = rects[i - 1], cur = rects[i];
      if (!(cur.left > prev.left) || cur.left < prev.right - 2) {
        return { ok: false, msg: 'order violated at index ' + i + ' (' + prev.id + ' -> ' + cur.id + '): ' + JSON.stringify(rects) };
      }
    }
    return { ok: true, rects: rects };
  }
")

;; EXPANDED/vertical order per gjoa.uc.css `#sidebar-container #nav-bar` (owner spec v2, 2026-07-11).
(def verticalOrderIds :- String
  (str orderCheckFn
    "return checkOrder(['PanelUI-button', 'unified-extensions-button', "
    "'back-button', 'forward-button', 'stop-reload-button', 'gjoa-sidebar-button|sidebar-button']);"))

;; COMPACT/horizontal order per gjoa.uc.css unscoped block (measured DOM order, not the aspirational one in horizontal-toolbar.bjs's message string).
(def horizontalOrderIds :- String
  (str orderCheckFn
    "return checkOrder(['back-button', 'forward-button', 'stop-reload-button', 'urlbar-container', "
    "'unified-extensions-button', 'gjoa-sidebar-button|sidebar-button', 'PanelUI-button']);"))

(def allIconYCheck :- String "
  // Collect every visible icon in nav-bar (any depth — including inside
  // customization-target). Report each by id+ancestry+top-position so a
  // failure can pinpoint the misaligned widget.
  const navBar = document.getElementById(\"nav-bar\");
  if (!navBar) return { error: \"no #nav-bar\" };
  const icons = navBar.querySelectorAll(\"toolbarbutton .toolbarbutton-icon, toolbarbutton image\");
  const hits = [];
  for (const ic of icons) {
    const r = ic.getBoundingClientRect();
    if (r.width <= 0 || r.height <= 0) continue;
    // Walk up to first parent with an id.
    let p = ic.parentElement;
    let id = \"\";
    while (p && p !== navBar) {
      if (p.id) { id = p.id; break; }
      p = p.parentElement;
    }
    hits.push({ id, top: r.top, bottom: r.bottom, left: r.left });
  }
  return { hits };
")

(def tests :- Any
  [(deftest "nav-bar — gjoa-sidebar-button (if present) lives in nav-bar, immediately right of refresh" [mn]
     (let [r (chrome-eval "
        const navBar = document.getElementById(\"nav-bar\");
        const pui = document.getElementById(\"PanelUI-button\");
        if (!pui) throw new Error(\"no PanelUI-button\");
        const gj = document.getElementById(\"gjoa-sidebar-button\");
        const refresh = document.getElementById(\"stop-reload-button\");
        const puiR = pui.getBoundingClientRect();
        const gjR = gj ? gj.getBoundingClientRect() : null;
        const rfR = refresh ? refresh.getBoundingClientRect() : null;
        return {
          gjoaBtn: gj ? {
            parentId: gj.parentElement ? (gj.parentElement.id || gj.parentElement.tagName) : \"\",
            inNavBar: navBar ? navBar.contains(gj) : false,
            left: gjR.left, right: gjR.right, top: gjR.top,
          } : null,
          refresh: rfR ? { left: rfR.left, right: rfR.right } : null,
          panelUI: { left: puiR.left, right: puiR.right, top: puiR.top },
        };
      ")]
       ;; If gjoa-sidebar-button doesn't exist on this profile (no native
       ;; #sidebar-button to swap), this assertion is moot — skip (the body
       ;; only runs when gjoaBtn is present; otherwise the test passes).
       (when (.-gjoaBtn r)
         (expect (.-inNavBar (.-gjoaBtn r))
           (str "#gjoa-sidebar-button must live inside the #nav-bar subtree, found under \""
                (.-parentId (.-gjoaBtn r)) "\". "
                "(install! in src/gjoa/chrome/bjs/drawer/sidebar-button.bjs didn't run)"))
         ;; install! inserts after #stop-reload-button (a customization-target
         ;; grandchild); the direct #nav-bar child slot is the no-refresh fallback.
         (expect (or (= (.-parentId (.-gjoaBtn r)) "nav-bar-customization-target")
                     (= (.-parentId (.-gjoaBtn r)) "nav-bar"))
           (str "#gjoa-sidebar-button parent must be #nav-bar-customization-target "
                "(or #nav-bar in the no-refresh fallback), got \"" (.-parentId (.-gjoaBtn r)) "\"."))
         ;; Rightmost via `order: 1` — so it sits just right of refresh when refresh
         ;; is on the row, and falls back to hugging the hamburger when it isn't.
         (let [anchor (if (.-refresh r) (.-refresh r) (.-panelUI r))
               anchor-name (if (.-refresh r) "stop-reload-button" "PanelUI-button")
               gap (- (.-left (.-gjoaBtn r)) (.-right anchor))]
           (expect (not (or (< gap -2) (> gap 50)))
             (str "#gjoa-sidebar-button not adjacent to #" anchor-name ": "
                  anchor-name ".right=" (.-right anchor) " gjoaBtn.left=" (.-left (.-gjoaBtn r)) " gap=" gap "px "
                  "(expected -2 to 50px)."))))))

   (deftest "nav-bar — all visible top-row icons share the same vertical CENTER (±2px)" [mn]
     (let [r (chrome-eval allIconYCheck)]
       (expect (not (.-error r)) (.-error r))
       ;; need ≥2 icons to compare; otherwise the body is skipped and the
       ;; test passes (the original early-returned here).
       (when (and (.-hits r) (>= (.-length (.-hits r)) 2))
         ;; Use center-Y, not top-Y. Icons can have different intrinsic sizes
         ;; (hamburger 16px vs back-button 32px) but visually align by CENTER.
         ;; Reference: PanelUI-button (or PanelUI-menu-button) — the hamburger.
         (let [center (fn [h] (/ (+ (.-top h) (.-bottom h)) 2))
               ref (or (.find (.-hits r) (fn [h] (or (= (.-id h) "PanelUI-button") (= (.-id h) "PanelUI-menu-button"))))
                       (aget (.-hits r) 0))
               refC (center ref)
               TOL 2]
           (doseq [h (.-hits r)]
             (let [c (center h)]
               (expect (not (> (Math/abs (- c refC)) TOL))
                 (str "Top-row icon center misaligned: id=\"" (.-id h) "\" center=" (.toFixed c 1) " "
                      "vs ref=\"" (.-id ref) "\" center=" (.toFixed refC 1) " "
                      "(diff=" (.toFixed (- c refC) 1) "px, tolerance ±" TOL ").\n"
                      "All hits: " (JSON/stringify (.-hits r) nil 2)))))))))

   (deftest "nav-bar — full owner-spec icon order, fresh vertical init: hamburger,ext,gap,back,forward,refresh,sidebar" [mn]
     ;; RESET-JS sets sidebar.verticalTabs=true + clears dynamicOrientation before every test — this IS the fresh-vertical state; pin it explicitly for readability.
     (chrome-eval "Services.prefs.setBoolPref('gjoa.layout.dynamicOrientation', false); Services.prefs.setBoolPref('sidebar.verticalTabs', true); return true;")
     (await-true "return !document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (let [r (chrome-eval verticalOrderIds)]
       (expect (.-ok r) (.-msg r))))

   (deftest "nav-bar — full icon order, fresh horizontal init: back,forward,refresh,urlbar,ext,sidebar,hamburger" [mn]
     (chrome-eval "Services.prefs.setBoolPref('gjoa.layout.dynamicOrientation', false); Services.prefs.setBoolPref('sidebar.verticalTabs', false); return true;")
     (await-true "return document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (let [r (chrome-eval horizontalOrderIds)]
       (expect (.-ok r) (.-msg r))))

   (deftest "nav-bar — full icon order survives live vertical<->horizontal flips" [mn]
     (chrome-eval "Services.prefs.setBoolPref('gjoa.layout.dynamicOrientation', false); Services.prefs.setBoolPref('sidebar.verticalTabs', true); return true;")
     (await-true "return !document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (let [r1 (chrome-eval verticalOrderIds)]
       (expect (.-ok r1) (str "before flip: " (.-msg r1))))
     (chrome-eval "Services.prefs.setBoolPref('sidebar.verticalTabs', false); return true;")
     (await-true "return document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (let [r2 (chrome-eval horizontalOrderIds)]
       (expect (.-ok r2) (str "after vertical->horizontal flip: " (.-msg r2))))
     (chrome-eval "Services.prefs.setBoolPref('sidebar.verticalTabs', true); return true;")
     (await-true "return !document.documentElement.hasAttribute('gjoa-horizontal-tabs');" 4000)
     (let [r3 (chrome-eval verticalOrderIds)]
       (expect (.-ok r3) (str "after horizontal->vertical flip: " (.-msg r3))))
     ;; restore defaults so we don't pollute later tests (#102)
     (chrome-eval "Services.prefs.clearUserPref('gjoa.layout.dynamicOrientation'); return true;"))])

(js/export-default tests)
