#lang beagle/js
;; Spaces UX:
;;   1. `:space` creates, switches, and renames spaces
;;   2. `#gjoa-space-header` renders the active space name in the sidebar
;;   3. The header updates on switch and rename
;;   4. Clicking the header opens the spaces picker
(ns gjoa.tests.integration.spaces-header
  (:require [gjoa.tests.dsl :refer [deftest chrome-eval await-true expect expect-eq wait-for]]))

;; Reset all non-default spaces between subtests so each one starts clean.
(defn reset-spaces [mn Any] Any
  (chrome-eval
    "
    const main = window.Spaces.list().find(s => s.name === \"Main\")
              || window.Spaces.list()[0];
    window.Spaces.setActive(main.id);
    for (const s of [...window.Spaces.list()]) {
      if (s.id !== main.id) window.Spaces.delete(s.id);
    }
  "))

(js/export (def tests Any
  [(deftest "Spaces — :space creates and switches" [mn]
     (await-true "return !!window.gjoaTest && !!window.gjoaTest.vim && !!window.Spaces;" 1500)
     (js/await (reset-spaces mn))
     (chrome-eval "window.gjoaTest.vim.runExCommand(\"space new Reading\");")
     (let [r Any (chrome-eval
               "
        const list = window.Spaces.list();
        return {
          count: list.length,
          activeName: window.Spaces.active().name,
          names: list.map(s => s.name),
        };
      ")]
       (expect-eq (js/get r .count) 2
                  (str "expected 2 spaces after :space new, got " (js/get r .count) " (" (js/call (js/get r .names) .join ",") ")"))
       (expect-eq (js/get r .activeName) "Reading"
                  (str "expected active=\"Reading\", got \"" (js/get r .activeName) "\""))))

   (deftest "Spaces header — element exists in sidebar above tab panel" [mn]
     (js/await (reset-spaces mn))
     (let [probe Any (chrome-eval
                   "
        const header = document.getElementById(\"gjoa-space-header\");
        const label = document.getElementById(\"gjoa-space-header-label\");
        const panel = document.getElementById(\"gjoa-tab-panel\");
        const pinned = document.getElementById(\"gjoa-pinned-container\");
        function precedes(a, b) {
          if (!a || !b) return false;
          const cmp = a.compareDocumentPosition(b);
          return !!(cmp & Node.DOCUMENT_POSITION_FOLLOWING);
        }
        return {
          headerExists: !!header,
          labelText: label ? (label.getAttribute(\"value\") || label.textContent) : null,
          precedesPanel: precedes(header, panel),
          precedesPinned: precedes(header, pinned),
        };
      ")]
       (expect (js/get probe .headerExists)
               "#gjoa-space-header not in DOM")
       (expect (js/get probe .precedesPanel)
               "#gjoa-space-header is not before #gjoa-tab-panel in DOM order")
       (expect (js/get probe .precedesPinned)
               "#gjoa-space-header is not before #gjoa-pinned-container in DOM order")
       (expect-eq (js/get probe .labelText) "Main"
                  (str "header label should read \"Main\" on fresh state, got \"" (js/get probe .labelText) "\""))))

   (deftest "Spaces header — updates to the new name on :space switch" [mn]
     (js/await (reset-spaces mn))
     (chrome-eval "window.gjoaTest.vim.runExCommand(\"space new Project\");")
     (await-true
       "
        const l = document.getElementById(\"gjoa-space-header-label\");
        return !!l && (l.getAttribute(\"value\") || l.textContent) === \"Project\";
      " 1500)

     ;; Now switch back to Main and verify header re-reflects.
     (chrome-eval
       "
        const main = window.Spaces.list().find(s => s.name === \"Main\");
        window.Spaces.setActive(main.id);
      ")
     (await-true
       "
        const l = document.getElementById(\"gjoa-space-header-label\");
        return !!l && (l.getAttribute(\"value\") || l.textContent) === \"Main\";
      " 1500))

   (deftest "Spaces header — aligned with content rail (matches nav-bar icon column)" [mn]
     (js/await (reset-spaces mn))
     (let [r Any (chrome-eval
               "
        const header = document.getElementById(\"gjoa-space-header\");
        const label = document.getElementById(\"gjoa-space-header-label\");
        const sidebar = document.getElementById(\"sidebar-container\");
        const navIcons = sidebar?.querySelectorAll(\"#nav-bar .toolbarbutton-icon, #nav-bar image\");
        let firstNavIconLeft = null;
        if (navIcons) {
          let minLeft = Infinity;
          for (const ic of navIcons) {
            const rect = ic.getBoundingClientRect();
            if (rect.width > 0 && rect.left < minLeft) minLeft = rect.left;
          }
          if (minLeft !== Infinity) firstNavIconLeft = minLeft;
        }
        return {
          headerLeft: header.getBoundingClientRect().left,
          labelLeft: label.getBoundingClientRect().left,
          firstNavIconLeft,
          sidebarLeft: sidebar.getBoundingClientRect().left,
        };
      ")]
       ;; The header content (its visible box, after margin) should not be
       ;; flush against the sidebar edge — it should sit inside the inset.
       (let [header-left Float (js/get r .headerLeft)
            sidebar-left Float (js/get r .sidebarLeft)
            header-inset Float (- header-left sidebar-left)]
         (expect (not (< header-inset 6))
                 (str "Header flush-left against sidebar edge: headerLeft=" (js/get r .headerLeft) " "
                      "sidebarLeft=" (js/get r .sidebarLeft) " inset=" header-inset "px (expected ≥6px).")))
       ;; And the label's left edge should be within ~12px of the leftmost
       ;; nav-bar icon — i.e. on the same visual content rail.
       (when (not= (js/get r .firstNavIconLeft) nil)
         (let [label-left Float (js/get r .labelLeft)
              first-nav-icon-left Float (js/get r .firstNavIconLeft)
               drift Float (Math/abs (- label-left first-nav-icon-left))]
           (expect (not (> drift 24))
                   (str "Header label not aligned with nav-bar icons: labelLeft=" (js/get r .labelLeft) " "
                        "firstNavIconLeft=" (js/get r .firstNavIconLeft) " drift=" drift "px (expected ≤24px)."))))))

   (deftest "Spaces header — updates on :space rename of the active space" [mn]
     (js/await (reset-spaces mn))
     (chrome-eval "window.gjoaTest.vim.runExCommand(\"space rename Inbox\");")
     (await-true
       "
        const l = document.getElementById(\"gjoa-space-header-label\");
        return !!l && (l.getAttribute(\"value\") || l.textContent) === \"Inbox\";
      " 1500)
     ;; Restore so subsequent tests see "Main".
     (chrome-eval "window.gjoaTest.vim.runExCommand(\"space rename Main\");"))]))

;; The runner loads test modules via `mod.default`. Beagle's emitter has no
;; `export default` form, so we expose the array under the named export `tests`
;; (the runner reads `mod.default ?? []`). The default-export shim is noted in
;; the conversion 'issues'.

(js/export-default tests)
