#lang beagle/js
;; The compact sidebar must remain open while a context menu is live.
;;
;; A tab/group context menu opens via openPopupAtScreen, which sets the menupopup's
;; state='showing' SYNCHRONOUSLY — before the async `popupshown` that bumps the
;; `open-popups` counter — and the 0ms mouseleave→collapse check (on-sidebar-leave)
;; can run in that gap. `is-guarded` must also query for a live
;; `menupopup[state='showing'|'open']`, which is true from the synchronous
;; showing state onward.
;;
;; We simulate the open menu with a synthetic menupopup in state='showing' (exactly
;; what openPopupAtScreen sets) so the test is deterministic + headless-safe — no
;; native popup timing.
(ns gjoa.tests.integration.compact-context-menu
  (:require [gjoa.tests.dsl :refer [deftest chrome-eval await-true expect wait-for sleep]]))

(def ENABLE-COMPACT String "
  Services.prefs.setBoolPref('sidebar.verticalTabs', true);
  Services.prefs.setBoolPref('gjoa.sidebar.compact', true);
  return true;
")

;; Reveal the sidebar, plant a live menupopup[state='showing'], and fire the
;; mouseleave collapse path.
(def OPEN-MENU-AND-LEAVE String "
  const XUL='http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul';
  const sb=document.getElementById('sidebar-container');
  if(!sb) return {error:'no sidebar-main'};
  sb.setAttribute('gjoa-has-hover','true');
  let m=document.getElementById('gjoa-test-ctxmenu');
  if(!m){ m=document.createElementNS(XUL,'menupopup'); m.id='gjoa-test-ctxmenu'; document.documentElement.appendChild(m); }
  m.setAttribute('state','showing');
  sb.dispatchEvent(new MouseEvent('mouseleave',{relatedTarget:document.body}));
  return { menuLive: !!document.querySelector(\"menupopup[state='showing'],menupopup[state='open']\") };
")

(def CLOSE-MENU-AND-LEAVE String "
  const sb=document.getElementById('sidebar-container');
  const m=document.getElementById('gjoa-test-ctxmenu');
  if(m) m.setAttribute('state','closed');
  sb.dispatchEvent(new MouseEvent('mouseleave',{relatedTarget:document.body}));
  return true;
")

;; ENABLE-COMPACT sets a PREF, and the runner's RESET does not clear it — leaving it
;; on puts every later file's sidebar off-canvas (urlbar-drawer's floating-palette
;; geometry fails outright). Each test restores it.
(def DISABLE-COMPACT String "
  Services.prefs.clearUserPref('gjoa.sidebar.compact');
  return true;
")

(def HAS-HOVER String "return document.getElementById('sidebar-container').hasAttribute('gjoa-has-hover');")

;; Same race as OPEN-MENU-AND-LEAVE, but with the drawer `e`-pinned. Read
;; [gjoa-pinned] immediately after dispatch to assert synchronous preservation.
(def PIN-THEN-MENU-AND-LEAVE String "
  const XUL='http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul';
  const sb=document.getElementById('sidebar-container');
  if(!sb) return {error:'no sidebar-main'};
  sb.setAttribute('gjoa-has-hover','true');
  sb.setAttribute('gjoa-pinned','true');
  let m=document.getElementById('gjoa-test-ctxmenu');
  if(!m){ m=document.createElementNS(XUL,'menupopup'); m.id='gjoa-test-ctxmenu'; document.documentElement.appendChild(m); }
  m.setAttribute('state','showing');
  const pinnedBefore = sb.hasAttribute('gjoa-pinned');
  sb.dispatchEvent(new MouseEvent('mouseleave',{relatedTarget:document.body}));
  return { menuLive: !!document.querySelector(\"menupopup[state='showing'],menupopup[state='open']\"),
           pinnedBefore, pinnedAfter: sb.hasAttribute('gjoa-pinned'),
           hasHover: sb.hasAttribute('gjoa-has-hover') };
")

(js/export (def tests Any
  [(deftest "compact — sidebar stays expanded while a context menu is open (#88)" [mn]
     (js/await (chrome-eval ENABLE-COMPACT))
     (js/await (await-true "return !!document.querySelector('#sidebar-container[data-gjoa-compact]');" 4000))
     (let [r Any (js/await (chrome-eval OPEN-MENU-AND-LEAVE))]
       (expect (js/get r .menuLive) "precondition: a live menupopup[state=showing] should exist"))
     ;; KEEP: negative assertion — no observable flag to await. The leave-collapse
     ;; opportunity is on-sidebar-leave's setTimeout(linger=150ms); we must let it FIRE
     ;; (then abort on the live menu) before asserting "still hovered". await-true on
     ;; gjoa-has-hover would return at the first 20ms poll, before the timer ran. Blind
     ;; settle past the 150ms linger (+ rAF/flash margin) is required.
     (js/await (sleep 400))
     (let [held Bool (js/await (chrome-eval HAS-HOVER))]
       (expect held "sidebar collapsed while a context menu was open"))
     ;; Once the menu closes, a later mouseleave may collapse the sidebar.
     (js/await (chrome-eval CLOSE-MENU-AND-LEAVE))
     (js/await (await-true "return !document.getElementById('sidebar-container').hasAttribute('gjoa-has-hover');" 3000))
     (js/await (chrome-eval DISABLE-COMPACT))
     (js/await (await-true "return !document.querySelector('#sidebar-container[data-gjoa-compact]');" 4000)))

   ;; The `e`-PINNED reveal (vim.bjs summonSidebar sets [gjoa-pinned], and
   ;; #sidebar-container[data-gjoa-compact][gjoa-pinned] is what keeps the drawer
   ;; visible) must survive the same race. The live-menu guard runs before any
   ;; pin removal.
   (deftest "compact — an `e`-pinned drawer survives a context menu opening" [mn]
     (js/await (chrome-eval ENABLE-COMPACT))
     (js/await (await-true "return !!document.querySelector('#sidebar-container[data-gjoa-compact]');" 4000))
     (let [r Any (js/await (chrome-eval PIN-THEN-MENU-AND-LEAVE))]
       (expect (js/get r .menuLive) "precondition: a live menupopup[state=showing] should exist")
       (expect (js/get r .pinnedBefore) "precondition: [gjoa-pinned] should be set before the leave")
       ;; Assert synchronously before asynchronous menu cleanup can change state.
       (expect (js/get r .pinnedAfter)
         (str "[gjoa-pinned] was stripped by mouseleave while a "
              "context menu was open — the compact drawer dismisses on right-click. "
              (JSON/stringify r))))
     ;; And the pin must not outlive the menu: closing it with the pointer off the
     ;; sidebar releases the deferred clear.
     (js/await (chrome-eval CLOSE-MENU-AND-LEAVE))
     (js/await (await-true
       (str "const sb = document.getElementById('sidebar-container');"
            "return !sb.hasAttribute('gjoa-pinned') && !sb.hasAttribute('gjoa-has-hover');")
       3000))
     (js/await (chrome-eval DISABLE-COMPACT))
     (js/await (await-true "return !document.querySelector('#sidebar-container[data-gjoa-compact]');" 4000)))]))

(js/export-default tests)
