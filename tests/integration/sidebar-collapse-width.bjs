#lang beagle/js
;; Sidebar collapse-width contract for drawer/layout.bjs.
;;
;; `expand` pins the persisted `gjoa.sidebar.width` as an inline width on
;; #sidebar-container. `collapse` must remove that inline property so the strip
;; reaches favicon width, and a later `expand` must restore the persisted width.
;;
;; This is runtime DOM/layout behavior (computed width across a collapse/expand
;; cycle + presence of an inline width style), not a statically-checkable string,
;; so it must boot a browser. #sidebar-container is CHROME, so a Marionette
;; chrome-context executeScript reads its rects directly — no content discard, no
;; network, DEFAULT lane.
;;
;; Collapse/expand are driven exactly as FF drives them at runtime: toggling the
;; `sidebar-launcher-expanded` attribute on #sidebar-container, which layout.bjs's
;; MutationObserver (attributeFilter ["sidebar-launcher-expanded"]) watches to
;; call expand()/collapse(). We await the real post-mutation DOM state — never a
;; fixed sleep.
(ns gjoa.tests.integration.sidebar-collapse-width
  (:require [gjoa.tests.dsl :refer [deftest chrome-eval await-true wait-for expect]]))

(declare-extern [Number] Any)

;; Put the window into the EXPANDED vertical-tab drawer layout, with a KNOWN-WIDE
;; persisted width so the expanded state is unambiguously wide (well past the
;; favicon strip). Setting the pref BEFORE expanding means expand() pins this
;; exact inline width. Returns the preconditions the test guards on.
(def ENSURE-EXPANDED-WIDE String "
  Services.prefs.setBoolPref('sidebar.verticalTabs', true);
  Services.prefs.setBoolPref('sidebar.revamp', true);
  Services.prefs.setIntPref('gjoa.sidebar.width', 320);
  const sm = document.getElementById('sidebar-container');
  if (sm && !sm.hasAttribute('sidebar-launcher-expanded')) {
    sm.setAttribute('sidebar-launcher-expanded', '');
  }
  return { hasSidebarMain: !!sm,
           hasToolbar: !!document.getElementById('gjoa-urlbar-toolbar'),
           hasGjoaTest: !!window.gjoaTest };
")

;; Force a collapse the way FF does at runtime: drop the attribute the drawer's
;; MutationObserver keys off, which calls collapse().
(def DRIVE-COLLAPSE String "
  const sm = document.getElementById('sidebar-container');
  if (!sm) return false;
  sm.removeAttribute('sidebar-launcher-expanded');
  return true;
")

;; Force a re-expand the same way: re-add the attribute → expand().
(def DRIVE-EXPAND String "
  const sm = document.getElementById('sidebar-container');
  if (!sm) return false;
  sm.setAttribute('sidebar-launcher-expanded', '');
  return true;
")

;; Snapshot #sidebar-container's measured width and inline width style. A
;; collapsed strip must have no inline `style.width`.
(def MEASURE-SIDEBAR String "
  const sm = document.getElementById('sidebar-container');
  if (!sm) return { error: 'no #sidebar-container' };
  const r = sm.getBoundingClientRect();
  return {
    width: r.width,
    inlineWidth: sm.style.width,          // '' when removeProperty cleared it
    hasInlineWidth: sm.style.width !== '',
    expandedAttr: sm.hasAttribute('sidebar-launcher-expanded'),
  };
")

;; Tallest visible footer moz-button — `.tools-overflow` exists only in the
;; expanded row, so the collapsed rail has no stable per-button selector.
(def FOOTER-BTN-JS String "
  const sideMain = document.querySelector('#sidebar-container sidebar-main');
  const root = sideMain ? (sideMain.shadowRoot || sideMain) : null;
  const hs = (root ? Array.from(root.querySelectorAll('moz-button')) : [])
    .map(b => b.getBoundingClientRect().height).filter(h => h > 0);
  const footerBtnHeight = hs.length ? Math.max(...hs) : null;
")

;; Collapsed-rail geometry (#B6). The rhythm the eye reads is GLYPH-to-GLYPH, not
;; box-to-box: both clusters centre a 16px icon in a larger box, so equal box gaps
;; with unequal boxes still look uneven. Gaps are measured between adjacent icon
;; rects — tab favicons in the panel, moz-button <img>s in sidebar-main's shadow.
(def MEASURE-RAIL-RHYTHM String (str "
  const panel = document.getElementById('gjoa-tab-panel');
  if (!panel || !panel.hasAttribute('gjoa-icons-only')) return { error: 'not icons-only' };
  const panelTop = panel.getBoundingClientRect().top;
  const rows = Array.from(panel.querySelectorAll('.gjoa-tab-row:not([hidden])'));
  if (rows.length < 2) return { error: 'need >=2 tabs to measure spacing' };
  const r0 = rows[0].getBoundingClientRect();
  const r1 = rows[1].getBoundingClientRect();
  const glyphOf = (el) => {
    for (const c of el.querySelectorAll('img, image, .gjoa-favicon, .button-icon')) {
      const r = c.getBoundingClientRect();
      if (r.width > 0 && r.height > 0) return r;
    }
    return null;
  };
" FOOTER-BTN-JS "
  const byTop = (a, b) => a.top - b.top;
  const tabGlyphs = rows.map(glyphOf).filter(Boolean).sort(byTop);
  const toolGlyphs = (root ? Array.from(root.querySelectorAll('moz-button')) : [])
    .filter(b => b.getBoundingClientRect().height > 0)
    .map(b => b.shadowRoot && b.shadowRoot.querySelector('img'))
    .filter(Boolean).map(i => i.getBoundingClientRect())
    .filter(r => r.height > 0).sort(byTop);
  const gapsOf = (rs) => rs.slice(1).map((r, i) => Math.round((r.top - rs[i].bottom) * 10) / 10);
  const tabGaps = gapsOf(tabGlyphs);
  const toolGaps = gapsOf(toolGlyphs);
  const mean = (xs) => xs.reduce((a, b) => a + b, 0) / xs.length;
  return {
    firstTabOffset: r0.top - panelTop,
    interTabGap: r1.top - r0.bottom,
    tabRowHeight: r0.height,
    rowPitch: r1.top - r0.top,
    footerBtnHeight,
    tabGaps, toolGaps,
    tabGapSpread: tabGaps.length ? Math.max(...tabGaps) - Math.min(...tabGaps) : null,
    toolGapSpread: toolGaps.length ? Math.max(...toolGaps) - Math.min(...toolGaps) : null,
    clusterGapDelta: (tabGaps.length && toolGaps.length)
      ? Math.abs(mean(tabGaps) - mean(toolGaps)) : null,
  };
"))

;; Same footer-button measurement alone, usable in the expanded state to prove
;; the collapsed-only --button-min-height override doesn't leak.
(def MEASURE-FOOTER-BTN String (str FOOTER-BTN-JS " return { footerBtnHeight };"))

(js/export (def tests Any
  [(deftest "sidebar — collapse narrows to favicon strip (no inline width pins it wide); expand restores (#833c5b9)" [mn]
     (let [pre (chrome-eval ENSURE-EXPANDED-WIDE)]
       ;; GUARD against a vacuous pass on a dead-chrome binary: if GjoaLoader
       ;; never ran, #gjoa-urlbar-toolbar / window.gjoaTest are absent and the
       ;; drawer's expand/collapse never wires up — the attribute toggle would
       ;; then be a no-op and a "narrow" assertion could pass on native Firefox
       ;; defaults rather than Gjoa's collapse path. Fail loudly and specifically.
       (expect (js/get pre .hasSidebarMain) "no #sidebar-container — not a gjoa chrome window")
       (expect (and (js/get pre .hasToolbar) (js/get pre .hasGjoaTest))
         (str "gjoa drawer chrome did not initialize (#gjoa-urlbar-toolbar / "
              "window.gjoaTest missing) — e.g. GjoaLoader $$bc-runtime mismatch in a "
              "stale binary. Rebuild the bundle/binary; this test needs live gjoa "
              "chrome to exercise expand/collapse. " (JSON/stringify pre))))

     ;; Settle the EXPANDED state: expand() must have pinned the persisted inline
     ;; width and the drawer must be wide (well past favicon).
     (js/await (await-true
                 (str "const sm = document.getElementById('sidebar-container');"
                      "if (!sm) return false;"
                      "return sm.hasAttribute('sidebar-launcher-expanded') &&"
                      "       sm.getBoundingClientRect().width > 200;")
                 5000))
     (let [exp (chrome-eval MEASURE-SIDEBAR)]
       (expect (not (js/get exp .error)) (str "MEASURE-SIDEBAR (expanded) error: " (JSON/stringify exp)))
       (expect (> (Number (js/get exp .width)) 200)
         (str "expanded sidebar not wide — width " (js/call (Number (js/get exp .width)) .toFixed 1)
              "px (expected > 200; expand() should pin the 320px persisted width). "
              (JSON/stringify exp)))
       (expect (js/get exp .hasInlineWidth)
         (str "expand() did not pin an inline width on #sidebar-container — the "
              "expanded-width contract is missing (collapse would have nothing "
              "to clear). " (JSON/stringify exp))))

     ;; --- COLLAPSE CONTRACT ---
     (js/await (js/call mn .executeScript DRIVE-COLLAPSE))
     ;; Await the real collapsed DOM state: BOTH the strip narrowed to favicon
     ;; width AND no inline width style remains. < 80px = favicon strip.
     (js/await (await-true
                 (str "const sm = document.getElementById('sidebar-container');"
                      "if (!sm || sm.hasAttribute('sidebar-launcher-expanded')) return false;"
                      "const w = sm.getBoundingClientRect().width;"
                      "return w > 0 && w < 80 && sm.style.width === '';")
                 5000))
     (let [col (chrome-eval MEASURE-SIDEBAR)]
       (expect (not (js/get col .error)) (str "MEASURE-SIDEBAR (collapsed) error: " (JSON/stringify col)))
       (expect (not (js/get col .expandedAttr))
         (str "sidebar still has [sidebar-launcher-expanded] after collapse — measured "
              "the wrong state. " (JSON/stringify col)))
       ;; No inline width style survives the collapse.
       (expect (not (js/get col .hasInlineWidth))
         (str "collapsed #sidebar-container STILL has an inline width style ('"
              (js/get col .inlineWidth) "') — collapse() did not removeProperty('width'); "
              "this inline width pins the strip wide. "
              (JSON/stringify col)))
       ;; The measured width is the narrow favicon strip.
       (expect (< (Number (js/get col .width)) 80)
         (str "collapsed sidebar did not narrow to the favicon strip — width "
              (js/call (Number (js/get col .width)) .toFixed 1) "px (expected < 80px). "
              (JSON/stringify col))))

     ;; --- RAIL RHYTHM (#B6): collapsed-rail vertical spacing ---
     (chrome-eval "
        const p = Services.scriptSecurityManager.getSystemPrincipal();
        const t = gBrowser.addTab('about:blank', { triggeringPrincipal: p });
        t.setAttribute('gjoa-test-marker', 'rail-rhythm');
        window.gjoaTest.rows.scheduleTreeResync();
        window.gjoaTest.rows.updateVisibility();
        return true;")
     (await-true "return document.querySelectorAll('#gjoa-tab-panel .gjoa-tab-row').length >= 2;" 3000)
     (let [rhythm (chrome-eval MEASURE-RAIL-RHYTHM)]
       (expect (not (js/get rhythm .error)) (str "MEASURE-RAIL-RHYTHM error: " (JSON/stringify rhythm)))
       ;; The rail is ONE rhythm, not two calibrated ones: every adjacent icon pair —
       ;; tab to tab, tool to tool, and the two clusters against each other — sits the
       ;; same distance apart, within 3px (sub-pixel layout + the 1.75px cluster-edge
       ;; padding are the only slack). Owner spec: "all the icons (settings, tabs)
       ;; should have same space between distances".
       (expect (and (>= (Number (js/get rhythm .firstTabOffset)) 10) (<= (Number (js/get rhythm .firstTabOffset)) 14))
         (str "first-tab top offset must sit in the 10–14px band (10px container padding "
              "+ 2px row margin) — below it the first favicon reads as jammed against the "
              "panel edge. " (JSON/stringify rhythm)))
       ;; One absolute anchor, so a uniformly INFLATED rail can't pass on symmetry alone.
       (expect (<= (Number (js/get rhythm .rowPitch)) 28)
         (str "collapsed row pitch must be <= 28px (24px row + 2x2px margin) — " (JSON/stringify rhythm)))
       (expect (and (> (js/get (js/get rhythm .tabGaps) .length) 0) (> (js/get (js/get rhythm .toolGaps) .length) 0))
         (str "rhythm probe found no adjacent icon pair to measure in one of the clusters "
              "— the uniformity assertion below would pass vacuously. "
              (JSON/stringify rhythm)))
       (expect (<= (Number (js/get rhythm .tabGapSpread)) 3)
         (str "tab-cluster icon gaps are not uniform (spread " (js/get rhythm .tabGapSpread)
              "px > 3px): " (JSON/stringify (js/get rhythm .tabGaps))))
       (expect (<= (Number (js/get rhythm .toolGapSpread)) 3)
         (str "tool-cluster icon gaps are not uniform (spread " (js/get rhythm .toolGapSpread)
              "px > 3px): " (JSON/stringify (js/get rhythm .toolGaps))))
       (expect (<= (Number (js/get rhythm .clusterGapDelta)) 3)
         (str "the two clusters run different rhythms (delta " (js/get rhythm .clusterGapDelta)
              "px > 3px) — tabs " (JSON/stringify (js/get rhythm .tabGaps)) " vs tools "
              (JSON/stringify (js/get rhythm .toolGaps)) ". The collapsed rail must read as one "
              "beat top to bottom; --tab-min-height and --button-min-height both size the "
              "tool box, so they must equal the tab-row box. " (JSON/stringify rhythm)))
       (chrome-eval "
          const t = [...gBrowser.tabs].find(x => x.getAttribute('gjoa-test-marker') === 'rail-rhythm');
          if (t) { try { gBrowser.removeTab(t); } catch {} }
          return true;")

       ;; --- EXPAND: must restore the persisted width, AND the footer --tab-min-height
       ;; override must not leak past its collapsed-only guard.
       (js/await (js/call mn .executeScript DRIVE-EXPAND))
       (js/await (await-true
                   (str "const sm = document.getElementById('sidebar-container');"
                        "if (!sm || !sm.hasAttribute('sidebar-launcher-expanded')) return false;"
                        "return sm.style.width !== '' && sm.getBoundingClientRect().width > 200;")
                   5000))
       (let [re (chrome-eval MEASURE-SIDEBAR)]
         (expect (not (js/get re .error)) (str "MEASURE-SIDEBAR (re-expanded) error: " (JSON/stringify re)))
         (expect (and (js/get re .hasInlineWidth) (> (Number (js/get re .width)) 200))
           (str "re-expand did not restore the persisted width — width "
                (js/call (Number (js/get re .width)) .toFixed 1) "px, inline '" (js/get re .inlineWidth)
                "' (expected wide + inline 320px). "
                (JSON/stringify re))))
       (let [exp-footer (chrome-eval MEASURE-FOOTER-BTN)]
         (expect (not= (js/get exp-footer .footerBtnHeight) (js/get rhythm .footerBtnHeight))
           (str "expanded footer button height (" (js/get exp-footer .footerBtnHeight)
                ") must differ from the collapsed height (" (js/get rhythm .footerBtnHeight)
                ") — the collapsed-only --tab-min-height override is leaking.")))))]))

(js/export-default tests)
