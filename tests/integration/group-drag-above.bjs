#lang beagle/js
;; Regression: a tab positioned ABOVE a group, dropped INTO the group, must land
;; BELOW the group (indented child) — not stay above it. The empty-group case is
;; the trap: the group is not a Firefox tab, so moveTabTo leaves the dropped
;; tab's index unchanged and fires no TabMove to reposition its row, which used
;; to strand the child ABOVE its parent. drag.bjs now repositions the row
;; explicitly for the tab-into-group case.
(ns gjoa.tests.integration.group-drag-above
  (:require [gjoa.tests.dsl :refer [deftest chrome-eval await-true wait-for expect]]))
(define-mode strict)

(defn ensure-sidebar-expanded [mn :- Any] :- Any
  (chrome-eval "
    const sm = document.getElementById(\"sidebar-container\");
    if (sm && !sm.hasAttribute(\"sidebar-launcher-expanded\")) {
      sm.setAttribute(\"sidebar-launcher-expanded\", \"true\");
    }
    return true;")
  (await-true "return !!document.querySelector(\"#gjoa-tab-panel\");")
  nil)

(def ROWS-JS :- String "
  return [...document.querySelectorAll(\"#gjoa-tab-panel .gjoa-tab-row, #gjoa-tab-panel .gjoa-group-row\")]
    .map(r => ({
      kind: r.classList.contains(\"gjoa-group-row\") ? \"group\" : \"tab\",
      level: Math.max(0, Math.round(((parseFloat(r.style.paddingInlineStart||\"0\")||0) - 8) / 14)),
      label: r.querySelector(\".gjoa-tab-label, .gjoa-group-name\")?.textContent ?? \"\",
    }));")

;; `screenX/screenY` are set as well as client coords so the guard asserts drop
;; BEHAVIOUR rather than riding on whichever pair the #124 movement threshold reads.
;; The target rect is measured AFTER dragstart: dragging an unpinned row reveals the
;; empty pinned strip, which reflows the list under the pointer.
(defn drag-script [src :- Int tgt :- Int] :- String
  (str "
    const rows = [...document.querySelectorAll(\"#gjoa-tab-panel .gjoa-tab-row, #gjoa-tab-panel .gjoa-group-row\")];
    const source = rows[" src "]; const target = rows[" tgt "];
    if (!source || !target) throw new Error(\"row missing src=" src " tgt=" tgt " len=\"+rows.length);
    const dt = new DataTransfer();
    const fire = (el,type,x,y) => el.dispatchEvent(new DragEvent(type,{bubbles:true,cancelable:true,view:window,clientX:x,clientY:y,screenX:x+1000,screenY:y+1000,dataTransfer:dt}));
    const sR = source.getBoundingClientRect();
    fire(source,\"dragstart\",sR.left+5,sR.top+5);
    const tR = target.getBoundingClientRect();
    const cY = tR.top + tR.height/2; const cX = tR.left + tR.width/2;
    fire(target,\"dragenter\",cX,cY); fire(target,\"dragover\",cX,cY);
    fire(target,\"drop\",cX,cY); fire(source,\"dragend\",cX,cY);
    return true;"))

;; --- drop-to-pin helpers ----------------------------------------------------
;; Marker attribute (not label text): a label substring collision between the
;; seeded and the dragged tab silently turns a failure into a pass.
(defn add-marked-tab-js [marker :- String] :- String
  (str "
    const p = Services.scriptSecurityManager.getSystemPrincipal();
    const t = gBrowser.addTab(\"about:blank\", { triggeringPrincipal: p });
    t.setAttribute(\"gjoa-test-marker\", \"" marker "\");
    window.gjoaTest.rows.scheduleTreeResync();
    window.gjoaTest.rows.updateVisibility();
    return true;"))

(defn marked-row-ready-js [marker :- String] :- String
  (str "
    const t = [...gBrowser.tabs].find(t => t.getAttribute(\"gjoa-test-marker\") === \"" marker "\");
    return !!(t && window.gjoaTest.rowOf.get(t));"))

(defn marked-pinned-js [marker :- String] :- String
  (str "
    const t = [...gBrowser.tabs].find(t => t.getAttribute(\"gjoa-test-marker\") === \"" marker "\");
    const r = t && window.gjoaTest.rowOf.get(t);
    const pc = document.getElementById(\"gjoa-pinned-container\");
    const panel = document.getElementById(\"gjoa-tab-panel\");
    return !!(t && t.pinned && r && pc && pc.contains(r) && !panel.contains(r));"))

;; Drag the marked row onto the pinned section. `mode`:
;;   centre — the container's rect centre (the only target when it is empty)
;;   band   — 4px above the container's bottom edge, i.e. inside the divider band
;;            BELOW the last pinned row (the natural append aim point)
;;   label  — a pinned row's `.gjoa-tab-label` child, which is what exercises the
;;            structural-equality drop routing
(defn pin-drag-js [marker :- String mode :- String] :- String
  (str "
    const M = \"" marker "\"; const mode = \"" mode "\";
    const tab = [...gBrowser.tabs].find(t => t.getAttribute(\"gjoa-test-marker\") === M);
    const row = tab && window.gjoaTest.rowOf.get(tab);
    const pc = document.getElementById(\"gjoa-pinned-container\");
    if (!tab || !row || !pc) return { error: \"setup: tab/row/pinned-container missing\" };
    const dt = new DataTransfer();
    const fire = (el,type,x,y) => el.dispatchEvent(new DragEvent(type,{bubbles:true,cancelable:true,view:window,clientX:x,clientY:y,screenX:x+1000,screenY:y+1000,dataTransfer:dt}));
    const sr = row.getBoundingClientRect();
    fire(row, \"dragstart\", sr.left+5, sr.top+5);
    const pr = pc.getBoundingClientRect();
    const pinnedRows = [...pc.querySelectorAll(\".gjoa-tab-row:not([hidden])\")];
    const last = pinnedRows[pinnedRows.length - 1];
    const lastBottom = last ? last.getBoundingClientRect().bottom : null;
    let target = pc, x = pr.left + pr.width/2, y = pr.top + pr.height/2;
    if (mode === \"band\") { y = pr.bottom - 4; }
    else if (mode === \"label\") {
      if (!last) return { error: \"label mode needs an existing pinned row\" };
      const lr = last.getBoundingClientRect();
      target = last.querySelector(\".gjoa-tab-label\") || last;
      x = lr.left + lr.width/2; y = lr.top + lr.height/2;
    }
    fire(target, \"dragenter\", x, y); fire(target, \"dragover\", x, y);
    const dropPrevented = !fire(target, \"drop\", x, y);
    fire(row, \"dragend\", x, y);
    return { ok: true, mode, x, y, pinnedRowsBefore: pinnedRows.length,
             containerRect: { top: pr.top, bottom: pr.bottom, height: pr.height },
             lastBottom, belowLastRow: lastBottom !== null && y > lastBottom,
             targetTag: target.className || target.localName, dropPrevented };"))

;; --- drop DIRECTLY ONTO a tab shown in the pinned section ------------------
;; Real-DND fidelity the single-shot dispatches above lack: the pointer is
;; hit-tested per step, comes to REST on the target, and `drop` is dispatched
;; only when the last dragover was canceled — a browser fires none otherwise.
(defn drop-onto-pinned-js [marker :- String] :- String
  (str "
    const M = \"" marker "\";
    const doc = document;
    const pc = doc.getElementById(\"gjoa-pinned-container\");
    const tab = [...gBrowser.tabs].find(t => t.getAttribute(\"gjoa-test-marker\") === M);
    const row = tab && window.gjoaTest.rowOf.get(tab);
    const shown = [...pc.querySelectorAll(\".gjoa-tab-row:not([hidden])\")];
    const target = shown[shown.length - 1];
    if (!tab || !row || !target) return { error: \"setup: tab/row/pinned-row missing\" };
    const dt = new DataTransfer();
    const mk = (type,x,y,rel) => new DragEvent(type,{bubbles:true,cancelable:true,view:window,
        clientX:x,clientY:y,screenX:x+1000,screenY:y+1000,dataTransfer:dt,relatedTarget:rel||null});
    const sr = row.getBoundingClientRect();
    const x0 = sr.left + sr.width/2, y0 = sr.top + sr.height/2;
    row.dispatchEvent(mk(\"dragstart\", x0, y0));
    const tr = target.getBoundingClientRect();          // AFTER dragstart: the strip reflows
    const x1 = tr.left + tr.width/2, y1 = tr.top + tr.height/2;
    let cur = null, accepted = false;
    const tick = (x, y) => {
      const hit = doc.elementFromPoint(x, y);
      if (!hit) { cur = null; accepted = false; return; }
      if (hit !== cur) { hit.dispatchEvent(mk(\"dragenter\", x, y, cur));
                         if (cur) cur.dispatchEvent(mk(\"dragleave\", x, y, hit));
                         cur = hit; }
      accepted = !hit.dispatchEvent(mk(\"dragover\", x, y));
    };
    const n = Math.max(1, Math.ceil(Math.hypot(x1-x0, y1-y0) / 4));
    for (let i = 1; i <= n; i++) tick(x0 + (x1-x0)*i/n, y0 + (y1-y0)*i/n);
    for (let i = 0; i < 4; i++) tick(x1, y1);           // pointer at rest
    let dropped = false;
    if (accepted && cur) { cur.dispatchEvent(mk(\"drop\", x1, y1)); dropped = true; }
    row.dispatchEvent(mk(\"dragend\", x1, y1));
    return { ok: true, dropped, accepted,
             targetTabPinned: !!(target._tab && target._tab.pinned),
             hit: cur ? (cur.id ? \"#\"+cur.id : \".\"+String(cur.className).split(\" \")[0]) : \"null\" };"))

;; Every row the pinned section SHOWS must belong to a pinned tab — otherwise the
;; section lies, and a drop onto one of those rows is not a cross-container move.
(def PINNED-SECTION-HONEST :- String "
  const pc = document.getElementById(\"gjoa-pinned-container\");
  const rows = [...pc.querySelectorAll(\".gjoa-tab-row:not([hidden])\")];
  return rows.filter(r => !(r._tab && r._tab.pinned))
             .map(r => r._tab ? (r._tab.getAttribute(\"gjoa-test-marker\") || r._tab.label) : \"?\");")

;; RESET-JS keeps pinned tabs, so this test MUST leave none behind.
(def CLEANUP-PINNED :- String "
  for (const t of [...gBrowser.tabs]) {
    if (t.getAttribute(\"gjoa-test-marker\")) {
      try { if (t.pinned) gBrowser.unpinTab(t); } catch (e) {}
      try { gBrowser.removeTab(t); } catch (e) {}
    }
  }
  return true;")

(js/export (def tests :- Any
  [(deftest "drag: tab ABOVE an (empty) group dropped INTO it lands BELOW + indented" [mn]
     (js/await (ensure-sidebar-expanded mn))
     (chrome-eval "Services.prefs.setCharPref(\"gjoa.tabs.newTabPosition\", \"root\");")
     ;; A marked tab, then an empty group (spacer menu -> goes to the bottom, so
     ;; the marked tab is above it).
     (chrome-eval "
        const sp = Services.scriptSecurityManager.getSystemPrincipal();
        gBrowser.addTab(\"about:blank?abovegrp\", { triggeringPrincipal: sp });
        return true;")
     (await-true "return [...document.querySelectorAll('#gjoa-tab-panel .gjoa-tab-label')].some(e=>e.textContent.includes('abovegrp'));")
     (chrome-eval "
        const panel = document.getElementById(\"gjoa-tab-panel\");
        const spacer = panel.querySelector(\"[gjoa-spacer], .gjoa-spacer\") || panel.firstChild;
        const rect = (spacer || panel).getBoundingClientRect();
        (spacer || panel).dispatchEvent(new MouseEvent(\"contextmenu\", { bubbles:true, cancelable:true, button:2, clientX:rect.left+4, clientY:rect.top+4 }));
        const menu = document.getElementById(\"gjoa-panel-menu\");
        const item = [...menu.querySelectorAll(\"menuitem\")].find(mi => mi.getAttribute(\"label\") === \"New Tab Group\");
        item.dispatchEvent(new Event(\"command\", { bubbles:true }));
        return true;")
     (await-true "return document.querySelectorAll('#gjoa-tab-panel .gjoa-group-row').length >= 1;")
     ;; Find the marked tab + the latest group; require the tab to be ABOVE it.
     (let [rows (chrome-eval ROWS-JS)
           grp-idx (loop [i 0 acc -1]
                     (if (< i (.-length rows))
                       (recur (+ i 1) (if (= (.-kind (aget rows i)) "group") i acc))
                       acc))
           src-idx (.findIndex rows (fn [r] (.includes (.-label r) "abovegrp")))]
       (when (or (< grp-idx 0) (< src-idx 0))
         (throw (Error. (str "setup: grpIdx=" grp-idx " srcIdx=" src-idx " rows=" (JSON/stringify rows)))))
       (when (>= src-idx grp-idx)
         (throw (Error. (str "setup: marked tab must be ABOVE the group (srcIdx=" src-idx " grpIdx=" grp-idx ")"))))
       (chrome-eval (drag-script src-idx grp-idx))
       (js/await (Promise. (fn [r] (setTimeout (fn [] (r)) 250))))
       ;; After: the marked tab must render AFTER the group and indented.
       (let [after (chrome-eval ROWS-JS)
             grp2 (loop [i 0 acc -1]
                    (if (< i (.-length after))
                      (recur (+ i 1) (if (= (.-kind (aget after i)) "group") i acc))
                      acc))
             src2 (.findIndex after (fn [r] (.includes (.-label r) "abovegrp")))]
         (when (or (< grp2 0) (< src2 0))
           (throw (Error. (str "after: grpIdx=" grp2 " srcIdx=" src2 " rows=" (JSON/stringify after)))))
         (expect (> src2 grp2)
                 (str "dropped tab must render BELOW the group, not above (tabIdx=" src2 " groupIdx=" grp2 ")"))
         (expect (> (.-level (aget after src2)) (.-level (aget after grp2)))
                 (str "dropped tab must be indented as a child of the group (tabLevel="
                      (.-level (aget after src2)) " groupLevel=" (.-level (aget after grp2)) ")")))))

   ;; Dropping an unpinned tab on the pinned SECTION pins it. Three scenarios, in
   ;; order, because each leaves the pinned state the next one needs.
   (deftest "drag: unpinned tab dropped on the pinned section pins it" [mn]
     (js/await (ensure-sidebar-expanded mn))
     (chrome-eval CLEANUP-PINNED)
     (js/await (await-true
       "return document.querySelectorAll('#gjoa-pinned-container .gjoa-tab-row').length === 0;" 3000))

     ;; (a) EMPTY pinned container — hidden and 0x0, so the drag must reveal it.
     (chrome-eval (add-marked-tab-js "pinguard-a"))
     (js/await (await-true (marked-row-ready-js "pinguard-a") 3000))
     (let [ra (chrome-eval (pin-drag-js "pinguard-a" "centre"))]
       (expect (not (.-error ra)) (str "(a) " (.-error ra)))
       (expect (= (.-pinnedRowsBefore ra) 0)
         (str "(a) scenario needs an EMPTY pinned container, saw "
              (.-pinnedRowsBefore ra) " rows. " (JSON/stringify ra)))
       (js/await (await-true (marked-pinned-js "pinguard-a") 3000)))

     ;; (b) The divider band BELOW the last pinned row — the natural append aim
     ;; point, and the first thing a drag from the tab tree crosses going up.
     (chrome-eval (add-marked-tab-js "pinguard-b"))
     (js/await (await-true (marked-row-ready-js "pinguard-b") 3000))
     (let [rb (chrome-eval (pin-drag-js "pinguard-b" "band"))]
       (expect (not (.-error rb)) (str "(b) " (.-error rb)))
       (expect (.-belowLastRow rb)
         (str "(b) aim point y=" (.-y rb) " is NOT below the last pinned row's bottom "
              (.-lastBottom rb) " — the scenario stopped covering the divider band. "
              (JSON/stringify rb)))
       (js/await (await-true (marked-pinned-js "pinguard-b") 3000)))

     ;; (c) Control: dispatched on a pinned row's .gjoa-tab-label child, the node
     ;; that structural `=` mistakes for the container / panel / spacer.
     (chrome-eval (add-marked-tab-js "pinguard-c"))
     (js/await (await-true (marked-row-ready-js "pinguard-c") 3000))
     (let [rc (chrome-eval (pin-drag-js "pinguard-c" "label"))]
       (expect (not (.-error rc)) (str "(c) " (.-error rc)))
       (js/await (await-true (marked-pinned-js "pinguard-c") 3000)))

     (chrome-eval CLEANUP-PINNED))

   ;; The owner's gesture: drop an unpinned tab onto a tab the pinned section is
   ;; SHOWING. Precondition is the one a live session reaches — a tab pinned then
   ;; unpinned — because unpin used to leave the row behind in the pinned
   ;; container, and a drop onto that stranded row is not a cross-container move,
   ;; so it silently reordered instead of pinning.
   (deftest "drag: dropping an unpinned tab onto a pinned tab pins it" [mn]
     (js/await (ensure-sidebar-expanded mn))
     (chrome-eval CLEANUP-PINNED)
     (js/await (await-true
       "return document.querySelectorAll('#gjoa-pinned-container .gjoa-tab-row').length === 0;" 3000))

     (chrome-eval (add-marked-tab-js "pintgt"))
     (js/await (await-true (marked-row-ready-js "pintgt") 3000))
     (chrome-eval (add-marked-tab-js "pinbounce"))
     (js/await (await-true (marked-row-ready-js "pinbounce") 3000))
     (chrome-eval "
        const pick = m => [...gBrowser.tabs].find(t => t.getAttribute('gjoa-test-marker') === m);
        gBrowser.pinTab(pick('pintgt'));
        gBrowser.pinTab(pick('pinbounce'));
        gBrowser.unpinTab(pick('pinbounce'));
        return true;")
     (js/await (await-true (marked-pinned-js "pintgt") 3000))

     (chrome-eval (add-marked-tab-js "pindrag"))
     (js/await (await-true (marked-row-ready-js "pindrag") 3000))
     (let [r (chrome-eval (drop-onto-pinned-js "pindrag"))]
       (expect (not (.-error r)) (str "gesture: " (.-error r)))
       (expect (.-accepted r)
         (str "the pointer at rest on a pinned tab must be a valid drop target — the "
              "last dragover was refused on " (.-hit r) ", so a real browser fires no "
              "drop at all. " (JSON/stringify r)))
       (js/await (await-true (marked-pinned-js "pindrag") 3000)))

     (let [liars (chrome-eval PINNED-SECTION-HONEST)]
       (expect (= (.-length liars) 0)
         (str "the pinned section is showing rows whose tabs are NOT pinned: "
              (JSON/stringify liars))))

     (chrome-eval CLEANUP-PINNED))]))
(js/export-default tests)
