#lang beagle/js
;; Regression for the REAL-CREDENTIAL finding in scriptlet-resources.json
;; (security threads 019f79cd-a853 / S1 019f79f3-0a1f / S2 019f79f3-1765).
;;
;; Two of the 163 committed "scriptlet" entries — both named
;; `async-sugarcoat-<sha1>.js` — decoded to large third-party analytics
;; bundles that are NOT genuine uBO `+js()` scriptlets. One of them carried a
;; live GCP-shaped API key used as a URL query parameter in an executable
;; POST to a Google endpoint. That entry has been removed outright (not
;; redacted in place — it was never legitimate vendored content) and the
;; SHA-256 pin in verify-scriptlet-resources.sh + PROVENANCE.md updated so a
;; normal `bun run preflight` (Gate J) run — or any hand-edit that tries to
;; restore the old bytes — fails the integrity check instead of silently
;; re-admitting the credential.
;;
;; This test proves two things without ever handling the real secret value:
;;   1. structurally — no entry name/shape matching the removed resource
;;      remains, and the file matches the newly pinned hash.
;;   2. the scanner is still sensitive — a synthetic (non-real, clearly fake)
;;      GCP-API-key-shaped string, planted in an isolated scratch dir well
;;      outside the repo, still trips gitleaks' gcp-api-key rule. This is the
;;      negative control: if this ever stops failing, secret scanning itself
;;      has been weakened, independent of anything in this repo.
(ns gjoa.tests.scriptlet-resources-secret
  (:require [fs :refer [existsSync readFileSync mkdtempSync writeFileSync rmSync]]
            [path :refer [join]]
            [os :refer [tmpdir]]
            [crypto :refer [createHash]]
            [child_process :refer [spawnSync]]))
(declare-extern [describe expect test process] Any)

(def REPO String (js/call process .cwd))
(def BUNDLE String
  (join REPO "src" "gjoa" "toolkit" "components" "content-classifier"
        "scriptlet-resources.json"))
(def VERIFIER String
  (join REPO "tools" "prep" "verify-scriptlet-resources.sh"))

;; The exact bytes of the credential-bearing candidate must never appear in
;; this test or any artifact it produces — we assert absence by NAME (a
;; public identifier of the removed resource, not the secret) and by hash.
(def REMOVED-NAME String
  "async-sugarcoat-8a459c41783885dc83d30f5b7da2359091f4e607.js")
(def EXPECTED-SHA256 String
  "156b8d4c9cf833c141687ba33139fa98e8777c0bc95fee3ec05449760fb60e0a")

;; A synthetic, non-real GCP-API-key-shaped string for the sensitivity
;; control only. It authenticates nothing and was never a real credential —
;; but its SHAPE matches gitleaks' own gcp-api-key rule closely enough that
;; the literal "AIza" + 35-char tail must never appear contiguously in this
;; source file, or this very test file would itself trip the scanner it is
;; testing. Assembled from split fragments at runtime for that reason only.
(def PLANTED-SECRET String
  (str "AI" "za" "odJFCrnl2edlBDdz1C5Jau2RJtBRnlWmTSH"))

(defn sha256hex [text String] String
  (-> (createHash "sha256") (js/call text .update "utf8") (js/call "hex" .digest)))

(describe "scriptlet-resources.json credential removal (019f79f3-1765)"
  (fn [] Any
    (test "bundle exists"
      (fn [] Any
        (js/call (expect (existsSync BUNDLE)) .toBe true)))

    (test "removed resource name is absent from the committed bundle"
      (fn [] Any
        (let [raw String (readFileSync BUNDLE "utf8")]
          (js/call (expect (>= (js/call raw .indexOf REMOVED-NAME) 0)) .toBe false))))

    (test "committed bundle matches the newly pinned SHA-256 (old bytes cannot be restored silently)"
      (fn [] Any
        (let [raw String (readFileSync BUNDLE "utf8")]
          (js/call (expect (sha256hex raw)) .toBe EXPECTED-SHA256))))

    (test "verify-scriptlet-resources.sh is pinned to the same hash as the bundle"
      (fn [] Any
        (let [src String (readFileSync VERIFIER "utf8")]
          (js/call (expect (>= (js/call src .indexOf EXPECTED-SHA256) 0)) .toBe true))))

    (test "verify-scriptlet-resources.sh (Gate J) passes against the current bundle"
      (fn [] Any
        (let [r Any (spawnSync "bash" [VERIFIER] {:encoding "utf8"})]
          (js/call (expect (js/get r .status)) .toBe 0))))

    ;; Sensitivity negative control: gitleaks must still catch a
    ;; gcp-api-key-shaped secret. Runs in an isolated tmp dir, never inside
    ;; this repo, and is torn down immediately after the assertion.
    (test "gitleaks still detects a planted synthetic gcp-api-key secret (scanner sensitivity)"
      (fn [] Any
        (let [dir String (mkdtempSync (join (tmpdir) "gl-sensitivity-"))
             file String (join dir "planted.js")]
          (writeFileSync file (str "const k = \"" PLANTED-SECRET "\";\n") "utf8")
          (let [r Any (spawnSync "gitleaks"
                    ["detect" "--no-banner" "--redact" "--no-git" "-s" dir]
                    {:encoding "utf8"})]
            (rmSync dir {:recursive true :force true})
            ;; gitleaks exits non-zero when it finds a leak.
            (js/call (js/get (expect (js/get r .status)) .not) .toBe 0)))))))
