#lang beagle/js
;; `diag` builds its dynamic domain-to-pending-array object functionally with
;; `reduce`/`assoc` over DOMAIN-ORDER. `(set! (aget out %) ...)` is not an
;; assignable place on the JavaScript target. This source-level check enforces
;; the valid construction and default empty pending array without a browser.
(ns gjoa.tests.scheduler-diag-place
  (:require [fs :refer [existsSync readFileSync]]
            [path :refer [join]]))
(declare-extern [describe expect test process RegExp] Any)

(def REPO String (js/call process .cwd))
(def SCHEDULER String
  (join REPO "src" "gjoa" "chrome" "bjs" "platform" "scheduler.bjs"))

(defn has? [(s String) (pat String)] Any (js/call (js/new RegExp pat) .test s))

(describe "scheduler diag() place-safety (E009 019f79cd)"
  (fn [] Any
    (test "source exists"
      (fn [] Any
        (js/call (expect (existsSync SCHEDULER)) .toBe true)))

    ;; set! must never target an (aget ...) non-place.
    (test "diag does not assign through (set! (aget ...))"
      (fn [] Any
        (let [src (readFileSync SCHEDULER "utf8")]
          (js/call (expect (has? src "\\(set!\\s*\\(aget")) .toBe false))))

    ;; Functional reduce/assoc over DOMAIN-ORDER,
    ;; still defaulting a domain's pending reasons to [] when untouched —
    ;; preserves the dynamic domain-keys + pending-array semantics diag()
    ;; callers (gjoa.platform.index diag) depend on.
    (test "diag rebuilds pending map via reduce/assoc over DOMAIN-ORDER"
      (fn [] Any
        (let [src (readFileSync SCHEDULER "utf8")]
          (js/call (expect (has? src "reduce[\\s\\S]{0,80}assoc")) .toBe true)
          (js/call (expect (has? src "\\(or \\(\\.get pending domain\\) \\[\\]\\)")) .toBe true)
          (js/call (expect (has? src "DOMAIN-ORDER")) .toBe true))))))
