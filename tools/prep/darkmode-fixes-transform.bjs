#lang beagle/js
;; tools/prep/darkmode-fixes-transform.bjs — Dark Reader dynamic-theme-fixes →
;; gjoa curated dark-mode entry generator, FULL-DIRECTIVE edition (M2 tier-2).
;;
;; WHAT THIS IS (vs darkmode-registry.bjs)
;;   darkmode-registry.bjs handles ONLY Dark Reader's CSS section (token-resolve →
;;   {mode,override,css}). This tool is its richer sibling: it parses the WHOLE
;;   directive set of each DR block —
;;     INVERT                → invertSelectors    (filter:invert(1) hue-rotate)
;;     IGNORE INLINE STYLE   → ignoreInlineStyle  (true / [selectors])
;;     IGNORE IMAGE ANALYSIS → ignoreImageAnalysis (true / [selectors])
;;     CSS                   → css                (DR tokens PRE-RESOLVED to consts)
;;   plus two gjoa-only refinements derived from the CSS body during eyeball:
;;     noInvertSelectors     → elements to EXCLUDE from engine inversion (curated)
;;     removeBgSelectors     → elements whose bg-image DR strips (background:none)
;;   and emits a CANDIDATE expansion of darkmode-fixes.json in the schema the
;;   actor reads ({host:{mode,override,css,inject, +the new fields}}).
;;
;; ⚠ LOSSY — VISUAL QA REQUIRED. DR ${...} tokens are PRE-RESOLVED to fixed dark
;;   constants here. DR resolves them at runtime against its computed theme +
;;   var(--darkreader-*) vars; this tool maps those to ONE fixed dark palette.
;;   So the conversion is an APPROXIMATION, NOT a faithful runtime port. This tool
;;   prints CANDIDATES for a human to eyeball; it is NOT a blind-convert pipeline.
;;   It deliberately does NOT --write: the curated entries land via human review.
;;
;; WORKFLOW
;;   bun .beagle-tools/gjoa/tools/prep/darkmode-fixes-transform.js <host> [host...]
;;     → prints the candidate JSON entry for each host (token-resolved, directives
;;       expanded), with a per-entry QA report (unresolved tokens, unmapped vars,
;;       which directives were present). Eyeball, then hand-merge the good ones
;;       into src/.../darkmode-fixes.json.
;;   --selftest  → parser + token-resolve assertions; exits nonzero on failure.
;;
;; PROVENANCE — Dark Reader is MIT-licensed. Each emitted entry carries
;;   "_provenance":"darkreader@<pin> MIT" so the registry records where it came from.
(ns gjoa.tools.prep.darkmode-fixes-transform
  (:require [fs :refer [existsSync readFileSync writeFileSync]]
            [path :refer [join]]
            [gjoa.tools.prep.paths :refer [REPO-ROOT]]
            [gjoa.tools.prep.log :refer [log]]))
(declare-extern [process Reflect Bun Number] Any)

;; Set a STRING/keyword-named property on a plain JS object. The pinned beagle
;; emits `(set! (get o k) v)` as `($$bc$get(o,k) = v)` — an invalid JS assignment
;; target (a call on the LHS) — so we route object-property mutation through
;; Reflect.set, which emits as a plain `Reflect.set(o,k,v)` call. This is the
;; idiomatic interop escape until the pinned compiler's set!-of-get lowering is
;; repaired upstream (it still bracket-assigns in the older committed registry.js).
(defn oset! [(o Any) (k Any) (v Any)] Any
  (js/call Reflect .set o k v)
  v)

;; ---------------------------------------------------------------------------
;; Paths + pin (mirror darkmode-registry.bjs — same snapshot, same release).
;; ---------------------------------------------------------------------------

(def SNAPSHOT-PATH String (join REPO-ROOT "tools" "prep" "darkreader-fixes.snapshot"))
(def REGISTRY-PATH String
  (join REPO-ROOT "src" "gjoa" "toolkit" "components" "content-classifier" "darkmode-fixes.json"))
(def DARKREADER-PIN String "v4.9.127")
(def PROVENANCE String (str "darkreader@" DARKREADER-PIN " MIT"))

;; SHA-256 of the committed snapshot at DARKREADER-PIN. --write-all verifies the
;; on-disk snapshot against this before generating any USER_SHEET CSS; a mismatch
;; (tampered / silently-refreshed corpus) aborts the write. Mirrors the same pin
;; gate darkmode-registry.bjs enforces. Recompute with
;; `sha256sum tools/prep/darkreader-fixes.snapshot`.
(def EXPECTED-SNAPSHOT-SHA256 String
  "0e6d82b4df349edeb789e4dbb346f427caff4861f071020525fd81e6f50e638f")

;; Hex SHA-256 of a string (Bun runtime hasher). Pure — no `!`.
(defn sha256 [(text String)] String
  (let [hash (js/new Bun.CryptoHasher "sha256")]
    (js/call hash .update text)
    (js/call hash .digest "hex")))

;; ---------------------------------------------------------------------------
;; Color model + luminance flip — a verbatim re-use of darkmode-registry.bjs's
;; EXACT engine port (patches/0009 invert_color_luminance). Kept self-contained
;; here (no cross-tool import of internals) so this generator stands alone, but
;; byte-identical: white→dark, black→light, single shared factor (hue/sat held),
;; alpha passthrough. The selftest pins the same invariants.
;; ---------------------------------------------------------------------------

(def NAMED-COLORS Any
  {"black"     [0 0 0]
   "white"     [255 255 255]
   "red"       [255 0 0]
   "blue"      [0 0 255]
   "cyan"      [0 255 255]
   "yellow"    [255 255 0]
   "orange"    [255 165 0]
   "purple"    [128 0 128]
   "gold"      [255 215 0]
   "goldenrod" [218 165 32]
   "khaki"     [240 230 140]
   "gray"      [128 128 128]
   "grey"      [128 128 128]
   "lightgray" [211 211 211]
   "lightgrey" [211 211 211]
   "darkgray"  [169 169 169]
   "darkgrey"  [169 169 169]
   "dimgrey"   [105 105 105]
   "dimgray"   [105 105 105]
   "slategray" [112 128 144]
   "lightblue" [173 216 230]
   "darkblue"  [0 0 139]
   "darkred"   [139 0 0]
   "aliceblue" [240 248 255]})

(defn clamp [(x Any) (lo Any) (hi Any)] Any
  (Math/max lo (Math/min hi x)))

(defn parse-hex [(h String)] Any
  (let [n (js/get h .length)
        valid (js/call (js/new RegExp "^[0-9a-fA-F]+$") .test h)]
    (cond
      (not valid) nil
      (= n 3) [(parseInt (str (aget h 0) (aget h 0)) 16)
               (parseInt (str (aget h 1) (aget h 1)) 16)
               (parseInt (str (aget h 2) (aget h 2)) 16)
               1]
      (= n 4) [(parseInt (str (aget h 0) (aget h 0)) 16)
               (parseInt (str (aget h 1) (aget h 1)) 16)
               (parseInt (str (aget h 2) (aget h 2)) 16)
               (/ (parseInt (str (aget h 3) (aget h 3)) 16) 255)]
      (= n 6) [(parseInt (js/call h .slice 0 2) 16)
               (parseInt (js/call h .slice 2 4) 16)
               (parseInt (js/call h .slice 4 6) 16)
               1]
      (= n 8) [(parseInt (js/call h .slice 0 2) 16)
               (parseInt (js/call h .slice 2 4) 16)
               (parseInt (js/call h .slice 4 6) 16)
               (/ (parseInt (js/call h .slice 6 8) 16) 255)]
      :else nil)))

(defn split-args [(body String)] Any
  (let [raw (js/call (js/call body .trim) .split (js/new RegExp "[\\s,/]+"))]
    (js/call raw .filter (fn [s] Any (> (js/get s .length) 0)))))

(defn parse-component [(s String) (whole Any)] Any
  (if (js/call s .endsWith "%")
    (* (/ (parseFloat (js/call s .slice 0 -1)) 100) whole)
    (parseFloat s)))

(defn hsl->rgb [(h Any) (s Any) (l Any)] Any
  (let [hh (/ (mod (mod h 360) 360) 360)
        q (if (< l 0.5) (* l (+ 1 s)) (- (+ l s) (* l s)))
        p (- (* 2 l) q)
        hue->rgb (fn [(t0 Any)] Any (let [t (cond (< t0 0) (+ t0 1) (> t0 1) (- t0 1) :else t0)]
                     (cond
                       (< t (/ 1 6)) (+ p (* (- q p) 6 t))
                       (< t (/ 1 2)) q
                       (< t (/ 2 3)) (+ p (* (- q p) (- (/ 2 3) t) 6))
                       :else p)))]
    (if (= s 0)
      [(Math/round (* l 255)) (Math/round (* l 255)) (Math/round (* l 255))]
      [(Math/round (* (hue->rgb (+ hh (/ 1 3))) 255))
       (Math/round (* (hue->rgb hh) 255))
       (Math/round (* (hue->rgb (- hh (/ 1 3))) 255))])))

(defn parse-color [(raw String)] Any
  (let [s (js/call raw .trim)
        lower (js/call s .toLowerCase)]
    (cond
      (js/call s .startsWith "#")
      (parse-hex (js/call s .slice 1))

      (or (js/call lower .startsWith "rgb(") (js/call lower .startsWith "rgba("))
      (let [body (js/call s .slice (+ (js/call s .indexOf "(") 1) (js/call s .lastIndexOf ")"))
            parts (split-args body)]
        (when (>= (js/get parts .length) 3)
          [(clamp (Math/round (parse-component (aget parts 0) 255)) 0 255)
           (clamp (Math/round (parse-component (aget parts 1) 255)) 0 255)
           (clamp (Math/round (parse-component (aget parts 2) 255)) 0 255)
           (if (>= (js/get parts .length) 4) (clamp (parse-component (aget parts 3) 1) 0 1) 1)]))

      (or (js/call lower .startsWith "hsl(") (js/call lower .startsWith "hsla("))
      (let [body (js/call s .slice (+ (js/call s .indexOf "(") 1) (js/call s .lastIndexOf ")"))
            parts (split-args body)]
        (when (>= (js/get parts .length) 3)
          (let [h (parseFloat (aget parts 0))
                sat (/ (parse-component (aget parts 1) 100) 100)
                lit (/ (parse-component (aget parts 2) 100) 100)
                rgb (hsl->rgb h (clamp sat 0 1) (clamp lit 0 1))]
            [(aget rgb 0) (aget rgb 1) (aget rgb 2)
             (if (>= (js/get parts .length) 4) (clamp (parse-component (aget parts 3) 1) 0 1) 1)])))

      (js/call (js/new RegExp "^[0-9a-fA-F]{3,8}$") .test s)
      (parse-hex s)

      (get NAMED-COLORS lower)
      (let [rgb (get NAMED-COLORS lower)]
        [(aget rgb 0) (aget rgb 1) (aget rgb 2) 1])

      :else nil)))

(defn compute [(u Any)] Any
  (let [f (/ u 255)]
    (if (<= f 0.03928) (/ f 12.92) (Math/pow (/ (+ f 0.055) 1.055) 2.4))))

(defn decompute [(x Any)] Any
  (let [s (if (<= x (/ 0.03928 12.92))
            (* x 12.92)
            (- (* 1.055 (Math/pow x (/ 1 2.4))) 0.055))]
    (clamp (Math/round (* s 255)) 0 255)))

(defn flip-rgba [(rgba Any)] Any
  (let [r (aget rgba 0) g (aget rgba 1) b (aget rgba 2) a (aget rgba 3)
        lr (compute r) lg (compute g) lb (compute b)
        lum (+ (* 0.2126 lr) (* 0.7152 lg) (* 0.0722 lb))
        target (- 1 lum)
        factor (/ (+ target 0.05) (+ lum 0.05))
        adj (fn [(l Any)] Any (decompute (Math/max 0 (- (* (+ l 0.05) factor) 0.05))))]
    [(adj lr) (adj lg) (adj lb) a]))

(defn luminance [(rgba Any)] Any
  (+ (* 0.2126 (compute (aget rgba 0)))
     (* 0.7152 (compute (aget rgba 1)))
     (* 0.0722 (compute (aget rgba 2)))))

(defn byte->hex [(n Any)] String
  (js/call (js/call (clamp (Math/round n) 0 255) .toString 16) .padStart 2 "0"))

(defn rgba->css [(rgba Any)] String
  (let [r (aget rgba 0) g (aget rgba 1) b (aget rgba 2) a (aget rgba 3)]
    (if (>= a 1)
      (str "#" (byte->hex r) (byte->hex g) (byte->hex b))
      (str "rgba(" (clamp (Math/round r) 0 255) ", " (clamp (Math/round g) 0 255) ", "
           (clamp (Math/round b) 0 255) ", " (Number (js/call a .toFixed 3)) ")"))))

(defn resolve-token [(inner String)] Any
  (let [parsed (parse-color inner)]
    (when parsed (rgba->css (flip-rgba parsed)))))

;; ---------------------------------------------------------------------------
;; Dark Reader runtime theme variables → fixed dark palette (lossy; QA flag).
;; ---------------------------------------------------------------------------

(def DARKREADER-VARS Any
  {"--darkreader-neutral-background"   "#181a1b"
   "--darkreader-neutral-text"         "#e8e6e3"
   "--darkreader-neutral-color"        "#e8e6e3"
   "--darkreader-selection-background" "#0060df"
   "--darkreader-selection-text"       "#ffffff"})

;; ---------------------------------------------------------------------------
;; Snapshot parsing — full directive set (extends darkmode-registry's parser).
;; A block: 1+ URL-pattern lines, then named UPPERCASE sections. Blocks are
;; separated by a run of '='. The first block (url `*`) is the global default.
;; ---------------------------------------------------------------------------

(def SEPARATOR Any (js/new RegExp "^=+\\s*$" "m"))
(def SECTION-HEADER Any (js/new RegExp "^[A-Z][A-Z ]+$"))

;; The directive headers DR uses. A header-shaped line is only a new section if
;; it is one of these — so a stray uppercase CSS selector isn't misread.
(def KNOWN-SECTIONS Any
  ["INVERT" "CSS" "IGNORE INLINE STYLE" "IGNORE IMAGE ANALYSIS"
   "INVERT SIZE" "PLUS"])

(defn parse-snapshot! [(text String)] Any
  (let [blocks (js/call text .split SEPARATOR)
        out []]
    (doseq [block blocks]
      (let [lines (js/call (js/call block .trimEnd) .split "\n")
            patterns []
            sections {}
            cur-name (atom nil)
            cur-lines (atom [])
            flush! (fn [] Any (when @cur-name
                       (oset! sections @cur-name (js/call (js/call @cur-lines .join "\n") .trim)))
                     (reset! cur-lines []))]
        (doseq [line lines]
          (let [trimmed (js/call line .trim)]
            (cond
              (and (= trimmed "") (not @cur-name)) nil

              (and (js/call SECTION-HEADER .test trimmed) (js/call KNOWN-SECTIONS .includes trimmed))
              (do (flush!) (reset! cur-name trimmed))

              (and (not @cur-name) (not= trimmed ""))
              (js/call patterns .push trimmed)

              :else
              (js/call @cur-lines .push line))))
        (flush!)
        (when (> (js/get patterns .length) 0)
          (js/call out .push {:patterns patterns :sections sections}))))
    out))

;; ---------------------------------------------------------------------------
;; Host matching (identical semantics to darkmode-registry.bjs).
;; ---------------------------------------------------------------------------

(defn pattern-host [(pat String)] String
  (let [no-scheme (js/call pat .replace (js/new RegExp "^[a-z]+://") "")
        host (aget (js/call no-scheme .split "/") 0)]
    (js/call (js/call host .trim) .toLowerCase)))

(defn host-matches? [(pat String) (host String)] Any
  (let [p (pattern-host pat)
        h (js/call host .toLowerCase)]
    (cond
      (= p "*") false
      (= p h) true
      (js/call p .startsWith "*.")
      (let [base (js/call p .slice 2)]
        (or (= h base) (js/call h .endsWith (str "." base))))
      (js/call h .endsWith (str "." p)) true
      :else false)))

(defn find-block [(blocks Any) (host String)] Any
  (js/call blocks .find (fn [b] Any (js/call (js/get b .patterns) .some (fn [pat] Any (host-matches? pat host))))))

;; ---------------------------------------------------------------------------
;; CSS resolution: ${...} tokens + var(--darkreader-*) refs.
;; ---------------------------------------------------------------------------

(defn resolve-tokens [(css String) (unresolved Any)] String
  (js/call css .replace (js/new RegExp "\\$\\{([^}]*)\\}" "g") (fn [_match inner] Any (let [trimmed (js/call inner .trim)]
                (cond
                  (= (js/call trimmed .toLowerCase) "transparent") "transparent"
                  :else
                  (let [resolved (resolve-token trimmed)]
                    (if resolved resolved (do (js/call unresolved .push trimmed) trimmed))))))))

(defn resolve-dr-vars [(css String) (unmapped Any)] String
  (js/call css .replace (js/new RegExp "var\\(\\s*(--darkreader-[A-Za-z0-9_-]+)\\s*(?:,[^)]*)?\\)" "g") (fn [_match name] Any (let [v (get DARKREADER-VARS name)]
                (if v v (do (js/call unmapped .push name) "#181a1b"))))))

;; Constructs that must NEVER reach the generated USER_SHEET (fail closed).
(def FORBIDDEN-CSS Any
  (js/new RegExp "url\\s*\\(|@import\\b|expression\\s*\\(" "i"))

;; ---------------------------------------------------------------------------
;; Directive → schema-field projection.
;; ---------------------------------------------------------------------------

;; Split a selector-list directive body (INVERT / IGNORE * with explicit
;; selectors) into a vector of trimmed, non-empty selector lines. DR lists one
;; selector per line.
;; `body` is a parsed-map lookup that may be `undefined` (section absent), so it
;; is genuinely Any here — guard truthiness before touching String methods.
(defn selector-lines [(body Any)] Any
  (if (or (not body) (= (js/call body .trim) ""))
    []
    (js/call (js/call (js/call body .split "\n") .map (fn [s] Any (js/call s .trim))) .filter (fn [s] Any (> (js/get s .length) 0)))))

;; IGNORE * with a body of exactly `*` means "all elements" → emit boolean true.
;; A non-`*` body → emit the explicit selector list. Empty → nil (directive absent).
(defn ignore-field [(body Any)] Any
  (let [sels (selector-lines body)]
    (cond
      (= (js/get sels .length) 0) nil
      (and (= (js/get sels .length) 1) (= (aget sels 0) "*")) true
      :else sels)))

;; Resolve + compact a CSS section to a single line (matches existing entries'
;; style). Returns {:css ... :unresolved [...] :unmapped [...]} or {:rejected r}.
;; Resolve all ${...} tokens to a FIXPOINT. A few DR blocks NEST tokens, e.g.
;; `${${#15150d}}` — the inner-first regex peels one layer per pass, so re-run
;; until no `${` remains (bounded to `passes` to stop a pathological loop; DR never
;; nests deeper than 2). Returns {:css ... :unresolved [...]} where :unresolved is
;; ONLY the FINAL pass's leftovers (a transient inner-layer literal isn't reported).
;; Pure: builds a fresh unresolved list per pass and returns the last one.
(defn resolve-tokens-fixpoint [(css String) (passes Any)] Any
  (if (or (<= passes 0) (not (js/call css .includes "${")))
    {:css css :unresolved []}
    (let [u []
          next (resolve-tokens css u)]
      (if (or (= next css) (not (js/call next .includes "${")))
        {:css next :unresolved u}
        (resolve-tokens-fixpoint next (- passes 1))))))

(defn build-css [(css Any)] Any
  (if (or (not css) (= (js/call css .trim) ""))
    {:css "" :unresolved [] :unmapped []}
    (let [unmapped []
          fixed (resolve-tokens-fixpoint css 5)
          resolved (resolve-dr-vars (js/get fixed .css) unmapped)
          compact (js/call (js/call (js/call resolved .replace (js/new RegExp "\\s*\\n\\s*" "g") " ") .replace (js/new RegExp "  +" "g") " ") .trim)]
      (if (js/call FORBIDDEN-CSS .test compact)
        {:rejected "resolved CSS contains a forbidden construct (url()/@import/expression())"}
        {:css compact :unresolved (js/get fixed .unresolved) :unmapped unmapped}))))

;; Build the candidate gjoa entry from a matched DR block. DR's per-site CSS is a
;; set of CORRECTIONS layered on its own page inversion. gjoa is accept-native-FIRST,
;; so the faithful default is override:"auto": the actor MEASURES the painted page
;; (drawSnapshot median L*, the scorer signal) and only force-inverts when the site
;; isn't already dark — a DR fix just lowers the force threshold (it's a "this site's
;; dark is bad" signal), never a blanket force. A blanket "active" was WRONG: it
;; inverted good native-dark sites (github) back to light. A human flips to "inactive"
;; (always accept native) or "active" (always force, pre-paint) during eyeball.
;;
;; PERFORMANCE PRUNE — DR's `INVERT` directive marks logo/image elements for a
;; per-element `filter: invert(1) hue-rotate(180deg)` so they survive DR's page
;; inversion. gjoa's engine already luminance-inverts every computed color at the
;; style-resolution stage (the fast, cached path); the actor would re-emit those
;; same selectors as per-element COMPOSITOR filters (the slow path). At bulk scale
;; (~2.8k sites) that piles thousands of compositor-filter rules onto the registry
;; for marginal logo fidelity — exactly the low-performance trap. So bulk import
;; DROPS `invertSelectors` and keeps only the high-value, cheap parts: CSS color
;; corrections, the override mode, and the IGNORE-* content-pass flags. (Curated
;; entries that carry hand-reviewed invertSelectors are merged on top and win, so
;; nothing hand-tuned is lost.) `keep-invert?` lets the QA print path still inspect
;; the raw INVERT list without it ever reaching the written entry.
(defn build-entry! [(block Any) (keep-invert? Any)] Any
  (let [secs (js/get block .sections)
        css-built (build-css (get secs "CSS"))]
    (if (js/get css-built .rejected)
      {:rejected (js/get css-built .rejected)}
      (let [invert-sels (selector-lines (get secs "INVERT"))
            ign-inline (ignore-field (get secs "IGNORE INLINE STYLE"))
            ign-image (ignore-field (get secs "IGNORE IMAGE ANALYSIS"))
            has-css (> (js/get (js/get css-built .css) .length) 0)
            entry {:mode "css" :override "auto"}]
        ;; Provenance uses a STRING key so the emitted JSON key is exactly
        ;; "_provenance" (a keyword :_provenance munges the leading underscore).
        (oset! entry "_provenance" PROVENANCE)
        ;; Only attach non-empty fields so entries stay minimal + diffable.
        (when has-css
          (oset! entry "css" (js/get css-built .css)))
        ;; invertSelectors: PRUNED from the written entry (see perf note above).
        ;; Only re-attached for the human print/QA path via keep-invert?.
        (when (and keep-invert? (> (js/get invert-sels .length) 0))
          (oset! entry "invertSelectors" invert-sels))
        (when (not (nil? ign-inline))
          (oset! entry "ignoreInlineStyle" ign-inline))
        (when (not (nil? ign-image))
          (oset! entry "ignoreImageAnalysis" ign-image))
        {:entry entry
         ;; An entry is SUBSTANTIVE only if it carries a real correction after the
         ;; prune: CSS or an IGNORE-* flag. A block that was INVERT-only collapses to
         ;; bare {mode,override:"active"} — which is already the engine default — so
         ;; the bulk writer skips it (no benefit, just file size + a pref-map entry).
         :substantive (or has-css (not (nil? ign-inline)) (not (nil? ign-image)))
         :unresolved (js/get css-built .unresolved)
         :unmapped (js/get css-built .unmapped)
         :directives {:invert (> (js/get invert-sels .length) 0)
                      :css has-css
                      :ignoreInline (not (nil? ign-inline))
                      :ignoreImage (not (nil? ign-image))}}))))

;; ---------------------------------------------------------------------------
;; Self-test: flip invariants + the directive parser/projection.
;; ---------------------------------------------------------------------------

(defn selftest! [] Any
  (let [info (js/get log .info) ok (js/get log .ok) err (js/get log .error)
        failures (atom 0)
        check! (fn [(label String) (pass Any) (detail String)] Any (if pass
                   (ok (str label " — " detail))
                   (do (err (str label " FAILED — " detail)) (reset! failures (+ @failures 1)))))
        white (flip-rgba [255 255 255 1])
        black (flip-rgba [0 0 0 1])
        ;; a tiny synthetic block exercising every directive
        sample (str "*.example.com\n\nINVERT\n.logo\n.brand-mark\n\n"
                    "CSS\n.box {\n  background: ${#ffffff} !important;\n}\n\n"
                    "IGNORE INLINE STYLE\n.entry *\n\n"
                    "IGNORE IMAGE ANALYSIS\n*\n")
        blocks (parse-snapshot! sample)
        blk (find-block blocks "example.com")
        built (and blk (build-entry! blk true))
        e (and built (js/get built .entry))]
    (info "darkmode-fixes-transform self-test")
    (check! "white→dark" (< (luminance white) 0.22) (str "luminance " (js/call (luminance white) .toFixed 4)))
    (check! "black→light" (> (luminance black) 0.5) (str "luminance " (js/call (luminance black) .toFixed 4)))
    (check! "block matched" (not (nil? blk)) "example.com block found")
    (check! "INVERT → invertSelectors[2]"
            (and e (js/get e .invertSelectors) (= (js/get (js/get e .invertSelectors) .length) 2))
            (str "got " (js/call JSON .stringify (and e (js/get e .invertSelectors)))))
    (check! "CSS token resolved (no ${} left, no #ffffff)"
            (and e (js/get e .css) (not (js/call (js/get e .css) .includes "${")) (not (js/call (js/get e .css) .includes "#ffffff")))
            (str "css=" (and e (js/get e .css))))
    (check! "IGNORE INLINE STYLE (explicit) → [selectors]"
            (and e (js/call Array .isArray (js/get e .ignoreInlineStyle)) (= (js/get (js/get e .ignoreInlineStyle) .length) 1))
            (str "got " (js/call JSON .stringify (and e (js/get e .ignoreInlineStyle)))))
    (check! "IGNORE IMAGE ANALYSIS (*) → true"
            (and e (= (js/get e .ignoreImageAnalysis) true))
            (str "got " (js/call JSON .stringify (and e (js/get e .ignoreImageAnalysis)))))
    (check! "_provenance stamped"
            (and e (= (js/get e ._provenance) PROVENANCE))
            (str "got " (and e (js/get e ._provenance))))
    (if (> @failures 0)
      (do (err (str @failures " self-test assertion(s) failed")) 1)
      (do (ok "all self-test assertions passed") 0))))

;; ---------------------------------------------------------------------------
;; CLI
;; ---------------------------------------------------------------------------

(def USAGE String
  (js/call "
gjoa darkmode-fixes-transform — Dark Reader → gjoa curated entry generator (full directives)

Usage:
  bun .beagle-tools/gjoa/tools/prep/darkmode-fixes-transform.js <host> [host...]
  bun .beagle-tools/gjoa/tools/prep/darkmode-fixes-transform.js --selftest
  bun .beagle-tools/gjoa/tools/prep/darkmode-fixes-transform.js --write-all

Per-host: prints CANDIDATE darkmode-fixes.json entries (directives expanded, DR
tokens PRE-RESOLVED to fixed dark constants — LOSSY, eyeball before committing).

--write-all: BULK-imports the WHOLE pinned DR corpus into darkmode-fixes.json.
Each entry is PRUNED to the cheap, high-value parts (CSS color corrections, the
override mode, IGNORE-* flags); DR's per-element INVERT selectors are dropped
because gjoa's engine already inverts at style-resolution (re-emitting them as
per-element compositor filters is the low-performance trap). The existing curated
registry is AUTHORITATIVE — its keys are merged ON TOP and win over any bulk
counterpart. Output is minified (the actor lazy-loads + caches it once).
" .trim))

(defn read-snapshot! [] Any
  (when (not (existsSync SNAPSHOT-PATH))
    (let [err (js/get log .error)]
      (err (str "snapshot not found at " SNAPSHOT-PATH))
      (err (str "refresh (pinned): curl -sL https://raw.githubusercontent.com/darkreader/darkreader/"
                DARKREADER-PIN "/src/config/dynamic-theme-fixes.config -o tools/prep/darkreader-fixes.snapshot"))
      (js/call process .exit 1)))
  (readFileSync SNAPSHOT-PATH "utf8"))

(defn generate-for-host! [(blocks Any) (host String)] Any
  (let [block (find-block blocks host)]
    (if (not block)
      {:host host :missing true :reason "no matching DR block"}
      ;; print/QA path keeps invertSelectors visible so a human can eyeball what
      ;; the bulk import drops; the --write-all path prunes them.
      (let [built (build-entry! block true)]
        (cond
          (js/get built .rejected)
          {:host host :missing true :reason (js/get built .rejected)}
          :else
          {:host host :entry (js/get built .entry)
           :unresolved (js/get built .unresolved) :unmapped (js/get built .unmapped)
           :directives (js/get built .directives)
           :matched-by (js/call (js/get block .patterns) .join ", ")})))))

(defn print-result! [(r Any)] Any
  (let [warn (js/get log .warn) step (js/get log .step)]
    (if (js/get r .missing)
      (warn (str (js/get r .host) ": skipped — " (js/get r .reason)))
      (do
        (step (str (js/get r .host) "  (matched DR patterns: " (js/get r .matched-by) ")"))
        (let [d (js/get r .directives)]
          (js/call log .info (str "  directives: "
                          (js/call (js/call ["INVERT" "CSS" "IGNORE INLINE STYLE" "IGNORE IMAGE ANALYSIS"] .filter (fn [name] Any (cond
                                              (= name "INVERT") (js/get d .invert)
                                              (= name "CSS") (js/get d .css)
                                              (= name "IGNORE INLINE STYLE") (js/get d .ignoreInline)
                                              (= name "IGNORE IMAGE ANALYSIS") (js/get d .ignoreImage)
                                              :else false))) .join ", "))))
        (when (> (js/get (js/get r .unresolved) .length) 0)
          (warn (str "  ⚠ unresolved tokens left literal (QA): " (js/call (js/get r .unresolved) .join ", "))))
        (when (> (js/get (js/get r .unmapped) .length) 0)
          (warn (str "  ⚠ unmapped --darkreader vars → fixed dark palette (QA): " (js/call (js/get r .unmapped) .join ", "))))
        (console/log (js/call JSON .stringify {(js/get r .host) (js/get r .entry)} nil 2))))))

;; ---------------------------------------------------------------------------
;; Bulk import (--write-all): convert the WHOLE pinned DR corpus into pruned,
;; host-keyed entries and merge them UNDER the existing curated registry — every
;; hand-reviewed key wins over its bulk counterpart, so curation is never lost.
;; ---------------------------------------------------------------------------

;; Derive the registry host KEY(S) a DR block's URL patterns map to. A `*.foo.com`
;; glob keys as the bare apex `foo.com` (the actor's fixForHost walks parent
;; domains, so the apex key also covers every subdomain). A plain host keys as
;; itself. The global `*` block and any pattern that reduces to `*` / empty is
;; skipped. De-duped within a block.
(defn block-host-keys! [(block Any)] Any
  (let [seen {}
        keys []]
    (doseq [pat (js/get block .patterns)]
      (let [ph (pattern-host pat)
            key (if (js/call ph .startsWith "*.") (js/call ph .slice 2) ph)]
        (when (and (not= key "") (not= key "*") (not (js/call key .includes "*"))
                   (not (get seen key)))
          (oset! seen key true)
          (js/call keys .push key))))
    keys))

;; Build the full host -> pruned-entry map from every block in the corpus. Keys
;; that several blocks fight over keep the FIRST substantive entry (DR orders the
;; corpus most-specific-first within a domain family). INVERT-only blocks (which
;; collapse to the engine default after the prune) contribute nothing.
(defn build-all! [(blocks Any)] Any
  (let [out {}
        ;; Hyphen-free keys: the beagle/js keyword `:skipped-empty` would munge to
        ;; `skipped_empty` on read while `oset!`/`get` use the literal string —
        ;; mismatched keys silently zero the counter. Plain camelCase keeps the
        ;; keyword-accessor (`.-skippedEmpty`) and the string key identical.
        stats {:blocks (js/get blocks .length) :written 0 :skippedEmpty 0 :rejected 0}]
    (doseq [block blocks]
      (let [built (build-entry! block false)] ;; false = prune invertSelectors
        (cond
          (js/get built .rejected)
          (oset! stats "rejected" (+ (js/get stats .rejected) 1))
          (not (js/get built .substantive))
          (oset! stats "skippedEmpty" (+ (js/get stats .skippedEmpty) 1))
          :else
          (doseq [key (block-host-keys! block)]
            (when (not (get out key))
              (oset! out key (js/get built .entry))
              (oset! stats "written" (+ (js/get stats .written) 1)))))))
    {:fixes out :stats stats}))

(defn write-all! [] Any
  (let [info (js/get log .info) ok (js/get log .ok) warn (js/get log .warn) err (js/get log .error)
        snapshot (read-snapshot!)]
    ;; Pin gate — refuse to write generated CSS unless the on-disk snapshot matches
    ;; the SHA-256 recorded at DARKREADER-PIN (tampered / silently-refreshed corpus
    ;; is rejected before any USER_SHEET CSS is produced).
    (let [actual (sha256 snapshot)]
      (when (not= actual EXPECTED-SNAPSHOT-SHA256)
        (err (str "snapshot SHA-256 does not match the pinned hash for Dark Reader " DARKREADER-PIN ".\n"
                  "  expected: " EXPECTED-SNAPSHOT-SHA256 "\n"
                  "  got:      " actual "\n"
                  "  --write-all refused. Re-pin deliberately, then update EXPECTED-SNAPSHOT-SHA256."))
        (js/call process .exit 1)))
    (let [blocks (parse-snapshot! snapshot)
          built (build-all! blocks)
          bulk (js/get built .fixes)
          st (js/get built .stats)
          ;; Curated registry is AUTHORITATIVE — load it last and let its keys win.
          curated (if (existsSync REGISTRY-PATH)
                    (js/call JSON .parse (readFileSync REGISTRY-PATH "utf8"))
                    {})
          merged {}
          curated-keys (Object/keys curated)
          bulk-keys (Object/keys bulk)
          overlap (atom 0)]
      ;; 1. lay down every bulk entry, then 2. overwrite with curated (curated wins).
      (doseq [k bulk-keys] (oset! merged k (get bulk k)))
      (doseq [k curated-keys]
        (when (get bulk k) (reset! overlap (+ @overlap 1)))
        (oset! merged k (get curated k)))
      (let [merged-keys (Object/keys merged)
            ;; minified single-line JSON — the file is lazy-loaded + cached by the
            ;; actor, so on-disk compactness is pure win (smaller fetch + parse).
            json (js/call JSON .stringify merged)]
        (writeFileSync REGISTRY-PATH (str json "\n"))
        (info "darkmode bulk import (Dark Reader → gjoa, pruned)")
        (info (str "  blocks parsed:        " (js/get st .blocks)))
        (info (str "  bulk entries written: " (js/get st .written)))
        (info (str "  skipped (INVERT-only / no correction after prune): " (js/get st .skippedEmpty)))
        (info (str "  rejected (forbidden CSS): " (js/get st .rejected)))
        (info (str "  curated entries kept (authoritative): " (js/get curated-keys .length)))
        (info (str "  curated∩bulk (curated won): " @overlap))
        (ok (str "wrote " (js/get merged-keys .length) " total entries → "
                 "src/gjoa/toolkit/components/content-classifier/darkmode-fixes.json "
                 "(" (Math/round (/ (js/get json .length) 1024)) " KB, minified)"))
        0))))

(defn main! [] Any
  (let [argv (js/call (js/get process .argv) .slice 2)
        selftest? (js/call argv .includes "--selftest")
        write-all? (js/call argv .includes "--write-all")
        hosts (js/call argv .filter (fn [a] Any (not (js/call a .startsWith "--"))))]
    (cond
      selftest? (js/call process .exit (selftest!))
      write-all? (js/call process .exit (write-all!))
      (= (js/get hosts .length) 0) (do (console/log USAGE) (js/call process .exit 0))
      :else
      (let [snapshot (read-snapshot!)
            blocks (parse-snapshot! snapshot)
            results (js/call hosts .map (fn [h] Any (generate-for-host! blocks h)))]
        (doseq [r results] (print-result! r))
        (let [warn (js/get log .warn)]
          (warn "candidates only — DR tokens PRE-RESOLVED (lossy). Eyeball + visual QA before merging into darkmode-fixes.json."))
        0))))

(main!)
