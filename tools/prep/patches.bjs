#lang beagle/js
;; Apply *.patch files from patches/ in alphabetical order. Idempotency:
;; engine/ has its own .git initialized inside it (see ensureEngineGit), and
;; we record applied patches in engine/.gjoa-applied-patches so re-runs skip.
;;
;; Each record is `<name>\t<sha256-of-patch-file>`. A patch is skipped ONLY when
;; its name is recorded AND the recorded hash matches the patch file's current
;; hash. A CHANGED patch (same name, new content) hashes differently, so it is
;; re-applied instead of silently skipped.
;;
;; We use git apply rather than git am because mozilla-central's tree isn't
;; commit-aware in the way we'd need — we just want a plain patch application.
(ns gjoa.tools.prep.patches
  (:require [fs :refer [existsSync readdirSync]]
            [path :refer [join]]
            [gjoa.tools.prep.paths :refer [ENGINE-DIR PATCHES-DIR]]
            [gjoa.tools.prep.patch-header :refer [check-all]]
            [gjoa.tools.prep.log :refer [log]]))
(declare-extern [Bun process Error] Any)

(def APPLIED-LOG String ".gjoa-applied-patches")

;; Hex SHA-256 of a patch file's bytes (Bun runtime — same hasher download.bjs
;; uses). This is the identity we record/compare so a changed patch (same name,
;; new content) is detected and re-applied instead of silently skipped.
(defn sha256OfFile [path String] Any
  (let [file Any (js/call Bun .file path)
        buf Any (js/await (js/call file .arrayBuffer))
        hash Any (js/new Bun.CryptoHasher "sha256")]
    (js/call hash .update buf)
    (js/call hash .digest "hex")))

;; Run a command in `cwd`, inheriting stdio. Returns the exit code.
(defn run-git
  [args Any
   cwd String] Any
  (let [proc Any (js/call Bun .spawn {:cmd args
                          :cwd cwd
                          :stdout "inherit"
                          :stderr "inherit"})]
    (js/await (js/get proc .exited))))

(defn ensureEngineGit [] Any
  (if (existsSync (join ENGINE-DIR ".git"))
    nil
    ;; mach detects .git/ and queries it for build metadata. If we don't init it,
    ;; mach falls back, but having the repo lets us use git apply cleanly.
    (do
      (js/await (run-git ["git" "init" "-q"] ENGINE-DIR))
      (js/await (run-git ["git" "add" "-A"] ENGINE-DIR))
      (js/await (run-git ["git" "-c" "user.email=prep@gjoa" "-c" "user.name=prep"
                          "commit" "-q" "-m" "vanilla mozilla-central"] ENGINE-DIR)))))

;; Read the applied-patches log into a Map of name -> recorded-hash.
(defn readApplied [] Any
  (let [path Any (join ENGINE-DIR APPLIED-LOG)
        applied (JsMap String String) (js/new Map)]
    (if (not (existsSync path))
      applied
      (let [text Any (js/await (js/call (js/call Bun .file path) .text))
            lines Any (js/call (js/call text .split "\n") .filter (fn [s String] Any (js/get (js/call s .trim) .length)))]
        (js/call lines .forEach (fn [line String] Any (let [m Any (js/call line .match (js/new RegExp "^([^\\t]+)\\t([0-9a-f]{64})$"))]
              (when (not m)
                (throw (js/new Error (str "invalid " APPLIED-LOG " record: " line))))
              (js/call applied .set (js/call (aget m 1) .trim) (aget m 2)))))
        applied))))

;; Persist the applied-patches log from a Map of name -> hash, sorted by name,
;; one `<name>\t<hash>` line each.
(defn recordApplied [applied Any] Any
  (let [path Any (join ENGINE-DIR APPLIED-LOG)
        names Any (js/call (js/call Array .from (js/call applied .keys)) .sort)
        body Any (js/call (js/call names .map (fn [n String] Any (str n "\t" (js/call applied .get n)))) .join "\n")]
    (js/await (js/call Bun .write path (str body "\n")))))

;; Patch-header lint. Non-fatal — we always apply patches regardless, but a
;; missing header surfaces immediately so future maintainers (read: the user,
;; post-Firefox-bump) get a clear signal that the 3-way-merge metadata is
;; incomplete.
(defn runLint [] Any
  (try
    (let [problems Any (js/await (check-all))]
      (when (> problems 0)
        (js/call log .warn (str problems " patch(es) missing the gjoa-patch header"))))
    (catch (e Error)
      (js/call log .warn (str "patch-header lint failed (non-fatal): " (js/get e .message))))))

;; Apply a single patch by name. Throws (with the patch name) on failure so
;; the caller surfaces exactly which patch broke.
;;
;; FALLBACK: if `git apply` fails AND a sibling claim-doc artifact exists
;; (patches/<name>.claims.json), replay it via the JS projector. The claim-doc is
;; anchored to (class, method) identity, so it survives upstream reflow that `.rej`s
;; the line-anchored textual patch. `git apply` is atomic, so on failure the tree is
;; untouched and the replay runs on pristine source.
(defn applyOne [name String] Any
  (js/call log .step (str "applying patch " name))
  (let [path Any (join PATCHES-DIR name)
        code Any (js/await (run-git ["git" "apply" "--whitespace=nowarn" path] ENGINE-DIR))]
    (when (not= code 0)
      (let [claims-path Any (join PATCHES-DIR (js/call name .replace ".patch" ".claims.json"))]
        (if (existsSync claims-path)
          (let [repo Any (js/call process .cwd)
                applier Any (join repo ".beagle-tools" "gjoa" "tools" "projector" "apply-claims.js")
                rc Any (js/await (run-git ["bun" applier claims-path ENGINE-DIR] repo))]
            (if (= rc 0)
              (js/call log .ok (str "  " name ": textual patch .rej'd — recovered via claim-doc replay (identity-anchored)"))
              (throw (js/new Error (str "failed to apply patch " name ": git apply exited " code
                                  "; claim-doc fallback exited " rc)))))
          (throw (js/new Error (str "failed to apply patch " name ": git apply exited " code))))))))

(js/export (defn patches [] Any
  (if (not (existsSync PATCHES-DIR))
    (do
      (js/call log .info "no patches/ directory, skipping")
      nil)
    (let [allPatches Any (js/call (js/call (readdirSync PATCHES-DIR) .filter (fn [f String] Any (js/call f .endsWith ".patch"))) .sort)]
      (if (= (js/get allPatches .length) 0)
        (do
          (js/call log .info "patches/ is empty, skipping")
          nil)
        (do
          (js/await (runLint))
          (js/await (ensureEngineGit))
          (let [applied Any (js/await (readApplied))]
            (loop [i Int 0
                   newCount Int
                   0]
              (if (>= i (js/get allPatches .length))
                ;; Done iterating — report + persist.
                (if (= newCount 0)
                  (js/call log .info (str "all " (js/get allPatches .length) " patches already applied"))
                  (do
                    (js/await (recordApplied applied))
                    (js/call log .ok (str "applied " newCount " new patch" (if (= newCount 1) "" "es")))))
                (let [name Any (aget allPatches i)]
                  (let [curHash Any (js/await (sha256OfFile (join PATCHES-DIR name)))
                        recordedHash Any (js/call applied .get name)]
                    ;; Skip only when the name and current content hash match.
                    (if (and (js/call applied .has name) (= recordedHash curHash))
                      (recur (+ i 1) newCount)
                      (do
                        (when (and (js/call applied .has name) (not= recordedHash curHash))
                          (js/call log .step (str "patch " name " changed since last apply — re-applying")))
                        (js/await (applyOne name))
                        (js/call applied .set name curHash)
                        (recur (+ i 1) (+ newCount 1)))))))))))))))
