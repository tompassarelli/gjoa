#lang beagle/js
(ns gjoa.tools.prep.cli
  (:require [fs :refer [existsSync]]
            [fs/promises :refer [rm]]
            [gjoa.tools.prep.download :refer [download!]]
            [gjoa.tools.prep.import :refer [import-sources!]]
            [gjoa.tools.prep.paths :refer [ENGINE-DIR]]
            [gjoa.tools.prep.log :refer [log]]
            [gjoa.tools.security.check :refer [check!]]))
(declare-extern [process String] Any)

(def USAGE String
  (js/call "
gjoa prep — Firefox source preparation pipeline

Commands:
  download    Fetch + verify + extract mozilla-central into engine/
  import      Apply src/gjoa/ overlays, patches/, and branding to engine/
  clean       Remove engine/ (forces fresh download next time)
  help        Show this message

Cold start: `bun run init` (= download + import).
After editing src/gjoa/ or gjoa.json: `bun run import`.
" .trim))

;; Print a loud, structured security banner above any build phase. We
;; deliberately make this hard to ignore — it's the highest-leverage
;; intervention preventing "I'll update later" drift. The banner is
;; fail-OPEN if the network probe can't run (e.g. offline) so it
;; never blocks legitimate work; it does ALWAYS produce output.
(defn printSecurityBanner! [] Any
  (let [(r Any) (try
                   (js/await (check!))
                   (catch (e Error)
                     (let [warn (js/get log .warn)]
                       (warn (str "[security] check threw: " (js/get e .message) " — proceeding without status")))
                     nil))]
    (cond
      (not r)
      nil

      (= (js/get r .status) "OK")
      (let [ok (js/get log .ok)]
        (ok (str "[security] " (js/get r .summary))))

      :else
      (let [bar (js/call "═" .repeat 72)
            header (cond
                     (= (js/get r .status) "CRITICAL") "🛑 SECURITY: CRITICAL"
                     (= (js/get r .status) "STALE")    "⚠  SECURITY: STALE"
                     :else                        "?  SECURITY: UNKNOWN")]
        (console/error "")
        (console/error (str "[33m" bar "[0m"))
        (console/error (str "[1;33m" header "[0m  — " (js/get r .summary)))
        (console/error (str "[33m" bar "[0m"))
        (console/error (js/get r .detail))
        (console/error (str "[33m" bar "[0m"))
        (cond
          (= (js/get r .status) "CRITICAL")
          (do
            (console/error (str "[1;31mAction: bump and rebuild within 24 hours. Run:  bun run security:bump[0m"))
            (console/error (str "[33m" bar "[0m")))

          (= (js/get r .status) "STALE")
          (do
            (console/error (str "Action: bump within the SLA in docs/security-policy.md. Run:  bun run security:bump"))
            (console/error (str "[33m" bar "[0m"))))
        (console/error "")))))

(defn main! [] Any
  (let [cmd (aget (js/get process .argv) 2)]
    (cond
      (= cmd "download")
      (do
        (js/await (printSecurityBanner!))
        (js/await (download!)))

      (= cmd "import")
      (do
        (when (not (existsSync ENGINE-DIR))
          (let [err (js/get log .error)]
            (err "engine/ does not exist — run `bun run download` first"))
          (js/call process .exit 1))
        (js/await (printSecurityBanner!))
        (js/await (import-sources!)))

      (= cmd "clean")
      (if (existsSync ENGINE-DIR)
        (let [step (js/get log .step)
              ok (js/get log .ok)]
          (step "removing engine/")
          (js/await (rm ENGINE-DIR {:recursive true}))
          (ok "engine/ removed"))
        (let [info (js/get log .info)]
          (info "engine/ already absent")))

      (or (= cmd "help") (= cmd "--help") (= cmd "-h"))
      (console/log USAGE)

      :else
      (do
        (console/error USAGE)
        (when cmd
          (let [err (js/get log .error)]
            (err (str "unknown command: " cmd))))
        (js/call process .exit (if cmd 1 0))))))

(js/call (main!) .catch
  (fn [err] Any
    (let [err-fn (js/get log .error)]
      (err-fn (or (js/get err .message) (String err))))
    (when (js/get (js/get process .env) .DEBUG)
      (console/error (js/get err .stack)))
    (js/call process .exit 1)))
