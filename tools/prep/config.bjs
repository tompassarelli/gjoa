#lang beagle/js
(ns gjoa.tools.prep.config
  (:require [fs :refer [readFileSync]]
            [path :refer [join]]
            [gjoa.tools.prep.paths :refer [REPO-ROOT]]))
(declare-extern undefined Any)

;; GjoaConfig shape (was a TS interface; carried as documentation here):
;;   name             "Gjoa"
;;   binaryName       "gjoa"
;;   appId            "gjoa"
;;   vendor           "tompassarelli"
;;   displayVersion   "0.1.0"
;;   license          "MPL-2.0"
;;   github           "tompassarelli/gjoa"
;;   firefox          { version candidate candidateBuild }
;;   branding         { shortName shorterName fullName productName vendorName
;;                      backgroundColor displayName }
;;   urls             { homepageOverride welcome welcomeAdditional updateManual
;;                      updateDetails releaseNotes releaseNotesAboutDialog
;;                      releaseNotesPrompt updateHostname }

;; Module-private cache. An atom (not a bare def) because top-level defs emit
;; `const` in JS; the original `let cached` mutation becomes atom reset!/deref.
(def cached Any (atom nil))

(js/export (defn load-config! [] Any
  (if (deref cached)
    (deref cached)
    (let [path Any (join REPO-ROOT "gjoa.json")
          raw Any (readFileSync path "utf8")
          parsed Any (js/call JSON .parse raw)]
      (validate parsed)
      (reset! cached parsed)
      parsed))))

(defn validate [c Any] Any
  (let [required (Vec String) ["name" "binaryName" "appId" "vendor" "displayVersion"
                  "license" "github" "firefox" "branding" "urls"]]
    (doseq [k String required]
      (if (= (get c k) undefined)
        (throw (js/new Error (str "gjoa.json missing required field: " k)))))
    (if (not (js/get (js/get c .firefox) .version))
      (throw (js/new Error "gjoa.json: firefox.version is required")))
    ;; firefox.version is interpolated into URLs and (via conflict-forecast) a git
    ;; shell-out — constrain it to a plain version so every consumer inherits the
    ;; guarantee (the trust-anchor systemic fix for the network-fetched bump value).
    (if (not (js/call (js/get (js/get c .firefox) .version) .match (js/new RegExp "^[0-9]+(\\.[0-9]+){1,3}(esr)?$")))
      (throw (js/new Error (str "gjoa.json: firefox.version \"" (js/get (js/get c .firefox) .version) "\" is not a valid Firefox version"))))
    (if (not (js/call (js/get c .binaryName) .match (js/new RegExp "^[a-z0-9-]+$")))
      (throw (js/new Error (str "gjoa.json: binaryName \"" (js/get c .binaryName) "\" must be lowercase alphanumeric+hyphen"))))))
