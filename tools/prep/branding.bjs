#lang beagle/js
;; Generate engine/browser/branding/<binaryName>/ from mozilla's "unofficial"
;; branding template: string-substitute brand text into recognized patterns,
;; overlay gjoa icons + content, append gjoa default prefs, and assert no
;; zen-browser.app substring leaked through.
(ns gjoa.tools.prep.branding
  (:require [fs :refer [existsSync readdirSync statSync mkdirSync readFileSync rmSync writeFileSync]]
            [path :refer [dirname extname join relative resolve]]
            [gjoa.tools.prep.config :refer [load-config!]]
            [gjoa.tools.prep.paths :refer [BRANDING-SRC
                                           ENGINE-BRANDING-DIR
                                           ENGINE-UNOFFICIAL-BRANDING
                                           REPO-ROOT
                                           SRC-DIR]]
            [gjoa.tools.prep.log :refer [log]]))
(declare-extern [Bun process] Any)

;; beagle-build compiles the pref .bjs sources to pref() JS at import time (same
;; resolution as tools/build-tools.bjs). The pref files are the one source-tree
;; artifact that must reach the engine as emitted JS rather than running under Bun.
;; It's a bash script (no Windows shebang support) — launched via `bash` at the
;; :cmd site; forward-slash the path for bash on Windows. (String/fromCharCode 92)
;; is a backslash; no-op on *nix.
(def BEAGLE-REF-FILE String (join REPO-ROOT "configs" "beagle.ref"))
(def BEAGLE-REF String
  (let [lines String (js/call (readFileSync BEAGLE-REF-FILE "utf8") .split "\n")
        ref Any
        (js/call lines .find (fn [l String] Bool
                           (and (> (js/get (js/call l .trim) .length) 0)
                                (not (js/call (js/call l .trim) .startsWith "#")))))]
    (if ref
      (js/call ref .trim)
      (throw (js/new Error "configs/beagle.ref has no Beagle object ID")))))
(def BEAGLE-PIN-ROOT String
  (or (js/get (js/get process .env) .BEAGLE_PIN_ROOT)
      (resolve (js/get (js/get process .env) .HOME) "code" "beagle" "pins" BEAGLE-REF)))
(def BEAGLE-BUILD String
  (js/call (resolve BEAGLE-PIN-ROOT "bin" "beagle-build") .replaceAll (js/call String .fromCharCode 92) "/"))

;; Files we string-substitute. Anything else (binary icons, archive formats,
;; platform-specific blobs) is copied as-is from the unofficial template.
(def TEXT-EXTS Any
  (js/new Set [".js" ".dtd" ".ftl" ".properties" ".sh" ".nsi"
         ".xml" ".css" ".json" ".mn" ".svg" ".html"]))
(def TEXT-FILENAMES Any
  (js/new Set ["moz.build" "configure.sh" "branding.nsi" "jar.mn" "jar.inc.mn"]))

(defn is-text-file [path String] Any
  (let [base Any (or (js/call (js/call path .split "/") .pop) "")]
    (if (js/call TEXT-FILENAMES .has base)
      true
      (js/call TEXT-EXTS .has (js/call (extname path) .toLowerCase)))))

;; Substitution map. Each pattern is INTENTIONALLY narrow — never substitute
;; bare "Mozilla" or "Firefox" as that breaks MPL headers ("Mozilla Public
;; License"), URLs (mozilla.org/MPL/2.0), file paths (firefox-branding.js),
;; and generic comments. Only swap brand strings inside specific structured
;; patterns we recognize.
(defn substitutions [cfg Any] Any
  (let [b Any (js/get cfg .branding)
        u Any (js/get cfg .urls)]
    [
     ;; ---- brand.ftl entries (Fluent localization format) ----
     [(js/new RegExp "^-brand-shorter-name\\s*=.*$" "m") (str "-brand-shorter-name = " (js/get b .shorterName))]
     [(js/new RegExp "^-brand-short-name\\s*=.*$" "m") (str "-brand-short-name = " (js/get b .shortName))]
     [(js/new RegExp "^-brand-shortcut-name\\s*=.*$" "m") (str "-brand-shortcut-name = " (js/get b .shortName))]
     [(js/new RegExp "^-brand-full-name\\s*=.*$" "m") (str "-brand-full-name = " (js/get b .fullName))]
     [(js/new RegExp "^-brand-product-name\\s*=.*$" "m") (str "-brand-product-name = " (js/get b .productName))]
     [(js/new RegExp "^-vendor-short-name\\s*=.*$" "m") (str "-vendor-short-name = " (js/get b .vendorName))]

     ;; ---- brand.dtd entries (XML entity format) ----
     [(js/new RegExp "<!ENTITY brandShorterName \".*?\">" "g") (str "<!ENTITY brandShorterName \"" (js/get b .shorterName) "\">")]
     [(js/new RegExp "<!ENTITY brandShortName \".*?\">" "g") (str "<!ENTITY brandShortName \"" (js/get b .shortName) "\">")]
     [(js/new RegExp "<!ENTITY brandShortcutName \".*?\">" "g") (str "<!ENTITY brandShortcutName \"" (js/get b .shortName) "\">")]
     [(js/new RegExp "<!ENTITY brandFullName \".*?\">" "g") (str "<!ENTITY brandFullName \"" (js/get b .fullName) "\">")]
     [(js/new RegExp "<!ENTITY brandProductName \".*?\">" "g") (str "<!ENTITY brandProductName \"" (js/get b .productName) "\">")]
     [(js/new RegExp "<!ENTITY vendorShortName \".*?\">" "g") (str "<!ENTITY vendorShortName \"" (js/get b .vendorName) "\">")]

     ;; ---- brand.properties entries (key=value format) ----
     [(js/new RegExp "^brandShorterName\\s*=.*$" "m") (str "brandShorterName=" (js/get b .shorterName))]
     [(js/new RegExp "^brandShortName\\s*=.*$" "m") (str "brandShortName=" (js/get b .shortName))]
     [(js/new RegExp "^brandShortcutName\\s*=.*$" "m") (str "brandShortcutName=" (js/get b .shortName))]
     [(js/new RegExp "^brandFullName\\s*=.*$" "m") (str "brandFullName=" (js/get b .fullName))]
     [(js/new RegExp "^brandProductName\\s*=.*$" "m") (str "brandProductName=" (js/get b .productName))]
     [(js/new RegExp "^vendorShortName\\s*=.*$" "m") (str "vendorShortName=" (js/get b .vendorName))]

     ;; ---- firefox-branding.js prefs ----
     ;; Welcome/whatsnew URLs (the ones that opened "Welcome to Zen!" pre-fix).
     [(js/new RegExp "pref\\(\"startup\\.homepage_override_url\",\\s*\".*?\"\\);")
      (str "pref(\"startup.homepage_override_url\", \"" (js/get u .homepageOverride) "\");")]
     [(js/new RegExp "pref\\(\"startup\\.homepage_welcome_url\",\\s*\".*?\"\\);")
      (str "pref(\"startup.homepage_welcome_url\", \"" (js/get u .welcome) "\");")]
     [(js/new RegExp "pref\\(\"startup\\.homepage_welcome_url\\.additional\",\\s*\".*?\"\\);")
      (str "pref(\"startup.homepage_welcome_url.additional\", \"" (js/get u .welcomeAdditional) "\");")]
     ;; Update + release-notes URLs. Catches both nightly.mozilla.org and
     ;; www.mozilla.org/firefox/* upstream templates.
     [(js/new RegExp "pref\\(\"app\\.update\\.url\\.manual\",\\s*\".*?\"\\);")
      (str "pref(\"app.update.url.manual\", \"" (js/get u .updateManual) "\");")]
     [(js/new RegExp "pref\\(\"app\\.update\\.url\\.details\",\\s*\".*?\"\\);")
      (str "pref(\"app.update.url.details\", \"" (js/get u .updateDetails) "\");")]
     [(js/new RegExp "pref\\(\"app\\.releaseNotesURL\",\\s*\".*?\"\\);")
      (str "pref(\"app.releaseNotesURL\", \"" (js/get u .releaseNotes) "\");")]
     [(js/new RegExp "pref\\(\"app\\.releaseNotesURL\\.aboutDialog\",\\s*\".*?\"\\);")
      (str "pref(\"app.releaseNotesURL.aboutDialog\", \"" (js/get u .releaseNotesAboutDialog) "\");")]
     [(js/new RegExp "pref\\(\"app\\.releaseNotesURL\\.prompt\",\\s*\".*?\"\\);")
      (str "pref(\"app.releaseNotesURL.prompt\", \"" (js/get u .releaseNotesPrompt) "\");")]

     ;; ---- configure.sh ----
     [(js/new RegExp "^MOZ_APP_DISPLAYNAME=.*$" "m")
      (str "MOZ_APP_DISPLAYNAME=" (js/get b .displayName))]

     ;; ---- branding.nsi (Windows NSIS installer defines) ----
     [(js/new RegExp "^!define BrandShortName \".*?\"$" "m")
      (str "!define BrandShortName \"" (js/get b .shortName) "\"")]
     [(js/new RegExp "^!define BrandFullName \".*?\"$" "m")
      (str "!define BrandFullName \"" (js/get b .fullName) "\"")]
     [(js/new RegExp "^!define BrandFullNameInternal \".*?\"$" "m")
      (str "!define BrandFullNameInternal \"" (js/get b .fullName) "\"")]
     [(js/new RegExp "^!define CompanyName \".*?\"$" "m")
      (str "!define CompanyName \"" (js/get b .vendorName) "\"")]]))

(defn apply-substitutions!
  [text String
   cfg Any] String
  (let [out (Atom String) (atom text)]
    (doseq [pair Any (substitutions cfg)]
      (let [re Any (nth pair 0)
            replacement Any (nth pair 1)]
        (reset! out (js/call @out .replace re replacement))))
    @out))

(defn walk-files [root String] Any
  (let [out (Vec Any) []]
    (letfn [(recurse [dir String] Any
              (doseq [name String (readdirSync dir)]
                (let [path Any (join dir name)]
                  (if (js/call (statSync path) .isDirectory)
                    (recurse path)
                    (js/call out .push path)))))]
      (recurse root))
    out))

;; Copy mozilla's unofficial branding tree to engine/browser/branding/<binaryName>/,
;; applying string substitutions to text files and overwriting our PNG icons.
(js/export (defn branding! [] Any
  (let [cfg Any (load-config!)
        target Any (join ENGINE-BRANDING-DIR (js/get cfg .binaryName))]

    (when (not (existsSync ENGINE-UNOFFICIAL-BRANDING))
      (throw (js/new Error (str "unofficial branding not found at " ENGINE-UNOFFICIAL-BRANDING " — "
                          "did you run `bun run download` first?"))))

    (js/call log .step (str "generating branding tree at engine/browser/branding/" (js/get cfg .binaryName) "/"))
    (when (existsSync target) (rmSync target {:recursive true}))
    (mkdirSync target {:recursive true})

    ;; 1. Walk mozilla's unofficial tree and copy each file, with substitution
    ;;    on text files.
    (let [all-files Any (walk-files ENGINE-UNOFFICIAL-BRANDING)
          text-count (Atom Int) (atom 0)
          binary-count (Atom Int) (atom 0)]
      (doseq [src String all-files]
        (let [rel Any (relative ENGINE-UNOFFICIAL-BRANDING src)
              dst Any (join target rel)]
          (mkdirSync (dirname dst) {:recursive true})
          (if (is-text-file src)
            (let [text Any (readFileSync src "utf8")]
              (writeFileSync dst (apply-substitutions! text cfg))
              (reset! text-count (+ @text-count 1)))
            ;; Binary copy — preserves icon bytes etc.
            (do
              (js/call Bun .spawnSync ["cp" src dst])
              (reset! binary-count (+ @binary-count 1))))))
      (js/call log .info (str "copied " @text-count " text + " @binary-count " binary files from unofficial template")))

    ;; 1b. Append gjoa's default prefs onto the branding pref file. firefox-branding.js
    ;;     is the ONE default-pref file this repo can ship without patching Mozilla
    ;;     source: it's already declared in branding-common.mozbuild via
    ;;     JS_PREFERENCE_FILES and enumerated in package-manifest.in, so it lands in
    ;;     omni.ja under defaults/pref/ and is read onto the default branch at startup.
    ;;     (The same source files also overlay to engine/defaults/pref/ via the generic
    ;;     overlay, but THAT path has no moz.build and is never packaged — this append
    ;;     is what actually makes the prefs take effect; unreferenced files in the
    ;;     objdir are dropped by mozpack.)
    ;;     Appended AFTER substitutions so pref values pass through verbatim.
    (let [branding-pref-file Any (join target "pref" "firefox-branding.js")]
      (when (not (existsSync branding-pref-file))
        (throw (js/new Error (str "branding pref file missing at " branding-pref-file " — Mozilla's unofficial "
                            "template no longer ships pref/firefox-branding.js, so gjoa default prefs "
                            "would not be packaged. Register a pref file explicitly before relying on this."))))
      (let [gjoa-pref-files (Vec String) ["perf-prefs" "dark-mode-prefs" "adblock-prefs" "genai-prefs" "layout-prefs" "theme-prefs"]
            tmp-dir Any (join REPO-ROOT ".beagle-tools" ".pref-build")
            _ Any (mkdirSync tmp-dir {:recursive true})
            pref-blocks (Atom String) (atom "\n\n// ===== gjoa default prefs (appended by tools/prep/branding.bjs) =====\n")]
        (doseq [name String gjoa-pref-files]
          (let [src Any (join SRC-DIR "defaults" "pref" (str name ".bjs"))
                out Any (join tmp-dir (str name ".js"))]
            (when (not (existsSync src)) (throw (js/new Error (str "gjoa pref source missing: " src))))
            ;; Compile the pref .bjs → pref() JS. Sync spawn keeps this in the
            ;; (now sync) branding pipeline; a nonzero exit is fatal so a broken
            ;; pref source can't silently ship empty defaults.
            (let [proc Any (js/call Bun .spawnSync {:cmd ["bash" BEAGLE-BUILD src out]
                                        :cwd REPO-ROOT
                                        :stdout "pipe"
                                        :stderr "pipe"})]
              (when (not= (js/get proc .exitCode) 0)
                (throw (js/new Error (str "beagle-build failed compiling pref source " src ":\n"
                                    (js/call (js/get proc .stderr) .toString))))))
            (let [contents Any (readFileSync out "utf8")]
              (reset! pref-blocks (str @pref-blocks "\n// ---- " name ".bjs ----\n" (js/call contents .trimEnd) "\n")))))
        (let [existing Any (readFileSync branding-pref-file "utf8")]
          (writeFileSync branding-pref-file (str existing @pref-blocks)))
        (js/call log .info (str "compiled + appended " (js/get gjoa-pref-files .length) " gjoa pref files to branding/" (js/get cfg .binaryName) "/pref/firefox-branding.js"))))

    ;; 1c. UA COMPAT: present as Firefox in the User-Agent so sites that sniff for a
    ;;     known engine (bloomberg, etc.) don't flag gjoa as out-of-date. The UA
    ;;     product token would otherwise read "Gjoa/<ver>": MOZ_APP_UA_NAME defaults
    ;;     to "" so Gecko falls back to MOZ_APP_BASENAME (Gjoa; stock Firefox reads
    ;;     "Firefox" only because ITS basename is "Firefox"). MOZ_APP_UA_NAME is the
    ;;     "proper" knob but an imply_option-ONLY project_flag — configure REFUSES it
    ;;     from confvars OR env ("accepted from: implied"), so wiring it needs a
    ;;     moz.configure source patch. A default pref is deterministic, needs no
    ;;     configure surgery, and lands in omni.ja for BOTH builds. Computed to
    ;;     Firefox/<major.minor> from the pinned Firefox version. Branding stays Gjoa
    ;;     everywhere else (about:, title, app name).
    (let [ver Any (js/get (js/get cfg .firefox) .version)
          mm-match Any (js/call ver .match (js/new RegExp "^(\\d+\\.\\d+)"))
          mm Any (if mm-match (aget mm-match 1) ver)
          ua String (str "Mozilla/5.0 (X11; Linux x86_64; rv:" mm ") Gecko/20100101 Firefox/" mm)
          ua-pref-file Any (join target "pref" "firefox-branding.js")]
      (when (existsSync ua-pref-file)
        (let [existing Any (readFileSync ua-pref-file "utf8")]
          (when (not (js/call existing .includes "general.useragent.override"))
            (writeFileSync ua-pref-file
              (str existing
                   "\n// gjoa UA compat: present as Firefox so UA-sniffing sites recognise the\n"
                   "// engine; branding stays Gjoa everywhere else (tools/prep/branding.bjs).\n"
                   "pref(\"general.useragent.override\", \"" ua "\");\n"))
            (js/call log .info (str "appended general.useragent.override = " ua))))))

    ;; 2. Overlay our own logo PNGs from configs/branding/gjoa/. Mozilla's
    ;;    convention: defaultNN.png at the branding root for sizes the desktop
    ;;    integration needs (16/22/24/32/48/64/128/256/512). We expect logoNN.png
    ;;    in our source dir at matching sizes.
    (let [sizes (Vec Int) [16 22 24 32 48 64 128 256 512]
          icon-count (Atom Int) (atom 0)]
      (doseq [size Int sizes]
        (let [src Any (join BRANDING-SRC (str "logo" size ".png"))
              dst Any (join target (str "default" size ".png"))]
          (if (existsSync src)
            (do
              (js/call Bun .spawnSync ["cp" src dst])
              (reset! icon-count (+ @icon-count 1)))
            (js/call log .warn (str "missing source icon: configs/branding/" (js/get cfg .binaryName) "/logo" size ".png")))))
      (js/call log .info (str "installed " @icon-count " desktop icons")))

    ;; 3. Overlay our content/ directory wholesale onto engine/.../gjoa/content/.
    ;;    Replaces the Firefox-logo PNGs/SVGs that copied through from the
    ;;    unofficial template (about-logo*, about-wordmark, etc.) with ours.
    (let [our-content Any (join BRANDING-SRC "content")
          target-content Any (join target "content")]
      (when (existsSync our-content)
        (let [content-count (Atom Int) (atom 0)]
          (doseq [name String (readdirSync our-content)]
            (let [src Any (join our-content name)]
              (when (js/call (statSync src) .isFile)
                (let [dst Any (join target-content name)]
                  (js/call Bun .spawnSync ["cp" src dst])
                  (reset! content-count (+ @content-count 1))))))
          (js/call log .info (str "overlaid " @content-count " content/ files (about-logo, wordmarks)")))))

    ;; 4. Sanity check: assert no zen-browser.app substring leaked through. If
    ;;    mozilla ships a future template that references zen, our regex won't
    ;;    catch it — fail loud rather than silently shipping it.
    (let [written Any (walk-files target)]
      (doseq [f String written]
        (when (is-text-file f)
          (let [text Any (readFileSync f "utf8")]
            (when (js/call text .includes "zen-browser.app")
              (throw (js/new Error (str "zen-browser.app leaked into " f " — extend substitutions in branding.bjs"))))))))

    (js/call log .ok "branding ready"))))
