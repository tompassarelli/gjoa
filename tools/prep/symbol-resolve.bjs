#lang beagle/js
;; Symbol resolver for Gate L (surface contracts). Given a declared upstream
;; dependency a gjoa patch/overlay relies on, verify it still RESOLVES in the
;; patched engine/ tree — cheap (rg/fs class), no build. Each resolver returns
;; {:verdict "resolved"|"not-found"|"ambiguous" :detail "..."}.
;;   resolved  — the symbol is present/reachable (green)
;;   not-found — moved / deleted / field gone (RED — the build will break)
;;   ambiguous — cfg-gated / deep-glob / missing objdir (warn, never a false green)
(ns gjoa.tools.prep.symbol-resolve
  (:require [fs :refer [existsSync readFileSync]]
            [path :refer [join dirname]]
            [gjoa.tools.prep.sh :refer [sh]]))
(declare-extern [process] Any)

(def REPO String (js/call process .cwd))
(def ENGINE String (join REPO "engine"))
(js/export (def STYLE-ROOT String (join ENGINE "servo" "components" "style")))

(defn slurp [f String] String
  (if (existsSync f) (readFileSync f "utf8") ""))

(defn rel [f String] String (js/call f .replace (str ENGINE "/") ""))

;; ── rust-path ──────────────────────────────────────────────────────────────
;; Walk the module chain from the crate root (lib.rs), honoring `#[path = ...]`
;; attributes — load-bearing: lib.rs maps `computed_value_flags` to
;; properties/computed_value_flags.rs, which a naive a::b::c -> a/b/c.rs resolver
;; gets wrong. Returns the resolved module file path, or nil if the chain breaks.
(defn resolve-module-file
  [crate-root String
   mods Any] Any
  (loop [file Any (join crate-root "lib.rs")
         dir String crate-root
         i Int 0]
    (if (>= i (js/get mods .length))
      file
      (let [seg Any (aget mods i)
            text String (slurp file)
            pm Any (js/call (js/new RegExp (str "#\\[path\\s*=\\s*\"([^\"]+)\"\\]\\s*(?:pub\\s+)?mod\\s+" seg "\\b")) .exec text)]
        (cond
          pm
          (let [nf Any (join dir (aget pm 1))]
            (recur nf (dirname nf) (+ i 1)))
          (existsSync (join dir (str seg ".rs")))
          (recur (join dir (str seg ".rs")) (join dir seg) (+ i 1))
          (existsSync (join dir seg "mod.rs"))
          (recur (join dir seg "mod.rs") (join dir seg) (+ i 1))
          :else nil)))))

(defn item-defined?
  [file String
   item String] Bool
  (let [text String (slurp file)]
    (or (js/call (js/new RegExp (str "(?:pub\\s+)?(?:struct|enum|fn|const|type|trait|static)\\s+" item "\\b")) .test text)
        (js/call (js/new RegExp (str "bitflags!\\s*\\{[\\s\\S]*?(?:pub\\s+)?struct\\s+" item "\\b")) .test text)
        (js/call (js/new RegExp (str "pub\\s+use\\s+[^;]*\\b" item "\\b")) .test text))))

(defn has-pub-glob? [file String] Bool
  (js/call (js/new RegExp "pub\\s+use\\s+[^;]*::\\*\\s*;") .test (slurp file)))

(js/export (defn resolve-rust-path
             [crate-root String
              sym String] Any
  (let [clean Any (js/call sym .replace (js/new RegExp "^crate::") "")
        segs Any (js/call clean .split "::")
        upper-idx Any (js/call segs .findIndex (fn [s String] Bool (js/call (js/new RegExp "^[A-Z]") .test s)))
        n Int (js/get segs .length)
        mods Any (if (= upper-idx -1) (js/call segs .slice 0 (- n 1)) (js/call segs .slice 0 upper-idx))
        item Any (if (= upper-idx -1) (aget segs (- n 1)) (aget segs upper-idx))
        file Any (resolve-module-file crate-root mods)]
    (cond
      (not file) {:verdict "not-found" :detail (str "module chain broke (no `mod " (js/call mods .join "::") "`)")}
      (item-defined? file item) {:verdict "resolved" :detail (str item " defined in " (rel file))}
      (has-pub-glob? file) {:verdict "ambiguous" :detail (str item " not a direct pub item; module has a `pub use ::*` glob — can't prove")}
      :else {:verdict "not-found" :detail (str item " not defined/re-exported in " (rel file))}))))

;; ── rust-field ─────────────────────────────────────────────────────────────
;; Generated Gecko style-struct longhands live ONLY in the objdir artifact
;; obj-*/.../style-*/out/properties.rs. Modern API is clone_<longhand>(); assert
;; the accessor (or a bare field) exists there.
(defn objdir-properties [] String
  (js/call (sh (str "ls -t " ENGINE "/obj-*/x86_64-unknown-linux-gnu/release/build/style-*/out/properties.rs 2>/dev/null | head -1") {:quiet true}) .trim))

(js/export (defn resolve-rust-field
             [field String
              accessor String] Any
  (let [gen String (objdir-properties)]
    (if (= gen "")
      {:verdict "ambiguous" :detail "objdir properties.rs absent (no prior build) — can't verify generated bindings"}
      (let [text String (slurp gen)
            has-acc Any (if (and accessor (not= accessor "")) (js/call (js/new RegExp (str "fn\\s+" accessor "\\b")) .test text) false)
            has-field Any (js/call (js/new RegExp (str "\\b" field "\\b")) .test text)]
        (if (or has-acc has-field)
          {:verdict "resolved" :detail (str (if has-acc (str "accessor " accessor "()") (str "field " field)) " present in generated properties.rs")}
          {:verdict "not-found" :detail (str "neither field `" field "` nor accessor `" accessor "()` in generated bindings")}))))))

;; ── js-prop ────────────────────────────────────────────────────────────────
;; A property on an exported object literal (e.g. AboutNewTab.newTabURL). Find
;; `export const Mod = {`, brace-match the body, assert get/set/prop inside.
;; Optionally assert >=1 non-definition reader exists under must-read (the
;; override is still CONSULTED, not orphaned like FF152's silently-ignored
;; newTabURL). Brace match is not string/comment-aware (v1 limitation).
(defn match-object-body
  [text String
   mod String] Any
  (let [m Any (js/call (js/new RegExp (str "export\\s+(?:const|let|var)\\s+" mod "\\s*=\\s*\\{")) .exec text)]
    (if (not m)
      nil
      (let [match-at Int (js/get m .index)
            match-len Int (js/get (aget m 0) .length)
            start Int (+ match-at match-len -1)
            len Any (js/get text .length)]
        (loop [i Int (+ start 1)
               depth Int 1]
          (if (>= i len)
            (js/call text .slice (+ start 1) i)
            (let [ch Any (js/call text .charAt i)
                  nd Int (cond (= ch "{") (+ depth 1) (= ch "}") (- depth 1) :else depth)]
              (if (= nd 0)
                (js/call text .slice (+ start 1) i)
                (recur (+ i 1) nd)))))))))

(js/export (defn resolve-js-prop
             [rel-path String
              mod String
              prop String
              must-read String] Any
  (let [file Any (join ENGINE rel-path)
        text String (slurp file)]
    (if (= text "")
      {:verdict "not-found" :detail (str rel-path " not found")}
      (let [body Any (match-object-body text mod)]
        (if (not body)
          {:verdict "not-found" :detail (str mod " is no longer an exported object literal in " rel-path)}
          (let [present Any (js/call (js/new RegExp (str "(?:get|set)\\s+" prop "\\s*\\(|\\b" prop "\\s*[:(]")) .test body)]
            (if (not present)
              {:verdict "not-found" :detail (str prop " not a member of " mod " (deleted/renamed)")}
              (if (and must-read (not= must-read ""))
                (let [readers String (js/call (sh (str "rg -l --no-messages '\\." prop "\\b' " (join ENGINE must-read) " 2>/dev/null | head -1") {:quiet true}) .trim)]
                  (if (= readers "")
                    {:verdict "not-found" :detail (str prop " exists but is ORPHANED — no reader under " must-read " (override silently ignored, like FF152 newTabURL)")}
                    {:verdict "resolved" :detail (str prop " present + read under " must-read)}))
                {:verdict "resolved" :detail (str prop " present on " mod)})))))))))

;; ── cpp-symbol / cpp-method / cpp-field ─────────────────────────────────────
;; A C++ anchor a patch references but does not define — e.g. patches 0012-0014
;; (dark-mode) declare `cpp-symbol nsPresContext::ColorInversion`,
;; `cpp-field nsTextPaintStyle::mFrameBackgroundColor`, etc. These resolved as
;; "ambiguous" before because parse-depends-on never matched the cpp-* kinds — a
;; latent Gate L blind spot: a Mozilla refactor renaming/removing the member would
;; pass apply and die mid-compile. Resolution is rg/fs-class (no build): given
;; `Class::Member`, accept if EITHER a qualified `Class::Member` reference exists
;; (out-of-line def / member-pointer / call — definite) OR `Member` appears in a
;; file that also declares `class Class`/`struct Class` (in-class decl). engine/
;; absent → ambiguous (never a false green), like resolve-rust-field with no objdir.
(def CPP-ROOTS Any ["layout" "widget" "dom" "gfx" "view"])
;; Only existing roots — a missing dir makes rg exit 2 (error), which the quiet sh
;; helper swallows to "" and would false-negative every anchor (the `view` dir is
;; absent in this Firefox tree). Resolve to absolute paths that actually exist.
(defn cpp-search-roots [] String
  (js/call (js/call (js/call CPP-ROOTS .map (fn [r String] String (join ENGINE r))) .filter (fn [p String] Bool (existsSync p))) .join " "))
(js/export (defn resolve-cpp-symbol
             [sym String
              kind String] Any
  (if (not (existsSync ENGINE))
    {:verdict "ambiguous" :detail (str kind " " sym " — engine/ not extracted (no `bun run import`); can't verify C++ anchors")}
    (let [parts Any (js/call sym .split "::")
          part-count Int (js/get parts .length)
          klass Any (if (>= part-count 2) (aget parts (- part-count 2)) "")
          member Any (aget parts (- part-count 1))
          roots String (cpp-search-roots)
          qualified String (js/call (sh (str "rg -l --no-messages -F '" klass "::" member "' " roots " 2>/dev/null | head -1") {:quiet true}) .trim)]
      (if (and (not= klass "") (not= qualified ""))
        {:verdict "resolved" :detail (str klass "::" member " referenced in " (rel qualified))}
        ;; (2) in-class DEFINITION: a file with a real `class Class {`/`: …`/`final`
        ;; body (NOT a `class Class;` forward declaration — that file won't hold the
        ;; member and would false-negative, e.g. nsTextFrame.h forward-declares
        ;; nsTextPaintStyle while the field lives in nsTextPaintStyle.h) that also
        ;; contains the member token (word-bounded). Allow Mozilla's optional
        ;; annotation macros between the keyword and the name (`class MOZ_STACK_CLASS
        ;; nsTextPaintStyle {`, `MOZ_RAII`, `final`, attributes, …).
        (let [cls-files String (js/call (sh (str "rg -l --no-messages -e '(class|struct)\\s+([A-Z_][A-Z0-9_]*\\s+)*" klass "\\b\\s*(\\{|:|final)' " roots " 2>/dev/null") {:quiet true}) .trim)]
          (if (= cls-files "")
            (if (= klass "")
              {:verdict "not-found" :detail (str "unqualified cpp symbol `" member "` — declare as Class::Member")}
              {:verdict "not-found" :detail (str "no `class " klass "`/`struct " klass "` found under " (js/call CPP-ROOTS .join "/") " (class moved/renamed?)")})
            (let [hit String (js/call (sh (str "rg -l --no-messages '\\b" member "\\b' " (js/call cls-files .replaceAll "\n" " ") " 2>/dev/null | head -1") {:quiet true}) .trim)]
              (if (not= hit "")
                {:verdict "resolved" :detail (str member " declared in " klass " (" (rel hit) ")")}
                {:verdict "not-found" :detail (str member " not found in any file declaring " klass " — member removed/renamed")})))))))))

;; ── contract parsing + dispatch ─────────────────────────────────────────────
;; A `depends-on` entry is any comment line `(# | ;;) - <kind> <symbol> [@ path]
;; [| accessor=X] [must-be-read-by: Y]`. The kind keyword IS the marker, so no
;; block delimiter is needed — works in both patch headers and overlay comments.
(defn parse-dep-entry
  [kind String
   rest String] Any
  (let [at-m Any (js/call (js/new RegExp "@\\s*(\\S+)") .exec rest)
        acc-m Any (js/call (js/new RegExp "accessor=(\\S+)") .exec rest)
        read-m Any (js/call (js/new RegExp "must-be-read-by:\\s*(\\S+)") .exec rest)
        sym Any (js/call (aget (js/call rest .split (js/new RegExp "\\s*[@|]\\s*|\\s*must-be-read-by:|\\s{2,}|\\s+\\(")) 0) .trim)]
    {:kind kind :symbol sym
     :at (if at-m (aget at-m 1) nil)
     :accessor (if acc-m (aget acc-m 1) nil)
     :mustRead (if read-m (aget read-m 1) nil)}))

(js/export (defn parse-depends-on [text String] Any
  (let [out (Vec Any) []
        re Any (js/new RegExp "(?:#|;;)\\s*-\\s*(rust-path|rust-field|rust-method|cpp-symbol|cpp-method|cpp-field|cpp-member|webidl-attr|js-prop)\\s+(.+?)\\s*$" "gm")]
    (doseq [m Any (js/call text .matchAll re)]
      (js/call out .push (parse-dep-entry (js/call (aget m 1) .trim) (js/call (aget m 2) .trim))))
    out)))

;; Parse a patch/overlay text's declared dependencies and resolve each against
;; engine/. Returns [{:kind :symbol :verdict :detail}].
(js/export (defn check-contract [text String] Any
  (let [entries Any (parse-depends-on text)
        out (Vec Any) []]
    (doseq [e Any entries]
      (let [kind Any (js/get e .kind)
            sym Any (js/get e .symbol)
            r Any (cond
                (= kind "rust-path") (resolve-rust-path STYLE-ROOT sym)
                (= kind "rust-field")
                (resolve-rust-field (or (aget (js/call sym .split ".") 1) sym) (or (js/get e .accessor) ""))
                (= kind "js-prop")
                (let [parts Any (js/call sym .split ".")]
                  (resolve-js-prop (or (js/get e .at) "") (aget parts 0) (or (aget parts 1) "") (or (js/get e .mustRead) "")))
                (or (= kind "cpp-symbol") (= kind "cpp-method") (= kind "cpp-field") (= kind "cpp-member"))
                (resolve-cpp-symbol sym kind)
                :else {:verdict "unsupported" :detail (str kind " — no resolver for this dep kind (fail-closed; add a resolver or fix the kind)")})]
        (js/call out .push {:kind kind :symbol sym :verdict (js/get r .verdict) :detail (js/get r .detail)})))
    out)))
