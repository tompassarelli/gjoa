#lang beagle/js
;; Direct checks for the security-mitigation source contracts.
(ns gjoa.tools.security.mitigations
  (:require [fs :refer [existsSync readFileSync]]
            [path :refer [join]]))
(define-mode strict)
(declare-extern [describe expect test process JSON RegExp Object] Any)

(def REPO :- String (.cwd process))
(def MANIFEST :- String (join REPO "configs" "security-mitigations.json"))

(defn regex-from-literal [lit :- String] :- Any
  (let [m (.match lit (RegExp. "^/(.*)/([a-z]*)$"))]
    (if m (RegExp. (aget m 1) (aget m 2)) (RegExp. lit))))

(describe "security mitigation contracts"
  (fn []
    (test "every source assertion and validator corpus holds"
      (fn []
        (.toBe (expect (existsSync MANIFEST)) true)
        (let [mits (.-mitigations (.parse JSON (readFileSync MANIFEST "utf8")))]
          (doseq [id (Object/keys mits)]
            (let [entry (get mits id)
                  src (readFileSync (join REPO (.-file entry)) "utf8")]
              (doseq [rx (or (.-mustMatch entry) [])]
                (.toBe (expect (.test (RegExp. rx "m") src)) true))
              (when (.-extractRegex entry)
                (let [m (.match src (RegExp. (.-from (.-extractRegex entry))))]
                  (.toBeTruthy (expect m))
                  (let [re (regex-from-literal (aget m 1))]
                    (doseq [s (.-mustReject entry)]
                      (.toBe (expect (.test re s)) true))
                    (doseq [s (.-mustAccept entry)]
                      (.toBe (expect (.test re s)) false))))))))))))
