#lang beagle/js
;; Compile all tooling + test .bjs → .beagle-tools/gjoa/<path>.js so they run
;; directly under Bun: the mirrored tree means beagle's relative import
;; specifiers (./log.js, ../security/check.js) resolve on disk, no bundler.
;;
;; Bootstrap: package.json's `tools:compile` first compiles THIS file with
;; the pinned Beagle checkout's bin/beagle-build, then runs it to compile
;; everything else. mtime-cached — re-runs are near-instant when nothing changed.
(ns gjoa.tools.build-tools
  (:require [fs :refer [existsSync statSync readdirSync readFileSync]]
            [path :refer [join resolve relative]]))
(declare-extern [process Bun] Any)

(def REPO-ROOT String (js/call process .cwd))
(def OUT-ROOT String (join REPO-ROOT ".beagle-tools"))
;; Local builds derive the immutable content-addressed pin directly from the full
;; object ID in configs/beagle.ref. CI overrides BEAGLE_PIN_ROOT with its fresh
;; checkout of that same object. Never compile against the moving shared checkout.
(def BEAGLE-REF-FILE String (join REPO-ROOT "configs" "beagle.ref"))
(def BEAGLE-REF String
  (let [lines (Vec String) (js/call (readFileSync BEAGLE-REF-FILE "utf8") .split "\n")
        ref Any (js/call lines .find (fn [l String] Bool
                           (and (> (js/get (js/call l .trim) .length) 0)
                                (not (js/call (js/call l .trim) .startsWith "#")))))]
    (if ref
      (js/call ref .trim)
      (throw (js/new Error "configs/beagle.ref has no Beagle object ID")))))
(def BEAGLE-PIN-ROOT String
  (or (js/get (js/get process .env) .BEAGLE_PIN_ROOT)
      (resolve (js/get (js/get process .env) .HOME) "code" "beagle" "pins" BEAGLE-REF)))
;; beagle-build-all is a `#!/usr/bin/env bash` script. Windows has no shebang support,
;; so it can't be exec'd directly there — it's launched via `bash` (Git Bash on the
;; runner). Normalize the path to forward slashes so bash
;; accepts it on Windows; (String/fromCharCode 92) is a backslash. No-op on *nix.
(def BEAGLE-BUILD-ALL String
  (js/call (resolve BEAGLE-PIN-ROOT "bin" "beagle-build-all") .replaceAll (js/call String .fromCharCode 92) "/"))
(def SRC-DIRS Any ["tools" "tests"])

;; Recursively collect every *.bjs path under `dir` (synchronous — small tree).
(defn find-bjs [dir String] Any
  (let [out (Vec Any) []
        entries (Vec Any) (readdirSync dir {:withFileTypes true})
        n Int (js/get entries .length)]
    (loop [i Int 0]
      (when (< i n)
        (let [entry Any (aget entries i)
              full String (join dir (js/get entry .name))]
          (if (js/call entry .isDirectory)
            (let [sub (Vec String) (find-bjs full)
                  m Int (js/get sub .length)]
              (loop [j Int 0]
                (when (< j m)
                  (js/call out .push (aget sub j))
                  (recur (+ j 1)))))
            (when (js/call (js/get entry .name) .endsWith ".bjs")
              (js/call out .push full)))
          (recur (+ i 1)))))
    out))

;; Recompile only when the source is newer than its output (or output missing).
(defn stale?
  [src String
   out String] Bool
  (if (existsSync out)
    (let [out-m Any (js/get (statSync out) .mtimeMs)]
      (or (> (js/get (statSync src) .mtimeMs) out-m)
          (> (js/get (statSync BEAGLE-REF-FILE) .mtimeMs) out-m)))
    true))

(defn run [] (Promise Any)
  (let [files (Vec Any) []
        nd Int (js/get SRC-DIRS .length)]
    (loop [d Int 0]
      (when (< d nd)
        (let [root String (join REPO-ROOT (aget SRC-DIRS d))]
          (when (existsSync root)
            (let [found (Vec String) (find-bjs root)
                  m Int (js/get found .length)]
              (loop [k Int 0] (when (< k m) (js/call files .push (aget found k)) (recur (+ k 1)))))))
        (recur (+ d 1))))
    (let [sorted (Vec Any) (js/call files .sort)
          n Int (js/get sorted .length)
          stale-count Int (loop [i Int 0
                                 count Int 0]
                        (if (< i n)
                          (let [src Any (aget sorted i)
                                rel String (relative REPO-ROOT src)
                                out String (join OUT-ROOT "gjoa" (js/call rel .replace (js/new RegExp "\\.bjs$") ".js"))]
                            (recur (+ i 1) (if (stale? src out) (+ count 1) count)))
                          count))]
      (if (= stale-count 0)
        (console/error (str "[2m[tools][0m compiled 0, " n " cached → .beagle-tools/gjoa/"))
        (let [proc Any (js/call Bun .spawn {:cmd ["bash" BEAGLE-BUILD-ALL "tools" "tests" "--out" OUT-ROOT]
                                        :cwd REPO-ROOT
                                        :stdout "pipe"
                                        :stderr "pipe"})
              results Any (js/await (js/call Promise .all [(js/call (js/new Response (js/get proc .stdout)) .text)
                                                       (js/call (js/new Response (js/get proc .stderr)) .text)
                                                       (js/get proc .exited)]))
              code Any (aget results 2)
              output String (js/call (str (or (aget results 0) "") (or (aget results 1) "")) .trim)]
          (if (not= code 0)
            (do
              (console/error output)
              (js/call process .exit 1))
            (console/error (str "[2m[tools][0m compiled " n ", 0 cached → .beagle-tools/gjoa/")))))
      0)))

(js/await (run))
