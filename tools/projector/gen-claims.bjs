#lang beagle/js
;; tools/projector/gen-claims.bjs — generate the committed claim-doc artifact for
;; patch 0003: patches/0003-newtab-redirector-gjoa.claims.json. The artifact is the
;; identity-anchored form of the patch ({file, edits:[set-body verbs]}), extracted
;; from the known-good patched output (pinned upstream + the textual patch). Run
;; once and commit; the build replays it as a fallback when the textual patch .rej's.
;;   bun run projector:gen-claims
(ns gjoa.tools.projector.gen-claims
  (:require [fs :refer [readFileSync writeFileSync]]
            [path :refer [join dirname]]
            [gjoa.tools.prep.sh :refer [sh]]
            [gjoa.tools.projector.claims :refer [build-doc]]))
(declare-extern [process console JSON] Any)

(def REPO String (js/call process .cwd))
(def REL String "browser/components/newtab/AboutNewTabRedirector.sys.mjs")
(def ANCHORS Any [{:class "AboutNewTabRedirectorParent" :method "newChannel"}
                     {:class "AboutNewTabRedirectorChild" :method "newChannel"}])
(def OUT String (join REPO "patches" "0003-newtab-redirector-gjoa.claims.json"))
(def FF-SRC String (join (js/get (js/get process .env) .HOME) "code" "resources" "firefox"))
(def TMP String "/tmp/gjoa-gen")

(defn main! [] Any
  (let [v (js/get (js/get (js/call JSON .parse (readFileSync (join REPO "gjoa.json") "utf8")) .firefox) .version)
        tag (str "FIREFOX_" (js/call v .replaceAll "." "_") "_RELEASE")
        dir (join TMP (dirname REL))]
    (sh (str "rm -rf " TMP " && mkdir -p " dir) nil)
    (sh (str "git -C " FF-SRC " show " tag ":" REL " > " (join TMP "pristine.mjs")) nil)
    (sh (str "cp " (join TMP "pristine.mjs") " " (join TMP REL)) nil)
    (sh (str "cd " TMP " && patch -p1 < " (join REPO "patches" "0003-newtab-redirector-gjoa.patch")) nil)
    (let [patched (readFileSync (join TMP REL) "utf8")
          pristine (readFileSync (join TMP "pristine.mjs") "utf8")
          edits (build-doc patched pristine ANCHORS)
          artifact {:file REL :edits edits}]
      (writeFileSync OUT (str (js/call JSON .stringify artifact nil 2) "\n"))
      (console/error (str "wrote " OUT "  (" (js/get edits .length) " set-body verbs, anchored @ " tag ")")))))

(when (js/get (js/import-meta) .main)
  (main!))
