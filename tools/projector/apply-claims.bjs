#lang beagle/js
;; tools/projector/apply-claims.bjs — replay a committed claim-doc artifact onto an
;; engine tree. Used by tools/prep/patches.bjs as a FALLBACK when a textual patch
;; `.rej`s: the name-anchored claim-doc reproduces the edit even after upstream
;; reflow that defeats line-anchored patching. Exit 0 on success, 1 on failure.
;;   bun apply-claims.js <artifact.claims.json> <engine-dir>
(ns gjoa.tools.projector.apply-claims
  (:require [fs :refer [readFileSync writeFileSync]]
            [path :refer [join resolve sep]]
            [gjoa.tools.projector.claims :refer [json->doc replay]]
            [gjoa.tools.projector.set-body :refer [parses?]]))
(declare-extern [process console] Any)

(defn main! [] Any
  (let [artifact-path (aget (js/get process .argv) 2)
        engine-dir (aget (js/get process .argv) 3)
        doc (json->doc (readFileSync artifact-path "utf8"))
        file (js/get doc .file)
        edits (js/get doc .edits)
        target (join engine-dir file)]
    ;; the artifact's :file is replayed onto disk; reject any path that escapes
    ;; engine-dir (absolute or `..`) before reading/writing it (path traversal).
    (when (or (js/call file .includes "..")
              (not (js/call (resolve target) .startsWith (str (resolve engine-dir) sep))))
      (console/error (str "  claim-doc :file escapes engine-dir, refusing: " file))
      (js/call process .exit 1))
    (let [src (readFileSync target "utf8")
          r (replay edits src)]
      (if (and (js/get r .ok) (parses? (js/get r .src)))
        (do
          (writeFileSync target (js/get r .src))
          (console/error (str "  claim-doc replay OK -> " file " (" (js/get edits .length) " set-body edit(s))"))
          (js/call process .exit 0))
        (do
          (console/error (str "  claim-doc replay FAILED: "
                              (if (js/get r .ok) "rendered result does not parse" (js/get r .reason))))
          (js/call process .exit 1))))))

(when (js/get (js/import-meta) .main)
  (main!))
