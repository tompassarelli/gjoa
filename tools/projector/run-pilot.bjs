#lang beagle/js
;; tools/projector/run-pilot.bjs — one-command reproducible Phase 5 pilot.
;; Materializes pristine upstream (the pinned Firefox tag from gjoa.json) + the
;; patch-0003-applied ground truth, then runs the claim-doc pilot gates.
;;   bun run projector:pilot
(ns gjoa.tools.projector.run-pilot
  (:require [child_process :refer [execSync]]
            [fs :refer [readFileSync]]
            [path :refer [join dirname]]
            [gjoa.tools.prep.sh :refer [sh]]))
(declare-extern [process console JSON Error] Any)

(def REPO String (js/call process .cwd))
(def REL String "browser/components/newtab/AboutNewTabRedirector.sys.mjs")
(def FF-SRC String (join (js/get (js/get process .env) .HOME) "code" "resources" "firefox"))
(def TMP String "/tmp/gjoa-pilot")

(defn ff-version [] String
  (js/get (js/get (js/call JSON .parse (readFileSync (join REPO "gjoa.json") "utf8")) .firefox) .version))

(defn main! [] Any
  (let [v String (ff-version)
       tag String (str "FIREFOX_" (js/call v .replaceAll "." "_") "_RELEASE")
       dir Any (join TMP (dirname REL))]
    ;; pristine = the pinned upstream file at its release tag; patched = pristine + 0011.
    (sh (str "rm -rf " TMP " && mkdir -p " dir) nil)
    (sh (str "git -C " FF-SRC " show " tag ":" REL " > " (join TMP "pristine.mjs")) nil)
    (sh (str "cp " (join TMP "pristine.mjs") " " (join TMP REL)) nil)
    (sh (str "cd " TMP " && patch -p1 < " (join REPO "patches" "0003-newtab-redirector-gjoa.patch")) nil)
    (sh (str "cp " (join TMP REL) " " (join TMP "patched.mjs")) nil)
    (console/error (str "pilot inputs ready (pristine @ " tag ", patched via patches/0003)"))
    ;; delegate to the pilot (it owns the gates + exit code).
    (execSync (str "bun " (join REPO ".beagle-tools" "gjoa" "tools" "projector" "pilot-0003.js")
                   " " (join TMP "pristine.mjs") " " (join TMP "patched.mjs") " " (join TMP "0003.claims.json"))
              {:stdio "inherit"})))

(when (js/get (js/import-meta) .main)
  (main!))
