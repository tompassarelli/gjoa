#lang beagle/js
;; tools/projector/claims.bjs — Phase 5, the edit-as-claims document layer.
;; A "claim-doc" is the persistable replacement for a textual patch: a list of
;; identity-anchored `set-body` verbs — {:verb "set-body" :class C :method M :body T}
;; — anchored to (class, method) IDENTITY, not line numbers. It serializes to JSON.
;; This is the stable verb layer (independent of Fram's fN/CRDT ordering internals,
;; which are mid-rewrite): the live-Fram-store projection of the AST itself is a
;; later integration step. Replaying a doc reproduces the edit; because it anchors
;; by name, it survives upstream reflow that `.rej`s the textual patch.
(ns gjoa.tools.projector.claims
  (:require [gjoa.tools.projector.set-body :refer [set-method-body get-body]]
            [gjoa.tools.projector.anchor :refer [capture-anchor]]))

;; build a claim-doc from the edited source + the PRISTINE source + (class,method)
;; anchors: the set-body payload is the method body from `edited`; the `:anchor`
;; fingerprint (params/ordinal/idents) is captured from `pristine` for rename-recovery.
(js/export (defn build-doc [edited String
                           pristine String
                           anchors Any] Any
  (let [out (Vec Any) []]
    (doseq [a Any anchors]
      (let [body Any (get-body edited (js/get a .class) (js/get a .method))
           fp Any (capture-anchor pristine (js/get a .class) (js/get a .method))]
        (when (some? body)
          (js/call out .push {:verb "set-body" :class (js/get a .class) :method (js/get a .method) :body body :anchor fp}))))
    out)))

;; replay a claim-doc onto a source -> {:ok :src :recoveries} or {:ok false :reason}.
;; Each verb passes its :anchor so set-method-body can recover an upstream rename.
(js/export (defn replay [doc Any
                        src String] Any
  (let [recoveries (Vec Any) []]
    (loop [i Int 0
          cur String src]
      (if (< i (js/get doc .length))
        (let [c Any (aget doc i)
             r Any (set-method-body cur (js/get c .class) (js/get c .method) (js/get c .body) (js/get c .anchor))]
          (if (js/get r .ok)
            (do (when (some? (js/get r .recovered)) (js/call recoveries .push (js/get r .recovered)))
                (recur (+ i 1) (js/get r .src)))
            r))
        {:ok true :src cur :recoveries recoveries})))))

(js/export (defn doc->json [doc Any] String (js/call JSON .stringify doc nil 2)))
(js/export (defn json->doc [s String] Any (js/call JSON .parse s)))
