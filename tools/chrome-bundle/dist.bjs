#lang beagle/js
;; Build the chrome distribution at dist/. Composes:
;;
;;   1. compile beagle:  src/gjoa/chrome/bjs/**/*.bjs → .beagle-out/gjoa/**/*.js
;;   2. bundle JS:       .beagle-out/ → dist/chrome/JS/*.uc.js (IIFE concat)
;;   3. stage CSS:       src/gjoa/chrome/css/* → dist/chrome/CSS/
;;
;; Output is consumed by `bun run chrome:install` which symlinks
;; dist/chrome/ into <install_root>/gjoa-dev/. Gjoa's native loader
;; (browser/components/gjoa/GjoaLoader.sys.mjs) reads from there at
;; startup when the dev-mode directory is present.
;;
;; No fx-autoconfig step. The loader is baked into omni.ja by the one-time
;; `mach build faster` after `bun run import`.
(ns gjoa.tools.chrome-bundle.dist
  (:require [fs :refer [existsSync readFileSync readdirSync writeFileSync]]
            [fs/promises :refer [mkdir copyFile readdir rm]]
            [path :refer [join]]))
(declare-extern [process Bun] Any)

;; REPO_ROOT was resolve(import.meta.dir, "..", ".."); tools run via `bun run`
;; from repo root, so import.meta.dir has no beagle equivalent — use cwd.
(def REPO-ROOT String (js/call process .cwd))
(def SRC-CHROME String (join REPO-ROOT "src" "gjoa" "chrome"))
(def DIST String (join REPO-ROOT "dist"))
(def DIST-CHROME String (join DIST "chrome"))

;; Spawn the COMPILED sibling tools (tools:compile populates .beagle-tools/
;; before this runs). bun can't execute .bjs directly, so point at the .js.
(def TOOLS-DIR String (join REPO-ROOT ".beagle-tools" "gjoa" "tools" "chrome-bundle"))

(defn step
  [name String
   fn Any] Any
  (let [_ Nil (console/log (str "→ " name))]
    (js/await (fn))))

(defn copy-dir
  [src String
   dst String] Any
  (let [_ Any (js/await (mkdir dst {:recursive true}))
        names (Vec String) (js/await (readdir src))]
    (doseq [name String names]
      (js/await (copyFile (join src name) (join dst name))))))

(defn main! [] Any
  (do
    (when (existsSync DIST)
      (js/await (rm DIST {:recursive true})))
    (js/await (mkdir DIST-CHROME {:recursive true}))

    (js/await
      (step "compiling beagle sources"
        (fn [] Any (let [proc Any (js/call Bun .spawn {:cmd ["bun" (join TOOLS-DIR "compile.js")]
                                  :cwd REPO-ROOT
                                  :stdout "inherit"
                                  :stderr "inherit"})
                         code Any (js/await (js/get proc .exited))]
            (when (not= code 0)
              (throw (js/new Error (str "beagle compile failed (exit " code ")"))))))))

    (js/await
      (step "bundling chrome JS"
        (fn [] Any (let [proc Any (js/call Bun .spawn {:cmd ["bun" (join TOOLS-DIR "build.js")]
                                  :cwd REPO-ROOT
                                  :stdout "inherit"
                                  :stderr "inherit"})
                         code Any (js/await (js/get proc .exited))]
            (when (not= code 0)
              (throw (js/new Error (str "chrome bundle failed (exit " code ")"))))))))

    (js/await
      (step "staging chrome/CSS"
        (fn [] Any (js/await (copy-dir (join SRC-CHROME "css") (join DIST-CHROME "CSS"))))))

    ;; Content STAMP over every bundled JS+CSS file — the dev loader watches this
    ;; file and hot-reloads the running chrome the instant it changes, so a running
    ;; browser can never hold a stale bundle (owner: "never stale by construction").
    (js/await
      (step "writing bundle stamp"
        (fn [] Any (let [Hasher Any (js/get Bun .CryptoHasher)
                         hasher Any (js/new Hasher "sha256")]
            (doseq [sub String ["JS" "CSS"]]
              (let [dir String (join DIST-CHROME sub)
                    names (Vec Any) (js/call (readdirSync dir) .sort)]
                (doseq [name Any names]
                  (js/call hasher .update name)
                  (js/call hasher .update (readFileSync (join dir name))))))
            (writeFileSync (join DIST-CHROME ".bundle-stamp") (js/call hasher .digest "hex"))))))

    (console/log "\n✓ chrome distribution ready at dist/")
    (console/log "  install: bun run chrome:install")))

(js/await (main!))
