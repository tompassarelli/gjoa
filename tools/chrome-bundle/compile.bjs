#lang beagle/js
;; Compile all chrome .bjs source files as one checked module overlay.
;; Skips macros.bjs (compile-time only) and test files.
(ns gjoa.tools.chrome-bundle.compile
  (:require [fs :refer [existsSync statSync readdirSync readFileSync]]
            [path :refer [join resolve relative]]))
(declare-extern [process] Any)

;; REPO_ROOT was resolve(import.meta.dir, "..", ".."); tools run via `bun run`
;; from repo root, so import.meta.dir has no beagle equivalent — use cwd.
(def REPO-ROOT String (js/call process .cwd))
(def BJS-ROOT String (join REPO-ROOT "src" "gjoa" "chrome" "bjs"))
(def OUT-ROOT String (join REPO-ROOT ".beagle-out"))
;; macros.bjs is inlined at compile time, so a change to it invalidates EVERY
;; compiled file's cache (any file may expand its macros).
(def MACROS-PATH String (join BJS-ROOT "macros.bjs"))
;; Local builds derive the immutable content-addressed pin directly from the full
;; object ID in configs/beagle.ref. CI overrides BEAGLE_PIN_ROOT with its checkout.
(def BEAGLE-REF-FILE String (join REPO-ROOT "configs" "beagle.ref"))
(def BEAGLE-REF String
  (let [lines (js/call (readFileSync BEAGLE-REF-FILE "utf8") .split "\n")
        ref (js/call lines .find (fn [(l String)] Bool
                           (and (> (js/get (js/call l .trim) .length) 0)
                                (not (js/call (js/call l .trim) .startsWith "#")))))]
    (if ref
      (js/call ref .trim)
      (throw (js/new Error "configs/beagle.ref has no Beagle object ID")))))
(def BEAGLE-PIN-ROOT String
  (or (js/get (js/get process .env) .BEAGLE_PIN_ROOT)
      (resolve (js/get (js/get process .env) .HOME) "code" "beagle" "pins" BEAGLE-REF)))
;; beagle-build-all is a bash script (no shebang support on Windows) — launched via
;; `bash` at the :cmd site; forward-slash the path so bash accepts it on Windows.
;; (String/fromCharCode 92) is a backslash; no-op on *nix.
(def BEAGLE-BUILD-ALL String
  (js/call (resolve BEAGLE-PIN-ROOT "bin" "beagle-build-all") .replaceAll (js/call String .fromCharCode 92) "/"))

(defn find-bjs-files [(dir String)] Any
  (let [results []
        entries (readdirSync dir {:withFileTypes true})
        n (js/get entries .length)]
    (loop [i 0]
      (when (< i n)
        (let [entry (aget entries i)
              full (join dir (js/get entry .name))]
          (if (js/call entry .isDirectory)
            (let [sub (find-bjs-files full)
                  m (js/get sub .length)]
              (loop [j 0]
                (when (< j m)
                  (js/call results .push (aget sub j))
                  (recur (+ j 1)))))
            (when (js/call (js/get entry .name) .endsWith ".bjs")
              (js/call results .push full)))
          (recur (+ i 1)))))
    results))

(defn should-skip [(rel String)] Bool
  (cond
    (= rel "macros.bjs") true
    (js/call rel .startsWith "test/") true
    (js/call rel .endsWith ".test.bjs") true
    :else false))

;; Batch compilation is all-or-nothing because local providers and consumers must
;; inhabit one compiler overlay. The batch is skipped when every output is fresh.
(defn up-to-date? [(src String) (out String)] Bool
  (if (not (existsSync out))
    false
    (let [out-m (js/get (statSync out) .mtimeMs)]
      (and (>= out-m (js/get (statSync src) .mtimeMs))
           (>= out-m (js/get (statSync BEAGLE-REF-FILE) .mtimeMs))
           (or (not (existsSync MACROS-PATH))
               (>= out-m (js/get (statSync MACROS-PATH) .mtimeMs)))))))

(defn run-compile [] (Promise Any)
  (let [all-files (find-bjs-files BJS-ROOT)
        sorted (js/call all-files .sort)
        total (js/get sorted .length)
        sources []]
    (loop [i 0]
      (when (< i total)
        (let [src (aget sorted i)
              rel (relative BJS-ROOT src)]
          (when (not (should-skip rel))
            (js/call sources .push src))
          (recur (+ i 1)))))
    (let [n (js/get sources .length)
          stale-count
          (loop [i 0 count 0]
            (if (< i n)
              (let [src (aget sources i)
                    rel (relative BJS-ROOT src)
                    out-rel (js/call rel .replace (js/new RegExp "\\.bjs$") ".js")
                    out-path (join OUT-ROOT "gjoa" out-rel)]
                (recur (+ i 1) (if (up-to-date? src out-path) count (+ count 1))))
              count))]
      (if (= stale-count 0)
        (console/log (str "✓ 0 compiled, " n " cached → .beagle-out/gjoa/"))
        (let [cmd ["bash" BEAGLE-BUILD-ALL]
              _ (loop [i 0]
                  (when (< i n)
                    (js/call cmd .push (aget sources i))
                    (recur (+ i 1))))
              _ (js/call cmd .push "--out")
              _ (js/call cmd .push OUT-ROOT)
              proc (js/call Bun .spawn {:cmd cmd
                                        :cwd REPO-ROOT
                                        :stdout "pipe"
                                        :stderr "pipe"})
              results (js/await (js/call Promise .all [(js/call (js/new Response (js/get proc .stdout)) .text)
                                                       (js/call (js/new Response (js/get proc .stderr)) .text)
                                                       (js/get proc .exited)]))
              code (aget results 2)
              output (js/call (str (or (aget results 0) "") (or (aget results 1) "")) .trim)]
          (if (not= code 0)
            (do
              (console/error output)
              (js/call process .exit 1))
            (console/log (str "✓ " n " compiled, 0 cached → .beagle-out/gjoa/")))))
      0)))

(js/await (run-compile))
