#lang beagle/js
;; tools/bench/cli.bjs — Main benchmark CLI entry point.
;;
;; Subcommands: cold-start, memory, all
(ns gjoa.tools.bench.cli)
(declare-extern [Bun process] Any)

(def subcommand Any (aget (js/get Bun .argv) 2))

(defn usage [] Any
  (console/log (str "
Usage: bun tools/bench/cli.ts <command> [options]

Commands:
  cold-start    Measure time-to-window-visible
  memory        Measure memory usage with N tabs
  all           Run all benchmarks
  env-check     Check if environment is ready for benchmarking

Options are passed through to subcommands. See individual scripts for details.

Common options:
  --gjoa-bin=<path>       Path to gjoa binary
  --firefox-bin=<path>    Path to firefox binary
  --runs=N                Number of runs (cold-start, default 20)
  --tabs=N                Number of tabs (memory, default 50)

Prepare environment first:
  sudo bash tools/bench/env.sh           # disable turbo, set governor, etc.
  sudo bash tools/bench/env.sh --restore # undo after benchmarking
")))

(defn check-environment [] Any
  (let [warnings (Vec Any) []
        push (Fn [String] Any) (fn [w String] Any (js/call warnings .push w))]
    ;; Check turbo boost
    (let [intel-turbo Any (js/call Bun .spawnSync ["cat" "/sys/devices/system/cpu/intel_pstate/no_turbo"])
          amd-boost Any (js/call Bun .spawnSync ["cat" "/sys/devices/system/cpu/cpufreq/boost"])]
      (cond
        (= (js/get intel-turbo .exitCode) 0)
        (when (= (js/call (js/call (js/get intel-turbo .stdout) .toString) .trim) "0")
          (push "Intel turbo boost is ON — results will have high variance. Run: sudo bash tools/bench/env.sh"))

        (= (js/get amd-boost .exitCode) 0)
        (when (= (js/call (js/call (js/get amd-boost .stdout) .toString) .trim) "1")
          (push "AMD boost is ON — results will have high variance. Run: sudo bash tools/bench/env.sh"))

        :else nil))

    ;; Check governor
    (let [governor Any (js/call Bun .spawnSync ["cat" "/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"])]
      (when (= (js/get governor .exitCode) 0)
        (let [gov String (js/call (js/call (js/get governor .stdout) .toString) .trim)]
          (when (not (= gov "performance"))
            (push (str "CPU governor is '" gov "' (want 'performance'). Run: sudo bash tools/bench/env.sh"))))))

    ;; Check ASLR
    (let [aslr Any (js/call Bun .spawnSync ["cat" "/proc/sys/kernel/randomize_va_space"])]
      (when (= (js/get aslr .exitCode) 0)
        (let [val String (js/call (js/call (js/get aslr .stdout) .toString) .trim)]
          (when (not (= val "0"))
            (push (str "ASLR is enabled (" val "). Run: sudo bash tools/bench/env.sh"))))))

    ;; Check xdotool
    (let [xdotool Any (js/call Bun .spawnSync ["which" "xdotool"])]
      (when (not (= (js/get xdotool .exitCode) 0))
        (push "xdotool not found — required for window detection. Install it.")))

    {:warnings warnings}))

(defn print-environment-status [] Any
  (let [warnings Any (js/get (check-environment) .warnings)]
    (if (= (js/get warnings .length) 0)
      (console/log "  Environment: OK (turbo off, performance governor, ASLR off)")
      (do
        (console/log "  Environment warnings:")
        (doseq [w Any warnings]
          (console/log (str "    WARN: " w)))))
    (console/log "")))

(defn find-binary [name String] Any
  (if (= name "gjoa")
    (let [local String (str (js/call process .cwd) "/result/bin/gjoa")
          stat Any (try (js/call Bun .file local) (catch (e Any) nil))]
      (if (and stat (> (js/get stat .size) 0))
        local
        (let [result Any (js/call Bun .spawnSync ["which" name])
              path String (js/call (js/call (js/get result .stdout) .toString) .trim)]
          (if (and (= (js/get result .exitCode) 0) path) path nil))))
    (let [result Any (js/call Bun .spawnSync ["which" name])
          path String (js/call (js/call (js/get result .stdout) .toString) .trim)]
      (if (and (= (js/get result .exitCode) 0) path) path nil))))

(defn run-subcommand [script String] Any
  (let [args (Vec Any) (js/call (js/get Bun .argv) .slice 3) ; pass through all args after subcommand
        cmd (Vec Any) (js/call ["bun" (str (js/call process .cwd) "/.beagle-tools/gjoa/tools/bench/" script)] .concat args)
        proc Any (js/call Bun .spawn cmd {:stdout "inherit"
                :stderr "inherit"
                :stdin "inherit"})
        code Any (js/await (js/get proc .exited))]
    (when (not (= code 0)) (js/call process .exit code))))

;; --- Main ---

(if (or (not subcommand) (= subcommand "--help") (= subcommand "-h"))
  (do
    (usage)
    (js/call process .exit 0))
  (do
    ;; Print header
    (console/log "\n=== Gjoa Benchmark Suite ===\n")

    ;; Auto-detect binaries
    (let [gjoa-bin (U String Nil) (find-binary "gjoa")
          firefox-bin (U String Nil) (find-binary "firefox")]
      (console/log (str "  Gjoa binary:    " (or gjoa-bin "NOT FOUND")))
      (console/log (str "  Firefox binary: " (or firefox-bin "NOT FOUND")))
      (console/log ""))

    ;; Environment check
    (print-environment-status)

    (match subcommand
      ["cold-start" (js/await (run-subcommand "cold-start.js"))]
      ["memory" (js/await (run-subcommand "memory.js"))]
      ["all" (do
               (js/await (run-subcommand "cold-start.js"))
               (js/await (run-subcommand "memory.js")))]
      ;; Already printed above
      ["env-check" nil]
      [_ (do
           (console/error (str "Unknown command: " subcommand))
           (usage)
           (js/call process .exit 1))])))
