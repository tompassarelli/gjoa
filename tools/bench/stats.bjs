#lang beagle/js
;; tools/bench/stats.bjs — Statistical utilities for benchmarking.
(ns gjoa.tools.bench.stats)

;; Student's t critical values for 95% CI (two-tailed, alpha=0.05)
;; Index by degrees of freedom (n-1), for n=3..30
(def T-CRITICAL-95 Any
  {2 4.303
   3 3.182
   4 2.776
   5 2.571
   6 2.447
   7 2.365
   8 2.306
   9 2.262
   10 2.228
   11 2.201
   12 2.179
   13 2.160
   14 2.145
   15 2.131
   16 2.120
   17 2.110
   18 2.101
   19 2.093
   20 2.086
   21 2.080
   22 2.074
   23 2.069
   24 2.064
   25 2.060
   26 2.056
   27 2.052
   28 2.048
   29 2.045})

(defn tCritical [df Int] Float
  (let [v Any (get T-CRITICAL-95 df)]
    (cond
      (some? v) v
      (< df 2) 12.706 ;; df=1, very wide
      :else 1.96))) ;; approximate for df > 29

(js/export (defn geometric-mean [values Any] Float
  (if (= (js/get values .length) 0)
    0.0
    (let [logSum Float (js/call values .reduce (fn [acc Float
                                                    v Float] Float (+ acc (Math/log v))) 0)]
      (let [n Int (js/get values .length)]
        (Math/exp (/ logSum n)))))))

(js/export (defn arithmetic-mean [values Any] Float
  (if (= (js/get values .length) 0)
    0.0
    (let [total Float (js/call values .reduce (fn [a Float
                                                   b Float] Float (+ a b)) 0)
          n Int (js/get values .length)]
      (/ total n)))))

(js/export (defn standard-deviation [values Any] Float
  (if (< (js/get values .length) 2)
    0.0
    (let [mean Float (arithmetic-mean values)
          squaredDiffs (Vec Any) (js/call values .map (fn [v Float] Float (Math/pow (- v mean) 2)))
          sum-sq Float (js/call squaredDiffs .reduce (fn [a Float
                                                          b Float] Float (+ a b)) 0)
          n Int (js/get values .length)
          variance Float (/ sum-sq (- n 1))]
      (Math/sqrt variance)))))

(js/export (defn confidence-interval95 [values Any] Any
  (let [n Int (js/get values .length)
        mean Float (arithmetic-mean values)]
    (if (< n 2)
      {:mean mean :ci 0 :low mean :high mean}
      (let [sd Float (standard-deviation values)
            df Int (- n 1)
            t Float (tCritical df)
            se Float (/ sd (Math/sqrt n))
            ci Float (* t se)]
        {:mean mean :ci ci :low (- mean ci) :high (+ mean ci)})))))

(js/export (defn median [values Any] Float
  (if (= (js/get values .length) 0)
    0.0
    (let [sorted (Vec Any) (js/call [...values] .sort (fn [a Float
                                                           b Float] Float (- a b)))
          sample-count Int (js/get sorted .length)
          mid Int (Math/floor (/ sample-count 2))]
      (if (= (mod sample-count 2) 0)
        (let [lo Float (get sorted (- mid 1))
              hi Float (get sorted mid)]
          (/ (+ lo hi) 2))
        (get sorted mid))))))

(js/export (defn format-result
             [label String
              gjoa Any
              firefox Any
              unit String] String
  (let [gjoaCI Any (confidence-interval95 gjoa)
        firefoxCI Any (confidence-interval95 firefox)
        lines (Vec Any) []]
    (js/call lines .push (str "  " label))
    (js/call lines .push (str "    Gjoa:    " (js/call (js/get gjoaCI .mean) .toFixed 1) " " unit "  "
           "[" (js/call (js/get gjoaCI .low) .toFixed 1) " .. " (js/call (js/get gjoaCI .high) .toFixed 1) "] "
           "(95% CI, n=" (js/get gjoa .length) ")"))
    (js/call lines .push (str "    Firefox: " (js/call (js/get firefoxCI .mean) .toFixed 1) " " unit "  "
           "[" (js/call (js/get firefoxCI .low) .toFixed 1) " .. " (js/call (js/get firefoxCI .high) .toFixed 1) "] "
           "(95% CI, n=" (js/get firefox .length) ")"))
    ;; Guard against division by zero / empty samples (BENCH-6).
    (if (or (< (js/get gjoa .length) 1) (< (js/get firefox .length) 1)
            (= (js/get gjoaCI .mean) 0) (= (js/get firefoxCI .mean) 0))
      (do
        (js/call lines .push "    Ratio:   n/a (insufficient samples)")
        (js/call lines .join "\n"))
      (let [firefox-mean Float (js/get firefoxCI .mean)
            gjoa-mean Float (js/get gjoaCI .mean)
            speedup Float (/ firefox-mean gjoa-mean)
            pct String (js/call (* (- speedup 1) 100) .toFixed 1)
            dir String (if (>= speedup 1) "faster" "slower")
            absPct String (js/call (Math/abs (parseFloat pct)) .toFixed 1)]
        (js/call lines .push (str "    Ratio:   " (js/call speedup .toFixed 3) "x — Gjoa is " absPct "% " dir))
        (js/call lines .join "\n"))))))
