#lang beagle/js
;; tools/bench/cold-start.bjs — Cold start (time-to-window-visible) benchmark.
;;
;; Uses xdotool to detect when the browser window becomes visible.
;; Drops filesystem caches between runs for true cold-start measurement.
(ns gjoa.tools.bench.cold-start
  (:require [util :refer [parseArgs]]
            [path :refer [join]]
            [gjoa.tools.bench.stats :refer [confidence-interval95 median format-result]]))
(declare-extern [Bun process] Any)

(def parsed Any
  (parseArgs {:args (js/call (js/get Bun .argv) .slice 2)
              :strict false
              :options {:runs {:type "string" :default "20"}
                        :gjoa-bin {:type "string"}
                        :firefox-bin {:type "string"}
                        :skip-cache-drop {:type "boolean" :default false}}}))

(def values Any (js/get parsed .values))

(def NUM-RUNS Any (parseInt (get values "runs") 10))
(when (or (not (js/call Number .isFinite NUM-RUNS)) (< NUM-RUNS 2))
  (console/error "ERROR: --runs must be >= 2 (first run is dropped as warm-up).")
  (js/call process .exit 1))

(defn localGjoa [name String] Any
  ;; Check common locations: a freshly-built ./result/bin/gjoa under cwd.
  (when (= name "gjoa")
    (let [local String (str (js/call process .cwd) "/result/bin/gjoa")]
      (try
        (let [stat Any (js/call Bun .file local)]
          (when (> (js/get stat .size) 0)
            local))
        (catch (e Error) nil)))))

(defn findBinary [name String] String
  (let [local (U String Nil) (localGjoa name)]
    (if local
      local
      ;; Fall back to PATH
      (let [result Any (js/call Bun .spawnSync ["which" name])
            path String (js/call (js/call (js/get result .stdout) .toString) .trim)]
        (if (and (= (js/get result .exitCode) 0) path)
          path
          (do
            (console/error (str "ERROR: cannot find " name " binary. Use --" name "-bin=<path>"))
            (js/call process .exit 1)))))))

(def GJOA-BIN Any (or (get values "gjoa-bin") (findBinary "gjoa")))
(def FIREFOX-BIN Any (or (get values "firefox-bin") (findBinary "firefox")))
(def SKIP-CACHE-DROP Any (get values "skip-cache-drop"))

(defn dropCaches [] Any
  (when (not SKIP-CACHE-DROP)
    (let [result Any (js/call Bun .spawnSync ["sudo" "sh" "-c" "sync; echo 3 > /proc/sys/vm/drop_caches"])]
      (when (not= (js/get result .exitCode) 0)
        (console/error "WARN: failed to drop caches (not root?). Use --skip-cache-drop or run with sudo.")))))

(defn measureColdStart!
  [binary String
   windowPattern String] Any
  ;; Create a temporary profile directory
  (let [profileDir String (str (join (js/call process .cwd) "tools" "bench") "/.bench-profile-" (js/call Date .now))]
    (js/call Bun .spawnSync ["mkdir" "-p" profileDir])
    (try
      (js/await (dropCaches))
      ;; Small delay to let caches settle
      (js/await (js/call Bun .sleep 100))

      (let [start Float (js/call performance .now)
            ;; Launch browser with fresh profile, pointing at about:blank
            browser Any (js/call Bun .spawn [binary
                                 "--no-remote"
                                 "--profile" profileDir
                                 "about:blank"] {:stdout "ignore"
                             :stderr "ignore"})
            ;; Wait for window to become visible using xdotool
            xdotool Any (js/call Bun .spawn ["xdotool" "search" "--sync" "--onlyvisible" "--name" windowPattern] {:stdout "pipe"
                             :stderr "ignore"})]
        ;; Timeout after 30 seconds — kill xdotool so its wait resolves.
        (let [state (Atom Bool) (atom false)
              timeout Int (setTimeout (fn [] Any (reset! state true)
                                    (js/call xdotool .kill)
                                    (js/call browser .kill))
                                  30000)
              exitCode Any (js/await (js/get xdotool .exited))
              elapsed Float (- (js/call performance .now) start)]
          (clearTimeout timeout)

          ;; Kill the browser
          (js/call browser .kill)
          (js/await (js/get browser .exited))

          ;; Hard-fail rather than record a bogus measurement when xdotool never
          ;; matched a window (timeout, missing window, or other failure).
          (when @state
            (throw (js/new Error (str "xdotool timed out after 30s waiting for a window matching /" windowPattern "/. "
                                "Binary may have failed to launch, or the title pattern is wrong."))))
          (when (not= exitCode 0)
            (throw (js/new Error (str "xdotool exited with code " exitCode " (no window matched /" windowPattern "/). "
                                "Refusing to record a bogus timing."))))

          elapsed))
      (finally
        ;; Clean up profile
        (js/call Bun .spawnSync ["rm" "-rf" profileDir])))))

(defn runBenchmark!
  [binary String
   label String
   windowPattern String] Any
  (let [times (Atom (Vec Any)) (atom [])]
    (console/log (str "\n  Running " label " (" NUM-RUNS " runs)..."))
    (console/log (str "  Binary: " binary))

    (doseq [i Int (range NUM-RUNS)]
      (let [t Float (js/await (measureColdStart! binary windowPattern))]
        (swap! times conj t)
        (js/call (js/get process .stdout) .write (str "    Run " (+ i 1) "/" NUM-RUNS ": " (js/call t .toFixed 1) " ms\n"))
        ;; Brief pause between runs
        (js/await (js/call Bun .sleep 500))))

    ;; Drop first run as warm-up
    (let [results (Vec Any) (js/call @times .slice 1)
          ci Any (confidence-interval95 results)
          med Float (median results)]
      (console/log (str "\n  " label " results (excluding warm-up run):"))
      (console/log (str "    Median: " (js/call med .toFixed 1) " ms"))
      (console/log (str "    Mean:   " (js/call (js/get ci .mean) .toFixed 1) " ms  ["
                         (js/call (js/get ci .low) .toFixed 1) " .. " (js/call (js/get ci .high) .toFixed 1) "] (95% CI)"))
      results)))

;; --- Main ---

;; Preflight: xdotool is required to detect window visibility.
(when (= (js/call Bun .which "xdotool") nil)
  (console/error "ERROR: xdotool not found on PATH. Install it (e.g. `apt install xdotool`).")
  (js/call process .exit 1))

(console/log "=== Cold Start Benchmark ===")
(console/log (str "  Runs: " NUM-RUNS " (first dropped as warm-up)"))
(console/log (str "  Gjoa:    " GJOA-BIN))
(console/log (str "  Firefox: " FIREFOX-BIN))

(def gjoaTimes Any (js/await (runBenchmark! GJOA-BIN "Gjoa" "Gjoa|gjoa")))
(def firefoxTimes Any (js/await (runBenchmark! FIREFOX-BIN "Firefox" "Mozilla Firefox|Firefox")))

(console/log "\n=== Comparison ===\n")
(console/log (format-result "Cold Start (time to window visible)" gjoaTimes firefoxTimes "ms"))
(console/log "")
