#lang beagle/js
;; Minimal Marionette TCP client.
;;
;; Marionette is Firefox's privileged-context remote-control protocol. Wire
;; format (from ~/code/firefox/remote/marionette/packets.sys.mjs):
;;
;;   <utf8-byte-length>:<json-payload>
;;
;; Where each JSON payload is one of:
;;   Command:  [0, msgId, name, params]
;;   Response: [1, msgId, error|null, result|null]
;;
;; Server defaults to TCP port 2828. First packet from server is an info
;; banner (`{ applicationType, marionetteProtocol }`) — we read and discard
;; it before sending any commands.
;;
;; We deliberately avoid geckodriver — it adds a wrapper layer for
;; WebDriver-protocol consumers but we just need privileged eval.
(ns gjoa.tools.test-driver.marionette
  (:require [net :refer [connect]]))
(declare-extern [Buffer String Error] Any)

;; MarionetteError carries an optional `remote` payload (the raw server error).
(js/export
  (js/class MarionetteError extends Error
    (constructor [(message String) (remote Any)]
      Any
      (super message)
      (js/set! this .name "MarionetteError")
      (js/set! this .remote remote))))

;; Connect to a running Marionette server. Polls until the port accepts a
;; connection or the timeout elapses.
(js/export (defn connect-marionette! [(opts Any)] Any
  (let [o (or opts {})
        host (or (js/get o .host) "127.0.0.1")
        port (or (js/get o .port) 2828)
        (connect-timeout-ms Int) (or (js/get o .connectTimeoutMs) 30000)
        deadline (+ (js/call Date .now) connect-timeout-ms)
        ;; Mutable scan state — `socket`/`lastErr` accumulate across poll attempts.
        scan {:socket nil :lastErr nil}]
    ;; Both the loop and the inner try contain js/await, so beagle wraps each in
    ;; an async IIFE — they MUST be js/await'd or they run fire-and-forget and the
    ;; loop spins synchronously without ever waiting for the socket.
    (js/await
      (loop []
        (if (and (< (js/call Date .now) deadline) (not (js/get scan .socket)))
          (do
            (js/await
              (try
                (js/set! scan .socket (js/await (openSocket host port)))
                (catch (e Error)
                  (do
                    (js/set! scan .lastErr e)
                    (js/await (sleep 150))))))
            ;; Re-check: keep polling until a socket connects or the deadline passes.
            (if (js/get scan .socket) nil (recur)))
          nil)))
    (if (not (js/get scan .socket))
      (throw (js/new MarionetteError (str "could not connect to Marionette at " host ":" port " within timeout") (js/get scan .lastErr)))
      nil)
    (js/await (initClient! (js/get scan .socket))))))

(defn openSocket [(host String) (port Any)] Any
  (js/new Promise (fn [resolve reject] Any (let [s (connect {:host host :port port})]
                (js/call s .once "connect" (fn [] Any (resolve s)))
                (js/call s .once "error" (fn [e] Any (reject e)))))))

(defn initClient! [(socket Any)] Any
  (let [;; nextId is a monotonically increasing message-id counter; inflight maps
        ;; pending msgIds to their { resolve, reject }.
        idState {:nextId 1}
        (inflight (JsMap Int Any)) (js/new Map)
        ;; Incoming buffer — accumulates until we have a complete <length>:<json>.
        recv {:buf (js/call Buffer .alloc 0)
              :initialBannerSeen false}
        bannerSeen (createDeferred!)]

    (js/call socket .on "data" (fn [chunk] Any ;; `_grow` lifts the `set!` into a binding so it stays a statement (a
        ;; bare leading `set!` before `loop` mis-emits as an early return).
        (let [_grow (js/set! recv .buf (js/call Buffer .concat [(js/get recv .buf) chunk]))]
          (loop []
            (let [buf (js/get recv .buf)
                  (colonIdx Int) (js/call buf .indexOf 0x3a)] ;; ':'
              (if (< colonIdx 0)
                nil ;; need more data for header
                (let [lenStr (js/call (js/call buf .subarray 0 colonIdx) .toString "utf8")
                      (len Int) (js/call Number .parseInt lenStr 10)]
                  (if (or (not (js/call Number .isFinite len)) (< len 0))
                    (do
                      (js/call socket .destroy (js/new MarionetteError (str "invalid framing header: " (js/call JSON .stringify lenStr)) nil))
                      nil)
                    (let [totalNeeded (+ colonIdx 1 len)]
                      (if (< (js/get buf .length) totalNeeded)
                        nil ;; need more bytes for body
                        ;; Have a full frame: extract payload, advance buf, dispatch,
                        ;; then loop for the next frame. The `set!`/work all live in
                        ;; let-bindings so none become a stray tail `return`.
                        (let [payload (js/call (js/call buf .subarray (+ colonIdx 1) totalNeeded) .toString "utf8")
                              _adv (js/set! recv .buf (js/call buf .subarray totalNeeded))
                              parseState {:parsed nil :failed false}
                              _parse (try
                                       (js/set! parseState .parsed (js/call JSON .parse payload))
                                       (catch (e Error)
                                         (do
                                           (js/call socket .destroy (js/new MarionetteError (str "malformed JSON from server: " payload) e))
                                           (js/set! parseState .failed true))))
                              _dispatch (if (js/get parseState .failed)
                                          nil ;; socket destroyed; stop processing this chunk
                                          (let [parsed (js/get parseState .parsed)]
                                            (if (not (js/get recv .initialBannerSeen))
                                              ;; Banner — discard. Shape: { applicationType, marionetteProtocol }
                                              (let [_b (js/set! recv .initialBannerSeen true)
                                                    r (js/get bannerSeen .resolve)]
                                                (r))
                                              ;; Response: [1, msgId, error|null, result|null]
                                              (if (and (js/call Array .isArray parsed) (= (js/get parsed .length) 4) (= (aget parsed 0) 1))
                                                (let [msgId (aget parsed 1)
                                                      err (aget parsed 2)
                                                      result (aget parsed 3)
                                                      w (js/call inflight .get msgId)]
                                                  (if (nil? w)
                                                    nil ;; late or unknown
                                                    (let [_d (js/call inflight .delete msgId)]
                                                      (if err
                                                        (let [rej (js/get w .reject)] (rej (js/new MarionetteError (formatRemoteError err) err)))
                                                        (let [res (js/get w .resolve)] (res result))))))
                                                nil))))]
                          (if (js/get parseState .failed)
                            nil ;; stop: framing aborted
                            (recur)))))))))))))

    (js/call socket .on "error" (fn [e] Any (doseq [pair (js/call Array .from (js/call inflight .entries))]
          (let [id (aget pair 0)
                w (aget pair 1)
                rej (js/get w .reject)]
            (rej (js/new MarionetteError "socket error" e))
            (js/call inflight .delete id)))))
    (js/call socket .on "close" (fn [] Any (doseq [pair (js/call Array .from (js/call inflight .entries))]
          (let [id (aget pair 0)
                w (aget pair 1)
                rej (js/get w .reject)]
            (rej (js/new MarionetteError "socket closed before response" nil))
            (js/call inflight .delete id)))))

    ;; Wait for the banner before allowing commands. (Marionette won't process
    ;; commands sent before its session-init handshake.)
    (js/await (js/get bannerSeen .promise))

    (let [send (fn [(name String) (params Any)] Any
                 (let [p (or params {})
                       (id Int) (js/get idState .nextId)]
                   (js/set! idState .nextId (+ id 1))
                   (let [cmd (js/call JSON .stringify [0 id name p])
                         framed (str (js/call Buffer .byteLength cmd "utf8") ":" cmd)]
                     (js/new Promise (fn [resolve reject] Any (js/call inflight .set id {:resolve resolve :reject reject})
                                 (js/call socket .write framed "utf8" (fn [err] Any (if err
                                             (do
                                               (js/call inflight .delete id)
                                               (reject (js/new MarionetteError "write failed" err)))
                                             nil))))))))
          ctxState {:desired nil}]

      {:newSession
       ;; caps: optional alwaysMatch map (e.g. {:pageLoadStrategy "eager"} to
       ;; return Navigate at DOMContentLoaded instead of the full load event —
       ;; heavy sites never settle their ad/tracker tail). No arg = {} (default).
       (fn [(caps Any)] Any
         (let [r (js/await (send "WebDriver:NewSession"
                                 {:capabilities {:alwaysMatch (or caps {}) :firstMatch [{}]}}))]
           (js/get r .sessionId)))

       ;; WebDriver:Navigate blocks until the session's pageLoadStrategy is met
       ;; (default "normal" = load event; "eager" = DOMContentLoaded) — event-
       ;; driven, Fission-safe. Bound it with setTimeouts.
       :navigate
       (fn [(url String)] Any
         (js/await (send "WebDriver:Navigate" {:url url}))
         nil)

       :setTimeouts
       (fn [(timeouts Any)] Any
         (js/await (send "WebDriver:SetTimeouts" timeouts))
         nil)

       :setContext
       (fn [(context String)] Any
         (js/set! ctxState .desired context)
         (js/await (send "Marionette:SetContext" {:value context}))
         nil)

       :executeScript
       (fn [(script String) (args Any)] Any
         ;; Marionette drifts the active context back to "content" when a test
         ;; opens a content tab (gBrowser.addTab to an http URL). Re-assert the
         ;; desired context before each script so chrome tests keep hitting the
         ;; browser window — and the one content test keeps hitting content.
         (when (js/get ctxState .desired)
           (js/await (send "Marionette:SetContext" {:value (js/get ctxState .desired)})))
         (let [a (or args [])
               r (js/await (send "WebDriver:ExecuteScript"
                                 {:script script
                                  :args a
                                  ;; Some Firefox versions require these to be present.
                                  :scriptTimeout 30000
                                  :newSandbox false}))]
           (js/get r .value)))

       :executeAsyncScript
       (fn [(script String) (args Any)] Any
         (when (js/get ctxState .desired)
           (js/await (send "Marionette:SetContext" {:value (js/get ctxState .desired)})))
         (let [a (or args [])
               r (js/await (send "WebDriver:ExecuteAsyncScript"
                                 {:script script
                                  :args a
                                  :scriptTimeout 30000
                                  :newSandbox false}))]
           (js/get r .value)))

       :getWindowHandle
       (fn [] Any
         ;; Marionette wraps single-value returns in { value: ... } here, just
         ;; like ExecuteScript. Unwrap.
         (let [r (js/await (send "WebDriver:GetWindowHandle" {}))]
           (if (= (js/typeof r) "string") r (js/get r .value))))

       :getWindowHandles
       (fn [] Any
         (let [r (js/await (send "WebDriver:GetWindowHandles" {}))]
           (if (js/call Array .isArray r) r (js/get r .value))))

       :switchToWindow
       (fn [(handle String)] Any
         (js/await (send "WebDriver:SwitchToWindow" {:handle handle}))
         nil)

       :closeWindow
       (fn [] Any
         ;; WebDriver:CloseWindow closes the active *tab*, not the chrome window.
         ;; For our case (gjoa runs as a chrome-window-level extension) we
         ;; want to close the entire window, hence Marionette:CloseChromeWindow.
         (let [r (js/await (send "WebDriver:CloseChromeWindow" {}))]
           (if (js/call Array .isArray r) r (js/get r .value))))

       :performActions
       (fn [(actions Any)] Any
         (js/await (send "WebDriver:PerformActions" {:actions actions}))
         nil)

       :takeScreenshot
       (fn [] Any
         (let [r (js/await (send "WebDriver:TakeScreenshot" {:full true :hash false}))]
           (if (= (js/typeof r) "string") r (js/get r .value))))

       :releaseActions
       (fn [] Any
         (js/await (send "WebDriver:ReleaseActions" {}))
         nil)

       :quit
       (fn [(flags Any)] Any
         ;; Marionette:Quit gracefully shuts Firefox down and writes
         ;; sessionstore.jsonlz4. Returns { cause, in_app }.
         (try
           (js/await (send "Marionette:Quit" {:flags (or flags ["eAttemptQuit"])}))
           (catch (e Error)
             ;; Connection may close mid-shutdown; treat that as success.
             {})))

       :deleteSession
       (fn [] Any
         (try
           (do
             (js/await (send "WebDriver:DeleteSession" {}))
             nil)
           (catch (e Error)
             ;; Already gone — fine. We're tearing down anyway.
             nil)))

       :disconnect
       (fn [] Any
         (try (js/call socket .end) (catch (e Error) nil))
         (try (js/call socket .destroy) (catch (e Error) nil)))})))

(defn formatRemoteError [(err Any)] String
  (if (and err (= (js/typeof err) "object") (js/in? err "message"))
    (str (or (js/get err .error) "error") ": " (or (js/get err .message) "(no message)"))
    (String err)))

(defn sleep [(ms Any)] Any
  (js/new Promise (fn [r] Any (setTimeout (fn [] Any (r nil)) ms))))

;; A Deferred is a Promise plus its externalized resolve/reject. createDeferred!
;; assigns them out of the executor so callers can settle the promise later.
(defn createDeferred! [] Any
  (let [slot {:resolve nil :reject nil}
        promise (js/new Promise (fn [res rej] Any (js/set! slot .resolve res)
                            (js/set! slot .reject rej)))]
    {:promise promise
     :resolve (js/get slot .resolve)
     :reject (js/get slot .reject)}))
