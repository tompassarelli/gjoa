#lang beagle/js
;; Locate the gjoa binary inside engine/obj-*/dist/bin/.
;;
;; The binary produced by `mach build` lives under engine/obj-*/dist/bin/gjoa-bin
;; (or `gjoa` for the wrapper). The chrome JS gets loaded by gjoa's
;; built-in loader when <install_root>/gjoa-dev/ exists, which
;; `bun run chrome:install` sets up.
;;
;; Resolution flow:
;;   1. $GJOA_BIN env var (explicit override)
;;   2. engine/obj-*/dist/bin/gjoa-bin
;;   3. engine/obj-*/dist/bin/gjoa
;;   4. throw with setup hint
(ns gjoa.tools.test-driver.gjoa-locator
  (:require [fs :refer [existsSync readdirSync statSync]]
            [path :refer [join]]))

(def ENGINE-DIR String "engine")

;; GjoaBinaryInfo: { path, installRoot }
;;   path        — Absolute path to the binary to spawn.
;;   installRoot — Absolute path to the install root (where gjoa-dev/ lives).

;; Tiny dirname helper: no node:path dirname import needed for this single use.
(defn dirname [p String] String
  (let [i Any (js/call p .lastIndexOf "/")]
    (if (< i 0) "." (js/call p .slice 0 i))))

;; Find the gjoa binary. Throws with a setup hint if not present.
(js/export (defn locate-gjoa
  ([] Any (locate-gjoa (js/call process .cwd)))
  ([cwd String] Any
    (let [gjoa-bin (U String Nil) (js/get (js/get process .env) .GJOA_BIN)]
      (if gjoa-bin
        (do
          (when (not (existsSync gjoa-bin))
            (throw (js/new Error (str "$GJOA_BIN points at " gjoa-bin " but no such file exists"))))
          {:path gjoa-bin :installRoot (dirname gjoa-bin)})

        (let [engineDir String (join cwd ENGINE-DIR)]
          (when (not (existsSync engineDir))
            (throw (js/new Error (str "gjoa-locator: " engineDir " not found.\n"
                   "Run from the gjoa repo root, or set $GJOA_BIN."))))

          (let [objDir (U Nil (U String Any)) (loop [names (Vec String) (readdirSync engineDir)]
                  (if (empty? names)
                    nil
                    (let [name Any (first names)]
                      (if (and (js/call name .startsWith "obj-")
                               (js/call (statSync (join engineDir name)) .isDirectory))
                        (join engineDir name)
                        (recur (rest names))))))]
            (when (nil? objDir)
              (throw (js/new Error (str "gjoa-locator: no engine/obj-* build dir found.\n"
                     "Run `mach build faster` (Lane 2) inside engine/ first."))))

            (let [binDir String (join objDir "dist" "bin")
                  result (U Nil (Map Keyword Any)) (loop [candidates (Vec String) ["gjoa-bin" "gjoa" "firefox-bin" "firefox"]]
                    (if (empty? candidates)
                      nil
                      (let [candidate String (first candidates)
                            p String (join binDir candidate)]
                        (if (existsSync p)
                          {:path p :installRoot binDir}
                          (recur (rest candidates))))))]
              (if result
                result
                (throw (js/new Error (str "gjoa-locator: no gjoa-bin / gjoa / firefox-bin / firefox under " binDir ".\n"
                       "The build dir exists but no binary — did the build complete?"))))))))))))
