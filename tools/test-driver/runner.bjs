#lang beagle/js
;; Integration test runner.
;;
;; Spawns gjoa with --marionette + an ephemeral profile, drives the
;; privileged chrome scope via Marionette to run integration tests.
;; Streams structured pass/fail JSON for AI/CI consumption.
;;
;; Test shape:
;;   tests/integration/<name>.ts exports `default` an array of test objects:
;;     export default [
;;       { name: "test name", run: async (mn) => { ... } },
;;       ...
;;     ];
;;   Each `run` receives a connected, chrome-context Marionette client and
;;   may throw to fail.
;;
;; Output:
;;   {"type": "test:start", "name": "...", "file": "..."}
;;   {"type": "test:pass",  "name": "...", "file": "...", "durationMs": N}
;;   {"type": "test:fail",  "name": "...", "file": "...", "durationMs": N,
;;    "error": "...", "stack": "..."}
;;   {"type": "summary", "pass": N, "fail": M, "skip": K, "durationMs": ...}
;;
;; Exit code: 0 on full pass, 1 on any failure.
;;
;; The TS interfaces (TestContext, IntegrationTest, RunnerOptions, JsonEvent)
;; were type-only and have no runtime presence — dropped here.
(ns gjoa.tools.test-driver.runner
  (:require [child_process :refer [spawn]]
            [fs :refer [existsSync readFileSync]]
            [fs/promises :refer [readdir]]
            [path :refer [join basename]]
            [gjoa.tools.test-driver.marionette :refer [connect-marionette!]]
            [gjoa.tools.test-driver.profile :refer [create-profile]]
            [gjoa.tools.test-driver.gjoa-locator :refer [locate-gjoa]]))

(declare-extern [process String] Any)

;; SkipError factory. Detection downstream reads `(js/get e .name)` so the
;; emitted value stays an ordinary Error with the expected stack behavior.
(js/export (defn SkipError! [(reason String)] Any
  (let [e (js/new Error reason)]
    (js/set! e .name "SkipError")
    e)))

(defn emit [(ev Any)] Any
  (js/call (js/get process .stdout) .write (str (js/call JSON .stringify ev) "\n")))

(defn logErr [(line String)] Any
  (js/call (js/get process .stderr) .write (str "[runner] " line "\n")))

;; Per-test baseline reset (a de-facto beforeEach), run in chrome context before
;; EVERY test so the suite stays order-independent (#102). Best-effort: every
;; step is wrapped in try/catch and no-ops when its chrome API is absent (e.g.
;; the sqlite probe test). This covers the cross-test leaks that made 5 tests
;; fail in the full run yet pass in isolation:
;;   - layout/orientation + vim-leader prefs (a test left in horizontal mode or
;;     with useLeader on polluted the next) — restore deterministic defaults;
;;   - a FOCUSED urlbar (e.g. _diag's gURLBar.focus()) that swallows the next
;;     test's keydowns so Alt+h/Alt+l never reach the tab-panel fold handler;
;;   - a stale vim cursor pointing at a removed/foreign row;
;;   - leftover tabs AND group rows that inflate the tab tree (groups #11 saw a
;;     "Project-A" group left by spaces-scope-groups — the old reset cleared
;;     tabs but never groups), plus extra spaces;
;;   - a leaked 2nd browser window (multi-window tests like #89 open one via
;;     OpenBrowserWindow) — collapse to the marionette-current window first, so a
;;     test that fails before closing its own window can't pollute the next test
;;     with an extra navigator:browser (the window-scoped form of the leak above).
(def RESET-JS String
  (str
    "try {\n"
    "  try { for (var w of [...Services.wm.getEnumerator('navigator:browser')]) { if (w !== window) { try { w.close(); } catch (e) {} } } } catch (e) {}\n"
    "  try { Services.prefs.setBoolPref('sidebar.verticalTabs', true); } catch (e) {}\n"
    "  try { Services.prefs.clearUserPref('gjoa.layout.dynamicOrientation'); } catch (e) {}\n"
    "  try { Services.prefs.clearUserPref('gjoa.layout.narrowThreshold'); } catch (e) {}\n"
    "  try { Services.prefs.clearUserPref('gjoa.layout.horizontalSingleRow'); } catch (e) {}\n"
    "  try { Services.prefs.clearUserPref('gjoa.keys.useLeader'); } catch (e) {}\n"
    "  try { Services.prefs.clearUserPref('gjoa.tabs.newTabPosition'); } catch (e) {}\n"
    ;; Dismiss any modal picker/ex-command UI a prior test left open (e.g.
    ;; vim-hotkeys ends with the ex-command picker open) — an open picker
    ;; swallows the next test's keydowns. Escape is the picker's own dismiss
    ;; path (same synthetic event the suite's closePicker helper uses).
    "  try { document.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true, cancelable: true })); } catch (e) {}\n"
    "  try { if (window.Spaces && window.Spaces.list) { var L = window.Spaces.list(); var m = L.find(s => s.name === 'Main') || L[0]; if (m) { window.Spaces.setActive(m.id); L.forEach(s => { if (s.id !== m.id) { try { window.Spaces.delete(s.id); } catch (e) {} } }); } } } catch (e) {}\n"
    "  var GT = window.gjoaTest;\n"
    "  try { if (GT) { if (GT.vim && GT.vim.setCursor) GT.vim.setCursor(null); else if (GT.state) GT.state.cursor = null; } } catch (e) {}\n"
    "  try { if (window.gBrowser) { var blank = gBrowser.addTab('about:blank', { triggeringPrincipal: Services.scriptSecurityManager.getSystemPrincipal() }); gBrowser.selectedTab = blank; Array.from(gBrowser.tabs).forEach(t => { if (t !== blank && !t.pinned) { try { gBrowser.removeTab(t); } catch (e) {} } }); } } catch (e) {}\n"
    "  try { document.querySelectorAll('#gjoa-tab-panel .gjoa-group-row, #gjoa-tab-panel-pinned .gjoa-group-row').forEach(r => { try { r.remove(); } catch (e) {} }); } catch (e) {}\n"
    "  try { if (GT && GT.treeOf && window.gBrowser) { var td = GT.treeOf.get(gBrowser.selectedTab); if (td) { td.parentId = null; td.collapsed = false; } } } catch (e) {}\n"
    "  try { if (GT && GT.rows) { if (GT.rows.scheduleTreeResync) GT.rows.scheduleTreeResync(); if (GT.rows.updateVisibility) GT.rows.updateVisibility(); } } catch (e) {}\n"
    "  try { if (typeof gURLBar !== 'undefined' && gURLBar) { gURLBar.value = ''; if (gURLBar.view && gURLBar.view.close) gURLBar.view.close(); gURLBar.blur(); } } catch (e) {}\n"
    "  try { if (document.activeElement && document.activeElement.blur) document.activeElement.blur(); } catch (e) {}\n"
    "} catch (e) {}"))

;; Dynamic `import(path)` — beagle's static `import` form can't express a
;; runtime module load, so build the dynamic importer via Function.
(def dynImport Any (js/new Function "p" "return import(p)"))

(defn loadTests [(testDir String)] Any
  (let [entries
        (js/await
          (try
            (js/await (readdir testDir))
            (catch (e Any)
              (throw (js/new Error (str "could not read " testDir ": " (js/get e .message)))))))
        files (js/call entries .filter (fn [f] Any (and (js/call (js/new RegExp "\\.(ts|tsx|mjs|js)$") .test f)
                       (not (js/call f .endsWith ".d.ts")))))
        n (js/get files .length)
        out []]
    ;; Sequential, awaited load (one dynamic import at a time). A `doseq`
    ;; here compiles to a non-awaited forEach (fire-and-forget) which would
    ;; return `out` before the imports resolve — so use an explicit awaited
    ;; loop with recur as the SOLE tail form (side effects bound via _).
    (js/await
      (loop [i 0]
        (when (< i n)
          (let [f (aget files i)
                path (join testDir f)
                testMod (js/await (dynImport path))
                tests (or (js/get testMod .default) [])
                _push (if (not (js/call Array .isArray tests))
                        (logErr (str "skipping " f " — default export is not an array"))
                        (js/call out .push {:file (basename f) :tests tests}))]
            (recur (+ i 1))))))
    out))

;; tags.json lives next to the .bjs SOURCE tests (tests/integration/), not in
;; the compiled .beagle-tools/ mirror. Read it from cwd. Absent/malformed →
;; empty maps (no filtering) so the runner degrades safely.
(defn load-tags [] Any
  (let [p (join (js/call process .cwd) "tests" "integration" "tags.json")]
    (if (existsSync p)
      (try
        (js/call JSON .parse (readFileSync p "utf8"))
        (catch (e Any)
          (logErr (str "tags.json parse failed: " (js/get e .message)))
          {:subsystems {} :lanes {} :sources {}}))
      {:subsystems {} :lanes {} :sources {}})))

(defn strip-ext [(f String)] String
  (js/call f .replace (js/new RegExp "\\.[^.]+$") ""))

;; Resolve --files/--subsystem/--lane/--exclude-lane into a directive describing
;; which suite basenames to keep. Returns:
;;   nil                        no file-level filter requested → keep all
;;   {:keep <Set>}              keep only these basenames (positive selection)
;;   {:exclude <Set>}           keep everything NOT in this set (exclude-only)
;; A positive selection always wins; any --exclude-lane is subtracted from it.
(defn suite-keepset [(tags Any) (opts Any)] Any
  (let [subs (or (js/get tags .subsystems) {})
        lanes (or (js/get tags .lanes) {})
        keep (js/new Set)
        excl (js/new Set)
        ;; A positive selection was requested iff any of these flags is present.
        any (boolean (or (js/get opts .files) (js/get opts .subsystem) (js/get opts .lane)))]
    ;; --files a,b (explicit basenames)
    (when (js/get opts .files)
      (doseq [n (js/call (js/get opts .files) .split ",")]
        (when (js/call n .trim) (js/call keep .add (js/call n .trim)))))
    ;; --subsystem name(s) (comma-joined)
    (when (js/get opts .subsystem)
      (doseq [s (js/call (js/get opts .subsystem) .split ",")]
        (doseq [n (or (get subs (js/call s .trim)) [])] (js/call keep .add n))))
    ;; --lane name(s) → keep union of those lanes
    (when (js/get opts .lane)
      (doseq [l (js/call (js/get opts .lane) .split ",")]
        (doseq [n (or (get lanes (js/call l .trim)) [])] (js/call keep .add n))))
    ;; --exclude-lane name(s) → drop those
    (when (js/get opts .excludeLane)
      (doseq [l (js/call (js/get opts .excludeLane) .split ",")]
        (doseq [n (or (get lanes (js/call l .trim)) [])] (js/call excl .add n))))
    (cond
      ;; explicit keep set wins; subtract excludes from it
      any
      (do (doseq [n (js/call Array .from excl)] (js/call keep .delete n))
          {:keep keep})
      ;; exclude-only → keep everything NOT excluded (caller filters the full list)
      (> (js/get excl .size) 0) {:exclude excl}
      :else nil)))

(defn spawnGjoa [(opts Any)] Any
  ;; --remote-allow-system-access is required for privileged ("chrome")
  ;; context script eval — landed in Firefox 128+ as a safety gate.
  (let [verbose (js/get opts .verbose)
        args (js/call ["--profile" (js/get opts .profilePath)
                "--marionette"] .concat (if (js/get opts .headed) [] ["--headless"]) ["--no-remote"
                "--remote-allow-system-access"
                "-marionette-port" (String (js/get opts .marionettePort))])
        ;; Pass GJOA_ALLOW_INSECURE=1 unconditionally so the in-process
        ;; security gate (src/gjoa/chrome/bjs/security/index.bjs) doesn't
        ;; quit the test browser. The test environment runs against
        ;; whatever Firefox version the local build is at — that's
        ;; unrelated to "is this build safe to ship to users."
        ;; GJOA_DEV_LOADER=1: the F4 opt-in gate means the dev chrome bundles
        ;; (the gjoa-dev/ symlink) only load when this is set. The suite drives
        ;; the dev build, so it must opt in or no gjoa chrome loads at all.
        env (js/call Object .assign {} (js/get process .env) {"GJOA_ALLOW_INSECURE" "1" "GJOA_DEV_LOADER" "1"})
        child (spawn (js/get opts .gjoaBin) args
                     {:stdio (if verbose "inherit" "pipe")
                      :env env})]
    (when (not verbose)
      (let [out (js/get child .stdout)]
        (when out (js/call out .resume)))
      (let [err (js/get child .stderr)]
        (when err (js/call err .resume))))
    (js/call child .once "error" (fn [e] Any (logErr (str "gjoa spawn error: " (js/get e .message)))))
    child))

(js/export (defn run-all! [(opts0 Any)] Any
  (let [opts (or opts0 {})
        gjoaBin (or (js/get opts .gjoaBin) (js/get (locate-gjoa) .path))
        ;; Compiled test suites live under .beagle-tools/ (the source is .bjs).
        testDir (or (js/get opts .testDir) (join (js/call process .cwd) ".beagle-tools" "gjoa" "tests" "integration"))
        marionettePort (or (js/get opts .marionettePort) 2828)]

    (when (js/get opts .headed)
      (logErr "WARNING: --headed mode will pop a real gjoa window on your display."))

    (let [allSuites (js/await (loadTests testDir))
          ;; FILE-LEVEL lane/subsystem filter (additive; nil keep = no filter).
          tags (load-tags)
          keep (suite-keepset tags opts)
          suites (if keep
                   (js/call allSuites .filter (fn [s] Any (let [base (strip-ext (js/get s .file))]
                         (if (js/get keep .exclude)
                           (not (js/call (js/get keep .exclude) .has base))
                           (js/call (js/get keep .keep) .has base)))))
                   allSuites)]
      ;; --grep composes on top: a test-name filter within the surviving files.
      (when (js/get opts .grep)
        (let [needle (js/call (js/get opts .grep) .toLowerCase)]
          (doseq [s suites]
            (js/set! s .tests (js/call (js/get s .tests) .filter (fn [t] Any (js/call (js/call (js/get t .name) .toLowerCase) .includes needle)))))))
      (let [(totalCount Int) (js/call suites .reduce
                                      (fn [(n Int) s] Int
                                        (let [(suite-size Int) (js/get (js/get s .tests) .length)]
                                          (+ n suite-size)))
                                      0)]
        (if (= totalCount 0)
          (do
            (emit {:type "summary" :pass 0 :fail 0 :skip 0 :durationMs 0
                   :note (if (js/get opts .grep)
                           (str "no tests match --grep \"" (js/get opts .grep) "\"")
                           "no tests found")})
            {:pass 0 :fail 0 :skip 0})

          (let [profile (atom nil)
                gjoa (atom nil)
                mn (atom nil)
                pass (atom 0)
                fail (atom 0)
                skip (atom 0)
                start (js/call Date .now)]

            (let [killGjoa
                  (fn [] Any
                    (let [g (deref gjoa)]
                      (when (and g (not (js/get g .killed)))
                        (js/call g .kill "SIGTERM")
                        (js/await
                          (js/new Promise (fn [r] Any (let [timer (setTimeout
                                            (fn [] Any (try (js/call g .kill "SIGKILL") (catch (_ Any) nil))
                                              (r))
                                            3000)]
                                (js/call g .once "exit" (fn [] Any (clearTimeout timer) (r))))))))))

                  bootGjoa
                  (fn [profilePath] Any
                    (let [g (js/await
                            (spawnGjoa {:gjoaBin gjoaBin
                                        :profilePath profilePath
                                        :marionettePort marionettePort
                                        :verbose (js/get opts .verbose)
                                        :headed (js/get opts .headed)}))]
                    (reset! gjoa g))
                    (let [client (js/await (connect-marionette! {:port marionettePort}))]
                      (js/await (js/call client .newSession))
                      (js/await (js/call client .setContext "chrome"))
                      client))

                  ;; Run a single test: emit start, run, tally pass/skip/fail.
                  ;; Extracted to a fn so the suite/test iteration can be a
                  ;; clean awaited loop (recur as sole tail form).
                  runOneTest
                  (fn [(file String) (t Any)] Any
                    (emit {:type "test:start" :name (js/get t .name) :file file})
                    (let [tStart (js/call Date .now)
                          ctx {:profilePath (js/get (deref profile) .path)
                               :headed (boolean (js/get opts .headed))
                               :skip (fn [reason] Any (throw (SkipError! reason)))
                               :restartGjoa
                               (fn [] Any
                                 (try (js/await (js/call (deref mn) .quit)) (catch (_ Any) nil))
                                 (js/call (deref mn) .disconnect)
                                 (js/await (killGjoa))
                                 (let [m (js/await (bootGjoa (js/get (deref profile) .path)))]
                                   (reset! mn m))
                                 (deref mn))}]
                      (try
                        (do
                          ;; Marionette's context drifts back to "content" when a
                          ;; test opens a content tab (e.g. gBrowser.addTab to an
                          ;; http URL). Re-assert chrome before every test so each
                          ;; one runs against the browser window (window.Spaces,
                          ;; #gjoa-tab-panel, Services) rather than a stale page.
                          (try (js/await (js/call (deref mn) .setContext "chrome"))
                               (catch (_ Any) nil))
                          ;; Reset to a clean baseline before each test so tests
                          ;; stay order-independent (#102). See RESET-JS above for
                          ;; the full set of cross-test leaks this clears. Best-
                          ;; effort: no-op when the chrome APIs aren't present
                          ;; (e.g. the sqlite probe).
                          (try (js/await (js/call (deref mn) .executeScript RESET-JS))
                               (catch (_ Any) nil))
                          (js/await (js/call t .run (deref mn) ctx))
                          (emit {:type "test:pass" :name (js/get t .name) :file file
                                 :durationMs (- (js/call Date .now) tStart)})
                          (swap! pass inc))
                        (catch (e Any)
                          (if (= (js/get e .name) "SkipError")
                            (do
                              (emit {:type "test:skip" :name (js/get t .name) :file file
                                     :durationMs (- (js/call Date .now) tStart)
                                     :reason (js/get e .message)})
                              (swap! skip inc))
                            (do
                              (emit {:type "test:fail" :name (js/get t .name) :file file
                                     :durationMs (- (js/call Date .now) tStart)
                                     :error (or (js/get e .message) (String e))
                                     :stack (js/get e .stack)})
                              (swap! fail inc)))))))

                  ;; Sequential over all tests in a suite (awaited).
                  runSuite
                  (fn [(suite Any)] Any
                    (let [file (js/get suite .file)
                          ts (js/get suite .tests)
                          m (js/get ts .length)]
                      (js/await
                        (loop [j 0]
                          (when (< j m)
                            (let [_run (js/await (runOneTest file (aget ts j)))]
                              (recur (+ j 1))))))))]

              (js/await
               (try
                (do
                  (let [p (js/await (create-profile {:marionettePort marionettePort}))] (reset! profile p))
                  (when (js/get opts .verbose) (logErr (str "profile: " (js/get (deref profile) .path))))
                  (when (js/get opts .verbose) (logErr (str "binary:  " gjoaBin)))
                  (let [m (js/await (bootGjoa (js/get (deref profile) .path)))] (reset! mn m))

                  ;; Sequential over all suites (awaited).
                  (js/await
                    (loop [si 0]
                      (when (< si (js/get suites .length))
                        (let [_suite (js/await (runSuite (aget suites si)))]
                          (recur (+ si 1)))))))
                (catch (e Any)
                  (logErr (str "runner failure: " (or (js/get e .stack) (js/get e .message))))
                  (swap! fail inc))
                (finally
                  (when (deref mn)
                    (try (js/await (js/call (deref mn) .deleteSession)) (catch (_ Any) nil))
                    (js/call (deref mn) .disconnect))
                  (js/await (killGjoa))
                  (when (deref profile)
                    (if (js/get opts .verbose)
                      (logErr (str "profile preserved at " (js/get (deref profile) .path) " for inspection"))
                      (try (js/await (js/call (deref profile) .cleanup)) (catch (_ Any) nil))))))))

            (emit {:type "summary" :pass (deref pass) :fail (deref fail) :skip (deref skip)
                   :durationMs (- (js/call Date .now) start) :binary gjoaBin})
            {:pass (deref pass) :fail (deref fail) :skip (deref skip)})))))))

;; CLI entrypoint. The original guarded this with `import.meta.main`; beagle
;; has no import.meta, and no module imports `run-all` at runtime (the integration
;; tests import only the type-only `IntegrationTest`), so the block runs
;; unconditionally — equivalent to running the file as a script.
(def cliArgs Any (js/call (js/get process .argv) .slice 2))
(def cliVerbose Any (js/call cliArgs .includes "--verbose"))
(def cliHeaded Any (js/call cliArgs .includes "--headed"))
(def cliGrep Any
  (loop [i 0 grep nil]
    (if (>= i (js/get cliArgs .length))
      grep
      (let [a (aget cliArgs i)]
        (cond
          (and (= a "--grep") (aget cliArgs (+ i 1)))
          (recur (+ i 2) (aget cliArgs (+ i 1)))
          (js/call a .startsWith "--grep=")
          (recur (+ i 1) (js/call a .slice (js/get "--grep=" .length)))
          :else
          (recur (+ i 1) grep))))))

;; Generic `--flag <value>` / `--flag=value` reader. Single value per flag;
;; package.json passes comma-joined for repeatable lanes/subsystems.
(defn cli-val [(args Any) (flag String)] Any
  (loop [i 0]
    (if (>= i (js/get args .length))
      nil
      (let [a (aget args i)]
        (cond
          (and (= a flag) (aget args (+ i 1))) (aget args (+ i 1))
          (js/call a .startsWith (str flag "="))
            (let [(flag-len Int) (js/get flag .length)] (js/call a .slice (+ flag-len 1)))
          :else (recur (+ i 1)))))))

(def cliSubsystem Any (cli-val cliArgs "--subsystem"))
(def cliLane Any (cli-val cliArgs "--lane"))
(def cliExcludeLane Any (cli-val cliArgs "--exclude-lane"))
(def cliFiles Any (cli-val cliArgs "--files"))
(def cliListLanes Any (js/call cliArgs .includes "--list-lanes"))

;; Marionette port — env GJOA_MARIONETTE_PORT (or --marionette-port) overrides the
;; 2828 default so agents sharing one working tree can run the suite CONCURRENTLY
;; without colliding on a single port (the profile dir is already per-run unique and
;; the fixture servers are shareable, so the port was the only contention point).
;; Unset = 2828 — identical single-agent behavior, zero change for existing callers.
(def cliMarionettePort Any
  (let [v (or (cli-val cliArgs "--marionette-port") (js/get (js/get process .env) .GJOA_MARIONETTE_PORT))]
    (if v (parseInt v 10) nil)))

;; --list-lanes: resolve the keep-set against tags.json + the on-disk suite
;; list and print it WITHOUT booting gjoa. Cheap manifest sanity-check.
(defn list-lanes! [(opts Any)] Any
  (let [testDir (join (js/call process .cwd) ".beagle-tools" "gjoa" "tests" "integration")
        suites (js/await (loadTests testDir))
        tags (load-tags)
        keep (suite-keepset tags opts)
        bases (js/call suites .map (fn [s] Any (strip-ext (js/get s .file))))
        kept (if keep
               (js/call bases .filter (fn [b] Any (if (js/get keep .exclude)
                     (not (js/call (js/get keep .exclude) .has b))
                     (js/call (js/get keep .keep) .has b))))
               bases)]
    (console/log (js/call JSON .stringify {:filter (cond (js/get opts .files) (str "--files " (js/get opts .files))
                                   (js/get opts .subsystem) (str "--subsystem " (js/get opts .subsystem))
                                   (js/get opts .lane) (str "--lane " (js/get opts .lane))
                                   (js/get opts .excludeLane) (str "--exclude-lane " (js/get opts .excludeLane))
                                   :else "none (all)")
                     :total (js/get bases .length)
                     :kept (js/get (js/call (js/call kept .slice) .sort) .length)
                     :files (js/call (js/call kept .slice) .sort)} nil 2))))

;; Run the suite only when invoked directly (tests import this module for types).
(when (js/get (js/import-meta) .main)
  (let [opts {:verbose cliVerbose :grep cliGrep :headed cliHeaded
              :subsystem cliSubsystem :lane cliLane
              :excludeLane cliExcludeLane :files cliFiles
              :marionettePort cliMarionettePort}]
    (if cliListLanes
      (js/call (list-lanes! opts) .catch (fn [e] Any (logErr (str "fatal: " (or (js/get e .stack) e))) (js/call process .exit 1)))
      (js/call (js/call (run-all! opts) .then (fn [res] Any (js/call process .exit (if (> (js/get res .fail) 0) 1 0)))) .catch (fn [e] Any (logErr (str "fatal: " (or (js/get e .stack) e)))
          (js/call process .exit 1))))))
