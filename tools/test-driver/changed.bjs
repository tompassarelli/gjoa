#lang beagle/js
;; `test:changed` — run only the tests impacted by the working-tree diff.
;;
;; Changed set = (committed since merge-base with main) ∪ (uncommitted).
;; Each path maps via tests/integration/tags.json `sources`:
;;   - tests/integration/<x>.bjs          → run <x> directly (--files)
;;   - src/gjoa/chrome/bjs/<dir>/**        → the subsystem(s) for that dir
;;   - shared infra (runner, bundler, dsl, marionette, tags.json) → can't
;;     scope safely, fall back to the full FAST lane (--exclude-lane slow,network)
;;
;; Spawns the runner with the resolved flags and inherits stdio.
(ns gjoa.tools.test-driver.changed
  (:require [fs :refer [existsSync readFileSync]]
            [path :refer [join]]
            [child_process :refer [spawnSync]]))
(declare-extern [process] Any)

(def REPO-ROOT String (js/call process .cwd))
(def RUNNER String (join REPO-ROOT ".beagle-tools" "gjoa" "tools" "test-driver" "runner.js"))
(def TAGS String (join REPO-ROOT "tests" "integration" "tags.json"))

;; Shared-infra prefixes: any change here invalidates the whole suite, so
;; we can't safely scope — run the full fast lane instead.
(def INFRA-PREFIXES Any
  ["tools/test-driver/" "tools/chrome-bundle/" "tests/dsl"
   "tests/integration/marionette" "tests/integration/tags.json"])

(defn git [args Any] Any
  (try
    (let [r Any (spawnSync "git" args {:cwd REPO-ROOT :encoding "utf8"})]
      (if (= (js/get r .status) 0) (js/get r .stdout) ""))
    (catch (e Any) "")))

(defn lines [s Any] Any
  (js/call (js/call (or s "") .split "\n") .filter (fn [l String] Any (not= (js/call l .trim) ""))))

;; Union of committed-since-main and uncommitted changes.
(defn changed-files [] Any
  (let [base String (js/call (git ["merge-base" "HEAD" "main"]) .trim)
        committed (U (Vec Any) Any) (if (= base "")
                    []
                    (lines (git ["diff" "--name-only" (str base "...HEAD")])))
        ;; porcelain lines are "XY <path>"; slice the status prefix
        dirty (Vec Any) (js/call (lines (git ["status" "--porcelain"])) .map (fn [l String] Any (js/call (js/call l .slice 3) .trim)))
        set Any (js/new Set)]
    (doseq [f Any committed] (js/call set .add f))
    (doseq [f Any dirty] (js/call set .add f))
    (js/call Array .from set)))

(defn load-tags [] Any
  (if (existsSync TAGS)
    (try (js/call JSON .parse (readFileSync TAGS "utf8")) (catch (e Any) {:sources {}}))
    {:sources {}}))

(defn infra? [path String] Bool
  (let [hit Any (js/call INFRA-PREFIXES .find (fn [p String] Any (js/call path .startsWith p)))]
    (boolean hit)))

(defn strip-ext [f String] String
  (js/call f .replace (js/new RegExp "\\.[^.]+$") ""))

;; Resolve the changed set → {:files <Set> :subs <Set> :infra <bool>}.
(defn resolve-impacted
  [files Any
   tags Any] Any
  (let [sources (U Any (Map Any Any)) (or (js/get tags .sources) {})
        srcKeys (Vec String) (js/call Object .keys sources)
        fileSet Any (js/new Set)
        subSet Any (js/new Set)
        ;; infra is a pure predicate over the changed set — no mutation needed.
        infra Bool (boolean (js/call files .some (fn [f String] Any (infra? f))))]
    (doseq [f Any files]
      (cond
        ;; a test file changed → run it directly
        (and (js/call f .startsWith "tests/integration/") (js/call f .endsWith ".bjs"))
        (js/call fileSet .add (strip-ext (js/call f .replace "tests/integration/" "")))
        ;; shared infra is handled by `infra` above — skip here
        (infra? f) nil
        ;; chrome source dir → subsystem(s)
        :else
        (doseq [k String srcKeys]
          (when (js/call f .startsWith k)
            (let [v Any (get sources k)]
              (if (js/call Array .isArray v)
                (doseq [s Any v] (js/call subSet .add s))
                (js/call subSet .add v)))))))
    {:files fileSet :subs subSet :infra infra}))

(defn run-runner! [args Any] Any
  (let [r Any (spawnSync "bun" (js/call [RUNNER] .concat args) {:cwd REPO-ROOT :stdio "inherit"})]
    (js/call process .exit (or (js/get r .status) 0))))

(defn main! [] Any
  (let [tags Any (load-tags)
        files Any (changed-files)
        impacted Any (resolve-impacted files tags)
        fset Any (js/get impacted .files)
        sset Any (js/get impacted .subs)]
    (cond
      ;; infra change OR nothing resolved → full fast lane
      (or (js/get impacted .infra)
          (and (= (js/get fset .size) 0) (= (js/get sset .size) 0)))
      (do
        (js/call (js/get process .stderr) .write (str "[changed] "
               (if (js/get impacted .infra)
                 "shared infra changed → full fast lane\n"
                 "no impacted subsystem resolved → full fast lane\n")))
        (run-runner! ["--exclude-lane" "slow,network"]))
      :else
      (let [args (Vec Any) []]
        (when (> (js/get fset .size) 0)
          (js/call args .push "--files")
          (js/call args .push (js/call (js/call Array .from fset) .join ",")))
        (when (> (js/get sset .size) 0)
          (js/call args .push "--subsystem")
          (js/call args .push (js/call (js/call Array .from sset) .join ",")))
        (js/call (js/get process .stderr) .write (str "[changed] running: " (js/call args .join " ") "\n"))
        (run-runner! args)))))

(when (js/get (js/import-meta) .main)
  (main!))
