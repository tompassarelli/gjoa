#lang beagle/js
;; `gjoa preflight` — the mechanical gate before a nix or full-mach build.
;; Exits 0 if every gate passes and 1 if any gate fails.
(ns gjoa.tools.scripts.preflight
  (:require [fs :refer [existsSync readFileSync readdirSync]]
            [child_process :refer [execSync]]
            [crypto :refer [createHash]]
            [path :refer [join basename]]
            [gjoa.tools.prep.symbol-resolve :refer [check-contract]]))
(declare-extern [process JSON RegExp Object Set Array String] Any)

;; Package scripts invoke this tool from the repository root.
(def REPO-ROOT String (js/call process .cwd))
(def ENGINE-DIR String (join REPO-ROOT "engine"))
(def FLAKE String (join REPO-ROOT "flake.nix"))
(def PATCHES-DIR String (join REPO-ROOT "patches"))
(def GJOA-JSON String (join REPO-ROOT "gjoa.json"))

(def tty Any (js/get (js/get process .stdout) .isTTY))
(defn c
  [s String
   code String] String
  (if tty (str "[" code "m" s "[0m") s))
(defn green [s String] String (c s "32"))
(defn red [s String] String (c s "31"))
(defn yellow [s String] String (c s "33"))
(defn dim [s String] String (c s "2"))
(defn bold [s String] String (c s "1"))

;; Accumulated GateResult records (plain JS objects):
;;   {:id :name :passed :warned :detail :fix}
(def results Any [])

(defn pass
  [id String
   name String
   detail String] Any
  (js/call results .push {:id id :name name :passed true :detail detail}))
(defn fail
  [id String
   name String
   detail String
   fix String] Any
  (js/call results .push {:id id :name name :passed false :detail detail :fix fix}))
;; A WARN does not fail the gate (passed: true) but flags a non-fatal,
;; inconclusive result the operator should be aware of — e.g. a nix eval that
;; timed out rather than genuinely failed.
(defn warn
  [id String
   name String
   detail String] Any
  (js/call results .push {:id id :name name :passed true :warned true :detail detail}))

(defn sh
  [cmd String
   opts Any] Any
  (try
    (let [out Any (execSync cmd {:encoding "utf8"
                             :timeout (or (js/get opts .timeout) 30000)
                             :stdio ["ignore" "pipe" "pipe"]})]
      {:ok true :out out})
    (catch (e Error)
      ;; A timeout (execSync sends SIGTERM and sets code 'ETIMEDOUT') is not a
      ;; real failure of the command — surface it so callers can WARN/skip
      ;; rather than treat it as a hard error.
      (let [timedOut Bool (or (= (js/get e .code) "ETIMEDOUT") (= (js/get e .signal) "SIGTERM"))
            stderr (U Any String) (if (js/get e .stderr) (js/call (js/get e .stderr) .toString) "")
            stdout (U Any String) (if (js/get e .stdout) (js/call (js/get e .stdout) .toString) "")]
        {:ok false
         :timedOut timedOut
         :out (or (str stderr stdout) (js/get e .message))}))))

;; ── Gate A: patches apply cleanly against fresh source ─────────────────────
(defn gateA! [] Any
  (let [cache String (str (js/get (js/get process .env) .HOME) "/.cache/gjoa/sources")
        gjoa Any (js/call JSON .parse (readFileSync GJOA-JSON "utf8"))
        tarball String (str cache "/firefox-" (js/get (js/get gjoa .firefox) .version) ".source.tar.xz")]
    (if (not (existsSync tarball))
      (fail "A" "patches apply clean on fresh source"
        (str "tarball not cached at " tarball)
        "run `bun run download` to populate the cache")
      (let [tmp String "/tmp/gjoa-preflight-engine"]
        (sh (str "rm -rf " tmp " && mkdir -p " tmp) {})
        (let [extract Any (sh (str "tar -xJf " tarball " -C " tmp " --strip-components=1") {:timeout 180000})]
          (if (not (js/get extract .ok))
            (fail "A" "patches apply clean on fresh source" "tarball extract failed" (js/call (js/get extract .out) .slice 0 400))
            (do
              (sh (str "cd " tmp " && git init -q && git add -A && git -c user.email=t@t -c user.name=t commit -q -m baseline") {:timeout 60000})
              ;; Apply patches cumulatively in the same order as `bun run import`.
              ;; Mutate `tmp` so each patch sees its predecessors, and stop on the
              ;; first failed apply because later patches depend on that tree.
              (let [patches (Vec Any) (js/call (js/call (readdirSync PATCHES-DIR) .filter (fn [p String] Any (js/call p .endsWith ".patch"))) .sort)
                    failed (Vec Any) []
                    drifted (Vec Any) []
                    stopped (Atom Bool) (atom false)]
                (doseq [p Any patches]
                  (when (not @stopped)
                    (let [path String (join PATCHES-DIR p)
                          ;; Drift WARN is computed BEFORE the real apply, on the
                          ;; current cumulative tree (--dry-run leaves it untouched):
                          ;; GNU patch reports "Hunk #N succeeded at M (offset L lines)"
                          ;; for offset git apply tolerates silently. Largest |offset|.
                          pr Any (sh (str "cd " tmp " && patch -p1 --dry-run --fuzz=0 --force -i " path " 2>&1 | grep -oiE 'offset -?[0-9]+' | grep -oE '[0-9]+' | sort -rn | head -1") {})
                          off Int (parseInt (js/call (or (js/get pr .out) "") .trim) 10)
                          ;; Real cumulative apply (no --check): mutate tmp so the
                          ;; next patch sees this one's added lines.
                          r Any (sh (str "cd " tmp " && git apply " path) {})]
                      (if (not (js/get r .ok))
                        (do
                          (js/call failed .push (str p ": " (js/call (or (aget (js/call (js/get r .out) .split "\n") 0) "") .trim)))
                          (reset! stopped true))
                        (when (> off 0)
                          (js/call drifted .push (str p " (offset " off ")")))))))
                (cond
                  (> (js/get failed .length) 0)
                  (fail "A" "patches apply clean on fresh source"
                    (str "cumulative apply stopped at the first failing patch (later patches build on it): " (js/get failed .length) " failed")
                    (str "regenerate the failing patch via `git diff` in a fresh extract WITH all prior patches applied (cumulative order matters):\n    " (js/call failed .join "\n    ")))
                  (> (js/get drifted .length) 0)
                  (warn "A" "patches apply clean on fresh source"
                    (str (js/get patches .length) "/" (js/get patches .length) " apply cumulatively, but " (js/get drifted .length) " drifting on line-offset (early warning — regenerate before they .rej): " (js/call drifted .join ", ")))
                  :else
                  (pass "A" "patches apply clean on fresh source" (str (js/get patches .length) "/" (js/get patches .length) " apply clean cumulatively, no drift")))))))))))

;; ── Gate B: chrome registration uses a known-working pattern ──────────────
(defn gateB [] Any
  (let [ours String (join REPO-ROOT "src" "gjoa" "browser" "components" "gjoa" "jar.mn")]
    (if (not (existsSync ours))
      (fail "B" "jar.mn pattern matches working example"
        (str ours " missing")
        "restore from git")
      (let [content String (readFileSync ours "utf8")
            usesBrowserJar Bool (js/call (js/new RegExp "^browser\\.jar:" "m") .test content)
            hasContentDecl Bool (js/call (js/new RegExp "^% content\\s+gjoa\\s+%content/gjoa/" "m") .test content)]
        (cond
          (not usesBrowserJar)
          (fail "B" "jar.mn pattern matches working example"
            "uses `<package>.jar:` syntax — silently no-op in modern Firefox"
            "change first non-comment line to `browser.jar:` (see browser/branding/unofficial/content/jar.mn)")

          (not hasContentDecl)
          (fail "B" "jar.mn pattern matches working example"
            "no `% content gjoa %content/gjoa/` registration line"
            "add `% content gjoa %content/gjoa/` after `browser.jar:`")

          :else
          (pass "B" "jar.mn pattern matches working example" "browser.jar: + % content gjoa %content/gjoa/"))))))

;; ── Gate C: no production-mode TODO/no-op landmines ───────────────────────
(defn gateC [] Any
  (let [prodFiles (Vec String) ["src/gjoa/browser/components/gjoa/GjoaLoader.sys.mjs"
                   "src/gjoa/chrome/bjs/security/index.bjs"
                   "src/gjoa/chrome/bjs/drawer/index.bjs"
                   "src/gjoa/chrome/bjs/spaces/index.bjs"
                   "src/gjoa/chrome/bjs/tabs/index.bjs"]
        landmines (Vec Any) []
        stub-return Regex (js/new RegExp "^\\s*return\\s*;?\\s*//\\s*(TODO|FIXME|future)" "i")
        stub-comment Regex (js/new RegExp "//\\s*(future commit|nothing yet|not yet implemented)" "i")]
    (doseq [f String prodFiles]
      (let [path String (join REPO-ROOT f)]
        (when (existsSync path)
          (let [lines (Vec String) (js/call (readFileSync path "utf8") .split "\n")]
            ;; Only flag literal "TODO" / "future commit" / "nothing yet" inside
            ;; executable code (not in jsdoc/regular comments that describe
            ;; intent). Heuristic: line ends with `return;` or matches the
            ;; specific dead-stub pattern.
            (js/call lines .forEach (fn [l String
                                         i Int] Any (when (or (js/call stub-return .test l) (js/call stub-comment .test l))
                  (js/call landmines .push (str f ":" (+ i 1) ": " (js/call l .trim))))))))))
    (if (> (js/get landmines .length) 0)
      (fail "C" "no production-mode TODO/no-op landmines"
        (str (js/get landmines .length) " suspicious dead-stub markers in production paths")
        (str "audit + implement or delete each:\n    " (js/call landmines .join "\n    ")))
      (pass "C" "no production-mode TODO/no-op landmines" (str (js/get prodFiles .length) " prod files scanned, none flagged")))))

;; ── Gate D: dep floors satisfied ──────────────────────────────────────────
(defn gateD [] Any
  (let [flakeContent String (readFileSync FLAKE "utf8")
        minNssMatch Any (js/call flakeContent .match (js/new RegExp "minNssVersion\\s*=\\s*\"([^\"]+)\""))
        minNss (U Any Nil) (if minNssMatch (aget minNssMatch 1) nil)]
    (if (nil? minNss)
      (pass "D" "dep floors satisfied" "no minNssVersion gate declared")
      (let [probe Any (sh
                    (str "nix eval --impure --raw --expr '(import (builtins.getFlake \"git+file://" REPO-ROOT "\").inputs.nixpkgs { system = \"x86_64-linux\"; }).nss_latest.version' 2>&1")
                    {:timeout 60000})]
        (if (not (js/get probe .ok))
          (fail "D" "dep floors satisfied" "could not probe nixpkgs nss_latest.version"
            (str "fix the nix eval error and re-run:\n" (js/call (js/get probe .out) .slice -300)))
          ;; compareVersions: if nixpkgs >= minNss, overlay short-circuits (good).
          ;; if behind, our overlay activates and Mozilla tarball is fetched.
          (let [nixpkgsNss Any (js/call (js/call (js/call (js/get probe .out) .trim) .split "\n") .pop)]
            (pass "D" "dep floors satisfied"
              (str "minNssVersion=" minNss ", nixpkgs nss_latest=" nixpkgsNss " → overlay "
                   ;; Beagle's `>=` is numeric, so use localeCompare for versions
                   ;; (>= 0 means nixpkgsNss >= minNss).
                   (if (>= (js/call (String nixpkgsNss) .localeCompare (String minNss)) 0) "auto-disabled" "ACTIVE (will fetch Mozilla tarball)")))))))))

;; ── Gate F: nix daemon will accept flake settings ─────────────────────────
;;
;; Two separate nix permission mechanisms get conflated easily:
;;   * trusted-users  → who can pass --option / --no-sandbox FLAGS at CLI
;;   * sandbox=true   → rejects ANY derivation with `__noChroot=true`
;;                      regardless of who's invoking
;;
;; For `__noChroot = true` to actually take effect, the daemon's
;; `sandbox` setting must be `relaxed` (or `false`). `sandbox = true`
;; rejects it at eval time even for trusted users.
(defn gateF [] Any
  ;; Strip nix comment lines before matching so we don't false-positive
  ;; on `__noChroot = true` written inside an explanation comment.
  (let [flakeContent String (js/call (js/call (js/call (readFileSync FLAKE "utf8") .split "\n") .filter (fn [l String] Any (not (js/call (js/new RegExp "^\\s*#") .test l)))) .join "\n")
        usesNoChroot Bool (js/call (js/new RegExp "__noChroot\\s*=\\s*true") .test flakeContent)
        usesImpure Bool (js/call (js/new RegExp "__impure\\s*=\\s*true") .test flakeContent)]
    (if (and (not usesNoChroot) (not usesImpure))
      (pass "F" "nix daemon will accept flake settings" "no privileged settings in flake.nix")
      (let [cfg Any (sh "nix show-config 2>/dev/null" {:timeout 15000})
            sandboxLine (U Any String) (or (js/call (js/call (js/get cfg .out) .split "\n") .find (fn [l String] Any (js/call (js/new RegExp "^sandbox = ") .test l))) "")
            sandbox String (js/call (or (aget (js/call sandboxLine .split "=") 1) "") .trim)]
        (if (and usesNoChroot (= sandbox "true"))
          (fail "F" "nix daemon will accept flake settings"
            "flake uses __noChroot but daemon has sandbox=true → rejected at eval"
            "either:\n      (a) remove __noChroot from flake.nix (Lane 1 edit; lose sccache persistence), or\n      (b) change sandbox = \"relaxed\" in nixos-config nix-settings module + firn rebuild")
          (pass "F" "nix daemon will accept flake settings"
            (str "sandbox=" sandbox " permits __noChroot/__impure")))))))

;; ── Gate G: nix flake evaluates without errors ────────────────────────────
(defn gateG [] Any
  (let [r Any (sh
            (str "nix eval --impure --raw '" REPO-ROOT "#gjoa.outPath' 2>&1")
            {:timeout 120000})]
    (if (not (js/get r .ok))
      (if (js/get r .timedOut)
        ;; A dirty git tree defeats nix's eval cache, so eval can be slow without
        ;; being broken. Don't fail the gate on a wall-clock timeout.
        (warn "G" "nix flake evaluates without errors"
          "nix eval timed out — not a real eval failure; re-run with a clean tree or longer timeout")
        (fail "G" "nix flake evaluates without errors"
          "evaluation failed — build cannot proceed"
          (js/call (js/call (js/call (js/call (js/get r .out) .split "\n") .filter (fn [l String] Any (js/call (js/call l .toLowerCase) .includes "error"))) .slice 0 5) .join "\n      ")))
      (pass "G" "nix flake evaluates without errors" (str "derivation resolves to " (js/call (js/call (js/call (js/call (js/get r .out) .trim) .split "\n") .pop) .slice -50))))))

;; ── Gate I: chrome bundle three-way alignment ─────────────────────────────
(defn gateI [] Any
  (let [loaderPath String (join REPO-ROOT "src" "gjoa" "browser" "components" "gjoa" "GjoaLoader.bjs")
        jarPath String (join REPO-ROOT "src" "gjoa" "browser" "components" "gjoa" "jar.mn")
        bakePath String (join REPO-ROOT "tools" "prep" "chrome-bake.bjs")]
    (if (not (js/call [loaderPath jarPath bakePath] .every existsSync))
      (fail "I" "chrome bundle three-way alignment" "one of loader/jar/bake missing" "investigate")
      (let [loader String (readFileSync loaderPath "utf8")
            jar String (readFileSync jarPath "utf8")
            bake String (readFileSync bakePath "utf8")
            loaderScripts (Vec Any) (js/call (js/call (js/call Array .from (js/call loader .matchAll (js/new RegExp "\"(gjoa-[a-z-]+\\.uc\\.js)\"" "g"))) .map (fn [m Any] Any (aget m 1))) .sort)
            jarScripts (Vec Any) (js/call (js/call (js/call (js/call Array .from (js/call jar .matchAll (js/new RegExp "scripts/(gjoa-[a-z-]+\\.uc\\.js)" "g"))) .map (fn [m Any] Any (aget m 1))) .filter (fn [v String
                                                                                                                                                                                                                i Int
                                                                                                                                                                                                                a (Vec String)] Any (= (js/call a .indexOf v) i))) .sort)
            bakeScripts (Vec Any) (js/call (js/call (js/call Array .from (js/call bake .matchAll (js/new RegExp "\"(gjoa-[a-z-]+\\.uc\\.js)\"" "g"))) .map (fn [m Any] Any (aget m 1))) .sort)
            ;; CSS bundles include the bare `gjoa.uc.css` (no hyphen suffix), so the
            ;; style pattern must allow an optional `-...` segment.
            loaderStyles (Vec Any) (js/call (js/call (js/call Array .from (js/call loader .matchAll (js/new RegExp "\"(gjoa(?:-[a-z-]+)?\\.uc\\.css)\"" "g"))) .map (fn [m Any] Any (aget m 1))) .sort)
            jarStyles (Vec Any) (js/call (js/call (js/call (js/call Array .from (js/call jar .matchAll (js/new RegExp "styles/(gjoa(?:-[a-z-]+)?\\.uc\\.css)" "g"))) .map (fn [m Any] Any (aget m 1))) .filter (fn [v String
                                                                                                                                                                                                                    i Int
                                                                                                                                                                                                                    a (Vec String)] Any (= (js/call a .indexOf v) i))) .sort)
            bakeStyles (Vec Any) (js/call (js/call (js/call Array .from (js/call bake .matchAll (js/new RegExp "\"(gjoa(?:-[a-z-]+)?\\.uc\\.css)\"" "g"))) .map (fn [m Any] Any (aget m 1))) .sort)
            eq (Fn [Any Any] Any) (fn [a Any
                                       b Any] Any (and (= (js/get a .length) (js/get b .length))
                      (js/call a .every (fn [x String
                                             i Int] Any (= x (aget b i))))))]
        (cond
          (or (not (eq loaderScripts jarScripts)) (not (eq loaderScripts bakeScripts)))
          (fail "I" "chrome bundle three-way alignment"
            (str "script lists differ:\n      loader: " (js/call loaderScripts .join ", ") "\n      jar:    " (js/call jarScripts .join ", ") "\n      bake:   " (js/call bakeScripts .join ", "))
            "align all three so they declare the exact same .uc.js filenames")

          (or (not (eq loaderStyles jarStyles)) (not (eq loaderStyles bakeStyles)))
          (fail "I" "chrome bundle three-way alignment"
            (str "style lists differ:\n      loader: " (js/call loaderStyles .join ", ") "\n      jar:    " (js/call jarStyles .join ", ") "\n      bake:   " (js/call bakeStyles .join ", "))
            "align all three so they declare the exact same .uc.css filenames")

          :else
          (pass "I" "chrome bundle three-way alignment"
            (str (js/get loaderScripts .length) " script + " (js/get loaderStyles .length) " style bundles agree across loader / jar.mn / chrome-bake.bjs")))))))

;; ── Gate J: vendored scriptlet bundle matches its pinned SHA-256 ──────────
;; scriptlet-resources.json is base64-encoded JS run via evalInSandbox on the
;; privileged side of the content classifier; a swapped/tampered bundle injects
;; attacker JS into pages. Assert it still matches the digest recorded in
;; scriptlet-resources.PROVENANCE.md.
(defn gateJ [] Any
  (let [script String (join REPO-ROOT "tools" "prep" "verify-scriptlet-resources.sh")]
    (if (not (existsSync script))
      (fail "J" "scriptlet bundle integrity" "verify-scriptlet-resources.sh missing" "restore the F10 verifier")
      (let [r Any (sh (str "bash " script) {})]
        (if (js/get r .ok)
          (pass "J" "scriptlet bundle integrity" "scriptlet-resources.json matches the pinned SHA-256")
          (fail "J" "scriptlet bundle integrity"
            (js/call (or (js/get r .out) "digest mismatch") .trim)
            "if you refreshed the bundle from a pinned uBO commit, update the SHA-256 in verify-scriptlet-resources.sh AND scriptlet-resources.PROVENANCE.md"))))))

;; ── Gate K: engine/ reflects current source (import-currency) ───────────────
;; The compile input is engine/ (gitignored), which mirrors src/gjoa/ + patches/
;; only after `bun run import`. Import stamps engine/.gjoa-import-stamp; a newer
;; source file means engine/ must be re-imported before building.
(def IMPORT-STAMP String (join ENGINE-DIR ".gjoa-import-stamp"))
(defn gateK [] Any
  (if (not (existsSync IMPORT-STAMP))
    (fail "K" "engine/ reflects current source (import-currency)"
      "no engine/.gjoa-import-stamp — engine/ is unimported"
      "run `bun run import` to (re)build engine/ from src/gjoa/ + patches/")
    (let [stamp-r Any (sh (str "stat -c %Y '" IMPORT-STAMP "'") {})
          newest-r Any (sh "find src/gjoa patches tools/prep -type f -printf '%T@\\n' 2>/dev/null | sort -rn | head -1" {})
          stamp-out String (js/call (or (js/get stamp-r .out) "") .trim)
          newest-out String (js/call (or (js/get newest-r .out) "") .trim)]
      (if (or (not (js/get stamp-r .ok)) (not (js/get newest-r .ok)) (= stamp-out "") (= newest-out ""))
        (warn "K" "engine/ reflects current source (import-currency)"
          "could not determine source/stamp mtimes — skipping (non-fatal)")
        (if (> (parseInt newest-out 10) (parseInt stamp-out 10))
          (fail "K" "engine/ reflects current source (import-currency)"
            "src/gjoa/, patches/, or tools/prep/ changed since the last `bun run import`"
            "run `bun run import` — the build compiles engine/, not src/, so un-imported edits silently vanish from the binary")
          (pass "K" "engine/ reflects current source (import-currency)"
            "no src/patches/tooling edits since the last import"))))))

;; ── Gate L: surface contracts (declared upstream deps still resolve) ────────
;; A patch/overlay DEPENDS ON upstream symbols it references but does not patch
;; (a Rust path, a generated style-struct accessor, a JS object property). git
;; apply (Gate A) is blind to these — they're added tokens, not context — so a
;; MOVE/REMOVAL passes apply and dies 26 min into the compile (ComputedValueFlags
;; module move; background_image field removal) or ships a silent no-op
;; (FF152 deleting AboutNewTab.newTabURL). A `# depends-on:` / `;; @gjoa-depends-on`
;; block declares those anchors; Gate L resolves each against engine/, RED before
;; the build if one vanished.
(def OVERLAY-FILES Any
  [(join REPO-ROOT "src" "gjoa" "browser" "components" "gjoa" "GjoaLoader.bjs")])
;; Count raw `# depends-on` bullets — every `- <kind> ...` line whose kind carries a
;; dep marker. DECLARED count; check-contract returns the EVALUATED count. Any gap =
;; the parser silently dropped a declared dep (the cpp-symbol/cpp-member skew) — fail-closed.
(def DEP-BULLET-RE Any (js/new RegExp "(?:#|;;)\\s*-\\s*((?:rust|cpp|webidl|js)-[a-z-]+)\\s+\\S" "gm"))
(defn count-declared-deps [text String] Int
  (let [m Any (js/call text .match DEP-BULLET-RE)]
    (if m (js/get m .length) 0)))
(defn gateL [] Any
  (let [patch-files (Vec Any) (js/call (js/call (readdirSync PATCHES-DIR) .filter (fn [p String] Bool (js/call p .endsWith ".patch"))) .map (fn [p String] String (join PATCHES-DIR p)))
        files (Vec Any) (js/call patch-files .concat (js/call OVERLAY-FILES .filter (fn [f String] Bool (existsSync f))))
        not-found (Vec Any) []
        ambiguous (Vec Any) []
        unsupported (Vec Any) []
        dropped (Vec Any) []
        resolved (Vec Any) []]
    (doseq [f Any files]
      (let [text String (readFileSync f "utf8")
            results Any (check-contract text)
            declared Int (count-declared-deps text)]
        ;; reconciliation: every declared `# depends-on` bullet MUST produce an evaluated
        ;; result; a shortfall = the parser silently dropped a dep (unknown/typo'd kind).
        (let [result-count Int (js/get results .length)
              delta Int (- declared result-count)]
          (if (> delta 0)
            (js/call dropped .push (str (basename f) ": " delta " declared depends-on bullet(s) parsed to nothing (unknown/typo'd kind — vocabulary drift)"))))
        (doseq [r Any results]
          (cond
            (= (js/get r .verdict) "not-found")
            (js/call not-found .push (str (basename f) ": " (js/get r .kind) " `" (js/get r .symbol) "` — " (js/get r .detail)))
            (= (js/get r .verdict) "unsupported")
            (js/call unsupported .push (str (basename f) ": " (js/get r .kind) " `" (js/get r .symbol) "` — " (js/get r .detail)))
            (= (js/get r .verdict) "ambiguous")
            (js/call ambiguous .push (str (basename f) ": " (js/get r .symbol)))
            :else (js/call resolved .push (js/get r .symbol))))))
    (cond
      ;; FAIL-CLOSED: a dep that moved (not-found), one the resolver can't evaluate
      ;; (unsupported kind), or one the parser dropped (declared>evaluated) blocks the build.
      ;; Green means every declared anchor resolved.
      (> (+ (+ (js/get not-found .length) (js/get unsupported .length)) (js/get dropped .length)) 0)
      (fail "L" "surface contracts (declared upstream deps resolve)"
        (str (+ (+ (js/get not-found .length) (js/get unsupported .length)) (js/get dropped .length)) " declared dependency(ies) unresolved or unevaluated (" (js/get resolved .length) " resolved)")
        (str "regenerate the patch/overlay against current upstream, or fix the dep declaration:\n    "
             (js/call (js/call (js/call not-found .concat unsupported) .concat dropped) .join "\n    ")))
      (> (js/get ambiguous .length) 0)
      (warn "L" "surface contracts (declared upstream deps resolve)"
        (str (js/get resolved .length) " resolved, " (js/get ambiguous .length) " ambiguous (cfg/glob/no-objdir — can't prove): " (js/call ambiguous .join ", ")))
      :else
      (pass "L" "surface contracts (declared upstream deps resolve)"
        (str (js/get resolved .length) " declared upstream dependencies resolve")))))

;; ── Gate M: beagle compiler pinned (beagle-currency) ───────────────────────
;; Local builds compile against the immutable checkout at
;; ~/code/beagle/pins/<full-object-id>, where the leaf comes directly from
;; configs/beagle.ref. CI supplies BEAGLE_PIN_ROOT for its checkout of the same
;; object. This is a hard fail because the emit/runtime contract is ref-specific.
(def BEAGLE-REF-FILE String (join REPO-ROOT "configs" "beagle.ref"))
(defn beagle-pin-dir [pinned String] String
  (or (js/get (js/get process .env) .BEAGLE_PIN_ROOT)
      (join (js/get (js/get process .env) .HOME) "code" "beagle" "pins" pinned)))
(defn gate-m-fix
  [pinned String
   pin-dir String] String
  (str "create the immutable content-addressed pin for this full object ID:\n"
       "      `git -C ~/code/beagle/main worktree add --detach " pin-dir " " pinned "`\n"
       "      write `" pin-dir ".pin` naming Gjoa as a consumer\n"
       "    To bump deliberately: create the new pin → update configs/beagle.ref → "
       "`bun run import` (re-vendors core.js) → `bun run sovereignty:manifest` "
       "(recompile chrome) → smoke-test → commit together. Never re-point an existing pin."))
(defn gateM [] Any
  (if (not (existsSync BEAGLE-REF-FILE))
    (fail "M" "beagle compiler pinned (beagle-currency)"
      "no configs/beagle.ref — gjoa has no reproducible Beagle compiler object"
      "record the intended full object ID, then create its immutable content-addressed pin")
    (let [lines (Vec String) (js/call (readFileSync BEAGLE-REF-FILE "utf8") .split "\n")
          pinned String (js/call (or (js/call lines .find (fn [l String] Bool
                                           (and (> (js/get (js/call l .trim) .length) 0)
                                                (not (js/call (js/call l .trim) .startsWith "#"))))) "") .trim)
          valid-ref Bool (js/call (js/new RegExp "^[0-9a-f]+$") .test pinned)
          pin-dir String (beagle-pin-dir pinned)
          r (U Any (Map Keyword (U Bool String))) (if valid-ref
              (sh (str "git -C " pin-dir " rev-parse HEAD") {})
              {:ok false :out ""})
          actual String (js/call (or (js/get r .out) "") .trim)]
      (cond
        (= pinned "") (fail "M" "beagle compiler pinned (beagle-currency)"
                        "configs/beagle.ref has no ref line"
                        "add the intended beagle commit hash to configs/beagle.ref")
        (not valid-ref) (fail "M" "beagle compiler pinned (beagle-currency)"
                          "configs/beagle.ref must contain one lowercase hexadecimal full object ID"
                          "replace the ref with `git -C ~/code/beagle/main rev-parse HEAD`")
        (or (not (js/get r .ok)) (= actual "")) (fail "M" "beagle compiler pinned (beagle-currency)"
                                            (str "could not read " pin-dir " HEAD — the pin checkout is missing")
                                            (gate-m-fix pinned pin-dir))
        (= actual pinned) (pass "M" "beagle compiler pinned (beagle-currency)"
                             (str pin-dir " at pinned ref " (js/call pinned .slice 0 12)))
        :else (fail "M" "beagle compiler pinned (beagle-currency)"
                (str pin-dir " HEAD " (js/call actual .slice 0 12) " != pinned " (js/call pinned .slice 0 12)
                     " — chrome would be compiled against a DIFFERENT beagle than pinned (emit/$$bc-runtime drift)")
                (gate-m-fix pinned pin-dir))))))

;; ── Gate N: knobs backed + reversible (knob-not-delete) ────────────────────
;; Every knob about:gjoa exposes (settings/registry.json) must be backed by a pref
;; actually SET in source. A dangling knob — whose feature was deleted but whose
;; toggle remains — is a no-op that lies to the user; this gate makes that deletion
;; impossible to ship silently (restore the pref, reversibly, or remove the knob).
;; Also asserts the registry privacy-profile `sets` prefs == GjoaLoader's
;; PRIVACY-PRESETS prefs, so the picker sets exactly what the loader applies.
(def REGISTRY-FILE String
  (join REPO-ROOT "src" "gjoa" "browser" "components" "gjoa" "content" "settings" "registry.json"))
(def LOADER-FILE String
  (join REPO-ROOT "src" "gjoa" "browser" "components" "gjoa" "GjoaLoader.bjs"))
(def PREF-DIR String (join REPO-ROOT "src" "gjoa" "defaults" "pref"))

(defn quoted-strings [s String] Any
  (let [m Any (js/call s .match (js/new RegExp "\"[^\"]+\"" "g"))]
    (if m (js/call m .map (fn [q String] String (js/call q .slice 1 -1))) [])))

(defn preset-pref-names [loader String] Any
  ;; pref-names referenced in the PRIVACY-PRESETS def: quoted strings containing a
  ;; "." (pref names have dots; "bool"/"int" and the profile-id keys don't).
  (let [start Int (js/call loader .indexOf "(def PRIVACY-PRESETS")
        end Int (js/call loader .indexOf "(defn apply-privacy-profile!")
        block String (if (and (>= start 0) (> end start)) (js/call loader .slice start end) "")]
    (js/call (quoted-strings block) .filter (fn [q String] Bool (js/call q .includes ".")))))

(defn gateN [] Any
  (if (not (and (existsSync REGISTRY-FILE) (existsSync LOADER-FILE) (existsSync PREF-DIR)))
    (warn "N" "knobs backed + reversible (knob-not-delete)"
      "no about:gjoa registry/loader/prefs — skipping")
    (let [reg Any (js/call JSON .parse (readFileSync REGISTRY-FILE "utf8"))
          loader String (readFileSync LOADER-FILE "utf8")
          pref-src String (js/call (js/call (js/call (readdirSync PREF-DIR) .filter (fn [f String] Bool (js/call f .endsWith ".bjs"))) .map (fn [f String] String (readFileSync (join PREF-DIR f) "utf8"))) .join "\n")
          src String (str pref-src "\n" loader)
          pv Any (js/get reg .privacy)
          sel Any (and pv (js/get pv .selector))
          profiles (U Any (Vec Any)) (or (and sel (js/get sel .profiles)) [])
          knob-prefs (Vec Any) []
          _g Any (doseq [g Any (or (and pv (js/get pv .granular)) [])] (js/call knob-prefs .push (js/get g .pref)))
          _ps Any (doseq [p Any profiles] (doseq [k String (js/call Object .keys (js/get p .sets))] (js/call knob-prefs .push k)))
          _s Any (doseq [sec Any (or (js/get reg .sections) [])]
               (doseq [s Any (or (js/get sec .settings) [])] (js/call knob-prefs .push (js/get s .pref)))
               ;; sections may group settings under named subsections (e.g.
               ;; "Dark mode & color" -> Dark mode / Theme); walk those too so
               ;; every nested knob is still backing-checked.
               (doseq [sub Any (or (js/get sec .subsections) [])]
                 (doseq [s Any (or (js/get sub .settings) [])] (js/call knob-prefs .push (js/get s .pref)))))
          dangling (Vec Any) (js/call knob-prefs .filter (fn [pf String] Bool (not (js/call src .includes (str "\"" pf "\"")))))
          reg-prefs (Vec Any) (js/call (js/call Array .from (js/new Set (js/call profiles .flatMap (fn [p Any] Any (js/call Object .keys (js/get p .sets)))))) .sort)
          preset-prefs (Vec Any) (js/call (js/call Array .from (js/new Set (preset-pref-names loader))) .sort)
          drift Bool (not (= (js/call reg-prefs .join "|") (js/call preset-prefs .join "|")))]
      (cond
        (> (js/get dangling .length) 0)
        (fail "N" "knobs backed + reversible (knob-not-delete)"
          (str (js/get dangling .length) " knob(s) reference a pref set nowhere in source")
          (str "a feature was deleted but its knob remains (or a typo) — restore the pref (reversible!) or drop the knob:\n    " (js/call dangling .join "\n    ")))
        drift
        (fail "N" "knobs backed + reversible (knob-not-delete)"
          "registry privacy `sets` prefs != GjoaLoader PRIVACY-PRESETS prefs"
          (str "the picker would set different prefs than the loader applies — sync them.\n    registry: " (js/call reg-prefs .join ", ") "\n    PRESETS:  " (js/call preset-prefs .join ", ")))
        :else
        (pass "N" "knobs backed + reversible (knob-not-delete)"
          (str (js/get knob-prefs .length) " knobs backed by real prefs; privacy presets (" (js/get preset-prefs .length) " prefs) in sync with the loader"))))))

;; ── Gate O: no bare beagle/ runtime specifier in shipped gjoa .sys.mjs ─────
;; beagle's value-semantics emit injects `import * as $$bc from 'beagle/core.js'`.
;; Firefox's chrome ES loader cannot resolve a bare specifier; it must be rewritten
;; to resource:///modules/gjoa/beagle/ at compile (tools/prep/overlay.bjs sets
;; BEAGLE_JS_RUNTIME_PREFIX). Every .bjs-authored .sys.mjs must use that prefix
;; or Firefox cannot load the module. Fail before the multi-hour build.
(defn gateO [] Any
  (let [gjoaDir String (join REPO-ROOT "engine" "browser" "components" "gjoa")]
    (if (not (existsSync gjoaDir))
      (warn "O" "no bare beagle/ import in shipped gjoa .sys.mjs"
        "engine/ not extracted yet — run after `bun run import`")
      (let [dirs String (str gjoaDir " " (join REPO-ROOT "engine" "toolkit" "components" "content-classifier"))
            r Any (sh (str "grep -rlE \"from 'beagle/\" " dirs " --include=*.sys.mjs 2>/dev/null || true") {})
            hits String (js/call (or (js/get r .out) "") .trim)]
        (if (= hits "")
          (pass "O" "no bare beagle/ import in shipped gjoa .sys.mjs"
            "all $$bc runtime imports resolve to resource:///modules/gjoa/beagle/")
          (fail "O" "no bare beagle/ import in shipped gjoa .sys.mjs"
            (str "unresolvable bare `import from 'beagle/...'` in: " (js/call hits .replaceAll "\n" ", "))
            "compile that .bjs with BEAGLE_JS_RUNTIME_PREFIX=resource:///modules/gjoa/beagle/ (tools/prep/overlay.bjs) + vendor the runtime"))))))

;; ── Gate P: patch-hash drift ───────────────────────────────────────────────
;; configs/patch-hashes.json records the expected SHA-256 of every patch. Gate P
;; rejects changed, unrecorded, and deleted patch entries.
(def PATCH-HASHES-FILE String (join REPO-ROOT "configs" "patch-hashes.json"))
(defn sha256-file [path String] String
  (js/call (js/call (createHash "sha256") .update (readFileSync path)) .digest "hex"))
(defn gateP [] Any
  (if (not (existsSync PATCH-HASHES-FILE))
    (fail "P" "patch hashes match recorded manifest"
      "no configs/patch-hashes.json — patch drift is unguarded"
      "create configs/patch-hashes.json with {\"algorithm\":\"sha256\",\"patches\":{<file>:<sha256>}} for every patches/*.patch")
    (let [manifest Any (js/call JSON .parse (readFileSync PATCH-HASHES-FILE "utf8"))
          recorded (U Any (Map Any Any)) (or (js/get manifest .patches) {})
          patches (Vec Any) (js/call (js/call (readdirSync PATCHES-DIR) .filter (fn [p String] Bool (js/call p .endsWith ".patch"))) .sort)
          mismatched (Vec Any) []
          missing (Vec Any) []]
      ;; current patches whose hash drifted or that aren't recorded at all
      (doseq [p Any patches]
        (let [actual String (sha256-file (join PATCHES-DIR p))
              expected Any (js/get recorded p)]
          (cond
            (nil? expected) (js/call missing .push (str p " (no entry in manifest)"))
            (not (= actual expected))
            (js/call mismatched .push (str p ": recorded " (js/call expected .slice 0 12) "… actual " (js/call actual .slice 0 12) "…")))))
      ;; manifest entries whose patch was deleted (stale record)
      (let [stale (Vec Any) (js/call (js/call Object .keys recorded) .filter (fn [k String] Bool (= (js/call patches .indexOf k) -1)))]
        (cond
          (or (> (js/get mismatched .length) 0) (> (js/get missing .length) 0) (> (js/get stale .length) 0))
          (fail "P" "patch hashes match recorded manifest"
            (str (js/get mismatched .length) " drifted, " (js/get missing .length) " unrecorded, " (js/get stale .length) " stale entry(ies)")
            (str "a patch changed without updating its recorded hash — review the diff, then regenerate the manifest:\n"
                 "      cd patches && for f in $(ls *.patch | sort); do echo \"$f $(sha256sum \"$f\" | cut -d' ' -f1)\"; done\n"
                 "    drift:      " (js/call mismatched .join "\n                ") "\n"
                 "    unrecorded: " (js/call missing .join ", ") "\n"
                 "    stale:      " (js/call stale .join ", ")))
          :else
          (pass "P" "patch hashes match recorded manifest"
            (str (js/get patches .length) "/" (js/get patches .length) " patch hashes match configs/patch-hashes.json")))))))

;; ── Gate Q: $$bc runtime export-closure (emit ↔ vendored core.js) ──────────
;; gjoa's chrome compiles against the pinned beagle (configs/beagle.ref) and
;; references the value-semantics runtime ($$bc) two ways:
;;   (a) namespace property access `$$bc.X`        — in the .uc.js bundles
;;       (window.$$bc is the ESM namespace import set up by GjoaLoader), and
;;   (b) ESM named imports `import { X as $$bc$… } from '…/beagle/core.js'`
;;       — in .sys.mjs files. A missing named export is a module-load SyntaxError,
;;       so the gate parses both reference forms.
;; Assertion: for every emitted gjoa chrome file, the set of beagle-runtime
;; symbols it references must be a SUBSET of the vendored core.js export surface.
;; Any `file: symbol` not exported is a hard fail.
(def VENDORED-CORE String
  (join ENGINE-DIR "browser" "components" "gjoa" "beagle" "core.js"))
(def GJOA-LOADER-MJS String
  (join ENGINE-DIR "browser" "components" "gjoa" "GjoaLoader.sys.mjs"))
;; CANONICAL bundle output: `bun run chrome:dist` always (re)writes dist/chrome/JS.
;; This is the single source of truth the dev loader AND chrome:install/bake both
;; consume — and it's fresh after every Lane-1 cycle, unlike the obj-* deploy dir
;; (a stale MACH-build artifact between builds). Scan this FIRST.
(def GJOA-BUNDLE-DIST-DIR String
  (join REPO-ROOT "dist" "chrome" "JS"))
;; Canonical direct export surface of the vendored core.js.
(defn core-export-surface [src String] Any
  (let [surface Any (js/new Set)]
    (doseq [m Any (js/call Array .from (js/call src .matchAll (js/new RegExp "export\\s+(?:function|const)\\s+([A-Za-z_$][A-Za-z0-9_$]*)" "g")))]
      (js/call surface .add (aget m 1)))
    surface))

;; beagle-runtime EXPORT symbols a chrome file references for CLOSURE checking
;; (each must exist in core.js's export surface), two forms:
;;   (a) `$$bc.X` namespace access — in .uc.js bundles (window.$$bc is the
;;       namespace; the bundler's per-file `const $$bc$L = $$bc.X;` preludes also
;;       land here, so the closure-relevant X is the real export), and
;;   (b) `import { X as … } from '<…>/beagle/core.js'` named-import (.sys.mjs).
;; The bare named-import local `$$bc$L` is not a closure symbol: its suffix L is
;; Beagle's local name, not an export (e.g.
;; `$$bc$equiv` ← export `equivV`, NOT `equiv`). Its real export reaches closure
;; via the prelude's `$$bc.X` (form a); whether that prelude EXISTS at all is the
;; separate binding-presence assertion in gateQ. (Scanning `$$bc$L` suffixes for
;; closure would mis-check a local against the export set — the wrong invariant.)
(defn referenced-runtime-symbols [src String] Any
  (let [refs Any (js/new Set)]
    ;; (a) namespace property access
    (doseq [m Any (js/call Array .from (js/call src .matchAll (js/new RegExp "\\$\\$bc\\.([A-Za-z_$][A-Za-z0-9_$]*)" "g")))]
      (js/call refs .add (aget m 1)))
    ;; (b) ESM named imports from any `…/beagle/core.js` specifier. Capture the
    ;; brace clause, then each `X` / `X as Y` (imported name X must be exported).
    (doseq [m Any (js/call Array .from (js/call src .matchAll (js/new RegExp "import\\s*\\{([^}]*)\\}\\s*from\\s*['\"][^'\"]*beagle/core\\.js['\"]" "g")))]
      (doseq [clause String (js/call (aget m 1) .split ",")]
        (let [t String (js/call clause .trim)]
          (when (> (js/get t .length) 0)
            (js/call refs .add (js/call (aget (js/call t .split (js/new RegExp "\\s")) 0) .trim))))))
    refs))

(defn gateQ [] Any
  (if (not (existsSync VENDORED-CORE))
    (warn "Q" "$$bc runtime export-closure (emit ↔ core.js)"
      "engine/.../beagle/core.js not vendored yet — run after `bun run import`")
    (if (not (existsSync GJOA-BUNDLE-DIST-DIR))
      (fail "Q" "$$bc runtime export-closure (emit ↔ core.js)"
        "dist/chrome/JS is missing"
        "run `bun run chrome:dist` to produce the canonical chrome bundle output")
      (let [surface Any (core-export-surface (readFileSync VENDORED-CORE "utf8"))
            bundle-files (Vec Any) (js/call (js/call (readdirSync GJOA-BUNDLE-DIST-DIR) .filter (fn [f String] Bool (js/call f .endsWith ".uc.js"))) .map (fn [f String] String (join GJOA-BUNDLE-DIST-DIR f)))
          ;; Any other emitted gjoa .sys.mjs that imports the beagle runtime.
          gjoa-dir String (join ENGINE-DIR "browser" "components" "gjoa")
            mjs-files (Vec Any) (if (existsSync gjoa-dir)
                      (js/call (js/call (readdirSync gjoa-dir) .filter (fn [f String] Bool
                                       (and (js/call f .endsWith ".sys.mjs")
                                            (js/call (readFileSync (join gjoa-dir f) "utf8") .includes "beagle/core.js")))) .map (fn [f String] String (join gjoa-dir f)))
                      [])
          ;; GjoaLoader is always in mjs-files if present (it imports core.js),
          ;; but include it explicitly so a non-importing-but-$$bc file is caught too.
          files (Vec Any) (js/call (js/call Array .from (js/new Set (js/call [GJOA-LOADER-MJS] .concat bundle-files mjs-files))) .filter (fn [f String] Bool (existsSync f)))
            offenders (Vec Any) []]
      (doseq [f Any files]
        (let [refs Any (referenced-runtime-symbols (readFileSync f "utf8"))]
          (doseq [sym Any (js/call Array .from refs)]
            (when (not (js/call surface .has sym))
              (js/call offenders .push (str (basename f) ": " sym))))))
      ;; binding-presence: in a .uc.js bundle the value-runtime locals `$$bc$L`
      ;; are bare refs that resolve ONLY because the bundler (build.bjs
      ;; rewrite-core-import) emits a per-file `const $$bc$L = $$bc.<export>;`
      ;; prelude from beagle's stripped core.js import. Export-closure (above)
      ;; cannot catch a missing prelude. Assert that every local a bundle references
      ;; is declared in that same bundle; otherwise loading raises ReferenceError.
      (doseq [f Any bundle-files]
        (when (existsSync f)
          (let [src String (readFileSync f "utf8")
                declared Any (js/new Set)
                referenced Any (js/new Set)]
            ;; declared: LHS of each `const $$bc$L = $$bc.…` prelude binding.
            (doseq [m Any (js/call Array .from (js/call src .matchAll (js/new RegExp "\\$\\$bc\\$([A-Za-z_$][A-Za-z0-9_$]*)\\s*=\\s*\\$\\$bc\\." "g")))]
              (js/call declared .add (aget m 1)))
            ;; referenced: every `$$bc$L` occurrence (incl. the decl LHS, which is
            ;; thus self-satisfied — only body-only refs can be orphans).
            (doseq [m Any (js/call Array .from (js/call src .matchAll (js/new RegExp "\\$\\$bc\\$([A-Za-z_$][A-Za-z0-9_$]*)" "g")))]
              (js/call referenced .add (aget m 1)))
            (doseq [sym Any (js/call Array .from referenced)]
              (when (not (js/call declared .has sym))
                (js/call offenders .push (str (basename f) ": $$bc$" sym " referenced but unbound — no `const $$bc$" sym " = $$bc.<export>` prelude (bundler rewrite-core-import missing/regressed)")))))))
      (if (> (js/get offenders .length) 0)
        (fail "Q" "$$bc runtime export-closure (emit ↔ core.js)"
          (str (js/get offenders .length) " emitted runtime reference(s) not exported by the vendored core.js")
          (str "the beagle emit references a $$bc symbol the vendored core.js doesn't export "
               "(ESM named-import of a missing export = module-load SyntaxError → gjoa chrome never initializes). "
               "bump configs/beagle.ref to a Beagle object whose core.js directly exports it, then re-import:\n    "
               (js/call offenders .join "\n    ")))
        (pass "Q" "$$bc runtime export-closure (emit ↔ core.js)"
          (str (js/get files .length) " emitted file(s) scanned; all $$bc refs (namespace + named-import) ⊆ "
               (js/get surface .size) " core.js exports")))))))

;; ── Gate R: security mitigations intact ──────────────────────────────────────
;; configs/security-mitigations.json records each mitigation's source file,
;; required source patterns, and optional validator reject/accept cases.
;; GjoaCosmeticChild.sys.mjs cannot be imported outside a chrome window, so the
;; gate extracts its validator regex from source and tests that regex directly.
(def MITIGATIONS-FILE String (join REPO-ROOT "configs" "security-mitigations.json"))
(defn gateR [] Any
  (if (not (existsSync MITIGATIONS-FILE))
    (fail "R" "security mitigations intact"
      "no configs/security-mitigations.json — security mitigation checks are unavailable"
      "create configs/security-mitigations.json with {\"mitigations\":{<id>:{file,mustMatch,[extractRegex,mustReject,mustAccept]}}}")
    (let [manifest Any (js/call JSON .parse (readFileSync MITIGATIONS-FILE "utf8"))
          mits (U Any (Map Any Any)) (or (js/get manifest .mitigations) {})
          ids (Vec String) (js/call Object .keys mits)
          problems (Vec Any) []]
      (doseq [id String ids]
        (let [e Any (js/get mits id)
              rel Any (js/get e .file)
              path String (join REPO-ROOT rel)]
          (if (not (existsSync path))
            (js/call problems .push (str id ": source file " rel " is missing"))
            (let [src String (readFileSync path "utf8")]
              ;; (1) every mustMatch regex must still hit the source.
              (doseq [rx Any (or (js/get e .mustMatch) [])]
                (when (not (js/call (js/new RegExp rx "m") .test src))
                  (js/call problems .push (str id ": required pattern /" rx "/ is absent from " rel))))
              ;; (2) extract the validator regex literal from source text + re-test
              ;; it against the reject/accept corpus (cannot import the actor).
              (let [ex Any (js/get e .extractRegex)]
                (when ex
                  (let [m Any (js/call src .match (js/new RegExp (js/get ex .from)))]
                    (if (not (and m (aget m 1)))
                      (js/call problems .push (str id ": extractRegex /" (js/get ex .from) "/ found no regex literal in " rel))
                      (let [lit Any (aget m 1)
                            ;; strip the surrounding slashes (and any flags) → the regex body.
                            body-m Any (js/call lit .match (js/new RegExp "^/(.*)/([a-z]*)$"))
                            body Any (if body-m (aget body-m 1) lit)
                            flags Any (if body-m (aget body-m 2) "")
                            re Any (try (js/new RegExp body flags) (catch (_e Error) nil))]
                        (if (not re)
                          (js/call problems .push (str id ": extracted literal `" lit "` is not a constructable RegExp"))
                          (do
                            ;; mustReject: each MUST be rejected (regex matches → safeSelector drops it).
                            (doseq [s Any (or (js/get e .mustReject) [])]
                              (when (not (js/call re .test s))
                                (js/call problems .push (str id ": mustReject " (js/call JSON .stringify s) " is NOT rejected by the current " (js/get ex .name) " — breakout no longer blocked"))))
                            ;; mustAccept: each MUST be accepted (regex must NOT match).
                            (doseq [s Any (or (js/get e .mustAccept) [])]
                              (when (js/call re .test s)
                                (js/call problems .push (str id ": mustAccept " (js/call JSON .stringify s) " is now WRONGLY rejected by " (js/get ex .name) " — over-broad, real rules dropped")))))))))))))))
      (if (> (js/get problems .length) 0)
        (fail "R" "security mitigations intact"
          (str (js/get problems .length) " mitigation check(s) failed across " (js/get ids .length) " entry(ies)")
          (str "security mitigation source does not match the manifest — restore it or update configs/security-mitigations.json:\n    "
               (js/call problems .join "\n    ")))
        (pass "R" "security mitigations intact"
          (str (js/get ids .length) " mitigation(s) intact (mustMatch + extracted-regex reject/accept all hold)"))))))

;; ── Gate S: security-critical patches persist ────────────────────────────────
;; A patch whose header carries a `# security:` block must apply and every upstream
;; anchor it `depends-on` must resolve. Non-apply and unresolved anchors fail closed.
(defn patch-security-block? [text String] Bool
  ;; `# security:` (with optional indent) anywhere in the header region.
  (js/call (js/new RegExp "^#\\s*security:\\s*$" "m") .test text))
(defn gateS! [] Any
  (let [patches (Vec Any) (js/call (js/call (readdirSync PATCHES-DIR) .filter (fn [p String] Bool (js/call p .endsWith ".patch"))) .sort)
        sec-patches (Vec Any) (js/call patches .filter (fn [p String] Bool
                                       (patch-security-block? (readFileSync (join PATCHES-DIR p) "utf8"))))]
    (if (= (js/get sec-patches .length) 0)
      (pass "S" "security-critical patches persist"
        "no `security:`-tagged patches (vacuously green; gate arms automatically when one is added)")
      ;; Build a fresh extract once, apply patches cumulatively in order; record the
      ;; apply result of each security-tagged patch, and resolve its declared anchors.
      (let [cache String (str (js/get (js/get process .env) .HOME) "/.cache/gjoa/sources")
            gjoa Any (js/call JSON .parse (readFileSync GJOA-JSON "utf8"))
            tarball String (str cache "/firefox-" (js/get (js/get gjoa .firefox) .version) ".source.tar.xz")]
        (if (not (existsSync tarball))
          (fail "S" "security-critical patches persist"
            (str (js/get sec-patches .length) " security-tagged patch(es) but the source tarball is not cached at " tarball " — cannot prove they apply (fail-closed)")
            "run `bun run download` to populate the cache, then re-run preflight")
          (let [tmp String "/tmp/gjoa-preflight-sec-engine"]
            (sh (str "rm -rf " tmp " && mkdir -p " tmp) {})
            (let [extract Any (sh (str "tar -xJf " tarball " -C " tmp " --strip-components=1") {:timeout 180000})]
              (if (not (js/get extract .ok))
                (fail "S" "security-critical patches persist" "tarball extract failed (fail-closed)" (js/call (js/get extract .out) .slice 0 400))
                (do
                  (sh (str "cd " tmp " && git init -q && git add -A && git -c user.email=t@t -c user.name=t commit -q -m baseline") {:timeout 60000})
                  (let [failed (Vec Any) []
                        unresolved (Vec Any) []
                        stopped (Atom Bool) (atom false)]
                    (doseq [p Any patches]
                      (when (not @stopped)
                        (let [ppath String (join PATCHES-DIR p)
                              is-sec Bool (js/call sec-patches .includes p)
                              r Any (sh (str "cd " tmp " && git apply " ppath) {})]
                          (when (not (js/get r .ok))
                            (reset! stopped true)
                            ;; only a SECURITY patch failing to apply is itself a security
                            ;; regression; a non-security patch breaking the chain ALSO blocks
                            ;; downstream security patches from being proven, so it is recorded
                            ;; as a fail-closed blocker.
                            (js/call failed .push (str p (if is-sec " (SECURITY)" " (blocks downstream security patches)") ": "
                                               (js/call (or (aget (js/call (js/get r .out) .split "\n") 0) "") .trim)))))))
                    ;; resolve declared anchors of each security-tagged patch (fail-closed).
                    (doseq [p Any sec-patches]
                      (doseq [cr Any (check-contract (readFileSync (join PATCHES-DIR p) "utf8"))]
                        (when (= (js/get cr .verdict) "not-found")
                          (js/call unresolved .push (str p ": " (js/get cr .kind) " `" (js/get cr .symbol) "` — " (js/get cr .detail))))))
                    (if (or (> (js/get failed .length) 0) (> (js/get unresolved .length) 0))
                      (fail "S" "security-critical patches persist"
                        (str (js/get sec-patches .length) " security-tagged patch(es): "
                             (js/get failed .length) " apply-failure(s), " (js/get unresolved .length) " unresolved anchor(s) — HARD STOP (a security mitigation regressed)")
                        (str "a security-critical patch no longer applies or its upstream anchor moved — regenerate it BEFORE building; do not ship the regression:\n"
                             "    apply:    " (js/call failed .join "\n              ") "\n"
                             "    anchors:  " (js/call unresolved .join "\n              ")))
                      (pass "S" "security-critical patches persist"
                        (str (js/get sec-patches .length) " security-tagged patch(es) apply cleanly + all declared anchors resolve")))))))))))))

;; Gate T — every gate/file/script named by docs/stewardship resolves, and the
;; generated topology.md is current.
(defn gateT [] Any
  (try
    (let [out Any (js/call (execSync "bun tools/stewardship/topology.mjs check 2>&1") .toString)]
      (pass "T" "stewardship tapestry intact (docs ↔ machinery)" (js/call out .trim)))
    (catch (e Any)
      (fail "T" "stewardship tapestry intact (docs ↔ machinery)"
            (js/call (if (js/get e .stdout) (js/call (js/get e .stdout) .toString) (or (js/get e .message) "check failed")) .trim)
            "a docs/stewardship/ ref dangled or topology.md is stale — `bun tools/stewardship/topology.mjs gen`, then commit"))))

;; Gate U — patch numbering coherence: every subsystem domain occupies a
;; contiguous numeric block (no foreign patch wedged into another domain's run).
;; Advisory (WARN, not a build stop) — alpha-apply order is sound regardless; a
;; split domain is a batching/comprehension smell with a known minimal renumber.
(defn gateU [] Any
  (try
    (let [out Any (js/call (execSync "bun .beagle-tools/gjoa/tools/prep/patch-order.js check --strict 2>&1") .toString)]
      (pass "U" "patch numbering coherent (domains contiguous)" (js/call out .trim)))
    (catch (e Any)
      (warn "U" "patch numbering coherent (domains contiguous)"
            (js/call (if (js/get e .stdout) (js/call (js/get e .stdout) .toString) (or (js/get e .message) "split domain — see `patch-order renumber`")) .trim)))))

;; Gate V — upstream provenance lock currency (churn). The lock records the git
;; blob OID of every patched file at the baseline FF tag; integrity mode asserts
;; the lock still describes the current patch surface at the declared baseline.
;; Skip-aware (the FF clone is dev-only, absent on CI) + WARN (stale lock is
;; hygiene, not a build stop).
(defn gateV [] Any
  (try
    (let [out Any (js/call (execSync "bun .beagle-tools/gjoa/tools/prep/upstream-provenance.js check --strict 2>&1") .toString)]
      (pass "V" "upstream provenance lock current" (js/call out .trim)))
    (catch (e Any)
      (warn "V" "upstream provenance lock current"
            (js/call (if (js/get e .stdout) (js/call (js/get e .stdout) .toString) (or (js/get e .message) "stale lock — re-run `provenance lock`")) .trim)))))

;; Gate W — dark-mode contrast backstop ships on. The APCA normalizer re-tones
;; text below the readable floor. Assert the shipped default so the suite measures
;; the configuration users receive.
(defn gateW [] Any
  (let [f String (join PREF-DIR "dark-mode-prefs.bjs")]
    (if (not (existsSync f))
      (warn "W" "dark-mode contrast backstop ships ON" "dark-mode-prefs.bjs absent — skipping")
      (let [src String (readFileSync f "utf8")]
        (if (js/call src .match (js/new RegExp "\\(pref\\s+\"gjoa\\.darkmode\\.normalize\\.enabled\"\\s+true\\)"))
          (pass "W" "dark-mode contrast backstop ships ON" "gjoa.darkmode.normalize.enabled defaults true (APCA no-black-on-black backstop active)")
          (fail "W" "dark-mode contrast backstop ships ON"
                "gjoa.darkmode.normalize.enabled is not defaulted true in dark-mode-prefs.bjs"
                "restore the `true` default; if disabling deliberately, update Gate W with the new constraint"))))))

;; Gate X — mirrors release.yml's tag-vs-displayVersion check locally, before push.
;; Only fires when HEAD carries a v* tag; untagged commits have nothing to compare.
(defn gateX [] Any
  (let [tagRes Any (sh "git describe --exact-match --tags HEAD 2>/dev/null" {})]
    (if (not (js/get tagRes .ok))
      (pass "X" "release tag matches gjoa.json displayVersion" "HEAD is not tagged — nothing to check")
      (let [tag String (js/call (js/get tagRes .out) .trim)]
        (if (not (js/call tag .match (js/new RegExp "^v[0-9]")))
          (pass "X" "release tag matches gjoa.json displayVersion" (str "HEAD tag `" tag "` is not a version tag — skipping"))
          (let [gjoa Any (js/call JSON .parse (readFileSync GJOA-JSON "utf8"))
                tagVersion String (js/call tag .slice 1)
                configVersion Any (js/get gjoa .displayVersion)]
            (if (= tagVersion configVersion)
              (pass "X" "release tag matches gjoa.json displayVersion" (str "HEAD tag `" tag "` matches displayVersion " configVersion))
              (fail "X" "release tag matches gjoa.json displayVersion"
                    (str "HEAD tag `" tag "` (" tagVersion ") does not match gjoa.json displayVersion " configVersion)
                    (str "bump gjoa.json displayVersion to " tagVersion " (or delete/retag) before `safe-push --tag " tag "`")))))))))

;; ── Run + render ──────────────────────────────────────────────────────────
(defn main! [] Any
  (console/log (bold "gjoa preflight"))
  (console/log (dim "Mandatory gate before any nix or full-mach build."))
  (console/log "")

  (let [gates (Vec (Vec Any)) [["A" gateA!] ["B" gateB] ["C" gateC] ["D" gateD]
               ["F" gateF] ["G" gateG]
               ["I" gateI] ["J" gateJ] ["K" gateK] ["L" gateL] ["M" gateM]
               ["N" gateN] ["O" gateO] ["P" gateP] ["Q" gateQ]
               ["R" gateR] ["S" gateS!] ["T" gateT] ["U" gateU] ["V" gateV]
               ["W" gateW] ["X" gateX]]]
    (doseq [gate (Vec Any) gates]
      (let [fn Any (aget gate 1)]
        (try (fn)
          (catch (e Error) (fail "?" (js/get fn .name) "gate threw" (js/get e .message)))))))

  (doseq [r Any results]
    (let [mark String (cond (js/get r .warned) (yellow "⚠")
                     (js/get r .passed) (green "✓")
                     :else (red "✗"))]
      (console/log (str mark "  " (bold (js/get r .id)) "  " (js/get r .name)))
      (console/log (str "     " (dim (js/get r .detail))))
      (when (and (not (js/get r .passed)) (js/get r .fix))
        (console/log (str "     " (yellow (str "fix: " (js/call (js/call (js/get r .fix) .split "\n") .join "\n          "))))))))

  (let [failed Int (js/get (js/call results .filter (fn [r Any] Any (not (js/get r .passed)))) .length)]
    (console/log "")
    (if (= failed 0)
      (do
        (console/log (str (green (bold "PREFLIGHT GREEN")) (dim (str "  — " (js/get results .length) "/" (js/get results .length) " gates passed"))))
        (console/log (dim "All pre-build gates passed."))
        (js/call process .exit 0))
      (do
        (console/log (str (red (bold "PREFLIGHT FAILED")) (dim (str "  — " failed "/" (js/get results .length) " gates failed"))))
        (console/log (red "Do NOT kick off a build until every gate is green."))
        (js/call process .exit 1)))))

;; Run the CLI only when invoked directly, never on import.
(when (js/get (js/import-meta) .main)
  (js/call (main!) .catch (fn [e Error] Any (console/error e) (js/call process .exit 1))))
