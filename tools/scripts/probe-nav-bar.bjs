#lang beagle/js
;; Diagnostic: launch gjoa, probe nav-bar layout in expanded + compact modes,
;; dump rects, save screenshots. Used to verify the actual layout matches
;; user's spec WITHOUT running the full integration test suite.
;;
;; Output:
;;   /tmp/gjoa-navbar-expanded.png   (sidebar-launcher-expanded=true)
;;   /tmp/gjoa-navbar-compact.png    (sidebar-launcher-expanded absent)
;;   Rect dumps printed to stdout.
;;
;; Usage: bun tools/scripts/probe-nav-bar.bjs
(ns gjoa.tools.scripts.probe-nav-bar
  (:require [child_process :refer [spawn]]
            [fs/promises :refer [writeFile]]
            [gjoa.tools.test-driver.marionette :refer [connect-marionette!]]
            [gjoa.tools.test-driver.profile :refer [create-profile]]
            [gjoa.tools.test-driver.gjoa-locator :refer [locate-gjoa]]))
(declare-extern [process Buffer String] Any)

(def PROBE-SCRIPT String "
  const navBar = document.getElementById(\"nav-bar\");
  const sidebarMain = document.getElementById(\"sidebar-container\");
  const expanded = sidebarMain && sidebarMain.hasAttribute(\"sidebar-launcher-expanded\");
  if (!navBar) return { error: \"no #nav-bar\" };
  const navRect = navBar.getBoundingClientRect();
  const kids = [];
  for (const ch of navBar.children) {
    const r = ch.getBoundingClientRect();
    const cs = getComputedStyle(ch);
    kids.push({
      id: ch.id || \"\",
      tag: ch.tagName.toLowerCase(),
      cls: ch.className || \"\",
      hidden: ch.hidden || cs.display === \"none\" || cs.visibility === \"hidden\",
      display: cs.display,
      order: cs.order,
      flex: cs.flex,
      left: Math.round(r.left),
      right: Math.round(r.right),
      top: Math.round(r.top),
      width: Math.round(r.width),
    });
  }
  // Also inspect customization-target's direct children.
  const ct = document.getElementById(\"nav-bar-customization-target\");
  const ctRect = ct ? ct.getBoundingClientRect() : null;
  const ctKids = [];
  if (ct) {
    for (const ch of ct.children) {
      const r = ch.getBoundingClientRect();
      const cs = getComputedStyle(ch);
      ctKids.push({
        id: ch.id || \"\",
        tag: ch.tagName.toLowerCase(),
        hidden: ch.hidden || cs.display === \"none\" || cs.visibility === \"hidden\",
        display: cs.display,
        order: cs.order,
        flex: cs.flex,
        marginInlineStart: cs.marginInlineStart,
        left: Math.round(r.left),
        right: Math.round(r.right),
        width: Math.round(r.width),
      });
    }
  }
  return {
    mode: expanded ? \"EXPANDED\" : \"COMPACT\",
    navBar: { left: Math.round(navRect.left), right: Math.round(navRect.right), width: Math.round(navRect.width) },
    customizationTarget: ctRect ? {
      left: Math.round(ctRect.left), right: Math.round(ctRect.right), width: Math.round(ctRect.width),
    } : null,
    navBarChildren: kids,
    ctChildren: ctKids,
  };
")

(defn probe [label String] Any
  (let [r Any (js/await (js/call mn .executeScript PROBE-SCRIPT))]
    (console/log (str "\n========== " label " (mode=" (js/get r .mode) ") =========="))
    (console/log "nav-bar:" (js/get r .navBar))
    (console/log "customization-target:" (js/get r .customizationTarget))
    (console/log "\nnav-bar children (left→right, visible only):")
    (let [visible (Vec Any) (js/call (js/get r .navBarChildren) .filter (fn [c Any] Any (and (not (js/get c .hidden)) (> (js/get c .width) 0))))]
      (js/call visible .sort
               (fn [a Any
                    b Any] Any
                 (let [a-left Float (js/get a .left)
                       b-left Float (js/get b .left)] (- a-left b-left))))
      (doseq [c Any visible]
        (console/log (str "  [" (js/call (String (js/get c .left)) .padStart 4) ".." (js/call (String (js/get c .right)) .padStart 4) "] w="
                           (js/call (String (js/get c .width)) .padStart 4) " order=" (js/call (js/get c .order) .padStart 3) "  "
                           (or (js/get c .id) (js/get c .tag)) "." (js/call (js/get c .cls) .slice 0 30)))))
    (console/log "\ncustomization-target children (visible only):")
    (let [ctVisible (Vec Any) (js/call (js/get r .ctChildren) .filter (fn [c Any] Any (and (not (js/get c .hidden)) (> (js/get c .width) 0))))]
      (js/call ctVisible .sort
               (fn [a Any
                    b Any] Any
                 (let [a-left Float (js/get a .left)
                       b-left Float (js/get b .left)] (- a-left b-left))))
      (doseq [c Any ctVisible]
        (console/log (str "  [" (js/call (String (js/get c .left)) .padStart 4) ".." (js/call (String (js/get c .right)) .padStart 4) "] w="
                           (js/call (String (js/get c .width)) .padStart 4) " order=" (js/call (js/get c .order) .padStart 3) " mIS="
                           (js/call (js/get c .marginInlineStart) .padStart 6) "  " (or (js/get c .id) (js/get c .tag))))))))

(def profile Any (js/await (create-profile {})))
(def gjoaBin String (js/get (locate-gjoa) .path))
(console/log (str "profile: " (js/get profile .path)))
(console/log (str "binary:  " gjoaBin))

(def child Any
  (spawn gjoaBin
         ["--profile" (js/get profile .path)
          "--marionette"
          "--headless"
          "--no-remote"
          "--remote-allow-system-access"
          "-marionette-port" "2828"]
         {:stdio "pipe"
          :env (js/call Object .assign {} (js/get process .env) {"GJOA_ALLOW_INSECURE" "1"})}))
(some-> (js/get child .stdout) (js/call .resume))
(some-> (js/get child .stderr) (js/call .resume))

(def mn Any (js/await (connect-marionette! {:port 2828})))
(js/await (js/call mn .newSession))
(js/await (js/call mn .setContext "chrome"))

(defn diagExt [label String] Any
  (let [r Any (js/await (js/call mn .executeScript "
    const ext = document.getElementById(\"unified-extensions-button\");
    const ct = document.getElementById(\"nav-bar-customization-target\");
    const sb = document.getElementById(\"sidebar-container\");
    if (!ext) return { error: \"no ext\" };
    const cs = getComputedStyle(ext);
    const ctCs = ct ? getComputedStyle(ct) : null;
    return {
      ext: {
        position: cs.position,
        right: cs.right,
        top: cs.top,
        transform: cs.transform,
        marginInlineStart: cs.marginInlineStart,
      },
      ct: ctCs ? { position: ctCs.position, display: ctCs.display } : null,
      sidebarMain: {
        present: !!sb,
        hasExpanded: sb ? sb.hasAttribute(\"sidebar-launcher-expanded\") : null,
        hasGjoaCompact: sb ? sb.hasAttribute(\"data-gjoa-compact\") : null,
      },
    };
  "))]
    (console/log (str "-- " label " computed style --"))
    (console/log (js/call JSON .stringify r nil 2))))

(try
  (do
    ;; Default boot — should be expanded mode (test profile sets verticalTabs+revamp=true).
    (js/await (js/new Promise (fn [r Any] Any (setTimeout r 2000))))
    (js/await (probe "DEFAULT BOOT"))
    (js/await (diagExt "DEFAULT"))
    (let [shot1 Any (js/await (js/call mn .takeScreenshot))]
      (js/await (writeFile "/tmp/gjoa-navbar-default.png" (js/call Buffer .from shot1 "base64"))))
    (console/log "\n→ saved /tmp/gjoa-navbar-default.png")

    ;; Toggle to compact: remove sidebar-launcher-expanded.
    (js/await (js/call mn .executeScript "
    const sb = document.getElementById(\"sidebar-container\");
    if (sb) sb.removeAttribute(\"sidebar-launcher-expanded\");
    // Also collapse using the native API if available.
    if (window.SidebarController && typeof window.SidebarController.toggleExpanded === \"function\") {
      try { window.SidebarController.toggleExpanded(); } catch {}
    }
    return null;
  "))
    (js/await (js/new Promise (fn [r Any] Any (setTimeout r 500))))
    (js/await (probe "AFTER REMOVE sidebar-launcher-expanded"))
    (js/await (diagExt "COMPACT"))
    (let [shot2 Any (js/await (js/call mn .takeScreenshot))]
      (js/await (writeFile "/tmp/gjoa-navbar-compact.png" (js/call Buffer .from shot2 "base64"))))
    (console/log "\n→ saved /tmp/gjoa-navbar-compact.png")

    ;; Mimic user's setup: URL bar has a max-width so it doesn't dominate
    ;; the nav-bar. Then ext should be VISIBLY right of URL, just left of
    ;; PanelUI/sidebar-toggle. Also force dark color-scheme so ext fill
    ;; resolves to light on dark bg (test profile defaults to light fill).
    (js/await (js/call mn .executeScript "
    document.documentElement.style.colorScheme = \"dark\";
    const url = document.getElementById(\"urlbar-container\");
    if (url) url.style.maxWidth = \"700px\";
    return null;
  "))
    (js/await (js/new Promise (fn [r Any] Any (setTimeout r 300))))
    (js/await (probe "WITH 700px URL CAP"))
    (js/await (diagExt "URL_CAP"))
    (let [shot4 Any (js/await (js/call mn .takeScreenshot))]
      (js/await (writeFile "/tmp/gjoa-navbar-urlcap.png" (js/call Buffer .from shot4 "base64"))))
    (console/log "\n→ saved /tmp/gjoa-navbar-urlcap.png")

    ;; Try horizontal-tabs mode — flip the pref + reload window via tabsLayout API.
    (js/await (js/call mn .executeScript "
    Services.prefs.setBoolPref(\"sidebar.verticalTabs\", false);
    return null;
  "))
    (js/await (js/new Promise (fn [r Any] Any (setTimeout r 1000))))
    (js/await (probe "HORIZONTAL TABS (verticalTabs=false)"))
    (let [shot3 Any (js/await (js/call mn .takeScreenshot))]
      (js/await (writeFile "/tmp/gjoa-navbar-horizontal.png" (js/call Buffer .from shot3 "base64"))))
    (console/log "\n→ saved /tmp/gjoa-navbar-horizontal.png")

    ;; Also dump ALL toolbar children including hidden ones — useful to see what's
    ;; there but display:none'd.
    (console/log "\n========== ALL NAV-BAR CHILDREN (incl. hidden) ==========")
    (let [all Any (js/await (js/call mn .executeScript "
    const navBar = document.getElementById(\"nav-bar\");
    const ct = document.getElementById(\"nav-bar-customization-target\");
    const out = { navBarChildren: [], ctChildren: [] };
    for (const ch of navBar.children) {
      const cs = getComputedStyle(ch);
      out.navBarChildren.push({ id: ch.id || ch.tagName, hidden: ch.hidden, display: cs.display, order: cs.order });
    }
    if (ct) for (const ch of ct.children) {
      const cs = getComputedStyle(ch);
      out.ctChildren.push({ id: ch.id || ch.tagName, hidden: ch.hidden, display: cs.display, order: cs.order });
    }
    return out;
  "))]
      (console/log "nav-bar:")
      (doseq [c Any (js/get all .navBarChildren)]
        (console/log (str "  " (if (or (js/get c .hidden) (= (js/get c .display) "none")) "[hidden]" "[show]  ")
                           "  ord=" (js/get c .order) "  " (js/get c .id))))
      (console/log "customization-target:")
      (doseq [c Any (js/get all .ctChildren)]
        (console/log (str "  " (if (or (js/get c .hidden) (= (js/get c .display) "none")) "[hidden]" "[show]  ")
                           "  ord=" (js/get c .order) "  " (js/get c .id))))))
  (finally
    (try (js/await (js/call mn .deleteSession)) (catch (e Any) nil))
    (js/call mn .disconnect)
    (js/call child .kill "SIGTERM")
    (js/await (js/call profile .cleanup))))
