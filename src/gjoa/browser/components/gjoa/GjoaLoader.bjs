#lang beagle/js
;; Gjoa chrome JS/CSS loader.
;;
;; Replaces fx-autoconfig with a Firefox-native loader that lives inside
;; omni.ja (install-root-owned) instead of bouncing through profile-side
;; chrome/ directories.
;;
;; This .bjs compiles to GjoaLoader.sys.mjs (an ESM) during `bun run import`
;; (see tools/prep/import.bjs). `;;` comments do not survive the beagle→js emit,
;; so the SECURITY MODEL notes below live in source only.
;;
;; =============================================================================
;; SECURITY MODEL
;; =============================================================================
;;
;; PRODUCTION (no <install_root>/gjoa-dev/ directory present):
;;   Scripts and styles load from omni.ja via chrome:// URLs. Same trust
;;   boundary as Firefox itself — if you trust the install, you trust the
;;   chrome JS. No user-writable script directory exists; no hash-pinning
;;   needed because there's nothing to tamper with.
;;
;; DEV MODE (opt-in via GJOA_DEV_LOADER=1 AND <install_root>/gjoa-dev/ present):
;;   The loader reads .uc.js / .uc.css files from <install_root>/gjoa-dev/
;;   directly at startup. Used for sub-second iteration on chrome JS without
;;   re-running mach build. Trust boundary: anyone who can write to the
;;   install root (typically root, or the dev who owns the build tree) can
;;   inject scripts. This is identical to "anyone who can write to the install
;;   root can replace the binary" — same threat boundary, no new attack
;;   surface.
;;
;;   F4 HARDENING (this file): the dev path is gated so it cannot activate by
;;   accident or via a dropped directory in a RELEASE build:
;;     1. OPT-IN — `dev-mode-dir` returns nil unless GJOA_DEV_LOADER=1 is set
;;        in the environment, EVEN IF gjoa-dev/ exists. A dropped directory
;;        alone is inert.
;;     2. DEFENSE-IN-DEPTH — when the dir IS used, it must be a real (non-
;;        symlink) directory that is NOT group- or other-writable
;;        (permissions & 0o022 == 0). A symlinked or world/group-writable
;;        gjoa-dev/ is refused (return nil → production fallback), so another
;;        local user cannot drop or redirect scripts into a dev tree.
;;
;; PRODUCTION HARDENING (deferred — full belt is the compile-out):
;;   The complete fix is to compile the dev path out of shipped release
;;   builds entirely via a build flag (MOZ_GJOA_DEV_LOADER=0), so the code
;;   path does not exist in the binary at all — defense-in-depth says don't
;;   compile in code paths your release doesn't need. The runtime gate above
;;   is the interim guard until that compile-out lands.
;;
;; =============================================================================
;; IMPLEMENTATION
;; =============================================================================
(ns gjoa.browser.components.gjoa.loader)
(declare-extern [ChromeUtils Cc Ci Services Components] Any)

(def lazy Any {})

(js/call ChromeUtils .defineESModuleGetters lazy
  {:AboutNewTab "resource:///modules/AboutNewTab.sys.mjs"})

;; The gjoa new-tab page. A content-accessible chrome document (see jar.mn's
;; `gjoa-newtab` package) pointed at by AboutNewTab.newTabURL. Because this URL
;; becomes BROWSER_NEW_TAB_URL, Firefox's blank-page handling gives it the
;; normal new-tab treatment (focused, empty urlbar) for free.
(def NEW-TAB-URL String "chrome://gjoa-newtab/content/newtab.html")

(def STYLE-SHEET-SERVICE Any
  (let [cid "@mozilla.org/content/style-sheet-service;1"]
    (js/call (get Cc cid) .getService (js/get Ci .nsIStyleSheetService))))

;; browser.xhtml is the only chrome document we want to inject into for now.
;; Restricting by document URL avoids accidentally double-loading into popup
;; windows, sidebar inner frames, etc.
(def TARGET-BROWSER-URL String "chrome://browser/content/browser.xhtml")

;; Module-level mutable state. `loaded-sheets` guards against double-registering
;; a stylesheet; `observer-registered` guards against double-registering the
;; chrome-document-loaded observer if the loader is re-imported.
(def st Any {:loaded-sheets (js/new Set) :observer-registered false})

;; Production-mode bundle list. These are the chrome bundles baked into omni.ja
;; by `bun run chrome:dist` + tools/prep/chrome-bake.bjs. Keep in sync with
;; tools/chrome-bundle/build.config entries (minus the gjoa-hello.uc.js
;; smoke-test bundle, which we don't ship).
(def PROD-SCRIPTS Any
  ["gjoa-security.uc.js" "gjoa-drawer.uc.js" "gjoa-tabs.uc.js" "gjoa-dark-mode.uc.js" "gjoa-blocking.uc.js" "gjoa-theme.uc.js"])
(def PROD-STYLES Any
  ["gjoa.uc.css" "gjoa-tabs.uc.css" "gjoa-which-key.uc.css"])

;; --- Source resolution -------------------------------------------------------

;; Reads an environment variable, returning "" if unset or on any failure.
;; Matches the gjoa.security pattern; nsIEnvironment.get never throws for a
;; missing var but we stay defensive.
(defn dev-env [(name String)] String
  (try
    (or (js/call (js/get Services .env) .get name) "")
    (catch (_e Any) "")))

;; F4 defense-in-depth: the resolved dev-source dir must not be group/other-
;; writable, so another local user can't drop/redirect scripts into the dev tree.
;; `.permissions` is the STAT mode of the *resolved* dir, so this works whether
;; gjoa-dev is a real dir or the user-owned symlink the mach dev loop creates
;; (tools/chrome-bundle/install.bjs). We deliberately do NOT check the symlink
;; node's own mode: on Linux a symlink is always 0777 (the kernel ignores link
;; mode bits), so an LSTAT check would both break the legit dev symlink AND add
;; no security — who can REPLACE the link is gated by the parent dir's bits, not
;; the link's. The opt-in GJOA_DEV_LOADER=1 gate above is the primary defense;
;; this is belt on the target. (Full belt = the deferred MOZ_GJOA_DEV_LOADER
;; compile-out.) Any read throwing → treat as unsafe.
(defn dev-dir-safe? [(dir Any)] Boolean
  (try
    ;; 0o022 = group-write | other-write.
    (= (bit-and (js/get dir .permissions) 0o022) 0)
    (catch (_e Any) false)))

;; Returns the dev-mode source directory if dev loading is explicitly enabled
;; AND the dir exists AND passes the safety check, else nil.
;; Convention: <install_root>/gjoa-dev/{JS,CSS}/*.uc.{js,css}
(defn dev-mode-dir [] Any
  ;; OPT-IN GATE: never source dev chrome unless GJOA_DEV_LOADER=1. A dropped
  ;; gjoa-dev/ directory is inert without this env var, so the full-chrome-
  ;; privilege dev path cannot activate by accident in a release build. The
  ;; deferred full belt is the MOZ_GJOA_DEV_LOADER compile-out (see SECURITY
  ;; MODEL above); this runtime gate is the interim guard.
  (if (not= (dev-env "GJOA_DEV_LOADER") "1")
    nil
    ;; GreD = Gecko runtime directory = the install root containing the binary.
    (let [dir (js/call (js/get Services .dirsvc) .get "GreD" (js/get Ci .nsIFile))]
      (js/call dir .append "gjoa-dev")
      (if (and (js/call dir .exists) (js/call dir .isDirectory) (dev-dir-safe? dir)) dir nil))))

(defn list-files [(dir Any) (suffix String)] Any
  (let [out []]
    (if (or (not (js/call dir .exists)) (not (js/call dir .isDirectory)))
      out
      (let [entries (js/get dir .directoryEntries)]
        (loop []
          (when (js/call entries .hasMoreElements)
            (let [f (js/call (js/call entries .getNext) .QueryInterface (js/get Ci .nsIFile))]
              (when (and (js/call f .isFile) (js/call (js/get f .leafName) .endsWith suffix))
                (js/call out .push f)))
            (recur)))
        out))))

;; --- Loading -----------------------------------------------------------------

(defn load-script-url-into [(window Any) (url String) (label String)] Any
  (try
    (do
      (js/call (js/get Services .scriptloader) .loadSubScriptWithOptions url {:target window :ignoreCache true})
      (console/log (str "gjoa-loader: loaded script " label)))
    (catch (e Any)
      (console/error (str "gjoa-loader: script " label " threw at load time") e))))

(defn register-style-sheet-url [(url String) (label String)] Any
  (when (not (js/call (js/get st .loaded-sheets) .has url))
    (try
      (let [uri (js/call (js/get Services .io) .newURI url)]
        (js/call STYLE-SHEET-SERVICE .loadAndRegisterSheet uri (js/get STYLE-SHEET-SERVICE .AGENT_SHEET))
        (js/call (js/get st .loaded-sheets) .add url)
        (console/log (str "gjoa-loader: registered stylesheet " label)))
      (catch (e Any)
        (console/error (str "gjoa-loader: stylesheet " label " threw at register time") e)))))

(defn load-script-into [(window Any) (file Any)] Any
  (load-script-url-into window (js/get (js/call (js/get Services .io) .newFileURI file) .spec) (js/get file .leafName)))

(defn register-style-sheet [(file Any)] Any
  (register-style-sheet-url (js/get (js/call (js/get Services .io) .newFileURI file) .spec) (js/get file .leafName)))

;; --- Dev live-reload: a running browser can NEVER hold a stale bundle ----------
;; chrome:dist writes <bundle>/.bundle-stamp (content hash; mtime bumps every build).
;; In dev mode the loader polls that file's mtime and, on change, tears down every
;; bundle (each bundle pushes its teardown into window.__gjoaHR.teardowns) + drops all
;; registered stylesheets, then re-runs load-into-chrome-window! — so the running chrome
;; becomes the freshly-compiled bundle within ~1s. By construction there is no window
;; in which the browser and the compiled bundle disagree. (owner: "never stale by
;; construction".) Production (omni.ja) has no loose files, so a launch is always the
;; built bundle — nothing to watch.

(defn unregister-sheets [] Any
  (doseq [url (Array/from (js/get st .loaded-sheets))]
    (try
      (let [uri (js/call (js/get Services .io) .newURI url)]
        (when (js/call STYLE-SHEET-SERVICE .sheetRegistered uri (js/get STYLE-SHEET-SERVICE .AGENT_SHEET))
          (js/call STYLE-SHEET-SERVICE .unregisterSheet uri (js/get STYLE-SHEET-SERVICE .AGENT_SHEET))))
      (catch (_e Any) nil)))
  (js/call (js/get st .loaded-sheets) .clear))

(defn stamp-mtime [(dev-dir Any)] Number
  (try
    (let [f (js/call dev-dir .clone)]
      (js/call f .append ".bundle-stamp")
      (if (js/call f .exists) (js/get f .lastModifiedTime) 0))
    (catch (_e Any) 0)))

(defn hot-reload! [(window Any)] Any
  (try
    (let [hr (js/get window .__gjoaHR)]
      (when hr
        (doseq [f (Array/from (js/get hr .teardowns))]
          (try (f) (catch (_e Any) nil)))
        (js/set! hr .teardowns [])))
    (unregister-sheets)
    (load-into-chrome-window! window)
    (console/log "gjoa-loader: chrome hot-reloaded (dev bundle changed)")
    (catch (e Any)
      (console/error "gjoa-loader: hot-reload! failed" e))))

(defn start-dev-watch! [(window Any) (dev-dir Any)] Any
  (when (not (js/get window .__gjoaHRWatching))
    (js/set! window .__gjoaHRWatching true)
    (let [(state Any) {:last (stamp-mtime dev-dir)}]
      (js/call window .setInterval
        (fn [] Any
          (let [cur (stamp-mtime dev-dir)]
            (when (and (> cur 0) (not= cur (js/get state .last)))
              (js/set! state .last cur)
              (hot-reload! window))))
        750))))

(defn load-into-chrome-window! [(window Any)] Any
  ;; .uc.js bundles reference the beagle value-semantics runtime, which a
  ;; loadSubScript bundle can't `import` (not an ESM context). Expose the
  ;; vendored runtime NAMESPACE on the window the bundles load into as
  ;; `window.$$bc`. beagle's emit references that runtime as named-import LOCALS
  ;; (`$$bc$equiv`, bound to export `equivV`) — and the chrome bundler
  ;; (tools/chrome-bundle/build.bjs) rewrites each stripped
  ;; `import { equivV as $$bc$equiv } from 'beagle/core.js'` into a
  ;; `const $$bc$equiv = $$bc.equivV;` prelude that resolves against this
  ;; namespace. Gate Q enforces this namespace and rewrite together. `.sys.mjs`
  ;; files keep the real import via BEAGLE_JS_RUNTIME_PREFIX; see overlay.bjs.
  (js/set! window .$$bc
        (js/call ChromeUtils .importESModule "resource:///modules/gjoa/beagle/core.js"))
  ;; Hot-reload teardown registry: each bundle's init! pushes its teardown fn here so
  ;; the loader can tear it down + re-run on a dev bundle change. Created once; a
  ;; hot-reload! resets .teardowns to [] (in hot-reload!) before re-running the bundles.
  (when (not (js/get window .__gjoaHR))
    (js/set! window .__gjoaHR {:teardowns []}))
  (let [dev (dev-mode-dir)]
    (if dev
      (let [js-dir (js/call dev .clone)
            css-dir (js/call dev .clone)]
        (js/call js-dir .append "JS")
        (js/call css-dir .append "CSS")
        (doseq [css (list-files css-dir ".uc.css")]
          (register-style-sheet css))
        (doseq [js (list-files js-dir ".uc.js")]
          (load-script-into window js))
        (start-dev-watch! window dev))
      ;; Production: load from chrome://gjoa/content/{scripts,styles}/, baked
      ;; into omni.ja by `bun run chrome:dist` + tools/prep/chrome-bake.bjs.
      (do
        (doseq [css PROD-STYLES]
          (register-style-sheet-url (str "chrome://gjoa/content/styles/" css) css))
        (doseq [js PROD-SCRIPTS]
          (load-script-url-into window (str "chrome://gjoa/content/scripts/" js) js))))))

;; Firefox creates parts of browser chrome during delayed startup, so loading at
;; chrome-document-loaded can permanently skip bundles gated on those elements.
(defn load-browser-window! [(window Any)] Any
  (when (and window
             (= (some-> window (js/get .location) (js/get .href)) TARGET-BROWSER-URL)
             (not= (some-> window (js/get .document) (js/get .readyState)) "loading")
             (some-> window (js/get .gBrowserInit) (js/get .delayedStartupFinished))
             (not (js/get window .__gjoaLoaderLoaded)))
    (js/set! window .__gjoaLoaderLoaded true)
    (try
      (load-into-chrome-window! window)
      (catch (e Any)
        (js/set! window .__gjoaLoaderLoaded false)
        (console/error "gjoa-loader: browser-window load failed" e)))))

(defn load-existing-browser-windows! [] Any
  (let [windows (js/call (js/get Services .wm) .getEnumerator "navigator:browser")]
    (loop []
      (when (js/call windows .hasMoreElements)
        (load-browser-window! (js/call windows .getNext))
        (recur)))))

;; --- Observer registration (called from BrowserGlue at app-startup) ----------

(def observer Any
  {:observe (fn [(subject Any) (topic Any)] Any
    (cond
      (= topic "chrome-document-loaded")
        ;; subject IS the Document directly (chrome-document-loaded contract);
        ;; no QueryInterface is required.
        (let [doc subject
              window (some-> doc (js/get .defaultView))]
          (load-browser-window! window))
      (= topic "browser-delayed-startup-finished")
        (load-browser-window! subject)))})

(defn set-defaults [] Any
  (try
    (let [d (js/call (js/get Services .prefs) .getDefaultBranch "")]
      (js/call d .setCharPref "browser.toolbars.bookmarks.visibility" "never")
      (js/call d .setBoolPref "sidebar.verticalTabs" true)
      (js/call d .setBoolPref "gjoa.sidebar.menuBar" false)
      (js/call d .setBoolPref "gjoa.toolbar.newTabButton" false)
      ;; Home/startup page is the gjoa new-tab page. "about:newtab" (and
      ;; "about:home") are routed to chrome://gjoa-newtab at the channel layer by
      ;; the AboutNewTabRedirector patch (patches/0003-newtab-redirector-gjoa).
      ;; The home button, new windows, and a
      ;; home-based startup all land on the same custom page as new tabs.
      (js/call d .setCharPref "browser.startup.homepage" "about:newtab")
      ;; The about:home startup cache pre-renders the activity-stream document we
      ;; no longer serve; with the activity-stream uninitialized it throws at
      ;; startup (AboutHomeStartupCache: activityStream is null). Disable it.
      (js/call d .setBoolPref "browser.startup.homepage.abouthome_cache.enabled" false)
      ;; FF152 "nova" UI reserves a content margin + window gap (see
      ;; browser/themes/shared/sidebar.css @media browser.nova.enabled) that crops
      ;; every page and exposes the desktop behind the inset — gjoa supplies its own
      ;; chrome, so force nova OFF: default false AND drop any stray user/experiment
      ;; value (runs every launch, so a Normandy flip can't re-crop the content).
      (js/call d .setBoolPref "browser.nova.enabled" false)
      (when (js/call (js/get Services .prefs) .prefHasUserValue "browser.nova.enabled")
        (js/call (js/get Services .prefs) .clearUserPref "browser.nova.enabled"))
      ;; ...and replace it with gjoa's OWN contextual floating cards (gjoa.uc.css
      ;; #region floating cards): a static sidebar + content render as two rounded
      ;; cards with a gap; a floating/hidden sidebar lets content fill the window.
      ;; Unlike nova's all-or-nothing inset, this is gated on the live sidebar state.
      (js/call d .setBoolPref "gjoa.layout.floatingCards" true)
      ;; sovereignty: the maximal-egress-lockdown meta-pref, default OFF (see apply-lockdown!).
      (js/call d .setBoolPref "gjoa.sovereignty.maximalLockdown" false)
      ;; privacy: the curated-profile selector. Default "balanced" — minimal's
      ;; telemetry/phone-home-off baseline PLUS cross-site referer trimming and
      ;; search/URL-bar suggestions off (no keystroke leak to the search engine),
      ;; at negligible site breakage. See PRIVACY-PRESETS / apply-privacy-profile!.
      (js/call d .setCharPref "gjoa.privacy.profile" "balanced"))
    (catch (e Any)
      (console/error "gjoa-loader: setDefaults failed" e))))

;; Registers the cosmetic-filtering JSWindowActor pair. The child (content
;; process) asks the parent (where the MAIN_PROCESS_ONLY content-classifier
;; service lives) for adblock-rust element-hiding selectors per document.
;; Restricted to web content (messageManagerGroups "browsers"); allFrames so
;; ads in subframes are covered too.
(defn register-cosmetic-actor [] Any
  (try
    (js/call ChromeUtils .registerWindowActor "GjoaCosmetic"
      {:parent {:esModuleURI "resource://gre/modules/GjoaCosmeticParent.sys.mjs"}
       :child {:esModuleURI "resource://gre/modules/GjoaCosmeticChild.sys.mjs"
               :events {:DOMContentLoaded {:mozSystemGroup true}
                        :DOMWindowCreated {}}}
       :allFrames true
       :messageManagerGroups ["browsers"]})
    (console/log "gjoa-loader: registered GjoaCosmetic window actor")
    (catch (e Any)
      (console/error "gjoa-loader: registerWindowActor failed" e))))

;; Registers the per-site dark-mode HYBRID actor. On the TOP document the child
;; measures the rendered background after first paint and sets the per-document
;; colorInversionOverride for sites with no native dark theme. allFrames so it ALSO
;; runs in subframes — NOT to set a per-subframe override (colorInversionOverride is
;; a top-BC-only field: CanSet=IsTop), but because the engine derives a subframe's
;; inversion from bc->Top()'s override, so on a native-dark top (Top()=inactive) a
;; cross-origin light widget — OneTrust consent, Google One Tap, chat/ad iframes — is
;; force-left white with no engine invert to refine. The child's subframe branch
;; CSS-darkens exactly that suppressed case (gated on the engine NOT already
;; inverting the subframe, so themeless/force tops are untouched).
(defn register-darkmode-actor [] Any
  (try
    (js/call ChromeUtils .registerWindowActor "GjoaDarkmode"
      {:parent {:esModuleURI "resource://gre/modules/GjoaDarkmodeParent.sys.mjs"}
       :child {:esModuleURI "resource://gre/modules/GjoaDarkmodeChild.sys.mjs"
               :events {:DOMContentLoaded {:mozSystemGroup true}
                        ;; document-start: run per-site inject scriptlets (e.g.
                        ;; YouTube html[dark]) before the page reads its theme.
                        :DOMWindowCreated {:mozSystemGroup true}}}
       :allFrames true
       :messageManagerGroups ["browsers"]})
    (console/log "gjoa-loader: registered GjoaDarkmode window actor")
    (catch (e Any)
      (console/error "gjoa-loader: registerDarkmodeActor failed" e))))

;; Registers the INPUT-STATE actor: reports editable-focus (so vim keys yield to
;; typing) and drives smooth scroll. allFrames so an input inside an iframe is
;; detected too; events fire in the system group so a page can't preventDefault
;; its way out of us seeing focus changes. Replaces a FF152-rejected data:-URL
;; frame script (see GjoaInput{Child,Parent}.sys.mjs).
(defn register-input-actor [] Any
  (try
    (js/call ChromeUtils .registerWindowActor "GjoaInput"
      {:parent {:esModuleURI "resource://gre/modules/GjoaInputParent.sys.mjs"}
       :child {:esModuleURI "resource://gre/modules/GjoaInputChild.sys.mjs"
               :events {:keydown {:capture true :mozSystemGroup true}
                        :focusin {:capture true :mozSystemGroup true}
                        :focusout {:capture true :mozSystemGroup true}
                        :pageshow {:mozSystemGroup true}
                        :pagehide {:mozSystemGroup true}
                        :DOMContentLoaded {:mozSystemGroup true}}}
       :allFrames true
       :messageManagerGroups ["browsers"]})
    (console/log "gjoa-loader: registered GjoaInput window actor")
    (catch (e Any)
      (console/error "gjoa-loader: registerInputActor failed" e))))

(defn set-new-tab-url! [] Any
  (try
    (js/set! (js/get lazy .AboutNewTab) .newTabURL NEW-TAB-URL)
    (console/log (str "gjoa-loader: new tab URL set to " NEW-TAB-URL))
    (catch (e Any)
      (console/error "gjoa-loader: failed to set newTabURL" e))))

;; --- Maximal egress lockdown (opt-in) -----------------------------------------
;; Two Firefox startup probes phone Mozilla: the captive-portal check
;; (detectportal.firefox.com) and the connectivity service. They power "sign in to
;; wifi" detection, so gjoa keeps them ON by default — sovereignty WITH adoptability.
;; Flipping gjoa.sovereignty.maximalLockdown gives LibreWolf-grade egress silence
;; for users who want it: the user decides their egress, the browser doesn't decide
;; for them. The 4 zero-cost vectors (telemetry/Contile/sponsored) are always off
;; via default prefs; only these two wifi-affecting probes are gated by the toggle.
(def LOCKDOWN-PREF String "gjoa.sovereignty.maximalLockdown")
(def LOCKDOWN-PROBES Any
  ["network.captive-portal-service.enabled" "network.connectivity-service.enabled"])

(defn apply-lockdown! [] Any
  (try
    (let [d (js/call (js/get Services .prefs) .getDefaultBranch "")
          on (js/call (js/get Services .prefs) .getBoolPref LOCKDOWN-PREF false)]
      (doseq [p LOCKDOWN-PROBES] (js/call d .setBoolPref p (not on)))
      (console/log (str "gjoa-loader: maximal-lockdown "
                        (if on "ON — captive-portal/connectivity probes disabled"
                               "off — wifi-detection probes active (default)"))))
    (catch (e Any)
      (console/error "gjoa-loader: apply-lockdown failed" e))))

(def lockdown-observer Any
  {:observe (fn [(_subject Any) (_topic Any) (_data Any)] Any (apply-lockdown!))})

;; --- privacy profiles --------------------------------------------------------
;; CURATED presets. `gjoa.privacy.profile` selects one ("minimal"/"balanced"/
;; "librewolf"/"custom"); applying it batch-sets a curated subset of privacy prefs
;; on the DEFAULT branch (so each stays individually overridable, reversible — the
;; about:gjoa picker flips to "custom" the moment a user hand-edits one). Each leaf
;; is [name value type]. Presets escalate: minimal ⊂ balanced ⊂ librewolf. Kept in
;; sync with settings/registry.json `sets` by preflight Gate N. #79(a):
;; "LibreWolf-INSPIRED" — a curated subset of LibreWolf's DEFAULTS, NOT LibreWolf.
(def PRIVACY-PRESETS Any
  {"minimal"
   [["privacy.resistFingerprinting" false "bool"]
    ["privacy.resistFingerprinting.letterboxing" false "bool"]
    ["network.http.referer.XOriginPolicy" 0 "int"]
    ["network.http.referer.XOriginTrimmingPolicy" 0 "int"]
    ["browser.search.suggest.enabled" true "bool"]
    ["browser.urlbar.suggest.searches" true "bool"]
    ["extensions.update.enabled" true "bool"]
    ["privacy.donottrackheader.enabled" true "bool"]]
   "balanced"
   [["privacy.resistFingerprinting" false "bool"]
    ["privacy.resistFingerprinting.letterboxing" false "bool"]
    ["network.http.referer.XOriginPolicy" 0 "int"]
    ["network.http.referer.XOriginTrimmingPolicy" 2 "int"]
    ["browser.search.suggest.enabled" false "bool"]
    ["browser.urlbar.suggest.searches" false "bool"]
    ["extensions.update.enabled" true "bool"]
    ["privacy.donottrackheader.enabled" true "bool"]]
   "librewolf"
   [["privacy.resistFingerprinting" true "bool"]
    ["privacy.resistFingerprinting.letterboxing" true "bool"]
    ["network.http.referer.XOriginPolicy" 2 "int"]
    ["network.http.referer.XOriginTrimmingPolicy" 2 "int"]
    ["browser.search.suggest.enabled" false "bool"]
    ["browser.urlbar.suggest.searches" false "bool"]
    ["extensions.update.enabled" false "bool"]
    ["privacy.donottrackheader.enabled" true "bool"]]})

(defn apply-privacy-profile! [] Any
  (try
    (let [id (js/call (js/get Services .prefs) .getCharPref "gjoa.privacy.profile" "balanced")
          preset (get PRIVACY-PRESETS id)
          d (js/call (js/get Services .prefs) .getDefaultBranch "")]
      (when (and (not (= id "custom")) preset)
        (doseq [leaf preset]
          (let [name (aget leaf 0) v (aget leaf 1)]
            (if (= (aget leaf 2) "int") (js/call d .setIntPref name v) (js/call d .setBoolPref name v))))
        (console/log (str "gjoa-loader: privacy profile '" id "' applied"))))
    (catch (e Any)
      (console/error "gjoa-loader: apply-privacy-profile failed" e))))

(def profile-observer Any
  {:observe (fn [(_subject Any) (_topic Any) (_data Any)] Any (apply-privacy-profile!))})

;; --- about: pages -------------------------------------------------------------
;; Register a privileged chrome page as a real about:<what> page at runtime (no
;; rebuild, no Mozilla-source patch). The page reads build-provenance prefs + toggles
;; and renders the verifiable truth. (NOTE: about-module flag/principal semantics are
;; FF-version-sensitive — needs one in-browser confirmation; wrapped so a failure only
;; logs and never blocks startup.)
(defn register-about! [(what String) (url String) (class-id String)] Any
  (try
    (let [about-module
          {:QueryInterface (js/call ChromeUtils .generateQI ["nsIAboutModule"])
           :newChannel (fn [(uri Any) (load-info Any)] Any
                         (let [ch (js/call (js/get Services .io) .newChannelFromURIWithLoadInfo
                                    (js/call (js/get Services .io) .newURI url) load-info)]
                           (js/set! ch .originalURI uri)
                           ch))
           :getURIFlags (fn [(_uri Any)] Any (js/get (js/get Ci .nsIAboutModule) .ALLOW_SCRIPT))}
          factory
          {:QueryInterface (js/call ChromeUtils .generateQI ["nsIFactory"])
           :createInstance (fn [(iid Any)] Any (js/call about-module .QueryInterface iid))}
          registrar (js/call (js/get Components .manager) .QueryInterface (js/get Ci .nsIComponentRegistrar))]
      (js/call registrar .registerFactory (js/call Components .ID class-id)
        (str "about:" what) (str "@mozilla.org/network/protocol/about;1?what=" what) factory)
      (console/log (str "gjoa-loader: registered about:" what)))
    (catch (e Any)
      (console/error (str "gjoa-loader: register about:" what " failed") e))))

;; The thin about:preferences POINTER — a window actor that injects a "gjoa Settings"
;; pointer into Firefox Settings (→ about:gjoa). gjoa OWNS its settings surface and
;; does NOT patch Firefox's preferences code; this only OBSERVES the page (graceful —
;; a miss is harmless, about:gjoa is always reachable by URL). Matches about:preferences
;; and its about:settings alias.
(defn register-aboutprefs-actor! [] Any
  (try
    (js/call ChromeUtils .registerWindowActor "GjoaAboutPrefs"
      {:parent {:esModuleURI "resource:///modules/gjoa/GjoaAboutPrefsParent.sys.mjs"}
       :child {:esModuleURI "resource:///modules/gjoa/GjoaAboutPrefsChild.sys.mjs"
               :events {:DOMContentLoaded {:mozSystemGroup true}}}
       :matches ["about:preferences*" "about:settings*"]})
    (console/log "gjoa-loader: registered GjoaAboutPrefs actor (about:preferences pointer)")
    (catch (e Any)
      (console/error "gjoa-loader: register GjoaAboutPrefs actor failed" e))))

(defn register-about-pages! [] Any
  (register-about! "sovereignty" "chrome://gjoa/content/sovereignty/sovereignty.html"
                   "{6a7c1e90-5b3d-4c2a-9f81-7e0d3a6b2c54}")
  (register-about! "gjoa" "chrome://gjoa/content/settings/settings.html"
                   "{b3d8f1a2-4c5e-4a9b-8f02-1e7d6c3b9a40}")
  ;; about:vim — the keybinding customizer (reads gjoa.keys.commands, edits
  ;; gjoa.keys.bindings; the vim dispatch resolves the same pref live).
  (register-about! "vim" "chrome://gjoa/content/vim/vim.html"
                   "{d5f0b3c4-6e7a-4c2d-9124-3a9f8e5db162}"))

(js/export (def GjoaLoader Any
  {:start (fn [] Any
    (when (not (js/get st .observer-registered))
      (js/set! st .observer-registered true)
      (set-defaults)
      (apply-lockdown!)
      (js/call (js/get Services .prefs) .addObserver LOCKDOWN-PREF lockdown-observer)
      (apply-privacy-profile!)
      (js/call (js/get Services .prefs) .addObserver "gjoa.privacy.profile" profile-observer)
      (register-about-pages!)
      (register-aboutprefs-actor!)
      (set-new-tab-url!)
      (register-cosmetic-actor)
      (register-darkmode-actor)
      (register-input-actor)
      (js/call (js/get Services .obs) .addObserver observer "chrome-document-loaded")
      (js/call (js/get Services .obs) .addObserver observer "browser-delayed-startup-finished")
      (load-existing-browser-windows!)
      (let [dev (dev-mode-dir)]
        (if dev
          (console/log (str "gjoa-loader: dev mode active — sourcing chrome from " (js/get dev .path)))
          (console/log "gjoa-loader: production mode — loading chrome bundles from chrome://gjoa/content/")))))}))
