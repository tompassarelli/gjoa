#lang beagle/js
(ns gjoa.spaces.visibility)

(declare-extern [undefined] Any)

(js/export (defn is-in-active-space [tab tab-space spaces default-id active-id] Any
  (let [id (js/call tab-space .get tab)]
    (let [effective (if (and (not= id undefined) (js/call spaces .has id))
                     id
                     default-id)]
      (= effective active-id)))))
