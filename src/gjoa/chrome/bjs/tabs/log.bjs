#lang beagle/js
(ns gjoa.tabs.log)

(declare-extern [Services Ci PathUtils undefined] Any)

(def LOG-FILENAME String "gjoa-debug.log")
(def LOG-MAX-BYTES Int (* 5 1024 1024))

(def state Any {:log-path nil :rotate-checked false :flush-pending false})
(def lines Any [])

(defn log-path! [] String
  (or (js/get state .log-path)
      (let [p (js/call PathUtils .join
                (js/get (js/call (js/get Services .dirsvc) .get "ProfD" (js/get Ci .nsIFile)) .path)
                LOG-FILENAME)]
        (js/set! state .log-path p)
        p)))

(defn flush-lines! [] Any
  (let [batch (js/call lines .splice 0)]
    (if (= 0 (js/get batch .length))
      (do (js/set! state .flush-pending false) nil)
      (let [blob (js/call (js/new TextEncoder) .encode (str (js/call batch .join "\n") "\n"))
            path (log-path!)]
        (-> (js/call IOUtils .write path blob {:mode "appendOrCreate"})
            (js/call .then (fn [] Any
              (if (> (js/get lines .length) 0)
                (flush-lines!)
                (js/set! state .flush-pending false))))
            (js/call .catch (fn [e] Any
              (console/error "[GJOA:log] write failed" e)
              (js/set! state .flush-pending false))))))))

(defn maybe-rotate! [] Any
  (when (not (js/get state .rotate-checked))
    (js/set! state .rotate-checked true)
    (-> (js/call IOUtils .stat (log-path!))
        (js/call .then (fn [info] Any
          (when (> (js/get info .size) LOG-MAX-BYTES)
            (js/call IOUtils .write (log-path!) (js/new Uint8Array 0) {:mode "overwrite"}))))
        (js/call .catch (fn [] Any nil)))))

(js/export (defn create-logger! [(tag String)] Any
  (let [prefix (str "[GJOA:" tag "]")]
    (fn [event data] Any
      (when (js/call (js/get Services .prefs) .getBoolPref "gjoa.debug" false)
        (maybe-rotate!)
        (console/log prefix event (or data {}))
        (js/call lines .push (str (Date/now) " [" tag "] " event " " (JSON/stringify (or data {}))))
        (when (not (js/get state .flush-pending))
          (js/set! state .flush-pending true)
          (js/call (Promise/resolve undefined) .then flush-lines!)))))))
