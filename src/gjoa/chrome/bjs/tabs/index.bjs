#lang beagle/js
(ns gjoa.tabs.index
  (:require [gjoa.macros :refer [q by-id xul-new xul-id attr! pref-bool pref-int set-pref-bool! on! on1! has? bool rmattr! tabs! last-of]]
            [gjoa.tabs.menu :refer [build-context-menu! build-group-context-menu! build-panel-context-menu!]]
            [gjoa.tabs.drag :refer [make-drag!]]
            [gjoa.tabs.events :refer [make-events!]]
            [gjoa.tabs.rows :refer [make-rows!]]
            [gjoa.tabs.vim :refer [make-vim!]]
            [gjoa.tabs.helpers :refer [all-rows pin-tab-id tab-url tree-data! try-register-pin-attr!]]
            [gjoa.tabs.log :refer [create-logger!]]
            [gjoa.tabs.history :refer [make-history!]]
            [gjoa.tabs.content-focus :refer [make-content-focus!]]
            [gjoa.firefox.prefs :refer [ensure-vertical-tabs-default apply-menubar-default]]
            [gjoa.spaces.niri :refer [make-niri-binding!]]
            [gjoa.platform.index :refer [make-gjoa!]]
            [gjoa.tabs.snapshot :refer [make-saver!]]
            [gjoa.tabs.layout :refer [make-layout!]]
            [gjoa.spaces.manager :refer [make-spaces!]]
            [gjoa.tabs.state :refer [closed-tabs row-of saved-tab-queue selection state tree-of]]))

;; Browser globals (all-tabs left as extern: collides — exported by both
;; gjoa.firefox.tabs and gjoa.tabs.helpers, both in this bundle).
(declare-extern [window document gBrowser gBrowserInit Services all-tabs
                 requestAnimationFrame] Any)

;; Module deps — no import, declared extern
(def pfx-log Any (create-logger! "tabs"))

;; sidebar-main is looked up once; the boot function exits if nil.
(def sidebar-main Any (by-id "sidebar-container"))

;; --- Selection helpers (small — vim + drag both consume) ---

(defn clear-selection [] Any
  (js/call (Array/from selection) .forEach
    (fn [%1] Any (rmattr! %1 "gjoa-multi")))
  (js/call selection .clear))

(defn select-range [(to-row Any)] Any
  (let [from-row (or (js/get state .cursor) (js/call row-of .get (js/get gBrowser .selectedTab)))]
    (when from-row
      (let [rows (js/call (all-rows) .filter (fn [%1] Any (not (js/get %1 .hidden))))
            from-idx (js/call rows .indexOf from-row)
            to-idx (js/call rows .indexOf to-row)]
        (when (and (>= from-idx 0) (>= to-idx 0))
          (clear-selection)
          (let [start (Math/min from-idx to-idx)
                end (Math/max from-idx to-idx)]
            (js/call (js/call rows .slice start (+ end 1)) .forEach
              (fn [r] Any
                (js/call selection .add r)
                (attr! r "gjoa-multi" "true")))))))))

;; --- Recursive DOM-removal helper ---

(defn remove-children! [container stop-el] Any
  (loop []
    (when (and (js/get container .firstChild) (not= (js/get container .firstChild) stop-el))
      (js/call (js/get container .firstChild) .remove)
      (recur))))

(defn clear-all-rows! [] Any
  (remove-children! (js/get state .panel) (js/get state .spacer))
  (remove-children! (js/get state .pinnedContainer) nil))

;; --- buildPanel — removes children before spacer, creates rows ---

(defn build-panel! [(rows-api Any)] Any
  (clear-all-rows!)
  (js/call (tabs!) .forEach
    (fn [tab] Any
      (let [row (js/call rows-api .createTabRow tab)]
        (if (and (js/get tab .pinned) (js/get state .pinnedContainer))
          (js/call (js/get state .pinnedContainer) .appendChild row)
          (js/call (js/get state .panel) .insertBefore row (js/get state .spacer))))))
  (when (js/get state .pinnedContainer)
    (js/set! (js/get state .pinnedContainer) .hidden
      (not (q (js/get state .pinnedContainer) ".gjoa-tab-row"))))
  (js/call rows-api .updateVisibility))

;; --- Persistence ---

(def history Any (make-history!))
(def content-focus Any (make-content-focus!))

(def gjoa-api Any (make-gjoa! {:history history}))
(js/set! window .Gjoa gjoa-api)

;; Forward refs for cyclic deps
(def rows-ref Any {:v nil})
(def vim-ref Any {:v nil})

;; updateSpaceHeader — reflect active space name into sidebar header
(defn update-space-header [] Any
  (let [el (js/get state .spaceHeader)
        label (some-> el (js/call .querySelector "#gjoa-space-header-label"))]
    (when (and el label)
      (attr! label "value" (js/get (js/call spaces .active) .name)))))

;; Spaces (workspaces)
(def spaces Any
  (make-spaces!
    {:onChange (fn [] Any
       (when (js/get rows-ref .v) (js/call (js/get rows-ref .v) .scheduleTreeResync))
       (when schedule-save (schedule-save))
       (update-space-header)
       ;; #89 — broadcast the space ROSTER to sibling windows so all windows on
       ;; the same workspace stay consistent. Skip while applying a remote
       ;; snapshot (else hydrate->onChange->broadcast echoes into a storm). The
       ;; active-id is omitted: receivers keep their own active space (Q1).
       (when (not (js/call spaces .isApplying))
         (let [snap {:spaces (js/call spaces .list)
                     :tabSpaces (js/call (tabs!) .map
                                  (fn [t] Any
                                    [(js/get (tree-data! t) .id) (js/call spaces .spaceOf t)]))}
               e (js/call (js/get Services .wm) .getEnumerator "navigator:browser")]
           (loop []
             (when (js/call e .hasMoreElements)
               (let [w (js/call e .getNext)]
                 (when (and (not (Object/is w window)) (js/get w .Spaces))
                   (js/call (js/get w .Spaces) .applyRemoteSpaces snap)))
               (recur))))))
     :onActivated (fn [_prev next] Any
       (let [current (js/get gBrowser .selectedTab)]
         (when (not (and current (= (js/call spaces .spaceOf current) next)))
           (let [in-next (js/call (tabs!) .filter
                           (fn [%1] Any (= (js/call spaces .spaceOf %1) next)))]
             (when (> (js/get in-next .length) 0)
               (js/set! gBrowser .selectedTab (aget in-next 0)))))))
     :tabById (fn [gjoa-id] Any
       (js/call (tabs!) .find
         (fn [%1] Any (let [td (tree-data! %1)]
            (and td (= (js/get td .id) gjoa-id))))))}))

(js/set! window .Spaces spaces)

;; #89 — inherit the space ROSTER from an existing sibling window (if any) so all
;; windows on the same workspace share ONE space-id namespace; each window
;; otherwise mints rival uuids for its default 'Main'. Roster only (empty
;; tabSpaces); applyRemoteSpaces keeps active-id local (lands on the shared first
;; space). No-op for the first/only window.
(let [e (js/call (js/get Services .wm) .getEnumerator "navigator:browser")]
  (loop []
    (when (js/call e .hasMoreElements)
      (let [w (js/call e .getNext)]
        (if (and (not (Object/is w window)) (js/get w .Spaces))
          (js/call spaces .applyRemoteSpaces {:spaces (js/call (js/get w .Spaces) .list) :tabSpaces []})
          (recur))))))

;; Mirror the OS (niri) virtual-workspace name onto the active gjoa space. No-ops
;; off niri (NIRI_SOCKET unset) or when gjoa.niri.enabled is false. Must run
;; after window.Spaces exists.
(make-niri-binding!)

;; #148: hide chrome until the layout has been applied once, ONLY on a narrow
;; (will-go-horizontal) launch. Wide/vertical spawns resolve correctly pre-paint
;; and stay untouched — so we don't pay the reveal fade for them.
(js/export (defn should-defer-reveal? [(dynamic-on? Bool) (narrow? Bool)] Bool
  (and dynamic-on? narrow?)))

;; Dynamic orientation (#99): vertical tabs on a wide/full window, horizontal on
;; a narrow/half-width one — flips live as the window resizes (e.g. niri tiling).
;; matchMedia fires only when the width CROSSES the threshold, so a manual mode
;; switch survives until the next crossing; honours the master pref each time.
(when (pref-bool "gjoa.layout.dynamicOrientation" true)
  (let [threshold (pref-int "gjoa.layout.narrowThreshold" 1000)
        mq (js/call window .matchMedia (str "(max-width: " threshold "px)"))
        apply-orientation
        (fn [] Any
          (when (pref-bool "gjoa.layout.dynamicOrientation" true)
            (let [want-horizontal (js/get mq .matches)
                  is-vertical (pref-bool "sidebar.verticalTabs" true)]
              (when (= is-vertical want-horizontal)
                (set-pref-bool! "sidebar.verticalTabs" (not want-horizontal))))))]
    ;; #148: a narrow spawn flips DOM->horizontal inside init! (positionPanel, behind
    ;; delayedStartupFinished + rAF), so first paint shows vertical-then-horizontal warp.
    ;; Stamp gjoa-booting pre-paint to hide #browser until positionPanel has run once
    ;; (cleared in init!). Failsafe timeout so a thrown init never leaves chrome hidden.
    (when (js/get mq .matches)
      (attr! (js/get document .documentElement) "gjoa-booting" "")
      (setTimeout (fn [] Any (rmattr! (js/get document .documentElement) "gjoa-booting")) 1200))
    ;; #126: decide SYNCHRONOUSLY at chrome-init (not setTimeout 0, which ran after first
    ;; paint and let the persisted vertical strip flash before flipping to horizontal on a
    ;; narrow spawn). Setting the pref now means the window resolves to the right mode up
    ;; front, so the strip never appears on a restricted-space spawn.
    (apply-orientation)
    (js/call mq .addEventListener "change" apply-orientation)))

;; Card gap (#125): ONE user-adjustable gjoa gap value (about:gjoa → gjoa.layout.cardGap)
;; drives the --gjoa-card-gap CSS var used for EVERY inset/gap in the floating-card
;; layout — window↔sidebar, sidebar↔content, content↔edge, and top/bottom are all
;; exactly this value. Live-updates on change (no restart).
(let [apply-gap (fn [] Any
                  (js/call (js/get (js/get document .documentElement) .style) .setProperty
                                "--gjoa-card-gap"
                                (str (pref-int "gjoa.layout.cardGap" 8) "px")))
      gap-observer {:observe (fn [_s _t _d] Any (apply-gap))}]
  (apply-gap)
  (js/call (js/get Services .prefs) .addObserver "gjoa.layout.cardGap" gap-observer))

;; Write-on-every-change saver
(def schedule-save Any
  (make-saver!
    (fn [] Any
      (let [snap {:tabs (tabs!)
                  :rows (fn [] Any (all-rows))
                  :savedTabQueue saved-tab-queue
                  :closedTabs closed-tabs
                  :nextTabId (js/get state .nextTabId)
                  :tabUrl tab-url
                  :treeData tree-data!
                  :spaces {:spaces (js/call spaces .list)
                           :activeId (js/call spaces .activeId)
                           :tabSpaces (js/call (tabs!) .map
                                        (fn [t] Any
                                          (let [id (js/get (tree-data! t) .id)
                                                sp (js/call spaces .spaceOf t)]
                                            [id sp])))}}]
        snap))
    history
    nil))

;; Re-assert the load-bearing invariant "the selected tab lives in the active
;; space". If a visibility pass (e.g. a mode toggle) would otherwise hide the
;; selected row, pick a visible tab in the active space; if the active space is
;; empty, follow the selection to its own space rather than strand it. No-op in
;; the normal case, so it is safe to call after any updateVisibility.
(defn reconcile-selection! [] Any
  (let [sel (js/get gBrowser .selectedTab)
        active (js/call spaces .activeId)]
    (when (and sel (not= (js/call spaces .spaceOf sel) active))
      (let [in-active (js/call (tabs!) .find (fn [%1] Any (= (js/call spaces .spaceOf %1) active)))]
        (if in-active
          (js/set! gBrowser .selectedTab in-active)
          (js/call spaces .setActive (js/call spaces .spaceOf sel)))))))

;; --- Factory wiring (drag <-> rows <-> vim cycle) ---

(def drag Any
  (make-drag!
    {:clearSelection clear-selection
     :scheduleTreeResync (fn [] Any (js/call (js/get rows-ref .v) .scheduleTreeResync))
     :scheduleSave schedule-save}))

(js/set! rows-ref .v
  (make-rows!
    {:setupDrag (js/get drag .setupDrag)
     :activateVim (fn [%1] Any (js/call (js/get vim-ref .v) .activateVim %1))
     :selectRange select-range
     :clearSelection clear-selection
     :cloneAsSibling (fn [%1] Any (js/call (js/get vim-ref .v) .cloneAsSibling %1))
     :startRename (fn [%1] Any (js/call (js/get vim-ref .v) .startRename %1))
     :scheduleSave schedule-save
     :isTabInActiveSpace (fn [%1] Any (js/call spaces .isVisible %1))
     :getActiveSpaceId (fn [] Any (js/call spaces .activeId))
     :isGroupInActiveSpace (fn [%1] Any (js/call spaces .isSpaceActive (js/get %1 .spaceId)))}))

(def layout Any
  (make-layout!
    {:sidebarMain sidebar-main
     :rows (js/get rows-ref .v)
     :isTabInActiveSpace (fn [%1] Any (js/call spaces .isVisible %1))
     :reconcileSelection reconcile-selection!}))

(js/set! vim-ref .v
  (make-vim!
    {:rows (js/get rows-ref .v)
     :layout layout
     :scheduleSave schedule-save
     :clearSelection clear-selection
     :selectRange select-range
     :sidebarMain sidebar-main
     :history history
     :contentFocus content-focus
     :spaces spaces}))

(def events Any
  (make-events!
    {:rows (js/get rows-ref .v)
     :vim (js/get vim-ref .v)
     :scheduleSave schedule-save
     :spaces spaces}))

;; --- loadFromHistory — promise chain ---

;; Recursive pairwise matching of saved nodes to live tabs
(defn match-tabs-loop! [(tab-nodes Any) (tabs Any) (ni Int) (li-ref Any)
                       (applied Any) (apply-fn Any)] Any
  (when (and (< ni (js/get tab-nodes .length)) (< (js/get li-ref .v) (js/get tabs .length)))
    (let [s (aget tab-nodes ni)
          live (aget tabs (js/get li-ref .v))
          live-url (or (some-> live (js/get .linkedBrowser) (js/get .currentURI) (js/get .spec)) "")
          pending (= live-url "about:blank")]
      (if (or (= live-url (js/get s .url)) pending)
        (do (apply-fn live s ni)
            (js/set! li-ref .v (+ (js/get li-ref .v) 1))
            (match-tabs-loop! tab-nodes tabs (+ ni 1) li-ref applied apply-fn))
        (let [off (loop [j 1]
                    (cond
                      (or (> j 5) (>= (+ (js/get li-ref .v) j) (js/get tabs .length))) 0
                      (= (or (some-> (aget tabs (+ (js/get li-ref .v) j)) (js/get .linkedBrowser) (js/get .currentURI) (js/get .spec)) "")
                         (js/get s .url)) j
                      :else (recur (+ j 1))))]
          (when (> off 0)
            (apply-fn (aget tabs (+ (js/get li-ref .v) off)) s ni)
            (js/set! li-ref .v (+ (js/get li-ref .v) off 1)))
          (match-tabs-loop! tab-nodes tabs (+ ni 1) li-ref applied apply-fn))))))

(def loaded-nodes-ref Any {:v nil})

(defn load-from-history! [] Any
  (-> (js/call history .getRecent 1)
      (js/call .then (fn [recent] Any
        (when (> (js/get recent .length) 0)
          (let [env (js/get (aget recent 0) .snapshot)]
            (try
              (do
                (when (not= (js/get env .nextTabId) nil)
                  (js/set! state .nextTabId (js/get env .nextTabId)))
                (js/set! closed-tabs .length 0)
                (js/call (js/get closed-tabs .push) .apply closed-tabs (js/get env .closedTabs))

                (let [tabs (all-tabs)
                      tab-nodes (js/call (js/call (js/get env .nodes) .filter
                                    (fn [%1] Any (not= (js/get %1 .type) "group"))) .map
                                  (fn [%1] Any (clone-node-fields %1)))]

                  ;; Store last loaded nodes
                  (js/set! state .lastLoadedNodes
                    (js/call tab-nodes .map (fn [%1] Any (clone-node-fields %1))))

                  ;; Advance nextTabId past all saved node IDs
                  (js/call tab-nodes .forEach
                    (fn [s] Any
                      (when (and (js/get s .id) (>= (js/get s .id) (js/get state .nextTabId)))
                        (js/set! state .nextTabId (+ (js/get s .id) 1)))))

                  (pfx-log "loadFromHistory"
                    {:nextTabId (js/get state .nextTabId)
                     :savedNextTabId (js/get env .nextTabId)
                     :tabNodes (js/get tab-nodes .length)
                     :liveTabs (js/get tabs .length)
                     :tabNodeIds (js/call tab-nodes .map (fn [%1] Any (js/get %1 .id)))
                     :liveTabPfxIds (js/call tabs .map (fn [%1] Any (or (and (js/get %1 .getAttribute) (js/call %1 .getAttribute "gjoa-id")) 0)))})

                  (let [applied (js/new Set)
                        apply-fn (fn [tab s i] Any
                                   (let [id (or (js/get s .id) (let [nid (js/get state .nextTabId)]
                                                           (js/set! state .nextTabId (+ nid 1))
                                                           nid))]
                                     (js/call tree-of .set tab
                                       {:id id
                                        :parentId (or (js/get s .parentId) nil)
                                        :name (or (js/get s .name) nil)
                                        :state (or (js/get s .state) nil)
                                        :collapsed (bool (js/get s .collapsed))})
                                     (pin-tab-id tab id)
                                     (js/call applied .add i)))
                        li-ref {:v 0}]

                    ;; Pairwise matching
                    (match-tabs-loop! tab-nodes tabs 0 li-ref applied apply-fn)

                    (console/log
                      (str "gjoa-tabs: loaded " (js/get tab-nodes .length) " saved tab nodes, "
                           "matched " (js/get applied .size) " to live tabs (of " (js/get tabs .length) ")."))

                    ;; Leftover nodes
                    (js/set! saved-tab-queue .length 0)
                    (js/call tab-nodes .forEach
                      (fn [s i] Any
                        (when (not (js/call applied .has i))
                          (js/set! s ._origIdx i)
                          (js/call saved-tab-queue .push s))))

                    ;; Spaces hydration
                    (when (js/get env .spaces)
                      (let [tab-by-gjoa-id (fn [gjoa-id] Any
                                            (js/call tabs .find
                                              (fn [%1] Any (let [td (js/call tree-of .get %1)]
                                                 (and td (= (js/get td .id) gjoa-id))))))]
                        (js/call spaces .hydrate (js/get env .spaces) tab-by-gjoa-id)))

                    ;; Full node list for buildFromSaved
                    (js/set! loaded-nodes-ref .v (js/get env .nodes)))))
              (catch (e Any)
                (console/error "gjoa-tabs: loadFromHistory apply error" e)))))))))

;; --- buildFromSaved — groups + tab order from saved data ---

(defn build-from-saved! [] Bool
  (let [loaded-nodes (js/get loaded-nodes-ref .v)]
    (if (or (not loaded-nodes) (not (js/get state .panel)))
      false
      (let [rows-api (js/get rows-ref .v)
            group-nodes (js/call loaded-nodes .filter (fn [%1] Any (= (js/get %1 .type) "group")))
            leading-groups []
            gafter {:entries []}]

        ;; Bucket groups by anchor
        (js/call group-nodes .forEach
          (fn [g] Any
            (if (= (js/get g .afterTabId) nil)
              (js/call leading-groups .push g)
              (let [entry (js/call (js/get gafter .entries) .find (fn [%1] Any (= (aget %1 0) (js/get g .afterTabId))))]
                (if entry
                  (js/call (aget entry 1) .push g)
                  (let [arr [g]]
                    (js/call (js/get gafter .entries) .push [(js/get g .afterTabId) arr])))))))

        (let [mk-group (fn [g] Any
                         (let [row (js/call rows-api .createGroupRow (or (js/get g .name) "") (or (js/get g .level) 0))]
                           (js/set! (js/get row ._group) .state (or (js/get g .state) nil))
                           (js/set! (js/get row ._group) .collapsed (bool (js/get g .collapsed)))
                           (when (js/get g .spaceId)
                             (js/set! (js/get row ._group) .spaceId (js/get g .spaceId)))
                           (js/call rows-api .syncGroupRow row)
                           row))]

          ;; Remove existing children
          (clear-all-rows!)

          ;; Insert leading groups
          (js/call leading-groups .forEach
            (fn [%1] Any (js/call (js/get state .panel) .insertBefore (mk-group %1) (js/get state .spacer))))

          ;; Insert tabs + trailing groups
          (js/call (tabs!) .forEach
            (fn [tab] Any
              (let [row (js/call rows-api .createTabRow tab)]
                (if (and (js/get tab .pinned) (js/get state .pinnedContainer))
                  (js/call (js/get state .pinnedContainer) .appendChild row)
                  (do
                    (js/call (js/get state .panel) .insertBefore row (js/get state .spacer))
                    (let [tid (js/get (tree-data! tab) .id)
                          entry (js/call (js/get gafter .entries) .find (fn [%1] Any (= (aget %1 0) tid)))]
                      (when entry
                        (js/call (aget entry 1) .forEach
                          (fn [%1] Any (js/call (js/get state .panel) .insertBefore (mk-group %1) (js/get state .spacer)))))))))))

          (when (js/get state .pinnedContainer)
            (js/set! (js/get state .pinnedContainer) .hidden
              (not (q (js/get state .pinnedContainer) ".gjoa-tab-row"))))

          (js/set! loaded-nodes-ref .v nil)
          (js/call rows-api .scheduleTreeResync)
          (js/call rows-api .updateVisibility)
          true)))))

;; --- describe helper for dev debug API ---

(defn describe [(el Any)] String
  (if (not el)
    "null"
    (let [tag (or (some-> el (js/get .tagName) (js/call .toLowerCase)) "?")
          id-str (if (js/get el .id) (str "#" (js/get el .id)) "")
          raw (when (= (js/typeof (js/get el .className)) "string") (js/call (js/get el .className) .trim))
          cls (if raw (str "." (js/call (js/call (js/call raw .split (js/new RegExp "\\s+")) .slice 0 2) .join ".")) "")]
      (str tag id-str cls))))

;; --- init — the bootstrap, converted from async to promise chains ---

(defn init! [] Any
  ;; Defensive: pre-panel steps wrapped in try/catch
  (try (ensure-vertical-tabs-default)
    (catch (e Any) (console/error "gjoa-tabs: ensureVerticalTabsDefault threw — continuing" e)))
  (try (apply-menubar-default document)
    (catch (e Any) (console/error "gjoa-tabs: applyMenubarDefault threw — continuing" e)))
  (try (try-register-pin-attr!)
    (catch (e Any) (console/error "gjoa-tabs: tryRegisterPinAttr threw — continuing" e)))

  (-> (-> (load-from-history!)
          (js/call .catch (fn [%1] Any (console/error "gjoa-tabs: loadFromHistory threw — init proceeds with empty state" %1))))
      (js/call .then (fn [] Any
        ;; await requestAnimationFrame
        (-> (js/new Promise (fn [%1] Any (requestAnimationFrame %1)))
            (js/call .then (fn [] Any
              (let [rows-api (js/get rows-ref .v)
                    vim-api (js/get vim-ref .v)]

                ;; A hot-reload re-runs init! without the previous bundle removing what
                ;; it built; a live holder of one of these ids is that stale node, and
                ;; leaving it stacks a second panel/header into the drawer column.
                (doseq [id ["gjoa-pinned-container" "gjoa-tab-panel" "gjoa-space-header"]]
                  (some-> (by-id id) (js/call .remove)))

                ;; Create pinned container
                (js/set! state .pinnedContainer (xul-id "vbox" "gjoa-pinned-container"))
                (js/set! (js/get state .pinnedContainer) .hidden true)
                (js/call drag .setupPinnedContainerDrop (js/get state .pinnedContainer))

                ;; Create panel
                (js/set! state .panel (xul-id "vbox" "gjoa-tab-panel"))

                ;; Create spacer
                (js/set! state .spacer (xul-id "box" "gjoa-tab-spacer"))
                (attr! (js/get state .spacer) "flex" "1")
                (js/call (js/get state .panel) .appendChild (js/get state .spacer))
                (js/call drag .setupPanelDrop (js/get state .panel))

                ;; Space header
                (js/set! state .spaceHeader (xul-id "hbox" "gjoa-space-header"))
                (let [header-label (xul-id "label" "gjoa-space-header-label")]
                  (js/call (js/get state .spaceHeader) .appendChild header-label))
                (on! (js/get state .spaceHeader) "click"
                  (fn [] Any
                    (try (js/call (js/get vim-ref .v) .runExCommand "space list")
                      (catch (e Any) (console/error "gjoa: space header click failed" e)))))
                (update-space-header)

                ;; Position panel
                (js/call layout .positionPanel)

                ;; #148: DOM is now in final arrangement — reveal chrome on the next
                ;; frame (no-op if gjoa-booting was never stamped, e.g. wide spawn).
                (requestAnimationFrame (fn [] Any (rmattr! (js/get document .documentElement) "gjoa-booting")))

                ;; MutationObserver for sidebar attribute changes. Use the
                ;; rAF-coalesced wrapper: compact mode bursts these attributes in
                ;; one turn, so the un-coalesced positionPanel would re-enter
                ;; several times per frame and could read a half-applied set.
                (let [obs (js/new MutationObserver (fn [] Any (js/call layout .requestPositionPanel)))
                      opts {:childList true
                            :attributes true
                            :attributeFilter ["sidebar-launcher-expanded" "data-gjoa-compact" "gjoa-has-hover"]}]
                  (js/call obs .observe sidebar-main opts))

                ;; Pref observer for vertical tabs
                (js/call (js/get Services .prefs) .addObserver "sidebar.verticalTabs"
                  {:observe (fn [] Any (js/call layout .requestPositionPanel))})

                ;; Build from saved or fresh
                (when (not (build-from-saved!))
                  (build-panel! rows-api))

                ;; Context menus
                (build-context-menu!
                  {:startRename (js/get vim-api .startRename)
                   :toggleCollapse (js/get rows-api .toggleCollapse)
                   :createGroupRow (js/get rows-api .createGroupRow)
                   :setCursor (js/get vim-api .setCursor)
                   :updateVisibility (js/get rows-api .updateVisibility)
                   :scheduleTreeResync (js/get rows-api .scheduleTreeResync)
                   :scheduleSave schedule-save})
                (build-group-context-menu!
                  {:startRename (js/get vim-api .startRename)
                   :toggleCollapse (js/get rows-api .toggleCollapse)
                   :syncGroupRow (js/get rows-api .syncGroupRow)
                   :updateVisibility (js/get rows-api .updateVisibility)
                   :scheduleSave schedule-save})
                (let [panel-menu (build-panel-context-menu!
                                  {:createGroupRow (js/get rows-api .createGroupRow)
                                   :startRename (js/get vim-api .startRename)
                                   :setCursor (js/get vim-api .setCursor)
                                   :updateVisibility (js/get rows-api .updateVisibility)
                                   :scheduleSave schedule-save})]

                  (js/call vim-api .createModeline)
                  (js/call vim-api .setupVimKeys)
                  (js/call vim-api .setupGlobalKeys)
                  (js/call vim-api .focusPanelUnlessUrlbar)

                  ;; Install event listeners
                  (let [teardown-events (js/call events .install)]

                    ;; Catch-up: create rows for tabs added between init and install
                    (js/call (tabs!) .forEach
                      (fn [t] Any
                        (when (not (js/call row-of .has t))
                          (let [row (js/call rows-api .createTabRow t)]
                            (if (js/get t .pinned)
                              (js/call (js/get state .pinnedContainer) .appendChild row)
                              (js/call (js/get state .panel) .insertBefore row (js/get state .spacer)))))))

                    ;; Ensure selected tab in active space
                    (reconcile-selection!)
                    (js/call rows-api .updateVisibility)

                    ;; Spacer click -> activate vim with last visible row
                    (on! (js/get state .spacer) "click"
                      (fn [] Any
                        (let [visible (js/call (all-rows) .filter (fn [%1] Any (not (js/get %1 .hidden))))]
                          (when (> (js/get visible .length) 0)
                            (js/call vim-api .activateVim (last-of visible))))))

                    ;; Spacer right-click -> panel context menu
                    (on! (js/get state .spacer) "contextmenu"
                      (fn [e] Any
                        (js/call e .preventDefault)
                        (js/call e .stopPropagation)
                        (js/call panel-menu .openPopupAtScreen (js/get e .screenX) (js/get e .screenY) true)))

                    ;; Unload teardown
                    (on1! window "unload" teardown-events)

                    ;; Session tagger — tag latest event on quit-application
                    (let [session-tagger
                            {:observe (fn [_subject topic] Any
                               (when (= topic "quit-application")
                                 (js/call (js/call history .tagLatest "session") .catch
                                   (fn [%1] Any (console/error "gjoa-tabs: tagLatest on quit failed" %1)))))}]
                      (js/call (js/get Services .obs) .addObserver session-tagger "quit-application")
                      (on1! window "unload"
                        (fn [] Any (js/call (js/get Services .obs) .removeObserver session-tagger "quit-application"))))

                    ;; Retention timer — prune old events
                    (setTimeout
                      (fn [] Any (js/call (js/call history .runRetention) .catch
                          (fn [e] Any (console/error "gjoa-tabs: initial retention pass failed" e))))
                      30000)
                    (let [retention-timer
                            (setInterval
                              (fn [] Any (js/call (js/call history .runRetention) .catch (fn [] Any nil)))
                              (* 10 60 1000))]
                      (on1! window "unload"
                        (fn [] Any
                          (clearInterval retention-timer)
                          (js/call (js/call history .close) .catch (fn [] Any nil))
                          (js/call content-focus .destroy)
                          (js/call gjoa-api .destroy))))

                    ;; Test-only debug API
                    (when (pref-bool "gjoa.test.exposeAPI" false)
                      (js/set! window .gjoaTest
                        {:state state
                         :treeOf tree-of
                         :rowOf row-of
                         :cursorId (fn [] Any
                                     (let [r (js/get state .cursor)]
                                       (when (and r (js/get r ._tab))
                                         (let [td (js/call tree-of .get (js/get r ._tab))]
                                           (and td (js/get td .id))))))
                         :snapshotTree (fn [] Any
                                         (let [out []]
                                           (js/call (tabs!) .forEach
                                             (fn [t] Any
                                               (let [td (js/call tree-of .get t)]
                                                 (when td
                                                   (js/call out .push
                                                     {:id (js/get td .id)
                                                      :parentId (js/get td .parentId)
                                                      :name (js/get td .name)
                                                      :collapsed (js/get td .collapsed)
                                                      :pinned (bool (js/get t .pinned))
                                                      :url (or (some-> t (js/get .linkedBrowser) (js/get .currentURI) (js/get .spec)) "")
                                                      :label (js/get t .label)})))))
                                           out))
                         :vim vim-api
                         :rows rows-api
                         :layout layout
                         :scheduleSave schedule-save
                         :history history
                         :contentFocus content-focus
                         :contentInputFocused (fn [] Any (js/call content-focus .contentInputFocused))
                         :contentFocusDiag (fn [] Any (js/call content-focus .diag))
                         :Gjoa gjoa-api})
                      (console/log "gjoa-tabs: gjoaTest debug API exposed"))

                    ;; Dev helpers (window.pfx)
                    (when (pref-bool "gjoa.debug" false)
                      (let [pfx-ns (or (js/get window .pfx) (do (js/set! window .pfx {}) (js/get window .pfx)))]

                        (js/set! pfx-ns .measure
                          (fn [& els] Any
                            (js/call els .map (fn [el i] Any
                              (let [r (some-> el (js/call .getBoundingClientRect))]
                                (if (= r nil)
                                  {:i i :tag (describe el) :error "no rect"}
                                  {:i i
                                   :tag (describe el)
                                   :x (Math/round (js/get r .left))
                                   :y (Math/round (js/get r .top))
                                   :w (Math/round (js/get r .width))
                                   :h (Math/round (js/get r .height))
                                   :right (Math/round (js/get r .right))
                                   :bottom (Math/round (js/get r .bottom))}))))))

                        (js/set! pfx-ns .gaps
                          (fn [& els] Any
                            (js/call (js/call els .slice 1) .map (fn [el i] Any
                              (let [a (some-> (aget els i) (js/call .getBoundingClientRect))
                                    b (some-> el (js/call .getBoundingClientRect))]
                                (if (or (= a nil) (= b nil))
                                  {:i i :error "no rect"}
                                  {:i i
                                   :between (str (describe (aget els i)) " -> " (describe el))
                                   :gapY (Math/round (- (js/get b .top) (js/get a .bottom)))
                                   :gapX (Math/round (- (js/get b .left) (js/get a .right)))
                                   :sameY (= (Math/round (js/get a .top)) (Math/round (js/get b .top)))
                                   :sameX (= (Math/round (js/get a .left)) (Math/round (js/get b .left)))}))))))

                        (console/log "gjoa-tabs: dev helpers (window.pfx) exposed (gjoa.debug=true)")))

                    (console/log "gjoa-tabs: initialized")))))))))))

;; --- safeInit — wraps init in catch-all ---

(defn safe-init! [] Any
  (-> (init!)
      (js/call .then (fn [_] Any
               ;; First load: FF152's blank-page urlbar-focus treatment no longer
               ;; recognizes the gjoa newtab (about:newtab is redirected to a
               ;; chrome:// doc), so Firefox focuses the content <browser> and vim
               ;; eats the user's first keystroke (they typed expecting the urlbar,
               ;; like stock Firefox). Put the cursor in the urlbar, and re-assert
               ;; ONCE if Firefox steals focus to the <browser> while the newtab
               ;; content loads. One-shot + hard stop so it never fights a real click.
               (let [u (js/get window .gURLBar)]
                 (when u
                   (let [blank? (fn [] Bool
                                  (let [spec (or (some-> gBrowser (js/get .selectedBrowser) (js/get .currentURI) (js/get .spec)) "")]
                                    (or (js/call spec .startsWith "chrome://gjoa-newtab")
                                        (= spec "about:newtab") (= spec "about:home")
                                        (= spec "about:blank"))))
                         focus-it! (fn [] Any
                                     (when (and (blank?) (= (or (js/get u .value) "") ""))
                                       (try (js/call u .focus) (js/call u .select) (catch (_e Any) nil))))
                         holder {:fn nil}
                         stop! (fn [] Any
                                 (when (js/get holder .fn)
                                   (js/call window .removeEventListener "focusin" (js/get holder .fn) true)
                                   (js/set! holder .fn nil)))]
                     (js/set! holder .fn
                       (fn [e] Any
                         (when (= (some-> e (js/get .target) (js/get .tagName)) "browser")
                           (focus-it!)
                           (stop!))))
                     (js/call window .addEventListener "focusin" (js/get holder .fn) true)
                     (js/call window .setTimeout stop! 2500)
                     (js/call window .setTimeout focus-it! 120)
                     (js/call window .setTimeout
                       (fn [] Any (console/log (str "gjoa-urlbar-focus FINAL active="
                                                (some-> window (js/get .document) (js/get .activeElement) (js/get .tagName)))))
                       2200))))))
      (js/call .catch (fn [%1] Any (console/error "gjoa-tabs: init() threw — sidebar may be empty" %1)))))

;; --- clone-node-fields: copy the 6 persistence fields into a fresh object ---

(defn clone-node-fields [(src Any)] Any
  {:id        (js/get src .id)
   :parentId  (js/get src .parentId)
   :url       (js/get src .url)
   :name      (js/get src .name)
   :state     (js/get src .state)
   :collapsed (js/get src .collapsed)})

;; --- Boot gate: sidebar-main check + delayed startup ---

(when sidebar-main
  (if (js/get gBrowserInit .delayedStartupFinished)
    (safe-init!)
    (let [obs (fn [subject topic] Any
                (when (and (= topic "browser-delayed-startup-finished") (= subject window))
                  (js/call (js/get Services .obs) .removeObserver obs topic)
                  (safe-init!)))]
      (js/call (js/get Services .obs) .addObserver obs "browser-delayed-startup-finished"))))
