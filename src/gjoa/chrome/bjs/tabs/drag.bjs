#lang beagle/js
(ns gjoa.tabs.drag
  (:require [gjoa.macros :refer [q qa xul-new attr! on! onc! bool has? rmattr! css! tabs! toggle! undef-or last-of]]
            [gjoa.tabs.log :refer [create-logger!]]
            [gjoa.tabs.state :refer [state row-of selection moving-tabs]]
            [gjoa.tabs.constants :refer [INDENT]]
            [gjoa.tabs.helpers :refer [all-rows data-of! is-horizontal level-of! level-of-row! same-node? subtree-rows! tab-by-id tree-data!]]))

(declare-extern [document gBrowser Array requestAnimationFrame] Any)

;; Walk siblings from `start` using `dir` (e.g. .-nextElementSibling),
;; return the first node satisfying `pred`, or nil.
(defn find-sib! [(start Any) (pred Any) (dir Any)] Any
  (loop [node start]
    (cond
      (not node) nil
      (pred node) node
      :else (recur (dir node)))))

;; Set both targetIdx and idxBranch on a result map in one call.
(defn set-idx! [(r Any) (idx Any) (branch Any)] Any
  (js/set! r .targetIdx idx)
  (js/set! r .idxBranch branch))

;; Extract tabs from a row array: filter to rows with ._tab, map to the tab.
(defn tabs-of [(rows Any)] Any
  (js/call (js/call rows .filter (fn [%1] Any (js/get %1 ._tab))) .map
        (fn [%1] Any (js/get %1 ._tab))))

;; Is the row's tab pinned?  Returns a bool.
;; Covers both tab-rows and the (.-dragSource ds) pattern.
(defn row-pinned? [(row Any)] Any
  (bool (and (js/get row ._tab) (js/get (js/get row ._tab) .pinned))))

;; Cross-container routing follows the row's CONTAINER, not its tab's flag: a row
;; the pinned section shows is a pin target even if the two disagree, so a drop
;; onto it can never degrade into a same-container reorder.
(defn in-pinned-section? [(row Any)] Any
  (bool (and row (same-node? (js/get row .parentNode) (js/get state .pinnedContainer)))))

;; Pretty-printer for a row -- used in log lines so we can correlate source
;; vs target across event boundaries without dumping the whole element.
(defn row-desc! [(row Any)] Any
  (cond
    (not row)
    {:row "null"}

    (js/get row ._tab)
    {:kind "tab"
     :id (js/get (tree-data! (js/get row ._tab)) .id)
     :label (js/get (js/get row ._tab) .label)
     :level (level-of! (js/get row ._tab))
     :pinned (bool (js/get (js/get row ._tab) .pinned))
     :parentId (js/get (tree-data! (js/get row ._tab)) .parentId)}

    (js/get row ._group)
    {:kind "group"
     :id (js/get (js/get row ._group) .id)
     :name (js/get (js/get row ._group) .name)
     :level (js/get (js/get row ._group) .level)}

    :else {:kind "?"}))

;; Parent-id for a tab dropped INTO a group.
(defn find-group-context-parent [(group Any) (log-fn Any)] Any
  (let [id (some-> group (js/get ._group) (js/get .id))]
    (log-fn "findGroupContextParent"
            {:groupId id
             :groupLevel (or (some-> group (js/get ._group) (js/get .level)) 0)})
    id))

;; Closest preceding tab in DOM. Skips groups. Uses find-sib!.
(defn find-closest-tab-before! [(row Any)] Any
  (let [hit (find-sib! (js/get row .previousElementSibling)
                      (fn [%1] Any (js/get %1 ._tab))
                      (fn [%1] Any (js/get %1 .previousElementSibling)))]
    (and hit (js/get hit ._tab))))

;; Resolve the grid cell (.gjoa-tab-row / .gjoa-group-row) actually under the
;; pointer, scoped to `container`'s visible rows. In the horizontal column-major
;; grid (rows.bjs update-horizontal-grid) each root opens a new COLUMN and its
;; children stack BELOW it, so the per-row `dragover` listener can fire on a
;; neighbouring cell when the pointer is near a column/row boundary — which is
;; the #101 imprecision. Hit-testing the real rects makes the drop land on the
;; cell the user is actually pointing at. Returns nil when the pointer is in a
;; grid gap (the caller then falls back to the listener's own row).
(defn cell-under! [(container Any) (client-x Any) (client-y Any)] Any
  (let [rows (when container
               (js/call container .querySelectorAll
                 ".gjoa-tab-row:not([hidden]), .gjoa-group-row:not([hidden])"))
        found {:v nil}]
    (when rows
      (js/call rows .forEach
        (fn [r] Any
          (when (not (js/get found .v))
            (let [rect (js/call r .getBoundingClientRect)]
              (when (and (>= client-x (js/get rect .left)) (< client-x (js/get rect .right))
                         (>= client-y (js/get rect .top)) (< client-y (js/get rect .bottom)))
                (js/set! found .v r)))))))
    (js/get found .v)))

;; Last tab inside the group's visual subtree, or -- if the group has no
;; tabs in its subtree -- the closest preceding tab before the group.
(defn find-last-tab-in-group-or-before! [(group Any)] Any
  (let [subtree-tabs (tabs-of (js/call (subtree-rows! group) .slice 1))]
    (if (js/get subtree-tabs .length)
      (last-of subtree-tabs)
      (find-closest-tab-before! group))))
(js/export (defn make-drag! [(deps Any)] Any
  (let [clear-selection (js/get deps .clearSelection)
        schedule-tree-resync (js/get deps .scheduleTreeResync)
        schedule-save (js/get deps .scheduleSave)
        log (create-logger! "tabs/drag")

        ;; Closure-private drag/drop cycle state
        ds {:dragSource nil
            :dropIndicator nil
            :dropTarget nil
            :dropPosition nil}

        ;; --- clearDropIndicator ---
        clear-drop-indicator (fn [] Any
          (when (js/get ds .dropIndicator)
            (js/call (js/get ds .dropIndicator) .remove))
          (js/set! ds .dropTarget nil)
          (js/set! ds .dropPosition nil))

        ;; The pinned section is `hidden` (0x0, no drag events) while empty, so the
        ;; into-empty-pinned path is unreachable unless the drag reveals it.
        clear-drop-strip (fn [] Any
          (let [pc (js/get state .pinnedContainer)]
            (when (and pc (has? pc "gjoa-drop-strip"))
              (rmattr! pc "gjoa-drop-strip")
              (js/set! pc .hidden (not (bool (q pc ".gjoa-tab-row")))))))

        ;; --- showDropIndicator ---
        show-drop-indicator (fn [target-row position] Any
          (when-not (js/get ds .dropIndicator)
            (let [el (xul-new "box")]
              (js/set! el .id "gjoa-drop-indicator")
              (js/set! ds .dropIndicator el)))
          (let [ind (js/get ds .dropIndicator)]
            (rmattr! ind "gjoa-drop-child")
            (rmattr! ind "gjoa-fixed")
            (css! ind "")
            (log "showDropIndicator"
                 {:target (row-desc! target-row)
                  :position position
                  :horizontal (is-horizontal)})
            (if (is-horizontal)
              (do
                (when (not (same-node? (js/get ind .parentNode)
                                       (js/get document .documentElement)))
                  (js/call (js/get document .documentElement) .appendChild ind))
                (let [rect (js/call target-row .getBoundingClientRect)
                      s (js/get ind .style)]
                  (attr! ind "gjoa-fixed" "true")
                  (js/set! s .position "fixed")
                  (if (= position "child")
                    (do
                      (attr! ind "gjoa-drop-child" "true")
                      (js/set! s .left (str (js/get rect .left) "px"))
                      (js/set! s .top (let [(rect-bottom Float) (js/get rect .bottom)]
                                        (str (- rect-bottom 1) "px")))
                      (js/set! s .width (str (js/get rect .width) "px"))
                      (js/set! s .height "2px"))
                    (let [(rect-left Float) (js/get rect .left)
                          (rect-right Float) (js/get rect .right)
                          x-edge (if (= position "before")
                                   (- rect-left 1)
                                   (- rect-right 1))]
                      (js/set! s .left (str x-edge "px"))
                      (js/set! s .top (str (js/get rect .top) "px"))
                      (js/set! s .width "2px")
                      (js/set! s .height (str (js/get rect .height) "px"))))))
              ;; Vertical mode
              (let [lvl (level-of-row! target-row)]
                (cond
                  (= position "child")
                  (do (attr! ind "gjoa-drop-child" "true")
                      (js/call target-row .after ind))

                  (= position "before")
                  (js/call target-row .before ind)

                  :else
                  (let [st (subtree-rows! target-row)]
                    (js/call (last-of st) .after ind)))
                (js/set! (js/get ind .style) .marginInlineStart
                      (str (+ (* (if (= position "child") (+ lvl 1) lvl)
                                  INDENT)
                               8)
                           "px"))))))

        ;; --- executeDrop ---
        execute-drop (fn [src-row tgt-row position] Any
          (clear-drop-indicator)
          (let [tgt-level (level-of-row! tgt-row)]
            (if (not (data-of! tgt-row))
              (log "executeDrop:abort"
                   {:reason "no-tgt-data" :target (row-desc! tgt-row)})
              (let [src-pinned (or (row-pinned? src-row)
                                   (in-pinned-section? src-row))
                    tgt-pinned (or (row-pinned? tgt-row)
                                   (in-pinned-section? tgt-row))
                    is-cross-container (not= src-pinned tgt-pinned)]

                (log "executeDrop:enter"
                     {:source (row-desc! src-row) :target (row-desc! tgt-row)
                      :position position :srcPinned src-pinned
                      :tgtPinned tgt-pinned :isCrossContainer is-cross-container
                      :tgtLevel tgt-level})

                (let [moved-rows
                      (cond
                        (and is-cross-container (js/get src-row ._tab))
                        [src-row]

                        (and is-cross-container (js/get src-row ._group))
                        (subtree-rows! src-row)

                        is-cross-container
                        []

                        (and (> (js/get selection .size) 1)
                             (js/call selection .has src-row))
                        (js/call (all-rows) .filter (fn [%1] Any (js/call selection .has %1)))

                        :else
                        (subtree-rows! src-row))]

                  (if (not (js/get moved-rows .length))
                    (log "executeDrop:abort" {:reason "no-movedRows"})
                    (let [src-level (level-of-row! (aget moved-rows 0))
                          new-src-level (if (= position "child")
                                          (+ tgt-level 1)
                                          tgt-level)
                          delta (- new-src-level src-level)]

                      (log "executeDrop:plan"
                           {:movedRowsCount (js/get moved-rows .length)
                            :srcLevel src-level :newSrcLevel new-src-level
                            :delta delta})

                      ;; Compute new parent for source
                      (let [(parent-result Any) {:value nil
                                                  :branch "no-tab-no-group->null"}]
                        (cond
                          (js/get tgt-row ._tab)
                          (do
                            (js/set! parent-result .branch
                                  (if (= position "child")
                                    "tab/child->tgtId"
                                    "tab/sibling->tgtParentId"))
                            (js/set! parent-result .value
                                  (if (= position "child")
                                    (js/get (tree-data! (js/get tgt-row ._tab)) .id)
                                    (js/get (tree-data! (js/get tgt-row ._tab)) .parentId))))

                          (js/get tgt-row ._group)
                          (if (= position "child")
                            (do
                              (js/set! parent-result .branch
                                    "group/child->groupId")
                              (js/set! parent-result .value
                                    (find-group-context-parent tgt-row log)))
                            (let [group-level (or (some-> tgt-row (js/get ._group) (js/get .level)) 0)]
                              (js/set! parent-result .branch
                                    (str "group/" position
                                         "->siblingOfGroup(level="
                                         group-level ")"))
                              (if (<= group-level 0)
                                (js/set! parent-result .value nil)
                                (let [enc (find-sib!
                                            (js/get tgt-row .previousElementSibling)
                                            (fn [prev] Any
                                              (and (js/get prev ._group)
                                                   (< (or (js/get (js/get prev ._group) .level) 0)
                                                      group-level)))
                                            (fn [%1] Any (js/get %1 .previousElementSibling)))]
                                  (js/set! parent-result .value
                                        (and enc (js/get (js/get enc ._group) .id)))))))

                          :else nil)

                        (log "executeDrop:newParent"
                             {:branch (js/get parent-result .branch)
                              :newParentForSource (js/get parent-result .value)})

                        ;; Update parentId for top-level moved tabs
                        (let [moved-set (js/new Set moved-rows)
                              mutation-count {:v 0}]
                          (js/call moved-rows .forEach
                            (fn [r] Any
                              (cond
                                (js/get r ._tab)
                                (let [td (tree-data! (js/get r ._tab))
                                      parent (tab-by-id
                                               (undef-or (js/get td .parentId) 0))]
                                  (when (or (not parent)
                                            (not (js/call moved-set .has
                                                   (js/call row-of .get parent))))
                                    (let [old-pid (js/get td .parentId)]
                                      (js/set! td .parentId
                                            (js/get parent-result .value))
                                      (let [(mutations Int) (js/get mutation-count .v)]
                                        (js/set! mutation-count .v (+ mutations 1)))
                                      (log "executeDrop:mutate"
                                           {:tab (js/get (js/get r ._tab) .label)
                                            :tabId (js/get td .id)
                                            :oldParentId old-pid
                                            :newParentId
                                              (js/get parent-result .value)}))))

                                (js/get r ._group)
                                (let [(group-level Int) (or (js/get (js/get r ._group) .level) 0)]
                                  (js/set! (js/get r ._group) .level
                                        (Math/max 0 (+ group-level delta))))

                                :else nil))
                          (log "executeDrop:mutations"
                               {:parentIdMutations (js/get mutation-count .v)}))

                        (let [moved-tabs (tabs-of moved-rows)]

                          ;; Cross-container: pin/unpin BEFORE computing
                          ;; targetIdx
                          (when is-cross-container
                            (js/call moved-tabs .forEach
                              (fn [%1] Any (cond
                                 (and tgt-pinned (not (js/get %1 .pinned)))
                                 (js/call gBrowser .pinTab %1)

                                 (and (not tgt-pinned) (js/get %1 .pinned))
                                 (js/call gBrowser .unpinTab %1)

                                 :else nil))))

                          (let [tabs-arr (tabs!)
                                idx-result {:targetIdx 0
                                            :idxBranch ""}]

                            ;; Compute target index in Firefox's tab list
                            (cond
                              ;; target is a group row
                              (js/get tgt-row ._group)
                              (if (= position "child")
                                ;; Drop INTO group
                                (let [sub-tabs
                                      (tabs-of
                                        (js/call (subtree-rows! tgt-row) .slice 1))]
                                  (if (js/get sub-tabs .length)
                                    (let [(sub-count Int) (js/get sub-tabs .length)
                                          (last-sub-idx Int) (js/call tabs-arr .indexOf
                                                               (aget sub-tabs (- sub-count 1)))
                                          idx (+ last-sub-idx 1)]
                                      (set-idx! idx-result idx
                                        (str "group/child->after-lastSubtreeTab@"
                                             (- idx 1))))
                                    ;; Empty group
                                    (let [first-after-row
                                          (find-sib!
                                            (js/get tgt-row .nextElementSibling)
                                            (fn [%1] Any (js/get %1 ._tab))
                                            (fn [%1] Any (js/get %1 .nextElementSibling)))
                                          first-after
                                          (some-> first-after-row (js/get ._tab))]
                                      (if first-after
                                        (let [idx (js/call tabs-arr .indexOf
                                                    first-after)]
                                          (set-idx! idx-result idx
                                            (str "group/child(empty)->before-firstAfterGroup@"
                                                 idx)))
                                        (set-idx! idx-result
                                          (js/get tabs-arr .length)
                                          "group/child(empty,end)->tabsArr.length")))))
                                ;; Drop BEFORE/AFTER group
                                (let [anchor-tab
                                      (if (= position "before")
                                        (find-closest-tab-before! tgt-row)
                                        (find-last-tab-in-group-or-before!
                                          tgt-row))]
                                  (if anchor-tab
                                    (let [(anchor-idx Int) (js/call tabs-arr .indexOf anchor-tab)]
                                      (set-idx! idx-result
                                        (+ anchor-idx 1)
                                        (str "group/" position
                                             "->after-anchor")))
                                    (set-idx! idx-result
                                      (js/get tabs-arr .length)
                                      (str "group/" position
                                           "->no-anchor->end")))))

                              ;; target is a tab, position "before"
                              (= position "before")
                              (let [idx (js/call tabs-arr .indexOf (js/get tgt-row ._tab))]
                                (set-idx! idx-result idx
                                  (str "tab/before->" idx)))

                              ;; target is a tab, "after" or "child"
                              :else
                              ;; In VERTICAL, anchor "after" on the LAST tab of the
                              ;; target's subtree, so a parent's whole block is jumped.
                              ;; In HORIZONTAL the grid is column-major (children stack
                              ;; BELOW the parent in its column), so that walk resolves to
                              ;; the column head and the moved tab lands leftmost — the
                              ;; move-skip bug. There, anchor on the target's OWN index.
                              (let [tgt-subtree
                                    (when (not (is-horizontal))
                                      (js/call (js/call (subtree-rows! tgt-row) .slice) .reverse))
                                    tgt-sub-row
                                    (when tgt-subtree (js/call tgt-subtree .find (fn [%1] Any (js/get %1 ._tab))))
                                    tgt-sub-tab
                                    (some-> tgt-sub-row (js/get ._tab))
                                    (tgt-idx Int) (if tgt-sub-tab
                                                     (js/call tabs-arr .indexOf tgt-sub-tab)
                                                     (js/call tabs-arr .indexOf
                                                       (js/get tgt-row ._tab)))
                                    idx (+ tgt-idx 1)]
                                (set-idx! idx-result idx
                                  (str "tab/" position "->after->" idx))))

                            ;; Clamp negative
                            (when (< (js/get idx-result .targetIdx) 0)
                              (set-idx! idx-result
                                (js/get tabs-arr .length)
                                (str (js/get idx-result .idxBranch)
                                     "->clamp(" (js/get tabs-arr .length)
                                     ")")))

                            (log "executeDrop:targetIdx"
                                 {:idxBranch (js/get idx-result .idxBranch)
                                  :targetIdx (js/get idx-result .targetIdx)
                                  :tabsLen (js/get tabs-arr .length)})

                            ;; Mark tabs as moving
                            (js/call moved-tabs .forEach
                              (fn [%1] Any (js/call moving-tabs .add %1)))

                            ;; Move Firefox tabs via gBrowser.moveTabTo
                            (let [(insert-state Any)
                                    {:idx (js/get idx-result .targetIdx)}
                                  (move-count Any) {:v 0}]
                              (js/call moved-tabs .forEach
                                (fn [t] Any
                                  (let [current-idx
                                        (js/call (tabs!) .indexOf
                                          t)]
                                    (when (>= current-idx 0)
                                      (let [(insert-idx Int) (js/get insert-state .idx)]
                                        (when (< current-idx insert-idx)
                                          (js/set! insert-state .idx (- insert-idx 1))))
                                      (when (not= current-idx
                                                   (js/get insert-state .idx))
                                        (log "executeDrop:moveTabTo"
                                             {:tab (js/get t .label)
                                              :currentIdx current-idx
                                              :insertIdx
                                                (js/get insert-state .idx)})
                                        (js/call gBrowser .moveTabTo t
                                          {:tabIndex
                                            (js/get insert-state .idx)})
                                        (let [(moves Int) (js/get move-count .v)]
                                          (js/set! move-count .v (+ moves 1))))
                                      (let [(insert-idx Int) (js/get insert-state .idx)]
                                        (js/set! insert-state .idx (+ insert-idx 1)))))))
                              (log "executeDrop:moveSummary"
                                   {:actualMoves (js/get move-count .v)
                                    :totalTabs (js/get moved-tabs .length)}))

                            ;; Move group rows in DOM
                            (let [group-rows
                                  (js/call moved-rows .filter (fn [%1] Any (js/get %1 ._group)))]
                              (when (js/get group-rows .length)
                                (if (= position "before")
                                  (js/call group-rows .forEach
                                    (fn [%1] Any (js/call tgt-row .before %1)))
                                  (let [st (subtree-rows! tgt-row)
                                        anchor-rows
                                        (js/call st .filter
                                          (fn [%1] Any (not (js/call moved-rows .includes %1))))
                                        (anchor-count Int) (js/get anchor-rows .length)
                                        anchor
                                        (if (> anchor-count 0)
                                          (aget anchor-rows (- anchor-count 1))
                                          tgt-row)
                                        last-ins {:v anchor}]
                                    (js/call group-rows .forEach
                                      (fn [%1] Any (do (js/call (js/get last-ins .v) .after %1)
                                           (js/set! last-ins .v %1))))))
                                (log "executeDrop:groupDOMMove"
                                     {:groupRowsCount
                                       (js/get group-rows .length)})))

                            ;; A TAB dropped INTO a group must render BELOW the
                            ;; group. A group is not a Firefox tab, so moveTabTo
                            ;; can leave the tab's index unchanged and fire no
                            ;; TabMove to reposition its row — stranding the
                            ;; child above the group. Position the moved rows
                            ;; explicitly after the group's last existing child
                            ;; (or the group row itself when empty).
                            (when (and (js/get tgt-row ._group)
                                       (= position "child")
                                       (js/get src-row ._tab))
                              (let [st (subtree-rows! tgt-row)
                                    anchor-rows
                                    (js/call st .filter
                                      (fn [%1] Any (not (js/call moved-rows .includes %1))))
                                    (anchor-count Int) (js/get anchor-rows .length)
                                    anchor
                                    (if (> anchor-count 0)
                                      (aget anchor-rows (- anchor-count 1))
                                      tgt-row)
                                    last-ins {:v anchor}]
                                (js/call moved-rows .forEach
                                  (fn [%1] Any (do (js/call (js/get last-ins .v) .after %1)
                                       (js/set! last-ins .v %1))))
                                (log "executeDrop:tabIntoGroupDOMMove"
                                     {:movedRows (js/get moved-rows .length)})))

                            ;; Clear selection
                            (clear-selection)

                            ;; Settle via requestAnimationFrame
                            (requestAnimationFrame
                              (fn [] Any
                                (js/call moved-tabs .forEach
                                  (fn [%1] Any (js/call moving-tabs .delete %1)))
                                (js/call moved-tabs .forEach
                                  (fn [%1] Any (let [r (js/call row-of .get %1)]
                                     (when r
                                       (toggle! r "busy"
                                         (has? %1 "busy"))))))
                                (log "executeDrop:settled"
                                     {:sourceFinal (row-desc! src-row)
                                      :sourceParentInTree
                                      (some-> src-row (js/get ._tab) tree-data! (js/get .parentId))})
                                (schedule-tree-resync)
                                (schedule-save))))))))))))))

        ;; --- handleContainerDrop ---
        ;; container-action: (fn [tab] ...) when dropTarget IS the container
        handle-container-drop (fn [e container-ref container-action] Any
          (js/call e .preventDefault)
          (let [tab (js/get (js/get ds .dragSource) ._tab)
                (client-x Float) (js/get e .clientX)
                (client-y Float) (js/get e .clientY)
                start-x (js/get ds .dragStartX)
                start-y (js/get ds .dragStartY)
                ;; dragstart may never have run for this element, so the origin
                ;; is a pointer coordinate only when it is actually a number.
                (dx Float) (- client-x (if (number? start-x) start-x client-x))
                (dy Float) (- client-y (if (number? start-y) start-y client-y))
                moved-px2 (+ (* dx dx) (* dy dy))]
            (cond
              ;; #124 ROOT FIX (extended): the row-level drop got a movement
              ;; threshold, but the panel / pinned-container drops did NOT — so a
              ;; click / 1-2px jitter on a draggable row whose drop bubbled to the
              ;; container (the common case in the dense column-major horizontal
              ;; grid, where popout children are position:fixed and the pointer
              ;; rarely sits over a .gjoa-tab-row) fell through here and reparented
              ;; the child to ROOT — surfacing as "child relocates to the next
              ;; column / parent" on plain j/k-driven selection. Reject it.
              (< moved-px2 36)
              (log "drop/container:abort"
                   {:reason "below-drag-threshold (click, not drag)"
                    :movedPx2 moved-px2})

              tab
              (if (same-node? (js/get ds .dropTarget) container-ref)
                (container-action tab)
                (when (and (js/get ds .dropTarget)
                           (or (some-> ds (js/get .dropTarget) (js/get ._tab))
                               (some-> ds (js/get .dropTarget) (js/get ._group)))
                           (js/get ds .dropPosition))
                  (execute-drop (js/get ds .dragSource)
                    (js/get ds .dropTarget) (js/get ds .dropPosition))))

              :else nil)
            (clear-drop-indicator)
            (clear-drop-strip)))

        ;; --- [gjoa-dragging] safety net ---
        _ (onc! document "mousedown"
            (fn [] Any
              (when (= (js/get ds .dragSource) nil)
                (js/call (qa document "[gjoa-dragging]") .forEach
                  (fn [%1] Any (rmattr! %1 "gjoa-dragging"))))))

        ;; --- setupDrag ---
        setup-drag (fn [row] Any
          (js/set! row .draggable true)

          ;; dragstart
          (on! row "dragstart"
            (fn [e] Any
              (let [t (js/get e .target)]
                (if (and (js/get t .classList)
                         (js/call (js/get t .classList) .contains "gjoa-tab-close"))
                  (js/call e .preventDefault)
                  (do
                    (js/set! ds .dragSource row)
                    (let [pc (js/get state .pinnedContainer)]
                      (when (and pc (not (row-pinned? row))
                                 (not (bool (q pc ".gjoa-tab-row"))))
                        (js/set! pc .hidden false)
                        (attr! pc "gjoa-drop-strip" "true")))
                    ;; Pointer origin for the #124 movement threshold. CLIENT coords,
                    ;; not screen: within one window the deltas are identical, and
                    ;; synthetic DragEvents carry only clientX/clientY.
                    (js/set! ds .dragStartX (js/get e .clientX))
                    (js/set! ds .dragStartY (js/get e .clientY))
                    (log "dragstart" {:source (row-desc! row)})
                    (let [dt (js/get e .dataTransfer)]
                      (js/set! dt .effectAllowed "move")
                      (js/call dt .setData "text/plain" ""))
                    (attr! row "gjoa-dragging" "true"))))))

          ;; dragend
          (on! row "dragend"
            (fn [] Any
              (log "dragend/row"
                   {:listenerOnRow (row-desc! row)
                    :sourceWas (if (js/get ds .dragSource)
                                 (row-desc! (js/get ds .dragSource))
                                 "already-null")
                    :dropPositionWas (js/get ds .dropPosition)})
              (when (js/get ds .dragSource)
                (rmattr! (js/get ds .dragSource) "gjoa-dragging"))
              (js/set! ds .dragSource nil)
              (clear-drop-indicator)
              (clear-drop-strip)))

          ;; dragover
          (let [(last-logged Any) {:v nil}]
            (on! row "dragover"
              (fn [e] Any
                (when (and (js/get ds .dragSource)
                           (not (same-node? (js/get ds .dragSource) row))
                           (not (js/call (subtree-rows! (js/get ds .dragSource)) .includes
                                  row)))
                  (js/call e .preventDefault)
                  (js/set! (js/get e .dataTransfer) .dropEffect "move")
                  (let [horizontal (is-horizontal)
                        ;; #101: in horizontal mode the drop maps to the real grid
                        ;; cell under the pointer, not whichever row's per-row
                        ;; listener happened to fire (they diverge near a column/
                        ;; row boundary). Skip the resolved cell if it's the drag
                        ;; source or inside its subtree; fall back to the listener
                        ;; row when the pointer is in a grid gap.
                        target (if horizontal
                                 (let [c (cell-under! (js/get row .parentNode)
                                           (js/get e .clientX) (js/get e .clientY))]
                                   (if (and c
                                            (not (same-node? c (js/get ds .dragSource)))
                                            (not (js/call (subtree-rows! (js/get ds .dragSource)) .includes c)))
                                     c
                                     row))
                                 row)
                        rect (js/call target .getBoundingClientRect)
                        (rect-left Float) (js/get rect .left)
                        (rect-top Float) (js/get rect .top)
                        (rect-w Float) (js/get rect .width)
                        (rect-h Float) (js/get rect .height)
                        (ptr-x Float) (js/get e .clientX)
                        (ptr-y Float) (js/get e .clientY)
                        (x Float) (- ptr-x rect-left)
                        (y Float) (- ptr-y rect-top)
                        pos-info {:branch ""}]
                    (if horizontal
                      (cond
                        ;; child only in the bottom QUARTER (was the lower third —
                        ;; too greedy: a column cell is short, so a sibling drop
                        ;; aimed at a cell's body kept getting stolen into
                        ;; child-of-target, which IS the #101 imprecision). Nesting
                        ;; still works by aiming the lower strip; the upper 3/4 is
                        ;; precise before/after sibling space.
                        (> y (* rect-h 0.75))
                        (do (js/set! ds .dropPosition "child")
                            (js/set! pos-info .branch
                                  "hz/y>3/4->child"))

                        (< x (/ rect-w 2))
                        (do (js/set! ds .dropPosition "before")
                            (js/set! pos-info .branch
                                  "hz/x<w/2->before"))

                        :else
                        (do (js/set! ds .dropPosition "after")
                            (js/set! pos-info .branch
                                  "hz/x>=w/2->after")))
                      ;; Vertical 3-zone on Y
                      (let [zone (/ rect-h 3)]
                        (cond
                          (< y zone)
                          (do (js/set! ds .dropPosition "before")
                              (js/set! pos-info .branch
                                    "vt/y<1/3->before"))

                          (> y (* zone 2))
                          (do (js/set! ds .dropPosition "after")
                              (js/set! pos-info .branch
                                    "vt/y>2/3->after"))

                          :else
                          (do (js/set! ds .dropPosition "child")
                              (js/set! pos-info .branch
                                    "vt/middle->child")))))
                    (js/set! ds .dropTarget target)
                    (when (or (js/get target ._group)
                              (not= (js/get last-logged .v)
                                    (js/get ds .dropPosition)))
                      (log "dragover"
                           {:target (row-desc! target)
                            :source (row-desc! (js/get ds .dragSource))
                            :position (js/get ds .dropPosition)
                            :posBranch (js/get pos-info .branch)
                            :rect {:w (Math/round (js/get rect .width))
                                   :h (Math/round (js/get rect .height))}
                            :mouse {:x (Math/round x)
                                    :y (Math/round y)}
                            :horizontal horizontal})
                      (js/set! last-logged .v (js/get ds .dropPosition)))
                    (show-drop-indicator target (js/get ds .dropPosition)))))))

          ;; dragleave
          (on! row "dragleave"
            (fn [e] Any
              (let [related (js/get e .relatedTarget)]
                (when (and (not (js/call row .contains related))
                           (same-node? (js/get ds .dropTarget) row))
                  (clear-drop-indicator)))))

          ;; drop
          (on! row "drop"
            (fn [e] Any
              (js/call e .preventDefault)
              ;; Commit to the cell the dragover RESOLVED (#101): for the
              ;; horizontal grid that's the real cell under the pointer, which can
              ;; differ from THIS listener's row near a column/row boundary —
              ;; dragover computed dropPosition for that resolved cell, so the drop
              ;; must use it too. Falls back to the listener row when no dragover
              ;; ran (dropTarget unset).
              (let [tgt (or (js/get ds .dropTarget) row)
                    (client-x Float) (js/get e .clientX)
                    (client-y Float) (js/get e .clientY)
                    start-x (js/get ds .dragStartX)
                    start-y (js/get ds .dragStartY)
                    (dx Float) (- client-x (if (number? start-x) start-x client-x))
                    (dy Float) (- client-y (if (number? start-y) start-y client-y))
                    moved-px2 (+ (* dx dx) (* dy dy))]
                (log "drop/row:fired"
                     {:listenerOnRow (row-desc! row)
                      :resolvedTarget (row-desc! tgt)
                      :movedPx2 moved-px2
                      :hasDragSource (bool (js/get ds .dragSource))})
                (cond
                  (not (js/get ds .dragSource))
                  (log "drop/row:abort" {:reason "no-dragSource"})

                  ;; #124 ROOT FIX: reject a drop whose pointer barely moved from dragstart —
                  ;; that's a click / 1-2px jitter on a draggable row, NOT an intentional
                  ;; reparent. The dense, overlapping horizontal grid cells made this fire on
                  ;; ordinary clicks, silently rewriting parentId from pointer geometry.
                  (< moved-px2 36)
                  (log "drop/row:abort" {:reason "below-drag-threshold (click, not drag)"})

                  (same-node? (js/get ds .dragSource) tgt)
                  (log "drop/row:abort" {:reason "source-equals-target"})

                  (js/call (subtree-rows! (js/get ds .dragSource)) .includes tgt)
                  (log "drop/row:abort" {:reason "target-in-source-subtree"})

                  :else
                  (do
                    (log "drop/row:proceeding"
                         {:target (row-desc! tgt)
                          :source (row-desc! (js/get ds .dragSource))
                          :position (js/get ds .dropPosition)})
                    (if (and (js/get ds .dropPosition)
                             (not= (js/get ds .dropPosition)
                                   "into-empty-pinned")
                             (not= (js/get ds .dropPosition)
                                   "into-empty-panel"))
                      (execute-drop (js/get ds .dragSource) tgt
                        (js/get ds .dropPosition))
                      (log "drop/row:abort"
                           {:reason "no-or-empty-zone-position"
                            :dropPosition (js/get ds .dropPosition)})))))
              (clear-drop-indicator))))

        ;; --- setupPinnedContainerDrop ---
        setup-pinned-container-drop (fn [container] Any
          ;; dragover
          (on! container "dragover"
            (fn [e] Any
              (when (and (js/get ds .dragSource)
                         (not (row-pinned? (js/get ds .dragSource)))
                         (same-node? (js/get e .target) container))
                  ;; The container's own bounds delimit the zone; anything inside it,
                  ;; including the divider band below the last row, appends to the
                  ;; pinned list. `:last-of-type` is tag-based and can resolve to a
                  ;; space-filtered row with a 0-height rect.
                  (let [last-row (last-of (Array/from
                                            (qa container ".gjoa-tab-row:not([hidden])")))]
                    (js/call e .preventDefault)
                    (js/set! (js/get e .dataTransfer) .dropEffect "move")
                    (if last-row
                      (do
                        (js/set! ds .dropTarget last-row)
                        (js/set! ds .dropPosition "after")
                        (show-drop-indicator last-row "after"))
                      (do
                        (js/set! ds .dropTarget container)
                        (js/set! ds .dropPosition
                              "into-empty-pinned")))))))

          ;; drop
          (on! container "drop"
            (fn [e] Any
              (log "drop/pinnedContainer:fired"
                   {:hasDragSource (bool (js/get ds .dragSource))
                    :srcPinned
                    (row-pinned? (js/get ds .dragSource))})
              (when (and (js/get ds .dragSource)
                         (not (row-pinned? (js/get ds .dragSource)))
                         (or (same-node? (js/get e .target) container)
                             (same-node? (js/get ds .dropTarget) container)))
                (handle-container-drop e container
                  (fn [%1] Any (js/call gBrowser .pinTab %1)))))))

        ;; --- setupPanelDrop ---
        setup-panel-drop (fn [p] Any
          ;; dragover
          (on! p "dragover"
            (fn [e] Any
              (when (and (js/get ds .dragSource)
                         (or (same-node? (js/get e .target) p)
                             (same-node? (js/get e .target) (js/get state .spacer))))
                (let [src-pinned (row-pinned? (js/get ds .dragSource))
                      anchor {:v nil}]
                  (if src-pinned
                      (js/set! anchor .v
                            (q p
                              (str ".gjoa-tab-row:last-of-type, "
                                   ".gjoa-group-row:last-of-type")))
                      ;; Find last root-level row not in source subtree
                      (let [src-subtree
                            (js/new Set (subtree-rows! (js/get ds .dragSource)))
                            panel-rows
                            (Array/from
                              (qa p
                                ".gjoa-tab-row, .gjoa-group-row"))]
                        (loop [i (let [(panel-count Int) (js/get panel-rows .length)] (- panel-count 1))]
                          (when (>= i 0)
                            (let [candidate (aget panel-rows i)]
                              (if (and (= (level-of-row! candidate) 0)
                                       (not (js/call src-subtree .has candidate)))
                                (js/set! anchor .v candidate)
                                (recur (- i 1))))))))
                    (js/call e .preventDefault)
                    (js/set! (js/get e .dataTransfer) .dropEffect "move")
                    (if (js/get anchor .v)
                      (do
                        (js/set! ds .dropTarget (js/get anchor .v))
                        (js/set! ds .dropPosition "after")
                        (show-drop-indicator (js/get anchor .v) "after"))
                      (do
                        (js/set! ds .dropTarget
                              (and src-pinned p))
                        (js/set! ds .dropPosition
                              "into-empty-panel")))))))

          ;; drop
          (on! p "drop"
            (fn [e] Any
              (log "drop/panel:fired"
                   {:eventTargetIsPanel (same-node? (js/get e .target) p)
                    :eventTargetIsSpacer
                    (same-node? (js/get e .target) (js/get state .spacer))
                    :hasDragSource (bool (js/get ds .dragSource))})
              (when (and (js/get ds .dragSource)
                         (or (same-node? (js/get e .target) p)
                             (same-node? (js/get e .target) (js/get state .spacer))
                             (same-node? (js/get ds .dropTarget) p)))
                (handle-container-drop e p
                  (fn [%1] Any (when (js/get %1 .pinned)
                     (js/call gBrowser .unpinTab %1))))))))]

    ;; Return public API
    {:setupDrag setup-drag
     :setupPinnedContainerDrop setup-pinned-container-drop
     :setupPanelDrop setup-panel-drop})))
