#lang beagle/js
(ns gjoa.tabs.state)

(js/export (def state Any
  {:panel nil
   :spacer nil
   :pinnedContainer nil
   :spaceHeader nil
   :contextTab nil
   :contextGroupRow nil
   :cursor nil
   :nextTabId 1
   :inSessionRestore true
   :lastLoadedNodes []}))

(js/export (def tree-of Any (js/new WeakMap)))
(js/export (def row-of Any (js/new WeakMap)))
(js/export (def hz-display Any (js/new WeakMap)))
(js/export (def saved-tab-queue Any []))
(js/export (def closed-tabs Any []))
(js/export (def selection Any (js/new Set)))
(js/export (def moving-tabs Any (js/new Set)))
