#lang beagle/js
(ns gjoa.tabs.snapshot
  (:require [gjoa.macros :refer [bool]]
            [gjoa.tabs.constants :refer [CLOSED-MEMORY]]))

(js/export (defn build-envelope! [snapshot Any] Any
  ;; Keys and values are the raw halves of a persisted tabSpaces pair — session
  ;; state gjoa reads back, not a shape this module produces.
  (let [tab-space-map (JsMap Any Any) (js/new Map)]
    (when (and (js/get snapshot .spaces) (js/get (js/get snapshot .spaces) .tabSpaces))
      (js/call (js/get (js/get snapshot .spaces) .tabSpaces) .forEach
        (fn [%1 Any] Any (js/call tab-space-map .set (aget %1 0) (aget %1 1)))))
    (let [tabEntries (Vec Any) (js/call (js/get snapshot .tabs) .map
                     (fn [%1 Any] Any (let [d Any (js/call snapshot .treeData %1)
                            sp Any (js/call tab-space-map .get (js/get d .id))]
                        {:id (js/get d .id)
                         :parentId (js/get d .parentId)
                         :url (js/call snapshot .tabUrl %1)
                         :name (js/get d .name)
                         :state (js/get d .state)
                         :collapsed (js/get d .collapsed)
                         :spaceId sp})))

        groupEntries (Vec Any) []
        lastSeen (Map Keyword Any) {:id nil}]

    ;; Walk rows — track last tab id, push group entries
    (js/call (Array/from (js/call snapshot .rows)) .forEach
      (fn [%1 Any] Any (if (js/get %1 ._tab)
         (js/set! lastSeen .id (js/get (js/call snapshot .treeData (js/get %1 ._tab)) .id))
         (when (js/get %1 ._group)
           (js/call groupEntries .push
             {:id 0
              :parentId nil
              :type "group"
              :name (js/get (js/get %1 ._group) .name)
              :level (js/get (js/get %1 ._group) .level)
              :state (js/get (js/get %1 ._group) .state)
              :collapsed (js/get (js/get %1 ._group) .collapsed)
              :spaceId (js/get (js/get %1 ._group) .spaceId)
              :afterTabId (js/get lastSeen .id)})))))

    ;; Filter unconsumed saved entries whose URL doesn't collide with live tabs
    (let [liveUrls Any (js/new Set (js/call (js/call tabEntries .map (fn [%1 Any] Any (js/get %1 .url))) .filter
                           Boolean))
          leftovers (Vec Any) (js/call (js/call (js/get snapshot .savedTabQueue) .filter
                        (fn [%1 Any] Any (or (not (js/get %1 .url))
                             (not (js/call liveUrls .has (js/get %1 .url)))))) .map
                      (fn [%1 Any] Any (Object/assign {} %1)))

          out (Vec Any) (js/call tabEntries .concat groupEntries leftovers)]

      {:nodes out
       :closedTabs (js/call (js/get snapshot .closedTabs) .slice (- 0 CLOSED-MEMORY))
       :nextTabId (js/get snapshot .nextTabId)
       :spaces (js/get snapshot .spaces)})))))
(defn do-save!
  [flags Any
   getSnapshot Any
   history Any
   onErr Any]
  Any
  (if (js/get flags .inFlight)
    (js/set! flags .pending true)
    (do
      (js/set! flags .inFlight true)
      (-> (js/call history .appendEvent (build-envelope! (getSnapshot)))
          (js/call .catch (fn [%1 Any] Any (onErr %1)))
          (js/call .then (fn [] Any
            (js/set! flags .inFlight false)
            (when (js/get flags .pending)
              (js/set! flags .pending false)
              (do-save! flags getSnapshot history onErr))))))))

(js/export (defn make-saver!
             [getSnapshot Any
              history Any
              onError Any]
             Any
             (let [fallback (Fn [Any] Any) (fn [%1 Any] Any (console/error "gjoa-tabs: save chain" %1))
        onErr (Fn [Any] Any) (or onError fallback)
        flags (Map Keyword Bool) {:inFlight false :pending false}]
    (fn [] Any (do-save! flags getSnapshot history onErr)))))
(js/export (defn pop-saved-by-url
             [queue Any
              url Any]
             Any
             (when url
    (let [i Int (js/call queue .findIndex (fn [%1 Any] Any (= (js/get %1 .url) url)))]
      (when (>= i 0) (aget (js/call queue .splice i 1) 0))))))

(js/export (defn pop-saved-by-index
             [queue Any
              idx Int]
             Any
             (when (>= idx 0)
    (let [i Int (js/call queue .findIndex (fn [%1 Any] Any (= (js/get %1 ._origIdx) idx)))]
      (when (>= i 0) (aget (js/call queue .splice i 1) 0))))))

;; popSavedForTab — combined helper for session-restore reconciliation
;; Priority: 1) gjoa-id, 2) URL match, 3) FIFO (session-restore only)
(js/export (defn pop-saved-for-tab
             [queue Any
              ctx Any]
             Any
             (let [currentIdx Int (js/get ctx .currentIdx)
        pinnedId Int (js/get ctx .pinnedId)
        url String (js/get ctx .url)
        inSessionRestore Bool (js/get ctx .inSessionRestore)
        log Any (js/get ctx .log)
        try-url-fifo (Fn [] Any) (fn [] Any
          (if (and url (not= url "about:blank"))
            (let [node Any (pop-saved-by-url queue url)]
              (when log (log "popSavedForTab:url"
                             {:idx currentIdx :url url :found (bool node)}))
              node)
            (when inSessionRestore
              (let [node Any (when (js/get queue .length) (js/call queue .shift))]
                (when log (log "popSavedForTab:fifo"
                               {:idx currentIdx :pfxId pinnedId :url url
                                :nodeId (and node (js/get node .id))
                                :nodeOrigIdx (and node (js/get node ._origIdx))}))
                node))))]
    (if pinnedId
      (let [i Int (js/call queue .findIndex (fn [%1 Any] Any (= (js/get %1 .id) pinnedId)))]
        (if (>= i 0)
          (do (when log (log "popSavedForTab:pfxId"
                             {:idx currentIdx :pfxId pinnedId :url url}))
              (aget (js/call queue .splice i 1) 0))
          (try-url-fifo)))
      (try-url-fifo)))))
