#lang beagle/js
(ns gjoa.tabs.rows
  (:require [gjoa.macros :refer [q qa by-id attr! on! xul htm has? toggle! rmattr! bool tabs!]]
            [gjoa.tabs.constants :refer [INDENT]]
            [gjoa.tabs.helpers :refer [has-children! is-horizontal level-of! level-of-row! tree-data! data-of! all-rows]]
            [gjoa.tabs.log :refer [create-logger!]]
            [gjoa.tabs.state :refer [hz-display moving-tabs row-of state]]))

(declare-extern [gBrowser cancelAnimationFrame requestAnimationFrame String undefined] Any)

;; From sibling modules — no import, declare-extern only.
;; --- reset-style!: clear all 7 grid/position style properties ---

(defn reset-style! [el Any] Any
  (js/set! (js/get el .style) .gridColumn "")
  (js/set! (js/get el .style) .gridRow "")
  (js/set! (js/get el .style) .position "")
  (js/set! (js/get el .style) .left "")
  (js/set! (js/get el .style) .top "")
  (js/set! (js/get el .style) .width "")
  (js/set! (js/get el .style) .zIndex ""))

(js/export (defn make-rows! [deps Any] Any
  (let [setupDrag Any (:setupDrag deps)
        activateVim Any (:activateVim deps)
        selectRange Any (:selectRange deps)
        clearSelection Any (:clearSelection deps)
        cloneAsSibling Any (:cloneAsSibling deps)
        startRename Any (:startRename deps)
        scheduleSave Any (:scheduleSave deps)

        log Any (create-logger! "tabs/rows")

        ;; Module-private mutable state
        counters (Map Keyword Any) {:group 0 :resync-pending false :grid-raf 0}

        ;; ----- sync tab row -----

        sync-tab-row (Fn [Any] Any) (fn [tab Any] Any
          (let [row Any (js/call row-of .get tab)]
            (when row
              (let [td Any       (tree-data! tab)
                    show-tab Any (or (js/call hz-display .get row) tab)
                    show-td Any  (if (= show-tab tab) td (tree-data! show-tab))
                    img Any      (js/call show-tab .getAttribute "image")
                    icon-el Any  (q row ".gjoa-tab-icon")]
                (when icon-el
                  (attr! icon-el "src"
                    (or img "chrome://global/skin/icons/defaultFavicon.svg")))
                (let [label-el Any (q row ".gjoa-tab-label")]
                  (when label-el
                    (js/set! label-el .textContent
                          (or (js/get show-td .name) (js/get show-tab .label) "New Tab"))))
                (toggle! row "selected" (js/get tab .selected))
                (when (not (js/call moving-tabs .has tab))
                  (toggle! row "busy" (has? tab "busy")))
                (toggle! row "pinned" (js/get tab .pinned))
                (toggle! row "gjoa-collapsed"
                  (and (or (bool (js/get td .collapsed)) (bool (js/get td .layoutCollapsed)))
                       (has-children! row)))
                (js/set! (js/get row .style) .paddingInlineStart
                      (str (+ (* (level-of! tab) INDENT) 8) "px"))))))

        ;; ----- group rows -----

        sync-group-row (Fn [Any] Any) (fn [row Any] Any
          (let [g Any (js/get row ._group)]
            (when g
              (let [label Any        (q row ".gjoa-tab-label")
                    state-prefix String (cond
                                   (= (js/get g .state) "todo") "[ ] "
                                   (= (js/get g .state) "wip")  "[-] "
                                   (= (js/get g .state) "done") "[x] "
                                   :else "")]
                (when label
                  (js/set! label .textContent (str state-prefix (js/get g .name))))
                (toggle! row "gjoa-collapsed"
                  (and (or (bool (js/get g .collapsed)) (bool (js/get g .layoutCollapsed)))
                       (has-children! row)))
                (js/set! (js/get row .style) .paddingInlineStart
                      (let [level Int (or (js/get g .level) 0)]
                        (str (+ (* level INDENT) 8) "px")))))))

        ;; ----- horizontal grid -----

        update-horizontal-grid (Fn [] Any) (fn [] Any
          (when (is-horizontal)
            (let [raw-containers (Vec Any) []]
              (when (js/get state .pinnedContainer)
                (js/call raw-containers .push (js/get state .pinnedContainer)))
              (when (js/get state .panel)
                (js/call raw-containers .push (js/get state .panel)))

              (js/call raw-containers .forEach
                (fn [c Any] Any
                  (let [rows-in-container (Vec Any) (Array/from
                          (qa c
                            ".gjoa-tab-row, .gjoa-group-row"))
                        gs (Map Keyword Int) {:col 0 :ric 0 :sc 0}]

                    (js/call rows-in-container .forEach
                      (fn [%1 Any] Any (let [d Any (data-of! %1)]
                         (when d
                           (if (js/get %1 .hidden)
                             (rmattr! %1 "gjoa-popout-child")
                             (do
                               (let [col Int (js/get gs .col)]
                                 (when (or (= (level-of-row! %1) 0) (= col 0))
                                   (js/set! gs .col (+ col 1))
                                   (js/set! gs .ric 0)))
                               (let [ric Int (js/get gs .ric)]
                                 (js/set! gs .ric (+ ric 1)))
                               (js/set! (js/get %1 .style) .gridColumn
                                     (String (js/get gs .col)))
                               (js/set! (js/get %1 .style) .gridRow
                                     (String (js/get gs .ric)))
                               (toggle! %1 "gjoa-popout-child"
                                 (> (js/get gs .ric) 1))
                               (when (has? %1 "selected")
                                 (js/set! gs .sc (js/get gs .col)))))))))

                    (if (> (js/get gs .col) 0)
                      (let [tracks (Vec Any) []]
                        (loop [i Int 1]
                          (when (<= i (js/get gs .col))
                            (js/call tracks .push
                              (if (= i (js/get gs .sc))
                                "minmax(200px, 200px)"
                                "minmax(0, 200px)"))
                            (recur (+ i 1))))
                        (js/set! (js/get c .style) .gridTemplateColumns
                              (js/call tracks .join " ")))
                      (js/set! (js/get c .style) .gridTemplateColumns "")))))

              ;; Pin container heights and handle popouts in rAF. Capture the
              ;; handle so a re-entrant pass (rapid mode toggle) cancels the
              ;; stale one instead of double-positioning popouts.
              (when (> (js/get counters .grid-raf) 0)
                (cancelAnimationFrame (js/get counters .grid-raf)))
              (js/set! counters .grid-raf
                (requestAnimationFrame
                  (fn [] Any (js/set! counters .grid-raf 0) (when (is-horizontal)
                   ;; Pin each container to first-row height
                   (js/call raw-containers .forEach
                     (fn [%1 Any] Any (let [first-row Any (q %1
                             ".gjoa-tab-row:not([hidden]), .gjoa-group-row:not([hidden])")]
                        (when first-row
                          (let [row-height Int (js/get first-row .offsetHeight)]
                            (js/set! (js/get %1 .style) .maxHeight
                                  (str (+ row-height 2) "px")))))))

                   ;; Urlbar popover demotion
                   (let [panel-popouts Int (if (js/get state .panel)
                                               (js/get (qa (js/get state .panel)
                                                           "[gjoa-popout-child]") .length)
                                               0)
                         pinned-popouts Int (if (js/get state .pinnedContainer)
                                                (js/get (qa (js/get state .pinnedContainer)
                                                            "[gjoa-popout-child]") .length)
                                                0)
                         total-popouts Int (+ panel-popouts pinned-popouts)
                         urlbar Any (by-id "urlbar")]
                     (when urlbar
                       (when (and (> total-popouts 0)
                                  (has? urlbar "popover"))
                         (rmattr! urlbar "popover"))
                       (log "hzGrid:urlbar" {:totalPopouts total-popouts})))

                   ;; Reset fixed positions, then reapply for popouts
                   (js/call raw-containers .forEach (fn [container Any] Any
                     (let [all-in-c Any (qa container
                                      ".gjoa-tab-row, .gjoa-group-row")]
                       (js/call all-in-c .forEach
                         (fn [%1 Any] Any (when (= (js/get (js/get %1 .style) .position) "fixed")
                            (reset-style! %1)))))

                     (let [popouts (Vec Any) (Array/from
                             (qa container "[gjoa-popout-child]"))]
                       (when (js/get popouts .length)
                         ;; Force reflow
                         (js/get container .offsetHeight)
                         (let [rects (Vec Any) (js/call popouts .map (fn [%1 Any] Any (js/call %1 .getBoundingClientRect)))]
                           (js/call popouts .forEach (fn
                                                       [p Any
                                                        idx Int] Any
                                                       (let [r Any (aget rects idx)]
                               (when (and (> (js/get r .width) 0)
                                          (> (js/get r .height) 0))
                                 (js/set! (js/get p .style) .position "fixed")
                                 (js/set! (js/get p .style) .left
                                       (str (js/get r .left) "px"))
                                 (js/set! (js/get p .style) .top
                                       (str (js/get r .top) "px"))
                                 (js/set! (js/get p .style) .width
                                       (str (js/get r .width) "px"))
                                 (js/set! (js/get p .style) .zIndex "9999")))))))))))))))))

        ;; ----- visibility / collapse -----

        update-visibility (Fn [] Any) (fn [] Any
          (let [space-filter Any (js/get deps .isTabInActiveSpace)
                group-filter Any (js/get deps .isGroupInActiveSpace)
                hide-state (Map Keyword Int) {:below -1}]
            (js/call (all-rows) .forEach
              (fn [%1 Any] Any (let [d Any (data-of! %1)]
                 (when d
                   (let [lv Int (level-of-row! %1)]
                     (cond
                       (and (>= (js/get hide-state .below) 0) (> lv (js/get hide-state .below)))
                       (js/set! %1 .hidden true)
                       (and space-filter (js/get %1 ._tab) (not (space-filter (js/get %1 ._tab))))
                       (js/set! %1 .hidden true)
                       (and group-filter (js/get %1 ._group) (not (group-filter (js/get %1 ._group))))
                       (do (js/set! %1 .hidden true) (js/set! hide-state .below lv))
                       :else
                       (do (js/set! %1 .hidden false)
                           (js/set! hide-state .below
                                 (if (and (or (js/get d .collapsed) (js/get d .layoutCollapsed))
                                          (has-children! %1)) lv -1)))))))))
            (update-horizontal-grid)))

        ;; ----- clear horizontal grid -----

        clear-horizontal-grid (Fn [] Any) (fn [] Any
          (when (> (js/get counters .grid-raf) 0)
            (cancelAnimationFrame (js/get counters .grid-raf))
            (js/set! counters .grid-raf 0))
          (let [both (Vec Any) []]
            (when (js/get state .pinnedContainer)
              (js/call both .push (js/get state .pinnedContainer)))
            (when (js/get state .panel)
              (js/call both .push (js/get state .panel)))
            (js/call both .forEach (fn [container Any] Any
              (js/set! (js/get container .style) .maxHeight "")
              (js/set! (js/get container .style) .gridTemplateColumns ""))))
          (js/call (all-rows) .forEach (fn [row Any] Any
            (reset-style! row)
            (rmattr! row "gjoa-popout-child"))))

        ;; ----- toggle collapse -----

        toggle-collapse (Fn [Any] Any) (fn [row Any] Any
          (let [d Any (data-of! row)]
            (when (and d (has-children! row))
              ;; The caret reflects the EFFECTIVE collapsed state (user collapse
              ;; OR transient layout collapse). Expanding clears both; collapsing
              ;; sets only the persisted user flag. This keeps a click on a
              ;; layout-collapsed tree (horizontal mode) from silently writing
              ;; collapsed=true into the saved tree.
              (if (or (js/get d .collapsed) (js/get d .layoutCollapsed))
                (do (js/set! d .collapsed false)
                    (js/set! d .layoutCollapsed false))
                (js/set! d .collapsed true))
              (if (js/get row ._tab)
                (sync-tab-row (js/get row ._tab))
                (sync-group-row row))
              (update-visibility)
              (scheduleSave))))

        ;; ----- row constructors -----

        create-tab-row (Fn [Any] Any) (fn [tab Any] Any
          (let [row Any     (xul "hbox" "gjoa-tab-row")
                icon Any    (xul "image" "gjoa-tab-icon")
                label Any   (htm "span" "gjoa-tab-label")
                close Any   (xul "image" "gjoa-tab-close")
                chevron Any (xul "image" "gjoa-tab-chevron")]
            (attr! row "align" "center")
            (attr! close "tooltiptext" "Close tab")

            ;; Subtle close affordance — CSS shows it on hover + on the active
            ;; row. Sits just before the collapse chevron when both are present.
            (on! close "click"
              (fn [%1 Any] Any (when (= (js/get %1 .button) 0)
                 (js/call %1 .stopPropagation)
                 (js/call gBrowser .removeTab tab))))

            (on! chevron "click"
              (fn [%1 Any] Any (when (= (js/get %1 .button) 0)
                 (js/call %1 .stopPropagation)
                 (toggle-collapse row))))

            (js/call row .append icon label close chevron)
            (js/set! row ._tab tab)
            (js/call row-of .set tab row)

            (on! row "click"
              (fn [%1 Any] Any (if (= (js/get %1 .button) 0)
                 (if (js/get %1 .shiftKey)
                   (selectRange row)
                   (let [target Any (or (js/call hz-display .get row) tab)]
                     (clearSelection)
                     (js/set! gBrowser .selectedTab target)
                     (activateVim (or (js/call row-of .get target) row))))
                 (when (= (js/get %1 .button) 1)
                   (js/call %1 .preventDefault)
                   (js/call gBrowser .removeTab tab)))))

            (on! row "dblclick"
              (fn [%1 Any] Any (when (= (js/get %1 .button) 0)
                 (js/call %1 .stopPropagation)
                 (cloneAsSibling tab))))

            (on! row "contextmenu"
              (fn [e Any] Any
                (js/call e .preventDefault)
                (js/call e .stopPropagation)
                (js/set! state .contextTab tab)
                (let [menu Any (by-id "gjoa-tab-menu")]
                  (when menu
                    (js/call menu .openPopupAtScreen (js/get e .screenX) (js/get e .screenY) true)))))

            (setupDrag row)
            (sync-tab-row tab)
            row))

        create-group-row (Fn [String Any] Any) (fn
                                                 [name Any
                                                  level Any] Any
                                                 (let [lv Any (if (= level undefined) 0 level)
                group-seq Int (js/get counters .group)
                _ Any  (js/set! counters .group (+ group-seq 1))
                group (Map Keyword Any) {:id       (str "g" (js/get counters .group))
                       :type     "group"
                       :name     (or name "New Group")
                       :level    lv
                       :state    nil
                       :collapsed false
                       ;; nil (not "") when there's no active space — "" is a
                       ;; phantom id that downstream truthy-checks treat as Main
                       ;; anyway; nil states "no space assigned" honestly.
                       :spaceId  (if (js/get deps .getActiveSpaceId)
                                   (or (js/call deps .getActiveSpaceId) nil)
                                   nil)}
                row Any     (xul "hbox" "gjoa-group-row")
                marker Any  (htm "span" "gjoa-group-marker")
                label Any   (htm "span" "gjoa-tab-label")
                chevron Any (xul "image" "gjoa-tab-chevron")]

            (attr! row "align" "center")
            (js/set! row ._group group)

            (js/set! marker .textContent "●")
            (js/set! label .textContent (js/get group .name))

            (on! chevron "click"
              (fn [%1 Any] Any (when (= (js/get %1 .button) 0)
                 (js/call %1 .stopPropagation)
                 (toggle-collapse row))))

            (on! marker "click"
              (fn [%1 Any] Any (when (= (js/get %1 .button) 0)
                 (js/call %1 .stopPropagation)
                 (toggle-collapse row))))

            (js/call row .append marker label chevron)

            (on! row "click"
              (fn [%1 Any] Any (when (= (js/get %1 .button) 0)
                 (activateVim row))))

            (on! row "dblclick"
              (fn [%1 Any] Any (when (= (js/get %1 .button) 0)
                 (js/call %1 .stopPropagation)
                 (startRename row))))

            (on! row "contextmenu"
              (fn [e Any] Any
                (js/call e .preventDefault)
                (js/call e .stopPropagation)
                (js/set! state .contextGroupRow row)
                (let [menu Any (by-id "gjoa-group-menu")]
                  (when menu
                    (js/call menu .openPopupAtScreen (js/get e .screenX) (js/get e .screenY) true)))))

            (setupDrag row)
            (sync-group-row row)
            row))

        ;; ----- schedule tree resync -----

        schedule-tree-resync (Fn [] Any) (fn [] Any
          (when (not (js/get counters .resync-pending))
            (js/set! counters .resync-pending true)
            (js/call (Promise/resolve undefined) .then (fn [] Any
              (js/set! counters .resync-pending false)
              (js/call (tabs!) .forEach
                (fn [%1 Any] Any (when (js/call row-of .get %1)
                   (sync-tab-row %1))))
              (update-visibility)))))

        ;; ----- sync any row -----

        sync-any-row (Fn [Any] Any) (fn [row Any] Any
          (if (js/get row ._tab)
            (sync-tab-row (js/get row ._tab))
            (when (js/get row ._group)
              (sync-group-row row))))]

    {:createTabRow create-tab-row
     :syncTabRow sync-tab-row
     :createGroupRow create-group-row
     :syncGroupRow sync-group-row
     :syncAnyRow sync-any-row
     :updateVisibility update-visibility
     :updateHorizontalGrid update-horizontal-grid
     :clearHorizontalGrid clear-horizontal-grid
     :toggleCollapse toggle-collapse
     :scheduleTreeResync schedule-tree-resync})))
