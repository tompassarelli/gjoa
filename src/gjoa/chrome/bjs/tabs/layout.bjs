#lang beagle/js
(ns gjoa.tabs.layout
  (:require [gjoa.macros :refer [by-id xul-new attr! pref-bool has? rmattr! toggle! on!]]
            [gjoa.tabs.log :refer [create-logger!]]
            [gjoa.tabs.helpers :refer [all-rows data-of! level-of-row! same-node?]]
            [gjoa.tabs.state :refer [row-of state]]))

(declare-extern [gBrowser requestAnimationFrame] Any)

;; PURE collapse-decision helper (functional-tested: collapse-flags.functional.mjs).
;; Given the AUTHORITATIVE launcher state + compact/hover, decide the two flags
;; that drive the collapsed favicon-rail: `iconsOnly` hides labels & shrinks the
;; strip; `sidebarCollapsed` stamps the doc-level collapsed layout. Kept pure and
;; keyed on `launcher-expanded` (FF's `sidebar-launcher-expanded`) — NOT the
;; toolbox's live parent, which lags the collapse (a separate module reparents it)
;; and caused the half-width labelled-rail regression (#collapse-width). The
;; invariant it locks: launcher collapsed (and not a compact reveal) ⇒ iconsOnly.
(js/export (defn collapse-flags
             [launcher-expanded Bool
              compact Bool
              hover Bool]
             Any
             (let [compact-revealed Any (and compact hover)]
    {:iconsOnly (and (not launcher-expanded) (not compact-revealed))
     :sidebarCollapsed (or (not launcher-expanded) compact)})))

(js/export (defn make-layout! [deps Any] Any
  (let [sidebar-main Any (js/get deps .sidebarMain)
        rows Any (js/get deps .rows)
        log Any (create-logger! "tabs/layout")

        ;; Module-private mutable state
        priv (Map Keyword Any) {:toolboxResizeObs nil
              :alignSpacer nil
              :lastVertical nil
              :posPanelRaf 0}

        is-vertical (Fn [] Bool) (fn [] Bool
          (pref-bool "sidebar.verticalTabs" true))

        ;; Keep only the active tree expanded in horizontal mode. This is a
        ;; LAYOUT concern, so it writes the transient `layoutCollapsed` flag —
        ;; NOT the persisted `collapsed`. Consequences:
        ;;   - a horizontal<->vertical round-trip never mutates the user's saved
        ;;     tree state (it's cleared when returning to vertical);
        ;;   - it is scoped to the ACTIVE SPACE, so other spaces are untouched;
        ;;   - if the active tree can't be resolved, nothing is collapsed — we
        ;;     never mass-collapse on a missed selected-tab lookup.
        apply-layout-tree-collapse (Fn [] Any) (fn [] Any
          (let [vertical Any (is-vertical)
                space-filter Any (js/get deps .isTabInActiveSpace)
                all (Vec Any) (all-rows)
                mutated (Map Keyword Bool) {:v false}
                set-lc! (Fn [Any Bool] Any) (fn
                                              [row Any
                                               val Bool] Any
                                              (let [d Any (data-of! row)
                        cur Bool (if (and d (js/get d .layoutCollapsed)) true false)]
                    (when (and d (not= cur val))
                      (js/set! d .layoutCollapsed val)
                      (js/call rows .syncAnyRow row)
                      (js/set! mutated .v true))))]
            (if vertical
              ;; Vertical never layout-collapses: clear the transient flag so the
              ;; user's real (persisted) collapse state is what renders.
              (js/call all .forEach (fn [row Any] Any
                (when (= (level-of-row! row) 0)
                  (set-lc! row false))))
              ;; Horizontal: collapse every active-space tree except the active one.
              (let [active-tab Any (and gBrowser (js/get gBrowser .selectedTab))
                    active-row Any (and active-tab
                                    (or (js/call row-of .get active-tab)
                                        (js/call all .find (fn [%1 Any] Any (= (js/get %1 ._tab) active-tab)))))
                    found (Map Keyword Any) {:root nil}]
                (when active-row
                  (loop [i Int (js/call all .indexOf active-row)]
                    (when (>= i 0)
                      (if (= (level-of-row! (aget all i)) 0)
                        (js/set! found .root (aget all i))
                        (recur (- i 1))))))
                (when (js/get found .root)
                  (js/call all .forEach (fn [row Any] Any
                    (when (and (= (level-of-row! row) 0)
                               (let [t Any (js/get row ._tab)]
                                 (or (not t) (not space-filter) (space-filter t))))
                      (set-lc! row (not= row (js/get found .root)))))))))
            (when (js/get mutated .v)
              (js/call rows .updateVisibility))))

        setup-horizontal-align-spacer (Fn [] Any) (fn [] Any
          (let [target Any (by-id "TabsToolbar-customization-target")]
            (when target
              (when (not (js/get priv .alignSpacer))
                (let [el Any (xul-new "box")]
                  (js/set! el .id "gjoa-content-alignment-spacer")
                  (js/set! (js/get el .style) .flex "0 0 auto")
                  (js/set! (js/get el .style) .width "10px")
                  (js/set! priv .alignSpacer el)))
              (when (not (same-node? (js/get target .firstChild) (js/get priv .alignSpacer)))
                (js/call target .prepend (js/get priv .alignSpacer))))))

        teardown-horizontal-align-spacer (Fn [] Any) (fn [] Any
          (when (js/get priv .alignSpacer)
            (js/call (js/get priv .alignSpacer) .remove)))

        set-urlbar-top-layer (Fn [Bool] Any) (fn [in-top-layer Bool] Any
          (let [urlbar Any (by-id "urlbar")]
            (when urlbar
              (when (not (has? sidebar-main "data-gjoa-compact"))
                (if (and in-top-layer (not (has? urlbar "popover")))
                  (do
                    (attr! urlbar "popover" "manual")
                    (try (js/call urlbar .showPopover) (catch (_e Any) nil)))
                  (when (and (not in-top-layer) (has? urlbar "popover"))
                    (rmattr! urlbar "popover")))))))

        position-panel (Fn [] Any) (fn [] Any
          (when (js/get state .panel)
            (let [vertical Any (is-vertical)]
              (toggle! (js/get state .panel) "gjoa-horizontal" (not vertical))
              (when (js/get state .pinnedContainer)
                (toggle! (js/get state .pinnedContainer) "gjoa-horizontal" (not vertical)))
              (toggle! (js/get document .documentElement) "gjoa-horizontal-tabs" (not vertical))

              (when (js/get priv .toolboxResizeObs)
                (js/call (js/get priv .toolboxResizeObs) .disconnect)
                (js/set! priv .toolboxResizeObs nil))

              (let [toolbox Any (by-id "navigator-toolbox")
                    ;; `same-node?`, never `=`: beagle's `=` is STRUCTURAL over own
                    ;; enumerable keys, so any two DOM nodes compare EQUAL — every
                    ;; node guard in this function is dead code without it.
                    toolbox-in-sidebar Any (and toolbox (same-node? (js/get toolbox .parentNode) sidebar-main))
                    ;; The AUTHORITATIVE collapsed signal is FF's own
                    ;; `sidebar-launcher-expanded` attribute — NOT the toolbox's
                    ;; parent. The toolbox is reparented in/out of the sidebar by
                    ;; a SEPARATE module (drawer/layout.bjs collapse/expand)
                    ;; reacting to the SAME attribute, so `toolbox-in-sidebar`
                    ;; LAGS during the collapse (worsened by FF's launcher
                    ;; animation): positionPanel could read toolbox-still-in and
                    ;; wrongly skip icons-only, leaving a half-width labelled rail
                    ;; instead of the favicon strip (#collapse-width regression).
                    ;; Decide icons-only/collapsed off the settled attribute; keep
                    ;; toolbox-in-sidebar only for the physical panel arrangement.
                    launcher-expanded Any (has? sidebar-main "sidebar-launcher-expanded")]

                (if vertical
                  (let [flags Any (collapse-flags launcher-expanded
                                              (has? sidebar-main "data-gjoa-compact")
                                              (has? sidebar-main "gjoa-has-hover"))
                        sidebar-collapsed Any (js/get flags .sidebarCollapsed)
                        icons-only Any (js/get flags .iconsOnly)]
                    (toggle! (js/get state .panel) "gjoa-icons-only" icons-only)
                    (when (js/get state .pinnedContainer)
                      (toggle! (js/get state .pinnedContainer) "gjoa-icons-only" icons-only))
                    (when (js/get state .spaceHeader)
                      (toggle! (js/get state .spaceHeader) "gjoa-icons-only" icons-only))
                    (toggle! (js/get document .documentElement) "gjoa-sidebar-collapsed" sidebar-collapsed)
                    (if (and toolbox-in-sidebar toolbox (js/get state .pinnedContainer))
                      (do
                        (when (and (js/get state .spaceHeader)
                                   (not (same-node? (js/get toolbox .nextElementSibling)
                                                    (js/get state .spaceHeader))))
                          (js/call toolbox .after (js/get state .spaceHeader)))
                        (let [header-anchor Any (or (js/get state .spaceHeader) toolbox)]
                          (when (not (same-node? (js/get header-anchor .nextElementSibling)
                                                 (js/get state .pinnedContainer)))
                            (js/call header-anchor .after (js/get state .pinnedContainer))))
                        (when (not (same-node? (js/get (js/get state .pinnedContainer) .nextElementSibling)
                                               (js/get state .panel)))
                          (js/call (js/get state .pinnedContainer) .after (js/get state .panel))))
                      (when (and (js/get state .pinnedContainer)
                                 (or (not (same-node? (js/get (js/get state .panel) .parentNode) sidebar-main))
                                     (not (same-node? (js/get sidebar-main .firstElementChild)
                                                      (or (js/get state .spaceHeader)
                                                          (js/get state .pinnedContainer))))))
                        (js/call sidebar-main .prepend (js/get state .panel))
                        (js/call sidebar-main .prepend (js/get state .pinnedContainer))
                        (when (js/get state .spaceHeader)
                          (js/call sidebar-main .prepend (js/get state .spaceHeader)))))
                    (teardown-horizontal-align-spacer)
                    (set-urlbar-top-layer true))
                  ;; horizontal branch
                  (do
                    (rmattr! (js/get state .panel) "gjoa-icons-only")
                    (when (js/get state .pinnedContainer)
                      (rmattr! (js/get state .pinnedContainer) "gjoa-icons-only"))
                    (rmattr! (js/get document .documentElement) "gjoa-sidebar-collapsed")
                    (when (and (js/get state .spaceHeader) (js/get (js/get state .spaceHeader) .parentNode))
                      (js/call (js/get state .spaceHeader) .remove))
                    (let [tabbrowser-tabs Any (by-id "tabbrowser-tabs")]
                      (when tabbrowser-tabs
                        (when (and (js/get state .pinnedContainer)
                                   (not (same-node? (js/get tabbrowser-tabs .nextElementSibling)
                                                    (js/get state .pinnedContainer))))
                          (js/call tabbrowser-tabs .after (js/get state .pinnedContainer)))
                        (let [anchor Any (or (js/get state .pinnedContainer) tabbrowser-tabs)]
                          (when (not (same-node? (js/get anchor .nextElementSibling) (js/get state .panel)))
                            (js/call anchor .after (js/get state .panel))))))
                    (setup-horizontal-align-spacer)))

                ;; Track toolbox height for compact mode offset
                (if (and (not toolbox-in-sidebar) toolbox)
                  (let [update-height (Fn [] Any) (fn [] Any
                          (let [h Float (js/get (js/call toolbox .getBoundingClientRect) .height)]
                            (js/call (js/get (js/get document .documentElement) .style) .setProperty
                                          "--gjoa-toolbox-height" (str h "px"))))]
                    (update-height)
                    (js/set! priv .toolboxResizeObs (js/new ResizeObserver update-height))
                    (js/call (js/get priv .toolboxResizeObs) .observe toolbox))
                  (js/call (js/get (js/get document .documentElement) .style) .removeProperty "--gjoa-toolbox-height"))

                ;; Re-sync all rows when switching modes
                (when vertical (js/call rows .clearHorizontalGrid))
                (js/call (all-rows) .forEach (fn [%1 Any] Any (js/call rows .syncAnyRow %1)))
                (js/call rows .updateVisibility)

                ;; Apply "keep only active tree expanded" on mode changes
                (let [mode-changed Any (and (not= (js/get priv .lastVertical) nil)
                                        (not= (js/get priv .lastVertical) vertical))
                      initial-horizontal Any (and (= (js/get priv .lastVertical) nil) (not vertical))]
                  (log "positionPanel:transitionCheck"
                       {:lastVertical (js/get priv .lastVertical)
                        :vertical vertical
                        :modeChanged mode-changed
                        :initialHorizontal initial-horizontal
                        :willTrigger (or mode-changed initial-horizontal)})
                  (when (or mode-changed initial-horizontal)
                    (apply-layout-tree-collapse)))

                ;; A visibility pass can hide the selected row if the selection
                ;; drifted out of the active space; re-assert the invariant so a
                ;; mode toggle never leaves the selected tab hidden.
                (when (js/get deps .reconcileSelection)
                  (js/call deps .reconcileSelection))
                (js/set! priv .lastVertical vertical)))))

        ;; rAF-coalesce positionPanel: compact mode bursts several sidebar
        ;; attributes in one turn (data-gjoa-compact / gjoa-has-hover /
        ;; sidebar-launcher-expanded), each firing the MutationObserver. Collapse
        ;; them into ONE positionPanel per frame so we never thrash the layout or
        ;; read a half-applied attribute set mid-burst.
        request-position-panel (Fn [] Any) (fn [] Any
          (when (= (js/get priv .posPanelRaf) 0)
            (js/set! priv .posPanelRaf
              (requestAnimationFrame
                (fn [] Any
                  (js/set! priv .posPanelRaf 0)
                  (position-panel))))))]

    {:positionPanel position-panel
     :requestPositionPanel request-position-panel
     :isVertical is-vertical
     :setUrlbarTopLayer set-urlbar-top-layer})))
