#lang beagle/js
(ns gjoa.tabs.picker
  (:require [gjoa.macros :refer [q xul-new html-new attr! key= on! onc! offc! xul htm bool]]))

(declare-extern [document undefined] Any)

;; --- helpers ---

(defn compute-filtered [(all-items Any) (query String)
                         (preserve Bool) (filter-fn Any)] Any
  (if (= query "")
    (js/call all-items .slice)
    (let [matched-set (js/new Set)]
      (js/call all-items .forEach
        (fn [%1] Any (when (if filter-fn
                 (filter-fn %1 query)
                 (let [hay (js/call (str (or (js/get %1 .display) "") " " (or (js/get %1 .secondary) "")) .toLowerCase)]
                   (js/call hay .includes query)))
           (js/call matched-set .add %1))))
      (if (not preserve)
        ;; Rank TITLE (.-display) matches above description-only (.-secondary)
        ;; matches, so typing "space" selects `:space` — not `:history`, whose
        ;; description ("…`:history space`…") merely mentions the word. Stable
        ;; sort keeps the original order within each rank tier.
        (let [qfirst (or (aget (js/call (js/call (js/call query .trim) .toLowerCase) .split (js/new RegExp "\\s+")) 0) "")
              title-rank (fn [(it Any)] Int
                           (if (and (not= qfirst "")
                                    (js/call (js/call (or (js/get it .display) "") .toLowerCase) .includes qfirst))
                             0 1))]
          (js/call (js/call all-items .filter (fn [%1] Any (js/call matched-set .has %1))) .sort
                 (fn [a b] Any (- (title-rank a) (title-rank b)))))
        ;; Items are caller-supplied; their ids are tab ids or command keys.
        (let [(by-id (JsMap Any Any)) (js/new Map)]
          (js/call all-items .forEach
            (fn [%1] Any (when (and (not= (js/get %1 .id) nil) (not= (js/get %1 .id) undefined))
               (js/call by-id .set (js/get %1 .id) %1))))
          (let [visible (js/new Set matched-set)]
            (js/call matched-set .forEach
              (fn [%1] Any (loop [cur %1]
                 (when (and cur (not= (js/get cur .parentId) nil) (not= (js/get cur .parentId) undefined))
                   (let [p (js/call by-id .get (js/get cur .parentId))]
                     (when (and p (not (js/call visible .has p)))
                       (js/call visible .add p)
                       (recur p)))))))
            (js/call all-items .filter (fn [%1] Any (js/call visible .has %1)))))))))

(defn is-direct-match [(item Any) (query String)] Bool
  (if (= query "")
    true
    (let [hay (js/call (str (or (js/get item .display) "") " " (or (js/get item .secondary) "")) .toLowerCase)]
      (js/call hay .includes query))))

(defn clear-children [(el Any)] Any
  (when (js/get el .firstChild)
    (js/call (js/get el .firstChild) .remove)
    (clear-children el)))

;; --- factory ---

(js/export (defn make-picker! [(deps Any)] Any
  (let [st {:pickerEl nil
            :pickerInput nil
            :pickerList nil
            :active false
            :items []
            :filtered []
            :selectedIdx 0
            :onSelect nil
            :actions []
            :preserveTree false
            :filterItem nil}

        ;; single forward ref for the show/open-action-menu cycle
        show-ref {:fn nil}

        reset-st! (fn [] Any
          (js/set! st .active false)
          (js/set! st .onSelect nil)
          (js/set! st .actions [])
          (js/set! st .preserveTree false)
          (when (js/get st .pickerEl)
            (js/set! (js/get st .pickerEl) .hidden true)))

        dismiss (fn [] Any
          (when (js/get st .active)
            (reset-st!)
            (js/call deps .restoreFocus)))

        commit (fn [] Any
          (when (js/get st .active)
            (let [item (aget (js/get st .filtered) (js/get st .selectedIdx))
                  cb (js/get st .onSelect)
                  query (or (some-> (js/get st .pickerInput) (js/get .value)) "")]
              (reset-st!)
              (when (and item cb)
                (cb item query)))))

        ;; --- render-list ---
        render-list (fn [] Any
          (when (js/get st .pickerList)
            (clear-children (js/get st .pickerList))
            (if (= (js/get (js/get st .filtered) .length) 0)
              (let [empty (xul "label" "gjoa-picker-empty")]
                (attr! empty "value" "(no matches)")
                (js/call (js/get st .pickerList) .appendChild empty))
              (do
                (let [query (or (some-> (js/get st .pickerInput) (js/get .value) (js/call .trim) (js/call .toLowerCase)) "")]
                  (js/call (js/get st .filtered) .forEach
                    (fn [item idx] Any
                      (let [row (xul "hbox" "gjoa-picker-row")]
                        (when (= idx (js/get st .selectedIdx))
                          (attr! row "gjoa-picker-selected" "true"))
                        (when (and (js/get st .preserveTree) query (not (is-direct-match item query)))
                          (attr! row "gjoa-picker-context" "true"))
                        (when (js/get item .depth)
                          (js/call (js/get row .style) .setProperty "padding-left"
                            (str (+ 14 (* (js/get item .depth) 14)) "px")
                            "important"))

                        ;; icon column
                        (when (js/get item .icon)
                          ;; Local schemes only — page-icon:/data:/chrome:/moz- never
                          ;; trigger a network fetch from this privileged document. A
                          ;; page-controlled http(s) favicon URL is deliberately NOT
                          ;; loadable here (it would beacon with the chrome principal).
                          (if (js/call (js/new RegExp "^page-icon:|^data:|^chrome:|^moz-") .test (js/get item .icon))
                            (let [img (htm "img" "gjoa-picker-icon")]
                              (js/set! img .src (js/get item .icon))
                              (js/set! img .alt "")
                              (js/call row .appendChild img))
                            (let [ic (xul "label" "gjoa-picker-icon-text")]
                              (attr! ic "value" (js/get item .icon))
                              (js/call row .appendChild ic))))

                        ;; text column
                        (let [text (xul "hbox" "gjoa-picker-text")]
                          (attr! text "flex" "1")
                          (let [primary (xul "label" "gjoa-picker-label")]
                            (attr! primary "value" (js/get item .display))
                            (attr! primary "crop" "end")
                            (js/call text .appendChild primary))
                          (when (js/get item .secondary)
                            (let [sec (xul "label" "gjoa-picker-secondary")]
                              (attr! sec "value" (js/get item .secondary))
                              (attr! sec "crop" "end")
                              (js/call text .appendChild sec)))
                          (js/call row .appendChild text))

                        ;; click handler
                        (on! row "click"
                          (fn [] Any
                            (js/set! st .selectedIdx idx)
                            (commit)))
                        (js/call (js/get st .pickerList) .appendChild row)))))
                (some-> (q (js/get st .pickerList) "[gjoa-picker-selected='true']")
                  (js/call .scrollIntoView {:block "nearest"}))))))

        ;; --- move-selection ---
        move-selection (fn [delta] Any
          (when (> (js/get (js/get st .filtered) .length) 0)
            (js/set! st .selectedIdx
              (rem (+ (js/get st .selectedIdx) delta (js/get (js/get st .filtered) .length))
                   (js/get (js/get st .filtered) .length)))
            (render-list)))

        ;; --- open-action-menu ---
        open-action-menu (fn [] Any
          (let [target (aget (js/get st .filtered) (js/get st .selectedIdx))
                local-actions (js/get st .actions)]
            (when (and target (js/get local-actions .length))
              (dismiss)
              (let [show-fn (js/get show-ref .fn)]
                (show-fn
                  {:prompt "actions >"
                   :items (js/call local-actions .map
                     (fn [%1] Any (let [label (str (js/get %1 .label)
                                    (if (js/get %1 .key)
                                      (str "   (" (js/get %1 .key) ")")
                                      ""))]
                        {:display label :data %1})))
                   :onSelect (fn [%1] Any (let [action (js/get %1 .data)]
                                (try
                                  (js/call action .run target)
                                  (catch (e Any)
                                    (js/call deps .modelineMsg
                                      (str "action failed: " (js/get e .message))
                                      4000)))))})))))

        ;; --- ensure-built ---
        ensure-built (fn [] Any
          (when (not (js/get st .pickerEl))
            (let [root (xul-new "vbox")
                  input-box (xul "hbox" "gjoa-picker-input-box")
                  prompt (xul "label" "gjoa-picker-prompt")
                  input (htm "input" "gjoa-picker-input")
                  list (xul "vbox" "gjoa-picker-list")]
              (js/set! root .id "gjoa-picker")
              (js/set! root .hidden true)
              (attr! root "aria-modal" "true")

              (attr! prompt "value" ">")
              (js/set! input .placeholder "Filter...")
              (js/call input-box .append prompt input)
              (js/call root .append input-box list)
              (js/call (js/get document .documentElement) .appendChild root)

              (js/set! st .pickerEl root)
              (js/set! st .pickerInput input)
              (js/set! st .pickerList list)

              ;; input filter handler
              (on! input "input"
                (fn [] Any (let [query (js/call (js/call (js/get input .value) .trim) .toLowerCase)]
                   (js/set! st .filtered
                     (compute-filtered (js/get st .items) query
                       (js/get st .preserveTree) (js/get st .filterItem)))
                   (js/set! st .selectedIdx 0)
                   (render-list))))

              ;; keydown handler (capture phase)
              (onc! input "keydown"
                (fn [%1] Any (when (js/get st .active)
                   (let [key (js/get %1 .key)]
                     (cond
                       (= key "Escape")
                       (do (js/call %1 .preventDefault) (js/call %1 .stopImmediatePropagation)
                           (dismiss))

                       (= key "Enter")
                       (do (js/call %1 .preventDefault) (js/call %1 .stopImmediatePropagation)
                           (commit))

                       (and (= key "Tab") (> (js/get (js/get st .actions) .length) 0))
                       (do (js/call %1 .preventDefault) (js/call %1 .stopImmediatePropagation)
                           (open-action-menu))

                       (or (= key "ArrowDown") (and (js/get %1 .ctrlKey) (or (= key "j") (= key "n"))))
                       (do (js/call %1 .preventDefault) (js/call %1 .stopImmediatePropagation)
                           (move-selection 1))

                       (or (= key "ArrowUp") (and (js/get %1 .ctrlKey) (or (= key "k") (= key "p"))))
                       (do (js/call %1 .preventDefault) (js/call %1 .stopImmediatePropagation)
                           (move-selection -1))

                       :else nil))))
              ))))

        ;; --- show ---
        show (fn [opts] Any
          (ensure-built)
          (when (and (js/get st .pickerEl) (js/get st .pickerInput) (js/get st .pickerList))
            (js/set! st .items (js/get opts .items))
            (js/set! st .selectedIdx 0)
            (js/set! st .onSelect (js/get opts .onSelect))
            (js/set! st .actions (or (js/get opts .actions) []))
            (js/set! st .preserveTree (bool (js/get opts .preserveTree)))
            (js/set! st .filterItem (js/get opts .filterItem))
            (js/set! st .filtered (js/call (js/get opts .items) .slice))
            (js/set! st .active true)

            (let [prompt-el (q (js/get st .pickerEl) ".gjoa-picker-prompt")]
              (cond
                (and prompt-el (js/get opts .prompt))
                (attr! prompt-el "value" (js/get opts .prompt))

                prompt-el
                (attr! prompt-el "value" ">")

                :else nil))

            (js/set! (js/get st .pickerInput) .value "")
            (render-list)
            (js/set! (js/get st .pickerEl) .hidden false)
            (js/call (js/get st .pickerInput) .focus)))

        ;; --- destroy ---
        destroy (fn [] Any
          (offc! document "keydown" on-doc-keydown)
          (offc! document "mousedown" on-doc-mousedown)
          (dismiss)
          (some-> (js/get st .pickerEl) (js/call .remove))
          (js/set! st .pickerEl nil)
          (js/set! st .pickerInput nil)
          (js/set! st .pickerList nil))

        ;; --- document-level listeners (capture phase) ---
        on-doc-keydown (fn [%1] Any (when (js/get st .active)
                          (when (key= %1 "Escape")
                            (js/call %1 .preventDefault)
                            (js/call %1 .stopImmediatePropagation)
                            (dismiss))))

        on-doc-mousedown (fn [%1] Any (when (and (js/get st .active) (js/get st .pickerEl))
                            (let [t (js/get %1 .target)]
                              (when (or (not t) (not (js/call (js/get st .pickerEl) .contains t)))
                                (dismiss)))))]

    ;; wire the single forward ref
    (js/set! show-ref .fn show)

    ;; attach document-level listeners
    (onc! document "keydown" on-doc-keydown)
    (onc! document "mousedown" on-doc-mousedown)

    ;; return public API
    {:show show
     :isActive (fn [] Any (js/get st .active))
     :dismiss dismiss
     :destroy destroy})))
