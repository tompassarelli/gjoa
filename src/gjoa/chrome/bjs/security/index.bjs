#lang beagle/js
(ns gjoa.security.index)

(declare-extern [Services] Any)

(def PRODUCT-DETAILS-URL String
  "https://product-details.mozilla.org/1.0/firefox_versions.json")

(def RECHECK-INTERVAL-MS Int (* 60 60 1000))

(def FETCH-TIMEOUT-MS Int 8000)

;; Shape guard for the upstream LATEST_FIREFOX_VERSION field: a bare dotted
;; numeric (e.g. "152", "152.0", "152.0.1"). Anything else (HTML error page,
;; "152.0esr", garbage) is rejected before it reaches parse-version / newer?.
(def VERSION-RE Any (js/new RegExp "^\\d+(\\.\\d+){0,2}$"))

(defn parse-version [v String] (Vec Int)
  (let [cleaned String (js/call (js/call v .replace (js/new RegExp "esr$" "i") "") .trim)
        parts (Vec Int) (js/call (js/call cleaned .split ".") .map (fn [x String] Int (or (parseInt x 10) 0)))]
    [(or (aget parts 0) 0) (or (aget parts 1) 0) (or (aget parts 2) 0)]))

(defn newer?
  [a String
   b String] Boolean
  (let [av (Vec Int) (parse-version a)
        bv (Vec Int) (parse-version b)]
    (cond
      (not= (aget bv 0) (aget av 0)) (> (aget bv 0) (aget av 0))
      (not= (aget bv 1) (aget av 1)) (> (aget bv 1) (aget av 1))
      (not= (aget bv 2) (aget av 2)) (> (aget bv 2) (aget av 2))
      :else false)))

(defn get-env [name String] String
  (try
    (or (js/call (js/get Services .env) .get name) "")
    (catch (_e Any) "")))

;; :confirmed-at — epoch-ms of the last probe that actually read a well-formed
;; LATEST_FIREFOX_VERSION from upstream (0 = never since launch). Lets the
;; fail-open offline path distinguish "transiently offline after a good probe"
;; from "never once confirmed this session" — a persistently-suppressed probe
;; that would otherwise be silently indistinguishable from being up to date.
(def state Any {:quitting false :confirmed-at 0})

(defn quit-stale!
  [my-version String
   latest-version String] Any
  (when (not (js/get state .quitting))
    (js/set! state .quitting true)
    (try
      (let [prompt-svc Any (js/get Services .prompt)
            w Any (js/call (js/get Services .wm) .getMostRecentWindow "navigator:browser")]
        (js/call prompt-svc .alert
          w
          "gjoa is out of date — quitting"
          (str "This build is Firefox " my-version
               "; the latest stable is " latest-version ".\n\n"
               "Running an out-of-date browser is unsafe. gjoa will now quit.\n\n"
               "To rebuild against the latest stable:\n"
               "  bun run security:bump\n"
               "  bun run import\n"
               "  nix build .#gjoa --impure   (~30-60 min)\n\n"
               "Emergency override (one-off, do not habituate):\n"
               "  GJOA_ALLOW_INSECURE=1 gjoa")))
      (catch (e Any)
        (console/error "[security] modal failed; quitting anyway" e)))
    (try
      (let [startup Any (js/get Services .startup)]
        (js/call startup .quit (js/get startup .eForceQuit)))
      (catch (e Any)
        (console/error "[security] startup.quit failed" e)))))

(defn probe! [] Any
  (let [my-version String (js/get (js/get Services .appinfo) .version)]
    (-> (fetch PRODUCT-DETAILS-URL {:signal (js/call AbortSignal .timeout FETCH-TIMEOUT-MS)})
        (js/call .then (fn [r Any] Any
          (when (not (js/get r .ok))
            (throw (js/new Error (str "HTTP " (js/get r .status)))))
          (js/call r .json)))
        (js/call .then (fn [j Any] Any
          (let [latest Any (or (js/get j .LATEST_FIREFOX_VERSION) nil)]
            (cond
              (not latest)
              (console/warn "[security] probe response missing LATEST_FIREFOX_VERSION — ignoring")

              (not (js/call VERSION-RE .test latest))
              (console/warn
                (str "[security] probe returned malformed LATEST_FIREFOX_VERSION ("
                     latest ") — ignoring (expected bare dotted numeric)"))

              :else
              (do
                (js/set! state .confirmed-at (Date/now))
                (if (not (newer? my-version latest))
                  (console/log (str "[security] OK — " my-version
                                     " matches or exceeds latest stable " latest))
                (let [my (Vec Int) (parse-version my-version)
                      up (Vec Int) (parse-version latest)
                      ;; parse-version yields a [major minor patch] triple whose
                      ;; every element is an integer or the 0 fallback.
                      up-major Int (aget up 0)
                      my-major Int (aget my 0)
                      major-behind Int (- up-major my-major)]
                  (if (>= major-behind 1)
                    (do
                      (console/error
                        (str "[security] CRITICAL: running " my-version
                             ", latest is " latest
                             " (" major-behind " major(s) behind) — quitting"))
                      (quit-stale! my-version latest))
                    (console/warn
                      (str "[security] STALE: running " my-version
                           ", latest is " latest
                           " (same major, point behind) — gjoa status will show STALE; rebuild when convenient"))))))))))
        (js/call .catch (fn [e Any] Any
          (if (= (js/get state .confirmed-at) 0)
            (console/warn
              (str "[security] probe failed and has NEVER confirmed current since launch"
                   " — staleness is UNVERIFIED, not known-good (fail-open):")
              (js/get e .message))
            (console/log "[security] probe failed — fail-open (offline?, last confirmed current earlier this session):" (js/get e .message))))))))

;; init
(defn init-! [] Any
  (if (= (get-env "GJOA_ALLOW_INSECURE") "1")
    (console/log "[security] GJOA_ALLOW_INSECURE=1 — gate disabled for this process")
    (when (not (js/get Services .__gjoaSecurityRunning))
      (js/set! Services .__gjoaSecurityRunning true)
      (setTimeout probe! 2000)
      (setInterval probe! RECHECK-INTERVAL-MS))))

(init-!)
