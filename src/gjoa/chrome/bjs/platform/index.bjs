#lang beagle/js
(ns gjoa.platform.index
  (:require [gjoa.platform.scheduler :refer [make-scheduler!]]
            [gjoa.platform.tabs-reconciler :refer [make-tabs-reconciler!]]
            [gjoa.platform.window :refer [make-gjoa-window!]]
            [gjoa.platform.history :refer [make-persisted]]
            [gjoa.platform.cross-window-tabs :refer [make-cross-window-tabs]]))

(js/export (defn make-gjoa! [deps Any] Any
  (let [scheduler Any (make-scheduler!)
        tabs-reconciler Any (make-tabs-reconciler! {:scheduler scheduler})
        win Any (make-gjoa-window! scheduler)
        persisted Any (make-persisted (js/get deps .history))
        cross-window-tabs Any (make-cross-window-tabs)]

    {:windows {:current (fn [] Any win)}
     :tabs cross-window-tabs
     :history (js/get persisted .history)
     :sessions (js/get persisted .sessions)
     :checkpoints (js/get persisted .checkpoints)
     :flush (fn [] Any (js/call scheduler .flush))
     :diag (fn [] Any (let [s Any (js/call scheduler .diag)
                  wid Any (js/get win .windowId)
                  iid Any (js/call (js/get deps .history) .instanceId)]
              {:scheduler s :windowId wid :instanceId iid}))
     :destroy (fn [] Any
                (js/call tabs-reconciler .destroy)
                (js/call scheduler .destroy))})))
