#lang beagle/js
(ns gjoa.platform.cross-window-tabs)

(js/export (defn make-cross-window-tabs [] Any
  {:all (fn [] Any
    (let [out (Vec Any) []]
      (try
        (loop [e Any (js/call (js/get Services .wm) .getEnumerator "navigator:browser")]
          (if (js/call e .hasMoreElements)
            (do
              (let [w Any (js/call e .getNext)
                    p Any (js/get w .Gjoa)]
                (when p
                  ;; per-window try: a window still initializing (no windows.current
                  ;; / tabs.list yet) must NOT abort the whole all-windows walk —
                  ;; otherwise one not-ready window blanks the entire shift+T picker.
                  (try
                    (let [win Any (js/call (js/get p .windows) .current)
                          tabs Any (js/call (js/get win .tabs) .list)]
                      (js/call tabs .forEach
                        (fn [t Any] Any
                          (js/call out .push {:id (js/get t .id)
                                      :url (js/get t .url)
                                      :label (js/get t .label)
                                      :customName (js/get t .customName)
                                      :pinned (js/get t .pinned)
                                      :selected (js/get t .selected)
                                      :hidden (js/get t .hidden)
                                      :parentId (js/get t .parentId)
                                      :depth (js/get t .depth)
                                      :windowId (js/get win .windowId)}))))
                    (catch (_e Any) nil))))
              (recur e))
            out))
        (catch (err Any)
          (console/error "[Gjoa.tabs.all] enumerate failed" err)))
      out))

   :activate (fn [gjoa-id Any
                 window-id Any] Any
    (try
      (loop [e Any (js/call (js/get Services .wm) .getEnumerator "navigator:browser")]
        (if (js/call e .hasMoreElements)
          (let [w Any (js/call e .getNext)
                p Any (js/get w .Gjoa)]
            (if p
              (let [win Any (js/call (js/get p .windows) .current)]
                (if (= (js/get win .windowId) window-id)
                  (js/call (js/get win .tabs) .activate gjoa-id)
                  (recur e)))
              (recur e)))
          false))
      (catch (err Any)
        (console/error "[Gjoa.tabs.activate] failed" err)
        false)))}))
