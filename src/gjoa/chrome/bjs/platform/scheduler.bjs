#lang beagle/js
(ns gjoa.platform.scheduler
  (:require [gjoa.tabs.log :refer [create-logger!]]))

(declare-extern [String undefined] Any)

(js/export (def DOMAIN-ORDER Any ["prefs" "windows" "tabs" "snapshots" "sidebar" "command"]))

(js/export (defn make-scheduler! [] Any
  (let [log Any (create-logger! "scheduler")
        ;; Both maps are keyed by domain name — the DOMAIN-ORDER vocabulary.
        reconcilers (JsMap String (Vec Any)) (js/new Map)
        pending (JsMap String (Vec Any)) (js/new Map)
        state Any {:pendingFlush nil
               :pendingResolve nil
               :lastReconcileMs nil
               :destroyed false}]

    (letfn [(get-dirty [domain String] Any
                      (or (js/call pending .get domain)
                          (let [fresh (Vec Any) []]
                            (js/call pending .set domain fresh)
                            fresh)))

          (run-once [] Any
                     (when (not (js/get state .destroyed))
                       (let [started-at Float (js/call performance .now)
                             ;; Freeze the dirty set before clearing it. Written
                             ;; entry-by-entry because the stdlib models Map's
                             ;; zero-argument constructor only.
                             snapshot (JsMap String (Vec Any)) (let [snap (JsMap String (Vec Any)) (js/new Map)]
                                        (js/call pending .forEach
                                          (fn [reasons (Vec Any)
                                               domain String] Any
                                            (js/call snap .set domain reasons)))
                                        snap)]
                         (js/call pending .clear)
                         (js/call DOMAIN-ORDER .forEach (fn [domain String] Any
                           (let [reasons (Vec Any) (js/call snapshot .get domain)]
                             (when (and reasons (not= (js/get reasons .length) 0))
                               (let [handlers (Vec Any) (or (js/call reconcilers .get domain) [])]
                                 (js/call handlers .forEach
                                   (fn [%1 Any] Any (try (js/call %1 .run reasons)
                                      (catch (e Any)
                                        (log "reconciler:error"
                                             {:domain domain
                                              :reasons reasons
                                              :msg (String e)}))))))))))
                         (js/set! state .lastReconcileMs (- (js/call performance .now) started-at))
                         (log "reconcile:done" {:ms (js/get state .lastReconcileMs)}))))

          (schedule [] Any
                     (when (not (or (js/get state .pendingFlush) (js/get state .destroyed)))
                       (js/set! state .pendingFlush
                             (js/new Promise (fn [resolve Any] Any
                               (js/set! state .pendingResolve resolve)
                               (queueMicrotask (fn [] Any
                                 (try (run-once)
                                   (finally
                                     (let [co Any {:v false}]
                                       (js/call pending .forEach
                                         (fn [%1 Any] Any (when (> (js/get %1 .length) 0)
                                            (js/set! co .v true))))
                                       (js/set! state .pendingFlush nil)
                                       (let [local-resolve Any (js/get state .pendingResolve)]
                                         (js/set! state .pendingResolve nil)
                                         (when (js/get co .v) (schedule))
                                         (when local-resolve (local-resolve)))))))))))))

          (register [reconciler Any] Any
                     (let [list (Vec Any) (or (js/call reconcilers .get (js/get reconciler .domain))
                                   (let [fresh (Vec Any) []]
                                     (js/call reconcilers .set (js/get reconciler .domain) fresh)
                                     fresh))]
                       (js/call list .push reconciler))
                     (log "register" {:domain (js/get reconciler .domain)})
                     (fn [] Any
                       (let [arr (Vec Any) (js/call reconcilers .get (js/get reconciler .domain))]
                         (when arr
                           (let [i Int (js/call arr .indexOf reconciler)]
                             (when (>= i 0) (js/call arr .splice i 1)))))))

          (mark-dirty [domain String
                       reason Any] Any
                       (when (not (js/get state .destroyed))
                         (js/call (get-dirty domain) .push reason)
                         (schedule)))

          (flush! [] Any
                  (if (not (js/get state .pendingFlush))
                    (Promise/resolve undefined)
                    (js/call (js/get state .pendingFlush) .then
                      (fn [] Any (when (js/get state .pendingFlush)
                         (flush!))))))

          (diag [] Any
                 (let [out Any (reduce (fn [acc Any
                                         domain String] Any
                                     (assoc acc domain (or (js/call pending .get domain) [])))
                                   {}
                                   DOMAIN-ORDER)]
                   {:pending out
                    :nextFlushPending (not= (js/get state .pendingFlush) nil)
                    :lastReconcileMs (js/get state .lastReconcileMs)}))

          (destroy [] Any
                    (js/set! state .destroyed true)
                    (js/call pending .clear)
                    (js/call reconcilers .clear))]

      {:register register
       :markDirty mark-dirty
       :flush flush!
       :diag diag
       :destroy destroy}))))
