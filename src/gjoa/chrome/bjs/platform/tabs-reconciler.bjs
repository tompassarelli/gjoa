#lang beagle/js
(ns gjoa.platform.tabs-reconciler
  (:require [gjoa.macros :refer [on! off!]]
            [gjoa.tabs.log :refer [create-logger!]]))

(declare-extern [gBrowser] Any)

(js/export (defn make-tabs-reconciler! [deps Any] Any
  (let [log Any (create-logger! "reconciler/tabs")
        scheduler Any (js/get deps .scheduler)

        unregister Any (js/call scheduler .register
                     {:domain "tabs"
                      :run (fn [%1 Any] Any (log "reconcile" {:reasons %1}))})

        on-tab-event (Fn [Any] Any) (fn [%1 Any] Any
                                      (js/call scheduler .markDirty "tabs" (js/get %1 .type)))

        events (Vec String) ["TabOpen" "TabClose" "TabMove" "TabSelect"
                             "TabAttrModified" "TabPinned" "TabUnpinned"]

        destroy (Fn [] Any) (fn [] Any
                  (js/call events .forEach
                    (fn [%1 String] Any (off! (js/get gBrowser .tabContainer) %1 on-tab-event)))
                  (unregister))]

    (js/call events .forEach
      (fn [%1 String] Any (on! (js/get gBrowser .tabContainer) %1 on-tab-event)))

    {:destroy destroy})))
