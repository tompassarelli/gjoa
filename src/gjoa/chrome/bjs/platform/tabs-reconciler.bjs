#lang beagle/js
(ns gjoa.platform.tabs-reconciler
  (:require [gjoa.macros :refer [on! off!]]
            [gjoa.tabs.log :refer [create-logger!]]))

(declare-extern [gBrowser] Any)

(js/export (defn make-tabs-reconciler! [(deps Any)] Any
  (let [log (create-logger! "reconciler/tabs")
        scheduler (js/get deps .scheduler)

        unregister (js/call scheduler .register
                     {:domain "tabs"
                      :run (fn [%1] Any (log "reconcile" {:reasons %1}))})

        on-tab-event (fn [%1] Any (js/call scheduler .markDirty "tabs" (js/get %1 .type)))

        events ["TabOpen" "TabClose" "TabMove" "TabSelect"
                "TabAttrModified" "TabPinned" "TabUnpinned"]

        destroy (fn [] Any
                  (js/call events .forEach
                    (fn [%1] Any (off! (js/get gBrowser .tabContainer) %1 on-tab-event)))
                  (unregister))]

    (js/call events .forEach
      (fn [%1] Any (on! (js/get gBrowser .tabContainer) %1 on-tab-event)))

    {:destroy destroy})))
