#lang beagle/js
(ns gjoa.drawer.urlbar
  (:require [gjoa.macros :refer [q by-id html-new htm attr! on! onc! offc! off! bool has? rmattr! css!]]
            [gjoa.tabs.log :refer [create-logger!]]))
(define-mode strict)

(declare-extern [document window String] Any)

;; The floating palette's hint footer, and the ONLY place its text is written.
;; Must stay a projection of handle-accel below: ctrl+j → selectBy(+1) = DOWN,
;; ctrl+k → selectBy(-1) = UP (vim convention), Escape → deactivate-floating.
(def FLOATING-HINTS :- Any
  [{:key "ctrl+j" :act "down"}
   {:key "ctrl+k" :act "up"}
   {:key "esc"    :act "exit"}])

(js/export (defn make-urlbar! [deps] :- Any
  (let [urlbar (.-urlbar deps)
        root (.-documentElement document)
        log (create-logger! "urlbar")
        state {:activated false :intent "current" :backdrop nil :ghost nil :hints nil
               :healObs nil :healFn nil :breakout0 false :containerBreakout0 false
               :urlbarH0 "" :containerH0 ""}

        intent-attr #(if (= % "newTab") "new-tab" "current")

        ;; Append the hint footer as #urlbar's LAST child so it lands below
        ;; .urlbarView (the results list). Idempotent — the re-arm path calls it
        ;; too, since a stale node can be orphaned by a raced teardown.
        ensure-hints (fn []
          (when (not (bool (some-> (.-hints state) .-isConnected)))
            (let [el (html-new "div")]
              (set! (.-id el) "gjoa-urlbar-hints")
              (attr! el "aria-hidden" "true")
              (.forEach FLOATING-HINTS (fn [h]
                (let [pair (htm "span" "gjoa-urlbar-hint")
                      k (htm "span" "gjoa-urlbar-hint-key")
                      a (htm "span" "gjoa-urlbar-hint-act")]
                  (set! (.-textContent k) (.-key h))
                  (set! (.-textContent a) (.-act h))
                  (.appendChild pair k)
                  (.appendChild pair a)
                  (.appendChild el pair))))
              (.appendChild urlbar el)
              (set! (.-hints state) el))))

        ;; #149 ATOMIC TEARDOWN. The naive teardown removed `gjoa-urlbar-floating`
        ;; synchronously, which instantly reverted the urlbar from the centered
        ;; position:fixed palette back to its resting in-sidebar INLINE box — that
        ;; geometry-restore frame was visible ("spazzes out" as a small inline
        ;; search box flashes in the sidebar) before the bar/ghost were gone.
        ;; Fix ordering: (1) set `gjoa-urlbar-teardown` → CSS instantly opacity:0's
        ;; the floating bar + backdrop with NO transition; (2) next animation frame
        ;; (after the hidden frame paints) actually remove the floating attrs and
        ;; tear down backdrop/ghost/popover behind the now-invisible box. So the
        ;; inline-restore reflow never paints.
        finish-teardown (fn []
          ;; Bail if a re-summon raced in before this frame fired — activate-floating
          ;; set activated=true + re-added the floating attrs, so tearing down now
          ;; would clobber the fresh activation. Leave it fully armed.
          (when (not (.-activated state))
            ;; Detach the top-layer watchdog FIRST — teardown deliberately hides the
            ;; popover and drops the floating attrs, and a live heal would fight it.
            (when (.-healObs state)
              (.disconnect (.-healObs state))
              (set! (.-healObs state) nil))
            (when (.-healFn state)
              (off! urlbar "toggle" (.-healFn state))
              (set! (.-healFn state) nil))
            ;; HIDE THE POPOVER FIRST, in EVERY mode (not just compact) — the
            ;; floating palette ALWAYS showPopover()s the urlbar into the top layer,
            ;; so a dismiss must take it back OUT or the resting urlbar stays a
            ;; :popover-open top-layer element hovering over its now-empty sidebar
            ;; slot: the "visual artifact on exit". (Previously gated on compact-on,
            ;; so non-compact never released it — verified popoverOpen=true post-
            ;; teardown.) Do it while the box is still invisible (teardown opacity:0)
            ;; and BEFORE dropping the floating/teardown attrs, so the urlbar returns
            ;; to normal in-flow (position:static) and paints its resting state in ONE
            ;; settled frame. Skip only when a click-to-expand (breakout-extend) raced
            ;; in — that owns the popover and must not be clobbered.
            ;; RETURN FOCUS TO CONTENT first: a non-Escape dismiss (backdrop / focus-out)
            ;; leaves the urlbar FOCUSED, and FF re-expands a focused resting urlbar into
            ;; breakout-extend (empty bar at the slot with top-sites results showing) — the
            ;; janky teardown residue the owner hit. Blurring to content collapses it. The
            ;; backdrop intercepts every click while floating, so a genuine click-to-expand
            ;; cannot race here; leftover focus is the ONLY source of breakout-extend at
            ;; teardown, so close the view + hide the popover + clear breakout unconditionally.
            (try
              (let [a (.-activeElement document)]
                (when (or (= a urlbar) (and a (.contains urlbar a)))
                  (some-> window .-gBrowser .-selectedBrowser .focus)))
              (some-> window .-gURLBar .-view .close)
              (when (and (.matches urlbar ":popover-open") (.-hidePopover urlbar))
                (.hidePopover urlbar))
              (rmattr! urlbar "popover")
              (rmattr! urlbar "breakout-extend")
              ;; Restore the PRE-SUMMON breakout state + the height vars Firefox may
              ;; have re-measured off the FLOATING box while we held it.
              (when (not (.-breakout0 state))
                (rmattr! urlbar "breakout"))
              (when (and (.-parentNode urlbar) (not (.-containerBreakout0 state)))
                (rmattr! (.-parentNode urlbar) "breakout"))
              (if (= (.-urlbarH0 state) "")
                (.removeProperty (.-style urlbar) "--urlbar-height")
                (.setProperty (.-style urlbar) "--urlbar-height" (.-urlbarH0 state)))
              (when (.-parentNode urlbar)
                (if (= (.-containerH0 state) "")
                  (.removeProperty (.-style (.-parentNode urlbar))
                                   "--urlbar-container-height")
                  (.setProperty (.-style (.-parentNode urlbar))
                                "--urlbar-container-height" (.-containerH0 state))))
              (catch Any e
                (log "finishTeardown:collapse-error" {:msg (String e)})))
            ;; #150: suppress urlbar transitions for the restore frame so the resting
            ;; geometry reverts INSTANTLY (matching the ghost look-alike) instead of
            ;; retracting through the breakout-extend width transition while opacity
            ;; restores to 1 — the "deformity after Enter" the cage frame-monitor caught.
            (attr! root "gjoa-urlbar-snap" "")
            (rmattr! root "gjoa-urlbar-floating")
            (rmattr! root "gjoa-urlbar-intent")
            (rmattr! root "gjoa-urlbar-teardown")
            (rmattr! root "gjoa-urlbar-arming")
            (when (.-backdrop state)
              (.remove (.-backdrop state))
              (set! (.-backdrop state) nil))
            (when (.-ghost state)
              (.remove (.-ghost state))
              (set! (.-ghost state) nil))
            (when (.-hints state)
              (.remove (.-hints state))
              (set! (.-hints state) nil))
            ;; release the snap after the instant revert has painted (double-rAF: frame
            ;; one applies the snapped resting layout, frame two re-enables transitions
            ;; so later focus/expand animations still work).
            (.requestAnimationFrame window
              (fn [] (.requestAnimationFrame window
                       (fn [] (rmattr! root "gjoa-urlbar-snap")))))))

        deactivate-floating (fn []
          (when (.-activated state)
            (set! (.-activated state) false)
            (log "deactivateFloating")
            ;; Fade the floating bar/backdrop out (CSS transition on the teardown
            ;; attr, ~130ms), then restore resting geometry AFTER the fade so the
            ;; inline-restore reflow paints behind the now-invisible box — smooth
            ;; close, no inline-sidebar flash. Matched to the 130ms CSS transition
            ;; (+ small buffer). A re-summon within the window clears teardown and
            ;; finish-teardown bails (guards on activated).
            (attr! root "gjoa-urlbar-teardown" "")
            ;; #150: fire finish-teardown when the opacity fade ACTUALLY completes
            ;; (transitionend on #urlbar's opacity), not on a guessed 150ms timer that
            ;; raced the fade — firing early restored the resting geometry while the box
            ;; was still visible (the retraction-through-the-tab-row deformity). One-shot
            ;; guard + removeEventListener; a fallback timer covers reduced-motion
            ;; (transition:none → no transitionend) and any dropped event.
            (let [h {:done false :f nil}
                  fire (fn [e]
                         (when (and (not (.-done h))
                                    (or (not e)
                                        (and (= (.-target e) urlbar)
                                             (= (.-propertyName e) "opacity"))))
                           (set! (.-done h) true)
                           (try (.removeEventListener urlbar "transitionend" (.-f h))
                                (catch Any _ nil))
                           (finish-teardown)))]
              (set! (.-f h) fire)
              (.addEventListener urlbar "transitionend" fire)
              (.setTimeout window (fn [] (fire nil)) 260))))

        ;; SINGLE OWNER of the top-layer promotion. The palette escapes the sidebar's
        ;; (transformed, in compact mode) stacking context ONLY by being a manual popover
        ;; in the top layer. This asserts that idempotently — popover=manual + showPopover
        ;; if not already open + focus — so it's safe to call on every summon (fresh OR
        ;; re-arm) and self-heals a popover that another writer (compact.bjs / teardown)
        ;; pulled out from under the `activated` flag.
        ensure-floating-promoted (fn []
          (try
            ;; #stopBreakout() drops [breakout] from BOTH #urlbar and #urlbar-container
            ;; in the same call that hides the popover, and that pair is what makes
            ;; .urlbar-background / .urlbarView render — restore both or the re-promoted
            ;; palette is correctly positioned and paints nothing.
            (when (not (has? urlbar "breakout"))
              (attr! urlbar "breakout" "true"))
            (when (and (.-parentNode urlbar) (not (has? (.-parentNode urlbar) "breakout")))
              (attr! (.-parentNode urlbar) "breakout" "true"))
            (when (not= (.getAttribute urlbar "popover") "manual")
              (attr! urlbar "popover" "manual"))
            (when (and (not (bool (.matches urlbar ":popover-open"))) (.-showPopover urlbar))
              (.showPopover urlbar))
            (some-> window .-gURLBar .focus)
            (some-> window .-gURLBar .select)
            (catch Any e
              (log "activateFloating:promote-error" {:msg (String e)}))))

        ;; TOP-LAYER WATCHDOG: gjoa does not own `popover` on #urlbar — UrlbarInput's
        ;; #stopBreakout() evicts it (modal blocker, layout-breakout re-measure, urlbar
        ;; reparenting), so a one-shot promotion cannot hold. Re-assert on every popover
        ;; `toggle` and on any [popover]/[breakout] write.
        heal (fn []
          (when (and (.-activated state)
                     (has? root "gjoa-urlbar-floating")
                     (not (has? root "gjoa-urlbar-teardown")))
            ;; A modal dialog raises the blocker deliberately; dismiss rather than heal.
            ;; [window-modal-open] lands AFTER the increment, so gate on `.open` too.
            (if (or (bool (some-> (by-id "window-modal-dialog") .-open))
                    (has? root "window-modal-open"))
              (do (log "heal:modal-dismiss")
                  (deactivate-floating))
              (when (not (and (bool (.matches urlbar ":popover-open"))
                              (has? urlbar "breakout")))
                (log "heal:re-promote"
                     {:popoverOpen (bool (.matches urlbar ":popover-open"))
                      :breakout (has? urlbar "breakout")})
                (ensure-floating-promoted)))))

        install-heal (fn []
          (when (not (.-healFn state))
            (set! (.-healFn state) heal)
            (on! urlbar "toggle" heal))
          (when (not (.-healObs state))
            (let [obs (MutationObserver. heal)]
              (.observe obs urlbar
                {:attributes true :attributeFilter ["popover" "breakout"]})
              (set! (.-healObs state) obs))))

        activate-floating (fn [new-intent]
          (set! (.-intent state) new-intent)
          ;; If a prior dismiss is still mid-teardown (teardown attr set, rAF
          ;; pending), a quick re-summon must clear it so the bar isn't stuck
          ;; opacity:0. The pending finish-teardown is then a near-no-op (attrs
          ;; already re-set by activate; it only re-removes the stale teardown
          ;; attr, which activate cleared anyway).
          (rmattr! root "gjoa-urlbar-teardown")
          (let [attr-val (intent-attr (.-intent state))]
            (if (.-activated state)
              (do (log "activateFloating:re-arm" {:intent (.-intent state)})
                  (attr! root "gjoa-urlbar-intent" attr-val)
                  ;; SELF-HEAL (2026-07-20): `activated` is a flag that can DESYNC from the
                  ;; real DOM state — the `popover` attr (what puts the palette in the top
                  ;; layer so it escapes the sidebar's transformed stacking context) is also
                  ;; written by compact.bjs's observer and by teardown, so it can be pulled
                  ;; out from under us while `activated` stays true. Without re-asserting it,
                  ;; a re-summon leaves the palette OUT of the top layer, positioned by its
                  ;; containing block (the compact sidebar) → clipped under the page content.
                  ;; Owner correctly called this a state-management failure, not a compositor
                  ;; bug. Re-assert the promotion here so every summon lands in the top layer.
                  (ensure-hints)
                  (ensure-floating-promoted))
              (do (set! (.-activated state) true)
                  (log "activateFloating" {:intent (.-intent state)})
                  ;; Snapshot everything Firefox's breakout machinery owns on #urlbar /
                  ;; #urlbar-container: a re-measure that lands while the palette floats
                  ;; pins the PALETTE's box into --urlbar-height, and [breakout] drives
                  ;; the resting layout — both must come back at teardown.
                  (set! (.-breakout0 state) (has? urlbar "breakout"))
                  (set! (.-containerBreakout0 state)
                        (bool (and (.-parentNode urlbar)
                                   (has? (.-parentNode urlbar) "breakout"))))
                  (set! (.-urlbarH0 state)
                        (.getPropertyValue (.-style urlbar) "--urlbar-height"))
                  (set! (.-containerH0 state)
                        (if (.-parentNode urlbar)
                          (.getPropertyValue (.-style (.-parentNode urlbar))
                                             "--urlbar-container-height")
                          ""))
                  ;; Leave a static look-alike (#gjoa-urlbar-ghost) in the resting
                  ;; slot so the real urlbar lifting to the centered palette doesn't
                  ;; collapse the slot / look like the bar "flew out" — the resting
                  ;; bar visually STAYS put. Capture the resting box FIRST, before
                  ;; the floating attr takes it position:fixed.
                  ;; Leave a static look-alike (#gjoa-urlbar-ghost) in the resting slot
                  ;; so the real urlbar lifting to the palette doesn't leave an empty
                  ;; box — the slot reads as the still urlbar (owner: "should still show
                  ;; identity icon + placeholder … frozen"). NOT a cloneNode of #urlbar:
                  ;; the input lives in a shadow root, which cloneNode does NOT copy, so
                  ;; a clone renders as a hollow box with the placeholder spilling out.
                  ;; Instead build a plain styled div — shield glyph + placeholder text —
                  ;; sized/bordered to match the resting bar. Captured BEFORE the floating
                  ;; attr so the box metrics are the true resting ones.
                  (when (not (.-ghost state))
                    (let [parent (.-parentNode urlbar)]
                      (when parent
                        (let [rect (.getBoundingClientRect urlbar)
                              cs (.getComputedStyle window urlbar)
                              g (html-new "div")
                              txt (html-new "div")
                              ph (or (some-> window .-gURLBar .-inputField .-placeholder)
                                     "Search with Google or enter address")
                              ;; #150c (2026-07-20): FREEZE the resting bar EXACTLY. The ghost
                              ;; fills the slot the instant the real urlbar lifts to float, so
                              ;; ANY difference reads as a swap. Two things the owner still saw
                              ;; wrong: (1) it showed the PLACEHOLDER instead of the loaded
                              ;; page's URL, and (2) it drew ONE plain shield where the resting
                              ;; bar shows several icons (search-mode switcher + trust/identity).
                              ;; Fix: text = the REAL resting value (gURLBar.value; placeholder
                              ;; only when the bar is truly empty), and reproduce EVERY visible
                              ;; leading icon at its real x by copying its rendered glyph —
                              ;; piercing shadow roots + honouring <img src> (the moz-button
                              ;; switcher renders its glyph in a shadow root, so light-DOM-only
                              ;; copying missed it, and cloneNode drops custom elements + un-hides
                              ;; state-hidden buttons; both verified in cage).
                              container (or (.querySelector urlbar ".urlbar-input-container") urlbar)
                              visible? (fn [el]
                                         (let [r (.getBoundingClientRect el)
                                               c (.getComputedStyle window el)]
                                           (and (> (.-width r) 0) (> (.-height r) 0)
                                                (not= (.-display c) "none")
                                                (not= (.-visibility c) "hidden"))))
                              ;; glyph of an element: an `iconsrc` attr (moz-button, e.g. the
                              ;; search-mode switcher's engine icon — a system blob:), else the
                              ;; first visible descendant (incl. open shadow root) that renders an
                              ;; image — <img src>, list-style / background / mask.
                              glyph-of (fn [el]
                                (let [isrc (or (.getAttribute el "iconsrc")
                                               (some-> (.querySelector el "[iconsrc]") (.getAttribute "iconsrc")))
                                      sr (.-shadowRoot el)
                                      cands (.concat (.from Array (.querySelectorAll el "*"))
                                                     (if sr (.from Array (.querySelectorAll sr "*")) [])
                                                     [el])
                                      hit (.find cands
                                            (fn [e]
                                              (and (visible? e)
                                                   (let [c (.getComputedStyle window e)]
                                                     (or (and (= (.-tagName e) "IMG") (.-src e) (not= (.-src e) ""))
                                                         (not= (.-listStyleImage c) "none")
                                                         (not= (.-backgroundImage c) "none")
                                                         (not= (.-maskImage c) "none"))))))]
                                  (cond
                                    (and isrc (not= isrc ""))
                                      {:css (str "background:url(\"" isrc "\") center/contain no-repeat;")}
                                    (not hit) nil
                                    :else
                                      (let [c (.getComputedStyle window hit)]
                                        (cond
                                          (and (= (.-tagName hit) "IMG") (.-src hit) (not= (.-src hit) ""))
                                            {:css (str "background:url(\"" (.-src hit) "\") center/contain no-repeat;")}
                                          (not= (.-listStyleImage c) "none")
                                            {:css (str "-moz-context-properties:fill;fill:" (.-fill c) ";"
                                                       "background:" (.-listStyleImage c) " center/contain no-repeat;")}
                                          (not= (.-backgroundImage c) "none")
                                            {:css (str "-moz-context-properties:fill;fill:" (.-fill c) ";"
                                                       "background:" (.-backgroundImage c) " center/contain no-repeat;")}
                                          :else
                                            {:css (str "background-color:" (.-color c) ";"
                                                       "mask:" (.-maskImage c) " center/contain no-repeat;"
                                                       "-webkit-mask:" (.-maskImage c) " center/contain no-repeat;")})))))
                              ;; input-box = the container's direct child holding the field (for
                              ;; slicing the leading icons); text-el = the actual .urlbar-input the
                              ;; text renders in (its left is where the URL text starts — the
                              ;; moz-input-box wrapper has ~26px of leading padding, so measuring
                              ;; the wrapper would shift the ghost text left of the real text).
                              input-box (.querySelector container "moz-input-box, .urlbar-input-box")
                              text-el (or (some-> window .-gURLBar .-inputField)
                                          (.querySelector urlbar ".urlbar-input")
                                          input-box)
                              input-left (if text-el
                                           (- (.-left (.getBoundingClientRect text-el)) (.-left rect))
                                           36)
                              kids (.from Array (.-children container))
                              input-idx (.indexOf kids input-box)
                              ;; EXCLUDE the search-mode switcher (2026-07-20): it's the
                              ;; engine-picker affordance and its `iconsrc` is the current
                              ;; engine's logo (Google), which showed up as a loud Google "G"
                              ;; in the frozen slot — clutter, not part of the resting identity.
                              ;; A frozen ghost is the security/identity icon(s) + the URL.
                              switcher? (fn [ch]
                                          (or (and (.-classList ch) (.contains (.-classList ch) "searchmode-switcher"))
                                              (.getAttribute ch "iconsrc")))
                              leading (.filter (if (>= input-idx 0) (.slice kids 0 input-idx) kids)
                                        (fn [ch] (and (visible? ch) (not (switcher? ch)))))
                              value (or (some-> window .-gURLBar .-value) "")
                              has-value? (not= (.trim value) "")
                              text-str (if has-value? value ph)]
                          (set! (.-id g) "gjoa-urlbar-ghost")
                          (attr! g "aria-hidden" "true")
                          (css! g (str "position:relative;display:block;box-sizing:border-box;padding:0;"
                                       "width:" (.-width rect) "px;height:" (.-height rect) "px;"
                                       "pointer-events:none;overflow:hidden;white-space:nowrap;"
                                       "border:" (.-border cs) ";border-radius:" (.-borderRadius cs) ";"
                                       "background:" (.-backgroundColor cs) ";"
                                       "font:" (.-font cs) ";color:" (.-color cs) ";"))
                          ;; one ghost icon per real visible leading icon, at its real x/width
                          (doseq [ch leading]
                            (let [r (.getBoundingClientRect ch)
                                  left (- (.-left r) (.-left rect))
                                  w (.-width r)
                                  gl (glyph-of ch)
                                  slot (html-new "div")]
                              (when gl
                                (css! slot (str "position:absolute;top:0;bottom:0;display:flex;"
                                                "align-items:center;justify-content:center;"
                                                "left:" left "px;width:" w "px;"))
                                (let [ic (html-new "div")]
                                  (css! ic (str "width:16px;height:16px;opacity:.9;" (.-css gl)))
                                  (.appendChild slot ic)
                                  (.appendChild g slot)))))
                          (set! (.-textContent txt) text-str)
                          (css! txt (str "position:absolute;top:0;bottom:0;display:flex;align-items:center;"
                                         "left:" input-left "px;right:8px;overflow:hidden;"
                                         "text-overflow:ellipsis;opacity:" (if has-value? ".95" ".55") ";"))
                          (.appendChild g txt)
                          (.appendChild parent g)
                          (set! (.-ghost state) g)))))
                  ;; #150b (2026-07-19): ARM opacity:0 (no transition) BEFORE the popover
                  ;; promotes to the top layer, then reveal on the next frame — so the
                  ;; float-in animation plays only from the settled centered geometry. The
                  ;; owner saw the bar flash ~40-100px off on the FIRST Ctrl+L of a session
                  ;; (cold popover-promotion paints one frame at the pre-promotion position);
                  ;; hiding until promoted makes that transient invisible by construction.
                  (attr! root "gjoa-urlbar-arming" "")
                  (attr! root "gjoa-urlbar-floating" "")
                  (attr! root "gjoa-urlbar-intent" attr-val)

                  (when (not (.-backdrop state))
                    (let [bd (html-new "div")]
                      (set! (.-id bd) "gjoa-urlbar-backdrop")
                      (on! bd "mousedown" #(deactivate-floating))
                      (.appendChild root bd)
                      (set! (.-backdrop state) bd)))

                  (ensure-hints)
                  (ensure-floating-promoted)
                  (install-heal)
                  ;; reveal once the popover has promoted + positioned (double-rAF); a
                  ;; setTimeout fallback covers a starved rAF (e.g. uncomposited window) so
                  ;; the bar can never get stuck invisible.
                  (let [reveal (fn [] (rmattr! root "gjoa-urlbar-arming"))]
                    (.requestAnimationFrame window
                      (fn [] (.requestAnimationFrame window reveal)))
                    (.setTimeout window reveal 120))))))

        is-floating #(.-activated state)

        on-focus-out (fn [e]
          (when (.-activated state)
            (setTimeout (fn []
              (when (.-activated state)
                (let [a (.-activeElement document)]
                  (when (not (bool (and a (or (= a urlbar) (.contains urlbar a)))))
                    (deactivate-floating)))))
              0)))

        handle-accel (fn [e]
          (let [accel (or (.-ctrlKey e) (.-metaKey e))]
            (when (and accel (not (.-shiftKey e)) (not (.-altKey e)))
              (let [k (.-key e)]
                (when (or (= k "j") (= k "k"))
                  (let [view (some-> window .-gURLBar .-view)]
                    (when (and view (.-selectBy view))
                      (.preventDefault e)
                      (.stopImmediatePropagation e)
                      (try (.selectBy view (if (= k "j") 1 -1))
                        (catch Any err
                          (log "selectBy:error" {:msg (String err)})))
                      true)))))))

        on-keydown (fn [e]
          (when (and (not (bool (handle-accel e))) (.-activated state))
              (cond
                (= (.-key e) "Escape")
                  (do
                    ;; We OWN the floating-palette dismiss. FF's UrlbarController
                    ;; Escape is a window-level BUBBLE listener that calls
                    ;; view.close() synchronously — with results showing that
                    ;; snaps the tall suggestion list shut BEFORE our fade even
                    ;; starts (the visible teardown jank). Our handler is
                    ;; capture-phase on #urlbar, so it runs first; stop the event
                    ;; here and FF never closes the view — the whole palette
                    ;; (input + results) fades as ONE unit.
                    (.preventDefault e)
                    (.stopImmediatePropagation e)
                    (deactivate-floating)
                    ;; Close the view + return focus to content AFTER the fade is
                    ;; visually done (opacity 0 by ~130ms) but BEFORE finish-teardown
                    ;; restores the resting geometry (150ms) — so the results
                    ;; neither snap early nor flash at the in-sidebar position. All
                    ;; of this happens behind opacity 0, invisibly.
                    (setTimeout (fn []
                      (try
                        (some-> window .-gURLBar .-view .close)
                        (let [a (.-activeElement document)]
                          (when (or (= a urlbar) (and a (.contains urlbar a)))
                            (some-> window .-gBrowser .-selectedBrowser .focus)))
                        (catch Any err
                          (log "escape:teardown-error" {:msg (String err)}))))
                      135))

                (= (.-key e) "Enter")
                  (do
                    (when (and (= (.-intent state) "newTab") (not (.-altKey e)))
                      (.preventDefault e)
                      (.stopImmediatePropagation e)
                      (log "intercept:newTab-enter")
                      (let [target (.-target e)]
                        (.dispatchEvent target (KeyboardEvent. "keydown"
                          {:key "Enter" :code "Enter" :keyCode 13 :which 13
                           :altKey true :bubbles true :cancelable true :view window}))))
                    (setTimeout deactivate-floating 0))

                :else nil)))

        on-activate-request (fn [e]
          (let [detail (.-detail e)]
            (activate-floating
              (if (and detail (= (.-intent detail) "newTab")) "newTab" "current"))))

        on-deactivate-request #(deactivate-floating)]

    (onc! urlbar "focusout" on-focus-out)
    (onc! urlbar "keydown" on-keydown)
    (on! document "gjoa-urlbar-activate" on-activate-request)
    (on! document "gjoa-urlbar-deactivate" on-deactivate-request)

    {:activateFloating activate-floating
     :deactivateFloating deactivate-floating
     :isFloating is-floating
     :destroy (fn []
       (offc! urlbar "focusout" on-focus-out)
       (offc! urlbar "keydown" on-keydown)
       (off! document "gjoa-urlbar-activate" on-activate-request)
       (off! document "gjoa-urlbar-deactivate" on-deactivate-request)
       ;; deactivate-floating's teardown is async (fade → transitionend), so detach the
       ;; watchdog here too or a hot-reload stacks observers on the next bundle.
       (when (.-healObs state)
         (.disconnect (.-healObs state))
         (set! (.-healObs state) nil))
       (when (.-healFn state)
         (off! urlbar "toggle" (.-healFn state))
         (set! (.-healFn state) nil))
       (deactivate-floating))})))
