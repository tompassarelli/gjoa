#lang beagle/js
(ns gjoa.drawer.urlbar
  (:require [gjoa.macros :refer [q by-id html-new htm xul-id attr! on! onc! offc! off! bool has? rmattr! css!]]
            [gjoa.tabs.log :refer [create-logger!]]))

(declare-extern [document window String] Any)

;; The floating palette's hint footer, and the ONLY place its text is written.
;; Must stay a projection of handle-accel below: ctrl+j → selectBy(+1) = DOWN,
;; ctrl+k → selectBy(-1) = UP (vim convention), Escape → deactivate-floating.
(def FLOATING-HINTS Any
  [{:key "ctrl+j" :act "down"}
   {:key "ctrl+k" :act "up"}
   {:key "esc"    :act "exit"}])

(js/export (defn make-urlbar! [deps Any] Any
  (let [urlbar Any (js/get deps .urlbar)
        root Any (js/get document .documentElement)
        log Any (create-logger! "urlbar")
        state Any {:activated false :intent "current" :backdrop nil :ghost nil :hints nil
               :healObs nil :healFn nil
               :urlbarH0 "" :containerH0 "" :stage nil :home nil
               :popover0 nil :pinObs nil}

        intent-attr (Fn [Any] Any) (fn [%1 Any] Any (if (= %1 "newTab") "new-tab" "current"))

        ;; #urlbar-container — NOT `parentNode`, which is the stage while floating.
        container (Fn [] Any) (fn [] Any
          (or (some-> (js/get state .home) (js/get .parent)) (js/get urlbar .parentNode)))

        ;; Append the hint footer as #urlbar's LAST child so it lands below
        ;; .urlbarView (the results list). Idempotent — the re-arm path calls it
        ;; too, since a stale node can be orphaned by a raced teardown.
        ensure-hints (Fn [] Any) (fn [] Any
          (when (not (bool (some-> (js/get state .hints) (js/get .isConnected))))
            (let [el Any (html-new "div")]
              (js/set! el .id "gjoa-urlbar-hints")
              (attr! el "aria-hidden" "true")
              (js/call FLOATING-HINTS .forEach (fn [h Any] Any
                (let [pair Any (htm "span" "gjoa-urlbar-hint")
                      k Any (htm "span" "gjoa-urlbar-hint-key")
                      a Any (htm "span" "gjoa-urlbar-hint-act")]
                  (js/set! k .textContent (js/get h .key))
                  (js/set! a .textContent (js/get h .act))
                  (js/call pair .appendChild k)
                  (js/call pair .appendChild a)
                  (js/call el .appendChild pair))))
              (js/call urlbar .appendChild el)
              (js/set! state .hints el))))

        ;; WINDOW-GLOBAL STAGE: documentElement is the only ancestor whose fixed
        ;; containing block is the viewport AND whose stacking context is above the
        ;; content deck — so the palette is centred and painted over the page by DOM
        ;; POSITION, not by the top-layer promotion (which Firefox evicts at will).
        ;; A <toolbar>, not a <div>: reparenting re-runs UrlbarInput's
        ;; connectedCallback, which sets `#allowBreakout = !!this.closest("toolbar")`
        ;; — under a plain div that goes false and #stopBreakout() permanently kills
        ;; [breakout]/[breakout-extend], so the palette never expands for its results.
        ensure-stage! (Fn [] Any) (fn [] Any
          (when (not (bool (some-> (js/get state .stage) (js/get .isConnected))))
            (let [el Any (xul-id "toolbar" "gjoa-urlbar-stage")]
              (attr! el "customizable" "false")
              (js/call root .appendChild el)
              (js/set! state .stage el)))
          (js/get state .stage))

        ;; Idempotent: records the home slot only on the move that actually leaves it,
        ;; so a re-summon or a heal can call this without clobbering the restore target.
        ;; `identical?` / `.contains`, never `=`: beagle's `=` is STRUCTURAL, and two
        ;; DOM nodes both have zero own enumerable keys, so `=` is true for any pair.
        ensure-staged! (Fn [] Any) (fn [] Any
          (let [st Any (ensure-stage!)]
            (when (not (bool (js/call st .contains urlbar)))
              (js/set! state .home {:parent (js/get urlbar .parentNode)
                                    :next (js/get urlbar .nextSibling)})
              (js/call st .appendChild urlbar))))

        restore-home! (Fn [] Any) (fn [] Any
          (let [h Any (js/get state .home)]
            (when h
              (js/set! state .home nil)
              (let [p Any (js/get h .parent)
                    n Any (js/get h .next)]
                (when p
                  (if (and n (identical? (js/get n .parentNode) p))
                    (js/call p .insertBefore urlbar n)
                    (js/call p .appendChild urlbar)))))))

        ;; HORIZONTAL ONLY. In the drawer the row height is a CSS constant gjoa owns
        ;; (`#gjoa-urlbar-toolbar #urlbar-container`); the nav-bar row has no such
        ;; constant, and Firefox's post-teardown measure lands on a frame with
        ;; [breakout] off the container — no in-flow child — so it latches the
        ;; collapsed box as the row height. One correction, then Firefox owns it again.
        pin-container-height! (Fn [Any Any] Any) (fn [c Any
                                                    want Any] Any
                                                   (when (js/get state .pinObs)
            (js/call (js/get state .pinObs) .disconnect)
            (js/set! state .pinObs nil))
          (when (and c (not= want ""))
            (let [obs Any (js/new MutationObserver
                        (fn [] Any
                          (when (not= (js/call (js/get c .style) .getPropertyValue "--urlbar-container-height")
                                      want)
                            (js/call obs .disconnect)
                            (js/set! state .pinObs nil)
                            (js/call (js/get c .style) .setProperty "--urlbar-container-height" want))))]
              (js/call obs .observe c {:attributes true :attributeFilter ["style"]})
              (js/set! state .pinObs obs)
              (js/call window .setTimeout
                (fn [] Any (when (identical? (js/get state .pinObs) obs)
                         (js/call obs .disconnect)
                         (js/set! state .pinObs nil)))
                1000))))

        ;; [popover] is Firefox's own markup on #urlbar and UrlbarInput calls
        ;; showPopover() unconditionally, but gjoa removes the attr to demote the bar
        ;; out of the top layer — so the promotion must no-op while demoted rather
        ;; than throw NotSupportedError and abort the rest of that frame's work.
        install-popover-shim! (Fn [] Any) (fn [] Any
          (when (not (js/get urlbar .gjoaPopoverShim))
            (let [native Any (js/get urlbar .showPopover)]
              (when native
                (js/set! urlbar .gjoaPopoverShim true)
                (js/set! urlbar .showPopover
                  (fn [] Any (when (has? urlbar "popover") (js/call native .call urlbar))))))))

        ;; #149 ATOMIC TEARDOWN. The naive teardown removed `gjoa-urlbar-floating`
        ;; synchronously, which instantly reverted the urlbar from the centered
        ;; position:fixed palette back to its resting in-sidebar INLINE box — that
        ;; geometry-restore frame was visible ("spazzes out" as a small inline
        ;; search box flashes in the sidebar) before the bar/ghost were gone.
        ;; Fix ordering: (1) set `gjoa-urlbar-teardown` → CSS instantly opacity:0's
        ;; the floating bar + backdrop with NO transition; (2) next animation frame
        ;; (after the hidden frame paints) actually remove the floating attrs and
        ;; tear down backdrop/ghost/popover behind the now-invisible box. So the
        ;; inline-restore reflow never paints.
        finish-teardown (Fn [] Any) (fn [] Any
          ;; Bail if a re-summon raced in before this frame fired — activate-floating
          ;; set activated=true + re-added the floating attrs, so tearing down now
          ;; would clobber the fresh activation. Leave it fully armed.
          (when (not (js/get state .activated))
            ;; Detach the top-layer watchdog FIRST — teardown deliberately hides the
            ;; popover and drops the floating attrs, and a live heal would fight it.
            (when (js/get state .healObs)
              (js/call (js/get state .healObs) .disconnect)
              (js/set! state .healObs nil))
            (when (js/get state .healFn)
              (off! urlbar "toggle" (js/get state .healFn))
              (js/set! state .healFn nil))
            ;; HIDE THE POPOVER FIRST, in EVERY mode (not just compact) — the
            ;; floating palette ALWAYS showPopover()s the urlbar into the top layer,
            ;; so a dismiss must take it back OUT or the resting urlbar stays a
            ;; :popover-open top-layer element hovering over its now-empty sidebar
            ;; slot: the "visual artifact on exit". (Previously gated on compact-on,
            ;; so non-compact never released it — verified popoverOpen=true post-
            ;; teardown.) Do it while the box is still invisible (teardown opacity:0)
            ;; and BEFORE dropping the floating/teardown attrs, so the urlbar returns
            ;; to normal in-flow (position:static) and paints its resting state in ONE
            ;; settled frame. Skip only when a click-to-expand (breakout-extend) raced
            ;; in — that owns the popover and must not be clobbered.
            ;; RETURN FOCUS TO CONTENT first: a non-Escape dismiss (backdrop / focus-out)
            ;; leaves the urlbar FOCUSED, and FF re-expands a focused resting urlbar into
            ;; breakout-extend (empty bar at the slot with top-sites results showing) — the
            ;; janky teardown residue the owner hit. Blurring to content collapses it. The
            ;; backdrop intercepts every click while floating, so a genuine click-to-expand
            ;; cannot race here; leftover focus is the ONLY source of breakout-extend at
            ;; teardown, so close the view + hide the popover + clear breakout unconditionally.
            (try
              (let [a Any (js/get document .activeElement)]
                (when (and a (or (identical? a urlbar) (js/call urlbar .contains a)))
                  ;; announce the hand-off: the init-window focus guard rescues any
                  ;; content-focus taken while the palette is up, this one included.
                  (some-> window (js/get .gjoaFocusGuard) (js/call .release))
                  (some-> window (js/get .gBrowser) (js/get .selectedBrowser) (js/call .focus))))
              ;; Un-stage FIRST: everything below writes through `parentNode`/`container`
              ;; and must see the real #urlbar-container. Still behind the teardown
              ;; opacity:0 + the floating attrs, so the in-flow restore never paints
              ;; (the #149/#150 ordering).
              (restore-home!)
              (some-> window (js/get .gURLBar) (js/get .view) (js/call .close))
              (when (and (js/call urlbar .matches ":popover-open") (js/get urlbar .hidePopover))
                (js/call urlbar .hidePopover))
              ;; RESTORE the pre-summon promotion, never strip unconditionally: gjoa does
              ;; not own [popover] — drawer/compact promotes the resting bar whenever
              ;; compact is off (the steady state in horizontal tabs) and leaves it
              ;; demoted when compact is on.
              (if (= (js/get state .popover0) "manual")
                (do (attr! urlbar "popover" "manual")
                    (when (and (not (bool (js/call urlbar .matches ":popover-open")))
                               (js/get urlbar .showPopover))
                      (js/call urlbar .showPopover)))
                (rmattr! urlbar "popover"))
              (rmattr! urlbar "breakout-extend")
              ;; [breakout] stays Firefox's: #updateLayoutBreakoutDimensions strips it and
              ;; re-adds a frame later, so any snapshot taken by a focusing summon reads a
              ;; transient "off". Only the height vars below are ours to undo — we caused
              ;; those writes by parking #urlbar on the viewport-sized stage.
              (if (= (js/get state .urlbarH0) "")
                (js/call (js/get urlbar .style) .removeProperty "--urlbar-height")
                (js/call (js/get urlbar .style) .setProperty "--urlbar-height" (js/get state .urlbarH0)))
              (when (js/get urlbar .parentNode)
                (if (= (js/get state .containerH0) "")
                  (js/call (js/get (js/get urlbar .parentNode) .style) .removeProperty
                                   "--urlbar-container-height")
                  (js/call (js/get (js/get urlbar .parentNode) .style) .setProperty
                                "--urlbar-container-height" (js/get state .containerH0)))
                (pin-container-height! (js/get urlbar .parentNode) (js/get state .containerH0)))
              (catch (e Any)
                (log "finishTeardown:collapse-error" {:msg (String e)})))
            ;; #150: suppress urlbar transitions for the restore frame so the resting
            ;; geometry reverts INSTANTLY (matching the ghost look-alike) instead of
            ;; retracting through the breakout-extend width transition while opacity
            ;; restores to 1 — the "deformity after Enter" the cage frame-monitor caught.
            (attr! root "gjoa-urlbar-snap" "")
            (rmattr! root "gjoa-urlbar-floating")
            (rmattr! root "gjoa-urlbar-intent")
            (rmattr! root "gjoa-urlbar-teardown")
            (rmattr! root "gjoa-urlbar-arming")
            (when (js/get state .backdrop)
              (js/call (js/get state .backdrop) .remove)
              (js/set! state .backdrop nil))
            (when (js/get state .ghost)
              (js/call (js/get state .ghost) .remove)
              (js/set! state .ghost nil))
            (when (js/get state .hints)
              (js/call (js/get state .hints) .remove)
              (js/set! state .hints nil))
            (when (js/get state .stage)
              (js/call (js/get state .stage) .remove)
              (js/set! state .stage nil))
            ;; release the snap after the instant revert has painted (double-rAF: frame
            ;; one applies the snapped resting layout, frame two re-enables transitions
            ;; so later focus/expand animations still work).
            (js/call window .requestAnimationFrame
              (fn [] Any (js/call window .requestAnimationFrame
                       (fn [] Any (rmattr! root "gjoa-urlbar-snap")))))))

        deactivate-floating (Fn [] Any) (fn [] Any
          (when (js/get state .activated)
            (js/set! state .activated false)
            (log "deactivateFloating")
            ;; Fade the floating bar/backdrop out (CSS transition on the teardown
            ;; attr, ~130ms), then restore resting geometry AFTER the fade so the
            ;; inline-restore reflow paints behind the now-invisible box — smooth
            ;; close, no inline-sidebar flash. Matched to the 130ms CSS transition
            ;; (+ small buffer). A re-summon within the window clears teardown and
            ;; finish-teardown bails (guards on activated).
            (attr! root "gjoa-urlbar-teardown" "")
            ;; #150: fire finish-teardown when the opacity fade ACTUALLY completes
            ;; (transitionend on #urlbar's opacity), not on a guessed 150ms timer that
            ;; raced the fade — firing early restored the resting geometry while the box
            ;; was still visible (the retraction-through-the-tab-row deformity). One-shot
            ;; guard + removeEventListener; a fallback timer covers reduced-motion
            ;; (transition:none → no transitionend) and any dropped event.
            (let [h Any {:done false :f nil}
                  fire (Fn [Any] Any) (fn [e Any] Any
                         (when (and (not (js/get h .done))
                                    (or (not e)
                                        ;; `identical?`: transitionend BUBBLES, so a descendant's
                                        ;; opacity fade must not fire the palette's teardown.
                                        (and (identical? (js/get e .target) urlbar)
                                             (= (js/get e .propertyName) "opacity"))))
                           (js/set! h .done true)
                           (try (js/call urlbar .removeEventListener "transitionend" (js/get h .f))
                                (catch (_ Any) nil))
                           (finish-teardown)))]
              (js/set! h .f fire)
              (js/call urlbar .addEventListener "transitionend" fire)
              (js/call window .setTimeout (fn [] Any (fire nil)) 260))))

        ;; SINGLE OWNER of the top-layer promotion. Belt-and-braces since the stage
        ;; above owns centring + paint order; this only restores the [breakout] pair
        ;; (what makes .urlbar-background / .urlbarView render at all) and re-promotes.
        ensure-floating-promoted (Fn [] Any) (fn [] Any
          (try
            (when (not (has? urlbar "breakout"))
              (attr! urlbar "breakout" "true"))
            (let [c Any (container)]
              (when (and c (not (has? c "breakout")))
                (attr! c "breakout" "true")))
            (when (not= (js/call urlbar .getAttribute "popover") "manual")
              (attr! urlbar "popover" "manual"))
            (when (and (not (bool (js/call urlbar .matches ":popover-open"))) (js/get urlbar .showPopover))
              (js/call urlbar .showPopover))
            (catch (e Any)
              (log "activateFloating:promote-error" {:msg (String e)})))
          ;; SEPARATE catch: sharing one with the promotion meant a showPopover throw
          ;; also skipped the focus, leaving a visible palette that swallowed typing.
          (try
            (some-> window (js/get .gURLBar) (js/call .focus))
            (some-> window (js/get .gURLBar) (js/call .select))
            (catch (e Any)
              (log "activateFloating:focus-error" {:msg (String e)}))))

        ;; TOP-LAYER WATCHDOG: gjoa does not own `popover` on #urlbar — UrlbarInput's
        ;; #stopBreakout() evicts it (modal blocker, layout-breakout re-measure, urlbar
        ;; reparenting), so a one-shot promotion cannot hold. Re-assert on every popover
        ;; `toggle` and on any [popover]/[breakout] write.
        heal (Fn [] Any) (fn [] Any
          (when (and (js/get state .activated)
                     (has? root "gjoa-urlbar-floating")
                     (not (has? root "gjoa-urlbar-teardown")))
            ;; A modal dialog raises the blocker deliberately; dismiss rather than heal.
            ;; [window-modal-open] lands AFTER the increment, so gate on `.open` too.
            (if (or (bool (some-> (by-id "window-modal-dialog") (js/get .open)))
                    (has? root "window-modal-open"))
              (do (log "heal:modal-dismiss")
                  (deactivate-floating))
              (when (not (and (bool (js/call urlbar .matches ":popover-open"))
                              (has? urlbar "breakout")))
                (log "heal:re-promote"
                     {:popoverOpen (bool (js/call urlbar .matches ":popover-open"))
                      :breakout (has? urlbar "breakout")})
                (ensure-staged!)
                (ensure-floating-promoted)))))

        install-heal (Fn [] Any) (fn [] Any
          (when (not (js/get state .healFn))
            (js/set! state .healFn heal)
            (on! urlbar "toggle" heal))
          (when (not (js/get state .healObs))
            (let [obs Any (js/new MutationObserver heal)]
              (js/call obs .observe urlbar
                {:attributes true :attributeFilter ["popover" "breakout"]})
              (js/set! state .healObs obs))))

        activate-floating (Fn [Any] Any) (fn [new-intent Any] Any
          (js/set! state .intent new-intent)
          ;; If a prior dismiss is still mid-teardown (teardown attr set, rAF
          ;; pending), a quick re-summon must clear it so the bar isn't stuck
          ;; opacity:0. The pending finish-teardown is then a near-no-op (attrs
          ;; already re-set by activate; it only re-removes the stale teardown
          ;; attr, which activate cleared anyway).
          (rmattr! root "gjoa-urlbar-teardown")
          (let [attr-val Any (intent-attr (js/get state .intent))]
            (if (js/get state .activated)
              (do (log "activateFloating:re-arm" {:intent (js/get state .intent)})
                  (attr! root "gjoa-urlbar-intent" attr-val)
                  ;; SELF-HEAL (2026-07-20): `activated` is a flag that can DESYNC from the
                  ;; real DOM state — the `popover` attr (what puts the palette in the top
                  ;; layer so it escapes the sidebar's transformed stacking context) is also
                  ;; written by compact.bjs's observer and by teardown, so it can be pulled
                  ;; out from under us while `activated` stays true. Without re-asserting it,
                  ;; a re-summon leaves the palette OUT of the top layer, positioned by its
                  ;; containing block (the compact sidebar) → clipped under the page content.
                  ;; Owner correctly called this a state-management failure, not a compositor
                  ;; bug. Re-assert the promotion here so every summon lands in the top layer.
                  (ensure-hints)
                  (ensure-staged!)
                  (ensure-floating-promoted))
              (do (js/set! state .activated true)
                  (log "activateFloating" {:intent (js/get state .intent)})
                  ;; Snapshot the resting geometry Firefox re-measures off the FLOATING box
                  ;; while we hold it, plus who owned the promotion (compact leaves none).
                  ;; `home` non-nil ⇒ still staged from an unfinished teardown, so these
                  ;; would capture the PALETTE's geometry as the resting geometry.
                  (when (nil? (js/get state .home))
                    (let [c Any (container)]
                      (js/set! state .urlbarH0
                            (js/call (js/get urlbar .style) .getPropertyValue "--urlbar-height"))
                      (js/set! state .containerH0
                            (if c
                              (js/call (js/get c .style) .getPropertyValue "--urlbar-container-height")
                              ""))
                      ;; the ATTR, never `:popover-open`: #stopBreakout hidePopover()s on
                      ;; every focus, so the open state reads a transient false here.
                      (js/set! state .popover0 (js/call urlbar .getAttribute "popover"))))
                  ;; Leave a static look-alike (#gjoa-urlbar-ghost) in the resting
                  ;; slot so the real urlbar lifting to the centered palette doesn't
                  ;; collapse the slot / look like the bar "flew out" — the resting
                  ;; bar visually STAYS put. Capture the resting box FIRST, before
                  ;; the floating attr takes it position:fixed.
                  ;; Leave a static look-alike (#gjoa-urlbar-ghost) in the resting slot
                  ;; so the real urlbar lifting to the palette doesn't leave an empty
                  ;; box — the slot reads as the still urlbar (owner: "should still show
                  ;; identity icon + placeholder … frozen"). NOT a cloneNode of #urlbar:
                  ;; the input lives in a shadow root, which cloneNode does NOT copy, so
                  ;; a clone renders as a hollow box with the placeholder spilling out.
                  ;; Instead build a plain styled div — shield glyph + placeholder text —
                  ;; sized/bordered to match the resting bar. Captured BEFORE the floating
                  ;; attr so the box metrics are the true resting ones.
                  ;; `home` nil for the same reason as the snapshot above: mid-teardown
                  ;; the "resting" rect this copies is the floating palette's.
                  ;; FAIL-SAFE: this runs BEFORE the stage/backdrop/floating attrs, so a
                  ;; throw would abort activation with `activated` already true — the
                  ;; urlbar left neither floated nor dismissable. A missing ghost is cosmetic.
                  (when (and (not (js/get state .ghost)) (nil? (js/get state .home)))
                   (try
                    (let [parent Any (container)]
                      (when parent
                        (let [rect Any (js/call urlbar .getBoundingClientRect)
                              cs Any (js/call window .getComputedStyle urlbar)
                              g Any (html-new "div")
                              txt Any (html-new "div")
                              ph Any (or (some-> window (js/get .gURLBar) (js/get .inputField) (js/get .placeholder))
                                     "Search with Google or enter address")
                              ;; #150c (2026-07-20): FREEZE the resting bar EXACTLY. The ghost
                              ;; fills the slot the instant the real urlbar lifts to float, so
                              ;; ANY difference reads as a swap. Two things the owner still saw
                              ;; wrong: (1) it showed the PLACEHOLDER instead of the loaded
                              ;; page's URL, and (2) it drew ONE plain shield where the resting
                              ;; bar shows several icons (search-mode switcher + trust/identity).
                              ;; Fix: text = the REAL resting value (gURLBar.value; placeholder
                              ;; only when the bar is truly empty), and reproduce EVERY visible
                              ;; leading icon at its real x by copying its rendered glyph —
                              ;; piercing shadow roots + honouring <img src> (the moz-button
                              ;; switcher renders its glyph in a shadow root, so light-DOM-only
                              ;; copying missed it, and cloneNode drops custom elements + un-hides
                              ;; state-hidden buttons; both verified in cage).
                              container Any (or (js/call urlbar .querySelector ".urlbar-input-container") urlbar)
                              visible? (Fn [Any] Any) (fn [el Any] Any
                                         (let [r Any (js/call el .getBoundingClientRect)
                                               c Any (js/call window .getComputedStyle el)]
                                           (and (> (js/get r .width) 0) (> (js/get r .height) 0)
                                                (not= (js/get c .display) "none")
                                                (not= (js/get c .visibility) "hidden"))))
                              ;; every node that can paint inside a leading child: its own light
                              ;; DOM plus its OPEN shadow root (moz-button renders the engine icon
                              ;; and the pill background in there).
                              inner-nodes (Fn [Any] Any) (fn [el Any] Any
                                (let [sr Any (js/get el .shadowRoot)]
                                  (js/call (js/call (Array/from (js/call el .querySelectorAll "*")) .concat
                                                    (if sr (Array/from (js/call sr .querySelectorAll "*")) [])) .filter
                                           visible?)))
                              ;; `contains` does not cross the shadow boundary, so ask the root too.
                              inside? (Fn [Any Any] Any) (fn [host Any
                                                            n Any] Any
                                                           (or (bool (js/call host .contains n))
                                    (bool (some-> (js/get host .shadowRoot) (js/call .contains n)))))
                              ;; url("…") out of a computed `content` — the chip's chevron paints
                              ;; that way, with no background/list-style/mask to copy.
                              content-url (Fn [Any] Any) (fn [c Any] Any
                                (let [m Any (js/call (js/new RegExp "url\\(\"?([^\")]+)\"?\\)") .exec (or (js/get c .content) ""))]
                                  (if m (aget m 1) nil)))
                              ;; CSS that repaints ONE element's glyph: an `iconsrc` attr
                              ;; (moz-button, e.g. the search-mode switcher's engine icon — a
                              ;; system blob:), an <img src>, or a computed content /
                              ;; list-style / background / mask image. nil = paints nothing.
                              glyph-of (Fn [Any] Any) (fn [el Any] Any
                                (let [c Any (js/call window .getComputedStyle el)
                                      isrc Any (js/call el .getAttribute "iconsrc")
                                      curl Any (content-url c)
                                      ;; the chrome document is XHTML — `tagName` keeps the
                                      ;; authored lowercase, so an "IMG" compare never matches.
                                      src Any (if (= (js/get el .localName) "img") (js/get el .src) nil)]
                                  (cond
                                    (and isrc (not= isrc ""))
                                      {:css (str "background:url(\"" isrc "\") center/contain no-repeat;")}
                                    (and src (not= src ""))
                                      {:css (str "background:url(\"" src "\") center/contain no-repeat;")}
                                    curl
                                      {:css (str "-moz-context-properties:fill;fill:" (js/get c .fill) ";"
                                                 "background:url(\"" curl "\") center/contain no-repeat;")}
                                    (not= (js/get c .listStyleImage) "none")
                                      {:css (str "-moz-context-properties:fill;fill:" (js/get c .fill) ";"
                                                 "background:" (js/get c .listStyleImage) " center/contain no-repeat;")}
                                    (not= (js/get c .backgroundImage) "none")
                                      {:css (str "-moz-context-properties:fill;fill:" (js/get c .fill) ";"
                                                 "background:" (js/get c .backgroundImage) " center/contain no-repeat;")}
                                    (not= (js/get c .maskImage) "none")
                                      {:css (str "background-color:" (js/get c .color) ";"
                                                 "mask:" (js/get c .maskImage) " center/contain no-repeat;"
                                                 "-webkit-mask:" (js/get c .maskImage) " center/contain no-repeat;")}
                                    :else nil)))
                              ;; text this element renders ITSELF (direct text nodes only, so a
                              ;; wrapper doesn't restate its children's label).
                              own-text (Fn [Any] Any) (fn [el Any] Any
                                (js/call (js/call (js/call (js/call (Array/from (js/get el .childNodes)) .filter
                                                             (fn [n Any] Any (= (js/get n .nodeType) 3))) .map
                                                    (fn [n Any] Any (js/get n .textContent))) .join
                                              "") .trim))
                              ;; The rendered parts of a leading child, each at its own rect — the
                              ;; search-mode chip is compound (icon + chevron + name + exit), so one
                              ;; centred glyph cannot stand in for it. Innermost painter wins, or a
                              ;; host forwarding `iconsrc` to a shadow <img> paints twice.
                              parts-of (Fn [Any] Any) (fn [el Any] Any
                                (let [nodes Any (inner-nodes el)
                                      painter? (Fn [Any] Any) (fn [n Any] Any (bool (glyph-of n)))
                                      leaf-glyph? (Fn [Any] Any) (fn [n Any] Any
                                        (and (painter? n)
                                             (not (bool (js/call nodes .some
                                                          (fn [m Any] Any (and (not= m n)
                                                                       (inside? n m)
                                                                       (painter? m))))))))
                                      out (Vec Any) []]
                                  (js/call nodes .forEach (fn [n Any] Any
                                    (let [t Any (own-text n)]
                                      (cond
                                        (leaf-glyph? n)
                                          (js/call out .push {:el n :css (js/get (glyph-of n) .css)})
                                        (not= t "")
                                          (let [c Any (js/call window .getComputedStyle n)]
                                            (js/call out .push {:el n :text t
                                                        :css (str "font:" (js/get c .font) ";color:" (js/get c .color) ";"
                                                                  "white-space:nowrap;overflow:hidden;")}))
                                        :else nil))))
                                  ;; nothing inside painted → the child paints its own glyph
                                  (when (= (js/get out .length) 0)
                                    (let [g Any (glyph-of el)]
                                      (when g (js/call out .push {:el el :css (js/get g .css)}))))
                                  out))
                              ;; A chip's PILL: moz-button paints its background on a shadow
                              ;; <span class="button-background">, not on the host, so take the
                              ;; box chrome from whichever element actually fills the child's box.
                              opaque? (Fn [Any] Any) (fn [col Any] Any (and col (not= col "transparent")
                                                     (not (js/call col .includes ", 0)"))))
                              box-chrome (Fn [Any Any] Any) (fn [ch Any
                                                               r Any] Any
                                                              (let [hit Any (js/call (js/call [ch] .concat (inner-nodes ch)) .find
                                            (fn [n Any] Any
                                              (let [nr Any (js/call n .getBoundingClientRect)
                                                    c Any (js/call window .getComputedStyle n)
                                                    nw Float (js/get nr .width)
                                                    nh Float (js/get nr .height)
                                                    rw Float (js/get r .width)
                                                    rh Float (js/get r .height)]
                                                (and (< (Math/abs (- nw rw)) 2)
                                                     (< (Math/abs (- nh rh)) 2)
                                                     (bool (opaque? (js/get c .backgroundColor)))))))]
                                  (if hit
                                    (let [c Any (js/call window .getComputedStyle hit)]
                                      (str "background:" (js/get c .backgroundColor) ";"
                                           "border-radius:" (js/get c .borderRadius) ";"))
                                    "")))
                              ;; input-box = the container's direct child holding the field (for
                              ;; slicing the leading icons); text-el = the actual .urlbar-input the
                              ;; text renders in (its left is where the URL text starts — the
                              ;; moz-input-box wrapper has ~26px of leading padding, so measuring
                              ;; the wrapper would shift the ghost text left of the real text).
                              input-box Any (js/call container .querySelector "moz-input-box, .urlbar-input-box")
                              text-el Any (or (some-> window (js/get .gURLBar) (js/get .inputField))
                                          (js/call urlbar .querySelector ".urlbar-input")
                                          input-box)
                              rect-left Float (js/get rect .left)
                              input-left Any (if text-el
                                           (let [text-left Float (js/get (js/call text-el .getBoundingClientRect) .left)]
                                             (- text-left rect-left))
                                           36)
                              kids Any (Array/from (js/get container .children))
                              input-idx Any (js/call kids .indexOf input-box)
                              ;; EVERY visible leading child, search-mode switcher included — the
                              ;; resting bar shows that chip, so a ghost without it reads as the
                              ;; engine icon vanishing the instant the palette floats.
                              leading Any (js/call (if (>= input-idx 0) (js/call kids .slice 0 input-idx) kids) .filter
                                            visible?)
                              value Any (or (some-> window (js/get .gURLBar) (js/get .value)) "")
                              has-value? Any (not= (js/call value .trim) "")
                              text-str Any (if has-value? value ph)]
                          (js/set! g .id "gjoa-urlbar-ghost")
                          (attr! g "aria-hidden" "true")
                          ;; LAYOUT-NEUTRAL like the bar it replaces (`.urlbar[breakout]` is
                          ;; absolute): an in-flow stand-in would hand the container content
                          ;; height it never had — the nav-bar row's height in horizontal.
                          ;; No offsets + inserted in the urlbar's own DOM slot below ⇒ its
                          ;; static position IS the urlbar's.
                          (css! g (str "position:absolute;display:block;box-sizing:border-box;padding:0;"
                                       "width:" (js/get rect .width) "px;height:" (js/get rect .height) "px;"
                                       "pointer-events:none;overflow:hidden;white-space:nowrap;"
                                       "border:" (js/get cs .border) ";border-radius:" (js/get cs .borderRadius) ";"
                                       "background:" (js/get cs .backgroundColor) ";"
                                       "font:" (js/get cs .font) ";color:" (js/get cs .color) ";"))
                          ;; one ghost slot per visible leading child, at its real box, holding a
                          ;; still copy of every part that child actually paints (at ITS real box,
                          ;; not centred — a compound chip's icon is not at the chip's centre).
                          (doseq [ch Any leading]
                            (let [r Any (js/call ch .getBoundingClientRect)
                                  r-left Float (js/get r .left)
                                  r-top Float (js/get r .top)
                                  rect-top Float (js/get rect .top)
                                  parts Any (parts-of ch)
                                  slot Any (html-new "div")]
                              (when (> (js/get parts .length) 0)
                                (css! slot (str "position:absolute;box-sizing:border-box;"
                                                "left:" (- r-left rect-left) "px;"
                                                "top:" (- r-top rect-top) "px;"
                                                "width:" (js/get r .width) "px;height:" (js/get r .height) "px;"
                                                (box-chrome ch r)))
                                (doseq [p Any parts]
                                  (let [pr Any (js/call (js/get p .el) .getBoundingClientRect)
                                        pr-left Float (js/get pr .left)
                                        pr-top Float (js/get pr .top)
                                        ic Any (html-new "div")]
                                    (css! ic (str "position:absolute;box-sizing:border-box;"
                                                  "left:" (- pr-left r-left) "px;"
                                                  "top:" (- pr-top r-top) "px;"
                                                  "width:" (js/get pr .width) "px;height:" (js/get pr .height) "px;"
                                                  "opacity:.9;" (js/get p .css)))
                                    (when (js/get p .text) (js/set! ic .textContent (js/get p .text)))
                                    (js/call slot .appendChild ic)))
                                (js/call g .appendChild slot))))
                          (js/set! txt .textContent text-str)
                          (css! txt (str "position:absolute;top:0;bottom:0;display:flex;align-items:center;"
                                         "left:" input-left "px;right:8px;overflow:hidden;"
                                         "text-overflow:ellipsis;opacity:" (if has-value? ".95" ".55") ";"))
                          (js/call g .appendChild txt)
                          (js/call parent .insertBefore g urlbar)
                          (js/set! state .ghost g))))
                    (catch (e Any)
                      (log "activateFloating:ghost-error" {:msg (String e)}))))
                  ;; #150b (2026-07-19): ARM opacity:0 (no transition) BEFORE the popover
                  ;; promotes to the top layer, then reveal on the next frame — so the
                  ;; float-in animation plays only from the settled centered geometry. The
                  ;; owner saw the bar flash ~40-100px off on the FIRST Ctrl+L of a session
                  ;; (cold popover-promotion paints one frame at the pre-promotion position);
                  ;; hiding until promoted makes that transient invisible by construction.
                  (attr! root "gjoa-urlbar-arming" "")
                  (attr! root "gjoa-urlbar-floating" "")
                  (attr! root "gjoa-urlbar-intent" attr-val)

                  (when (not (js/get state .backdrop))
                    (let [bd Any (html-new "div")]
                      (js/set! bd .id "gjoa-urlbar-backdrop")
                      (on! bd "mousedown" (fn [] Any (deactivate-floating)))
                      (js/call root .appendChild bd)
                      (js/set! state .backdrop bd)))

                  ;; After the ghost capture (which needs the TRUE resting rect) and
                  ;; behind [gjoa-urlbar-arming]'s opacity:0, so the move never paints.
                  (ensure-staged!)
                  (ensure-hints)
                  ;; focus/select inside re-runs here: reparenting blurs the field.
                  (ensure-floating-promoted)
                  (install-heal)
                  ;; reveal once the popover has promoted + positioned (double-rAF); a
                  ;; setTimeout fallback covers a starved rAF (e.g. uncomposited window) so
                  ;; the bar can never get stuck invisible.
                  (let [reveal (Fn [] Any) (fn [] Any (rmattr! root "gjoa-urlbar-arming"))]
                    (js/call window .requestAnimationFrame
                      (fn [] Any (js/call window .requestAnimationFrame reveal)))
                    (js/call window .setTimeout reveal 120))))))

        is-floating (Fn [] Any) (fn [] Any (js/get state .activated))

        on-focus-out (Fn [Any] Any) (fn [e Any] Any
          (when (js/get state .activated)
            (setTimeout (fn [] Any
              (when (js/get state .activated)
                (let [a Any (js/get document .activeElement)]
                  (when (not (bool (and a (or (identical? a urlbar) (js/call urlbar .contains a)))))
                    (deactivate-floating)))))
              0)))

        handle-accel (Fn [Any] Any) (fn [e Any] Any
          (let [accel Any (or (js/get e .ctrlKey) (js/get e .metaKey))]
            (when (and accel (not (js/get e .shiftKey)) (not (js/get e .altKey)))
              (let [k Any (js/get e .key)]
                (when (or (= k "j") (= k "k"))
                  (let [view Any (some-> window (js/get .gURLBar) (js/get .view))]
                    (when (and view (js/get view .selectBy))
                      (js/call e .preventDefault)
                      (js/call e .stopImmediatePropagation)
                      (try (js/call view .selectBy (if (= k "j") 1 -1))
                        (catch (err Any)
                          (log "selectBy:error" {:msg (String err)})))
                      true)))))))

        on-keydown (Fn [Any] Any) (fn [e Any] Any
          (when (and (not (bool (handle-accel e))) (js/get state .activated))
              (cond
                (= (js/get e .key) "Escape")
                  (do
                    ;; We OWN the floating-palette dismiss. FF's UrlbarController
                    ;; Escape is a window-level BUBBLE listener that calls
                    ;; view.close() synchronously — with results showing that
                    ;; snaps the tall suggestion list shut BEFORE our fade even
                    ;; starts (the visible teardown jank). Our handler is
                    ;; capture-phase on #urlbar, so it runs first; stop the event
                    ;; here and FF never closes the view — the whole palette
                    ;; (input + results) fades as ONE unit.
                    (js/call e .preventDefault)
                    (js/call e .stopImmediatePropagation)
                    (deactivate-floating)
                    ;; Close the view + return focus to content AFTER the fade is
                    ;; visually done (opacity 0 by ~130ms) but BEFORE finish-teardown
                    ;; restores the resting geometry (150ms) — so the results
                    ;; neither snap early nor flash at the in-sidebar position. All
                    ;; of this happens behind opacity 0, invisibly.
                    (setTimeout (fn [] Any
                      (try
                        (some-> window (js/get .gURLBar) (js/get .view) (js/call .close))
                        (let [a Any (js/get document .activeElement)]
                          (when (and a (or (identical? a urlbar) (js/call urlbar .contains a)))
                            (some-> window (js/get .gjoaFocusGuard) (js/call .release))
                            (some-> window (js/get .gBrowser) (js/get .selectedBrowser) (js/call .focus))))
                        (catch (err Any)
                          (log "escape:teardown-error" {:msg (String err)}))))
                      135))

                (= (js/get e .key) "Enter")
                  (do
                    (when (and (= (js/get state .intent) "newTab") (not (js/get e .altKey)))
                      (js/call e .preventDefault)
                      (js/call e .stopImmediatePropagation)
                      (log "intercept:newTab-enter")
                      (let [target Any (js/get e .target)]
                        (js/call target .dispatchEvent (js/new KeyboardEvent "keydown"
                          {:key "Enter" :code "Enter" :keyCode 13 :which 13
                           :altKey true :bubbles true :cancelable true :view window}))))
                    (setTimeout deactivate-floating 0))

                :else nil)))

        on-activate-request (Fn [Any] Any) (fn [e Any] Any
          (let [detail Any (js/get e .detail)]
            (activate-floating
              (if (and detail (= (js/get detail .intent) "newTab")) "newTab" "current"))))

        on-deactivate-request (Fn [] Any) (fn [] Any (deactivate-floating))]

    (install-popover-shim!)
    (onc! urlbar "focusout" on-focus-out)
    (onc! urlbar "keydown" on-keydown)
    (on! document "gjoa-urlbar-activate" on-activate-request)
    (on! document "gjoa-urlbar-deactivate" on-deactivate-request)

    {:activateFloating activate-floating
     :deactivateFloating deactivate-floating
     :isFloating is-floating
     :destroy (fn [] Any
       (offc! urlbar "focusout" on-focus-out)
       (offc! urlbar "keydown" on-keydown)
       (off! document "gjoa-urlbar-activate" on-activate-request)
       (off! document "gjoa-urlbar-deactivate" on-deactivate-request)
       ;; deactivate-floating's teardown is async (fade → transitionend), so detach the
       ;; watchdog here too or a hot-reload stacks observers on the next bundle.
       (when (js/get state .healObs)
         (js/call (js/get state .healObs) .disconnect)
         (js/set! state .healObs nil))
       (when (js/get state .healFn)
         (off! urlbar "toggle" (js/get state .healFn))
         (js/set! state .healFn nil))
       (when (js/get state .pinObs)
         (js/call (js/get state .pinObs) .disconnect)
         (js/set! state .pinObs nil))
       (deactivate-floating))})))
