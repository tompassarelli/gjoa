#lang beagle/js
(ns gjoa.drawer.drag-overlay
  (:require [gjoa.macros :refer [qa by-id xul-new pref-bool]]
            [gjoa.tabs.log :refer [create-logger!]]))


(def PREF String "gjoa.view.draggable-sidebar")

(def st Any
  {:overlay nil
   :resize-obs nil
   :mutation-obs nil
   :sidebar-main nil
   :arrowscrollbox nil
   :observer nil
   :log nil})

(defn update! [] Any
  (let [ov (js/get st .overlay)
        asb (js/get st .arrowscrollbox)]
    (when (and ov asb)
      (let [container-rect (js/call (js/get st .sidebar-main) .getBoundingClientRect)
            asb-rect (js/call asb .getBoundingClientRect)
            tabs (qa asb "tab.tabbrowser-tab")
            last-tab (if (> (js/get tabs .length) 0)
                       (aget tabs (- (js/get tabs .length) 1))
                       nil)
            top (if last-tab
                  (js/get (js/call last-tab .getBoundingClientRect) .bottom)
                  (js/get asb-rect .top))
            bottom (js/get asb-rect .bottom)
            height (Math/max 0 (- bottom top))]
        (js/set! (js/get ov .style) .left (str (- (js/get asb-rect .left) (js/get container-rect .left)) "px"))
        (js/set! (js/get ov .style) .top (str (- top (js/get container-rect .top)) "px"))
        (js/set! (js/get ov .style) .width (str (js/get asb-rect .width) "px"))
        (js/set! (js/get ov .style) .height (str height "px"))
        (js/set! (js/get ov .style) .display (if (> height 0) "" "none"))))))

(defn enable! [] Any
  (when (not (js/get st .overlay))
    (let [el (xul-new "box")
          asb (js/get st .arrowscrollbox)
          log (js/get st .log)]
      (js/set! el .id "gjoa-drag-overlay")
      (js/call (js/get st .sidebar-main) .appendChild el)
      (js/set! st .overlay el)
      (when asb
        (let [ro (js/new ResizeObserver update!)]
          (js/call ro .observe asb)
          (js/set! st .resize-obs ro))
        (let [mo (js/new MutationObserver update!)]
          (js/call mo .observe asb {:childList true})
          (js/set! st .mutation-obs mo)))
      (update!)
      (log "enable"))))

(defn disable! [] Any
  (when (js/get st .overlay)
    (let [log (js/get st .log)]
      (when (js/get st .resize-obs) (js/call (js/get st .resize-obs) .disconnect))
      (when (js/get st .mutation-obs) (js/call (js/get st .mutation-obs) .disconnect))
      (js/set! st .resize-obs nil)
      (js/set! st .mutation-obs nil)
      (js/call (js/get st .overlay) .remove)
      (js/set! st .overlay nil)
      (log "disable"))))

(defn destroy! [] Any
  (try (js/call (js/get Services .prefs) .removeObserver PREF (js/get st .observer))
    (catch (e Any) nil))
  (disable!))

(js/export (defn make-drag-overlay! [deps] Any
  (js/set! st .log (create-logger! "drawer/drag-overlay"))
  (js/set! st .sidebar-main (js/get deps .sidebarMain))
  (js/set! st .arrowscrollbox (by-id "tabbrowser-arrowscrollbox"))

  (when (pref-bool PREF true) (enable!))

  (let [obs {:observe (fn [] Any
              (if (pref-bool PREF true)
                (enable!)
                (disable!)))}]
    (js/set! st .observer obs)
    (js/call (js/get Services .prefs) .addObserver PREF obs))

  {:destroy destroy!}))
