#lang beagle/js
;; Urlbar focus ownership across the chrome-init window. Moving a subtree that
;; contains the focused node drops focus to <body> and fires NO blur, so nothing
;; downstream can notice or restore it: every reparent of #urlbar's ancestors
;; must go through `with-urlbar-focus!`. The guard below is the tripwire for the
;; rest of the init window.
(ns gjoa.drawer.focus
  (:require [gjoa.macros :refer [by-id bool onc! offc! on! off! pref-int set-pref-int!]]
            [gjoa.tabs.log :refer [create-logger!]]))

(declare-extern [document window] Any)

(def RESCUE-PREF String "gjoa.urlbar.focusRescues")

;; TRIPWIRE bounds, never the fix: how long after bundle load the guard stays
;; armed, how long one activation's intent survives, and how many times a single
;; startup may be rescued before we stop and leave the counter as the evidence.
(def GUARD-WINDOW-MS Number 5000)
(def INTENT-TTL-MS Number 1200)
(def MAX-RESCUES Number 3)

(js/export (defn urlbar-input [] Any
  (or (some-> window (js/get .gURLBar) (js/get .inputField))
      (some-> (by-id "urlbar") (js/call .querySelector ".urlbar-input")))))

;; Look #urlbar up every call — the drawer moves it, so nothing about its
;; position may be cached across one.
(js/export (defn urlbar-focused? [] Any
  (let [u Any (by-id "urlbar")
        a Any (js/get document .activeElement)]
    (bool (and u a (or (identical? a u) (js/call u .contains a)))))))

;; Run `f`, and if it moved the caret out of a urlbar that held it, put it back
;; — same node, same selection. A no-op when the urlbar did not own focus.
(js/export (defn with-urlbar-focus! [f Any] Any
  (let [held Any (urlbar-focused?)
        input Any (if held (urlbar-input) nil)
        start Any (if input (js/get input .selectionStart) 0)
        end Any (if input (js/get input .selectionEnd) 0)
        dir Any (if input (or (js/get input .selectionDirection) "none") "none")]
    (f)
    (when (and held (not (urlbar-focused?)))
      (try
        (some-> window (js/get .gURLBar) (js/call .focus))
        (when (and input (js/get input .setSelectionRange))
          (js/call input .setSelectionRange start end dir))
        (catch (_e Any) nil))))))

(js/export (defn make-focus-guard! [] Any
  (let [log Any (create-logger! "urlbar/focus-guard")
        st Any {:until (+ (Date/now) GUARD-WINDOW-MS)
            :intent 0 :kind "" :rescues 0 :watching false}
        ;; `check` and `watch!` are mutually recursive; the let is sequential, so
        ;; the forward edge rides a holder (the compact.bjs `fwd` pattern).
        fwd Any {:check nil}

        armed? (Fn [] Any) (fn [] Any (< (Date/now) (js/get st .until)))

        watch! (Fn [] Any) (fn [] Any
          (when (not (js/get st .watching))
            (js/set! st .watching true)
            (js/call window .requestAnimationFrame (fn [] Any (js/call fwd .check)))))

        rescue! (Fn [] Any) (fn [] Any
          (let [rescues Int (js/get st .rescues)]
            (js/set! st .rescues (+ rescues 1)))
          (let [prior Int (pref-int RESCUE-PREF 0)]
            (set-pref-int! RESCUE-PREF (+ prior 1)))
          (log "rescue" {:kind (js/get st .kind) :n (js/get st .rescues)})
          (try
            (some-> window (js/get .gURLBar) (js/call .focus))
            ;; Ctrl+L means "select the address"; a click already placed its own
            ;; caret and a held focus keeps whatever it had.
            (when (= (js/get st .kind) "key") (some-> window (js/get .gURLBar) (js/call .select)))
            (catch (_e Any) nil)))

        ;; Departure is a GESTURE (a page click dispatches a chrome mousedown at
        ;; <browser>, which clears below), never a destination — so a content-focus
        ;; is theft. Except under the INFERRED "hold" intent: nobody aimed at the
        ;; urlbar, and fighting a new window's startup hand-off destabilizes init.
        content-owns? (Fn [] Any) (fn [] Any
          (let [a Any (js/get document .activeElement)]
            (bool (and a (= (js/get a .localName) "browser") (= (js/get st .kind) "hold")))))

        check (Fn [] Any) (fn [] Any
          (js/set! st .watching false)
          (when (and (> (js/get st .intent) 0) (armed?))
            (cond
              (urlbar-focused?)
                (let [intent Int (js/get st .intent)]
                  (when (< (- (Date/now) intent) INTENT-TTL-MS) (watch!)))
              (content-owns?)
                (js/set! st .intent 0)
              :else
                (do (rescue!)
                    (if (>= (js/get st .rescues) MAX-RESCUES)
                      (js/set! st .intent 0)
                      (watch!))))))

        note! (Fn [Any] Any) (fn [kind Any] Any
          (when (armed?)
            (js/set! st .intent (Date/now))
            (js/set! st .kind kind)
            (watch!)))

        ;; An activation aimed anywhere else is the user changing their mind:
        ;; the guard must never pull focus back out from under it.
        clear! (Fn [] Any) (fn [] Any (js/set! st .intent 0))

        ;; `.contains` stops at a shadow boundary and the urlbar's input lives
        ;; inside one, so the composed path — which crosses it — decides.
        aimed-at-urlbar? (Fn [Any] Any) (fn [e Any] Any
          (let [u Any (by-id "urlbar")
                path Any (if (js/get e .composedPath) (js/call e .composedPath) nil)
                t Any (js/get e .target)]
            (bool (and u (or (and path (js/call path .includes u))
                             (and t (or (identical? u t) (js/call u .contains t))))))))

        on-mousedown (Fn [Any] Any) (fn [e Any] Any
          (if (aimed-at-urlbar? e) (note! "click") (clear!)))

        on-keydown (Fn [Any] Any) (fn [e Any] Any
          (let [accel Any (or (js/get e .ctrlKey) (js/get e .metaKey))]
            (cond
              (and accel (not (js/get e .shiftKey)) (not (js/get e .altKey))
                   (or (= (js/get e .key) "l") (= (js/get e .key) "L")))
                (note! "key")
              (= (js/get e .key) "Escape")
                (clear!)
              :else nil)))

        on-activate (Fn [Any] Any) (fn [_e Any] Any (note! "key"))]

    (js/set! fwd .check check)
    (onc! document "mousedown" on-mousedown)
    (onc! document "keydown" on-keydown)
    (on! document "gjoa-urlbar-activate" on-activate)
    ;; A click / Ctrl+L that landed BEFORE the bundles loaded leaves no event to
    ;; catch — only the state. A urlbar that already owns focus at load IS a
    ;; standing activation, so arm on it.
    (when (urlbar-focused?) (note! "hold"))

    {:rescues (fn [] Any (js/get st .rescues))
     ;; gjoa deliberately handing focus to content (float teardown, Escape) is not
     ;; theft — say so, or the guard fights the dismiss it was told about.
     :release clear!
     ;; Re-open the guard window on a live window — the only way to exercise the
     ;; tripwire after startup (tests, and a hot-reloaded bundle).
     :rearm (fn [] Any
       (js/set! st .until (+ (Date/now) GUARD-WINDOW-MS))
       (js/set! st .rescues 0)
       (js/set! st .intent 0)
       (when (urlbar-focused?) (note! "hold")))
     :destroy (fn [] Any
       (js/set! st .until 0)
       (js/set! st .intent 0)
       (offc! document "mousedown" on-mousedown)
       (offc! document "keydown" on-keydown)
       (off! document "gjoa-urlbar-activate" on-activate))})))
