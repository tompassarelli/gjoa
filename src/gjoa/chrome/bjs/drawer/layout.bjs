#lang beagle/js
(ns gjoa.drawer.layout
  (:require [gjoa.macros :refer [by-id q xul-new xul-id pref-int set-pref-int! pref-bool set-pref-bool! on! off! has?]]
            [gjoa.drawer.focus :refer [with-urlbar-focus!]]
            [gjoa.tabs.log :refer [create-logger!]]))

(declare-extern [window Services CustomizableUI getComputedStyle] Any)

(def WIDTH-PREF String "gjoa.sidebar.width")
(def REPAIR-PREF String "gjoa.navbar.repaired")

(defn collect-icons! [scope hits] Any
  (let [sr (js/get scope .shadowRoot)]
    (when sr (collect-icons! sr hits)))
  (let [kids (js/get scope .children)]
    (when kids
      (js/call (Array/from kids) .forEach
        (fn [child] Any
          (let [tag (js/call (js/get child .tagName) .toLowerCase)
                cls (js/get child .classList)
                is-icon (or (= tag "img")
                            (= tag "svg")
                            (= tag "moz-icon")
                            (js/call cls .contains "toolbarbutton-icon")
                            (js/call cls .contains "button-icon"))]
            (when is-icon
              (let [r (js/call child .getBoundingClientRect)]
                (when (and (> (js/get r .width) 0)
                           (> (js/get r .height) 0)
                           (>= (js/get r .top) 0))
                  (js/call hits .push r))))
            (collect-icons! child hits)))))))

(js/export (defn make-layout! [deps] Any
  (let [log (create-logger! "drawer/layout")
        sidebar-main (:sidebarMain deps)
        navigator-toolbox (:navigatorToolbox deps)
        urlbar-container (:urlbarContainer deps)
        nav-bar (:navBar deps)
        urlbar (:urlbar deps)
        sidebar-main-element (q sidebar-main "sidebar-main")

        toolbox-parent (js/get navigator-toolbox .parentNode)
        toolbox-next (js/get navigator-toolbox .nextSibling)
        urlbar-parent (js/get urlbar-container .parentNode)
        urlbar-next (js/get urlbar-container .nextSibling)

        state {:urlbar-toolbar nil
               :resize-obs nil
               :mutation-obs nil
               :extend-obs nil
               :updating false}

        ;; --- inject-sidebar-shadow-overrides ---
        inject-sidebar-shadow-overrides (fn [] Any
          (let [sr (some-> sidebar-main-element (js/get .shadowRoot))]
            (if (nil? sr)
              (setTimeout inject-sidebar-shadow-overrides 100)
              (let [s (js/new CSSStyleSheet)]
                (js/call s .replaceSync
                  (str "#sidebar-tools-and-extensions-splitter { display: none !important; }"
                       " .tools-and-extensions > moz-button:not(.tools-overflow):first-of-type {"
                       "   --button-outer-padding-block-start: calc(var(--space-xxsmall) * 2) !important;"
                       " }"
                       ;; bookmarks↔gear is an INTERNAL boundary (bookmarks is the
                       ;; last tool, gear the sole .bottom-actions button right below),
                       ;; so both its pads must equal the inner-icon boundary (one
                       ;; --space-xxsmall each) — NOT the doubled cluster-edge value —
                       ;; or the gear sits with a visibly wider gap above it (#horizontal).
                       " .tools-and-extensions > moz-button:not(.tools-overflow):last-of-type {"
                       "   --button-outer-padding-block-end: var(--space-xxsmall) !important;"
                       " }"
                       " .bottom-actions > moz-button:first-of-type {"
                       "   --button-outer-padding-block-start: var(--space-xxsmall) !important;"
                       " }"
                       " .bottom-actions > moz-button:last-of-type {"
                       "   --button-outer-padding-block-end: calc(var(--space-xxsmall) * 2) !important;"
                       " }"
                       " :host([expanded]) .buttons-wrapper {"
                       "   justify-content: flex-start !important;"
                       "   align-items: center !important;"
                       "   gap: calc(var(--space-xxsmall) * 2) !important;"
                       " }"
                       " :host([expanded]) .bottom-actions {"
                       "   align-self: center !important;"
                       " }"
                       ;; #147: the tool + bottom-action button column hugs the
                       ;; INNER (page) edge when flipped because native
                       ;; `.actions-list { align-items: start }` always means
                       ;; inline-start (left). Anchor it to the OUTER screen edge:
                       ;; start when the drawer is on the left, end when flipped
                       ;; right (FF sets `sidebar-positionend` on the host).
                       " :host([sidebar-positionend]) .actions-list {"
                       "   align-items: end !important;"
                       " }"
                       ;; Kill the startup overflow-flicker: the native sidebar's
                       ;; IntersectionObserver mis-fires before the column reaches
                       ;; full height → momentarily shows the `>>` chevron and
                       ;; inline-`visibility:hidden`s the real tool buttons, which
                       ;; then pop in. In the tall expanded vertical column these
                       ;; few buttons always fit, so suppress the chevron and keep
                       ;; the originals visible (overrides the inline hidden). Trade:
                       ;; a genuinely-overflowing tool set (15+ ext, short window)
                       ;; no longer collapses to `>>` — acceptable vs a per-launch flash.
                       " :host([expanded]) [part='overflow-button'] {"
                       "   display: none !important;"
                       " }"
                       " :host([expanded]) button-group.tools-and-extensions:not([part='overflow-button']) > moz-button {"
                       "   visibility: visible !important;"
                       " }"))
                (js/call (js/get sr .adoptedStyleSheets) .push s)))))

        ;; --- sync-urlbar-width ---
        sync-urlbar-width (fn [] Any
          (when (and urlbar (not (js/get state .updating))
                     (not (has? urlbar "breakout-extend")))
              (js/set! state .updating true)
              (let [(inset Float) (or (parseFloat
                                        (js/call (getComputedStyle (js/get document .documentElement)) .getPropertyValue
                                          "--gjoa-sidebar-inset"))
                                      10)
                    (sidebar-w Float) (js/get (js/call sidebar-main .getBoundingClientRect) .width)
                    w (Math/max 0.0 (- sidebar-w (* inset 2)))]
                (js/call (js/get urlbar .style) .setProperty "--urlbar-width" (str w "px"))
                ;; #150: stash the resting width so the FLIPPED breakout-extend
                ;; CSS can grow the bar toward the page (leftward) instead of the
                ;; off-screen window edge — it translates left by (expand-w −
                ;; resting-w), and `--urlbar-width` is clobbered to expand-w
                ;; inside that rule, so it needs this untouched copy.
                (js/call (js/get urlbar .style) .setProperty "--gjoa-urlbar-resting-w" (str w "px")))
              (js/set! state .updating false)))

        ;; Parent AND container: while the palette floats the parent is the stage.
        drop-breakout-dimensions! (fn [] Any
          (when urlbar
            (js/call (js/get urlbar .style) .removeProperty "--urlbar-height")
            (when (js/get urlbar .parentNode)
              (js/call (js/get (js/get urlbar .parentNode) .style) .removeProperty
                               "--urlbar-container-height")))
          (when urlbar-container
            (js/call (js/get urlbar-container .style) .removeProperty "--urlbar-container-height")))

        ;; The blocker pair is Firefox's own public re-measure entry
        ;; (decrementBreakoutBlockerCount → #updateLayoutBreakout); the flush is what
        ;; makes it read the settled layout rather than the pre-move one.
        relatch-breakout! (fn [] Any
          (try
            (js/call (js/call window .promiseDocumentFlushed (fn [] Any nil)) .then
              (fn [_r] Any
                (let [u (js/get window .gURLBar)]
                  (when (and u (js/get u .incrementBreakoutBlockerCount))
                    (js/call u .incrementBreakoutBlockerCount)
                    (js/call u .decrementBreakoutBlockerCount))))
              (fn [_e] Any nil))
            (catch (_e Any) nil)))

        ;; A re-measure taken while the bar is CLICK-EXPANDED measures the expanded
        ;; box, so the reconnect a move causes latches the row we left onto the row we
        ;; enter — drop both and re-measure once the extend ends. Never while the
        ;; palette floats: drawer/urlbar.bjs owns both vars for its lifetime.
        remeasure-breakout! (fn [] Any
          (when (js/get state .extend-obs)
            (js/call (js/get state .extend-obs) .disconnect)
            (js/set! state .extend-obs nil))
          (when (and urlbar (has? urlbar "breakout-extend")
                     (not (has? (js/get document .documentElement) "gjoa-urlbar-floating")))
            (drop-breakout-dimensions!)
            (let [obs (js/new MutationObserver
                        (fn [] Any
                          (when (not (has? urlbar "breakout-extend"))
                            (js/call obs .disconnect)
                            (js/set! state .extend-obs nil)
                            (relatch-breakout!))))]
              (js/call obs .observe urlbar {:attributes true :attributeFilter ["breakout-extend"]})
              (js/set! state .extend-obs obs))))

        ;; --- sync-symmetric-footer-once ---
        sync-symmetric-footer-once (fn [] Any
          (let [sidebar-main-el (by-id "sidebar-container")]
            (if (not sidebar-main-el)
              true
              (let [nav-bar-el (q sidebar-main-el "#nav-bar")
                    footer (q sidebar-main-el ":scope > sidebar-main")]
                (if (or (not nav-bar-el) (not footer))
                  true
                  (let [top-hits []
                        bottom-hits []]
                    (collect-icons! nav-bar-el top-hits)
                    (collect-icons! footer bottom-hits)
                    (if (or (= (js/get top-hits .length) 0) (= (js/get bottom-hits .length) 0))
                      true
                      (do
                        ;; collect-icons! pushes DOMRects, so every coordinate below
                        ;; is a CSS pixel double.
                        (js/call top-hits .sort
                          (fn [%1 %2] Any
                            (let [(a Float) (js/get %1 .top) (b Float) (js/get %2 .top)] (- a b))))
                        (js/call bottom-hits .sort
                          (fn [%1 %2] Any
                            (let [(a Float) (js/get %1 .bottom) (b Float) (js/get %2 .bottom)] (- a b))))
                        (let [top-icon (aget top-hits 0)
                              (bottom-count Int) (js/get bottom-hits .length)
                              bottom-icon (aget bottom-hits (- bottom-count 1))
                              sidebar-rect (js/call sidebar-main-el .getBoundingClientRect)
                              (top-icon-top Float) (js/get top-icon .top)
                              (bottom-icon-bottom Float) (js/get bottom-icon .bottom)
                              (sidebar-top Float) (js/get sidebar-rect .top)
                              (sidebar-bottom Float) (js/get sidebar-rect .bottom)
                              top-gap (- top-icon-top sidebar-top)
                              bottom-gap (- sidebar-bottom bottom-icon-bottom)
                              (BOTTOM-OFFSET Int) 4
                              delta (- (+ top-gap BOTTOM-OFFSET) bottom-gap)]
                          (if (< (Math/abs delta) 0.5)
                            (do
                              (log (str "symfooter:converged topGap="
                                        (js/call top-gap .toFixed 1)
                                        " bottomGap=" (js/call bottom-gap .toFixed 1)
                                        " target=" (js/call (+ top-gap BOTTOM-OFFSET) .toFixed 1)))
                              true)
                            (let [(current-var Float) (or (parseFloat
                                                            (js/call (getComputedStyle (js/get document .documentElement)) .getPropertyValue
                                                              "--gjoa-symmetric-footer"))
                                                          0)
                                  next (Math/max 0 (Math/round (- current-var (* delta 0.6))))]
                              (js/call (js/get (js/get document .documentElement) .style) .setProperty
                                            "--gjoa-symmetric-footer" (str next "px"))
                              (log (str "symfooter:pass topGap=" (js/call top-gap .toFixed 1)
                                        " bottomGap=" (js/call bottom-gap .toFixed 1)
                                        " var=" current-var "→" next))
                              false)))))))))))

        ;; --- sync-symmetric-footer ---
        sync-symmetric-footer (fn [] Any
          (js/call (Array/from {:length 30}) .forEach
            (fn [_ (i Int)] Any
              (setTimeout sync-symmetric-footer-once (* i 50)))))

        ;; --- expand ---
        expand (fn [] Any
          (when (not (js/get state .urlbar-toolbar))
            (log "expand")
            ;; A hot-reload re-runs init! without the previous bundle removing what it
            ;; built, so a live holder of the id is a stale duplicate — evict it AFTER
            ;; the new toolbar has taken #urlbar-container off it.
            (let [stale (by-id "gjoa-urlbar-toolbar")]
              ;; Both moves below carry #urlbar; without this the caret a user put
              ;; there before the drawer initialized is silently dropped to <body>.
              (with-urlbar-focus! (fn [] Any
                ;; Re-apply the persisted width — collapse() clears the inline width
                ;; so the icon strip can go favicon-thin, so re-expanding must restore
                ;; the user's chosen width (not snap back to native default).
                (js/set! (js/get sidebar-main .style) .width (str (pref-int WIDTH-PREF 300) "px"))
                (when sidebar-main-element
                  (js/call sidebar-main .insertBefore navigator-toolbox sidebar-main-element))
                (let [tb (xul-id "toolbar" "gjoa-urlbar-toolbar")]
                  (js/call (js/get tb .classList) .add "browser-toolbar")
                  (js/call tb .appendChild urlbar-container)
                  (js/call nav-bar .after tb)
                  (js/set! state .urlbar-toolbar tb))))
              (when (and stale (not (identical? stale (js/get state .urlbar-toolbar))))
                (js/call stale .remove)))
            (remeasure-breakout!)
            (when urlbar
              (let [ro (js/new ResizeObserver sync-urlbar-width)]
                (js/call ro .observe sidebar-main)
                (js/set! state .resize-obs ro))
              (let [mo (js/new MutationObserver sync-urlbar-width)]
                (js/call mo .observe urlbar {:attributes true :attributeFilter ["style"]})
                (js/set! state .mutation-obs mo)))))

        ;; --- collapse ---
        collapse (fn [] Any
          (when (js/get state .urlbar-toolbar)
            (log "collapse")
            (some-> state (js/get .resize-obs) (js/call .disconnect))
            (some-> state (js/get .mutation-obs) (js/call .disconnect))
            (js/set! state .resize-obs nil)
            (js/set! state .mutation-obs nil)

            ;; Drop the persisted expanded width (set inline on expand/init) so
            ;; the collapsed sidebar reverts to its native favicon-width strip.
            ;; Without this the inline `width:NNNpx` overrode the icon-strip
            ;; width — the sidebar stayed wide + still showed tab labels.
            (js/call (js/get sidebar-main .style) .removeProperty "width")

            ;; Same caret contract as expand: these moves carry #urlbar.
            (with-urlbar-focus! (fn [] Any
              ;; `identical?`, never `=`: beagle's `=` is STRUCTURAL and two DOM nodes
              ;; both have zero own keys, so `=` is true for ANY pair — and an
              ;; insertBefore against a reference node that has since moved THROWS.
              (if (and urlbar-next (identical? (js/get urlbar-next .parentNode) urlbar-parent))
                (js/call urlbar-parent .insertBefore urlbar-container urlbar-next)
                (js/call urlbar-parent .appendChild urlbar-container))

              (js/call (js/get state .urlbar-toolbar) .remove)
              (js/set! state .urlbar-toolbar nil)

              (let [spring2 (by-id "customizableui-special-spring2")
                    ext-btn (by-id "unified-extensions-button")
                    sb-btn (by-id "gjoa-sidebar-button")]
                (when spring2 (js/call urlbar-container .after spring2))
                (when (and spring2 ext-btn) (js/call spring2 .after ext-btn))
                ;; keep gjoa's swapped sidebar button immediately after the
                ;; extensions button through the collapse reflow, so the
                ;; hamburger → extensions → sidebar order survives compact mode (#92).
                (when (and ext-btn sb-btn) (js/call ext-btn .after sb-btn)))

              (if (and toolbox-next (identical? (js/get toolbox-next .parentNode) toolbox-parent))
                (js/call toolbox-parent .insertBefore navigator-toolbox toolbox-next)
                (js/call toolbox-parent .appendChild navigator-toolbox))))
            (remeasure-breakout!)))

        ;; --- context-menu fix ---
        on-context-menu (fn [e] Any
          (when (identical? (js/get navigator-toolbox .parentNode) sidebar-main)
            (js/call e .stopPropagation)))

        ;; --- nav-bar widget repair (#122) ---
        ;; #gjoa-sidebar-button is a swap of the native #sidebar-button node, so a
        ;; lost sidebar-button placement removes BOTH visible buttons.
        placement-of (fn [id] Any
          (try (js/call CustomizableUI .getPlacementOfWidget id) (catch (_e Any) nil)))

        build-in-window! (fn [id] Any
          (try
            (when (and (placement-of id) (nil? (by-id id)))
              (js/call CustomizableUI .ensureWidgetPlacedInWindow id window))
            (catch (_e Any) nil)))

        ;; addWidgetToArea APPENDS when position is nil, permanently reordering the
        ;; user's persisted nav-bar, so always hand it the slot the widget came from.
        re-add! (fn [id position] Any
          (try
            (when (nil? (placement-of id))
              (js/call CustomizableUI .addWidgetToArea id "nav-bar" position))
            (catch (_e Any) nil)))

        ;; Persisted slot only — visual order is pinned by nav-bar CSS `order`,
        ;; because this persisted index and the rendered DOM order differ.
        nav-bar-slot-after (fn [anchor-id] Any
          (try
            (let [p (placement-of anchor-id)]
              (if (and p (= (js/get p .area) "nav-bar"))
                (let [(position Int) (js/get p .position)] (+ position 1))
                nil))
            (catch (_e Any) nil)))

        ;; Called pre-buildArea: a placement live here and gone a tick later was
        ;; dropped BY the flip. A user-removed one already reads null, because
        ;; SidebarManager forces verticalTabs=false a microtask AFTER the removal.
        snapshot-placements (fn [] Any
          (js/call ["stop-reload-button" "sidebar-button"] .map
            (fn [id] Any
              (let [p (placement-of id)]
                {:id id :live (not (nil? p)) :position (if p (js/get p .position) nil)}))))

        repair-dropped! (fn [snap] Any
          (js/call snap .forEach
            (fn [entry] Any
              (when (js/get entry .live) (re-add! (js/get entry .id) (js/get entry .position)))
              (build-in-window! (js/get entry .id)))))

        ;; Heals a profile #122 already persisted as broken. Must stay ONE-shot:
        ;; re-adding per window init makes both widgets unremovable, since removing
        ;; sidebar-button forces horizontal tabs, which re-enters the repair below.
        heal-once! (fn [] Any
          (when (not (pref-bool REPAIR-PREF false))
            (re-add! "stop-reload-button" (nav-bar-slot-after "forward-button"))
            ;; no slot: gjoa's nav-bar CSS `order` owns where this one renders.
            (re-add! "sidebar-button" nil)
            (set-pref-bool! REPAIR-PREF true))
          (build-in-window! "stop-reload-button")
          (build-in-window! "sidebar-button"))]

    ;; --- wire up ---
    (on! navigator-toolbox "contextmenu" on-context-menu)

    (inject-sidebar-shadow-overrides)
    ;; Must precede make-sidebar-button! (index.bjs) — the swap needs the native node.
    ;; CustomizableUI rebuilds nav-bar widgets, so it too can move the focused urlbar.
    (with-urlbar-focus! heal-once!)
    (when (has? sidebar-main "sidebar-launcher-expanded") (expand))

    ;; --- symmetric footer ---
    (sync-symmetric-footer)
    (on! window "resize" sync-symmetric-footer)

    (let [sidebar-main-el (by-id "sidebar-container")
          sym-resize-obs (js/new ResizeObserver sync-symmetric-footer)]
      (when sidebar-main-el (js/call sym-resize-obs .observe sidebar-main-el))

      ;; --- expand/collapse observer ---
      (let [expand-observer (js/new MutationObserver
                              (fn [] Any
                                (let [expanded (has? sidebar-main "sidebar-launcher-expanded")]
                                  (if (and expanded (not (js/get state .urlbar-toolbar)))
                                    (expand)
                                    (when (and (not expanded) (js/get state .urlbar-toolbar))
                                      (collapse)))
                                  (sync-symmetric-footer))))]
        (js/call expand-observer .observe sidebar-main
          {:attributes true :attributeFilter ["sidebar-launcher-expanded"]})

        ;; --- #122: drive expand/collapse off the verticalTabs pref directly ---
        ;; expand/collapse above key ONLY on the sidebar-launcher-expanded attribute, but
        ;; FF clears that attribute on a vertical→horizontal flip ONLY when sidebar.visibility
        ;; is "hide-sidebar". gjoa runs the default "always-show", so the attribute stays set
        ;; and collapse() NEVER fired on a runtime flip — #navigator-toolbox stayed reparented
        ;; inside #sidebar-container, and FF's nav-bar buildArea then DROPPED the removable
        ;; #stop-reload-button + #sidebar-button (keeping non-removable back/forward/urlbar).
        ;; Fix: trigger collapse/expand off verticalTabs, and restore whatever buildArea
        ;; then dropped — snapshot synchronously, repair a tick later (post-buildArea).
        (let [vt-observer {:observe
                           (fn [_s _t _d] Any
                             (let [vertical (pref-bool "sidebar.verticalTabs" true)]
                               (if vertical
                                 (when (and (has? sidebar-main "sidebar-launcher-expanded")
                                            (not (js/get state .urlbar-toolbar)))
                                   (expand))
                                 (let [snap (snapshot-placements)]
                                   (when (js/get state .urlbar-toolbar) (collapse))
                                   (js/call window .setTimeout (fn [] Any (repair-dropped! snap)) 0)))
                               (sync-symmetric-footer)))}]
          (js/call (js/get Services .prefs) .addObserver "sidebar.verticalTabs" vt-observer))

        ;; --- width pref ---
        (let [default-width (pref-int WIDTH-PREF 300)]
          (when (has? sidebar-main "sidebar-launcher-expanded")
            (js/set! (js/get sidebar-main .style) .width (str default-width "px"))))

        (let [width-obs (js/new ResizeObserver
                          (fn [] Any
                            (when (has? sidebar-main "sidebar-launcher-expanded")
                              (let [w (Math/round (js/get (js/call sidebar-main .getBoundingClientRect) .width))]
                                (when (> w 0) (set-pref-int! WIDTH-PREF w))))))]
          (js/call width-obs .observe sidebar-main)

          {:isExpanded (fn [] Any (not= (js/get state .urlbar-toolbar) nil))
           :destroy (fn [] Any
             (js/call expand-observer .disconnect)
             (js/call width-obs .disconnect)
             (js/call sym-resize-obs .disconnect)
             (some-> state (js/get .resize-obs) (js/call .disconnect))
             (some-> state (js/get .mutation-obs) (js/call .disconnect))
             (some-> state (js/get .extend-obs) (js/call .disconnect))
             (off! navigator-toolbox "contextmenu" on-context-menu)
             (off! window "resize" sync-symmetric-footer))}))))))
