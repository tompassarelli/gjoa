#lang beagle/js
(ns gjoa.drawer.compact
  (:require [gjoa.macros :refer [q xul-new pref-bool pref-int set-pref-bool! on! off! has? attr! rmattr! bool]]
            [gjoa.tabs.log :refer [create-logger!]]
            [gjoa.drawer.timing :refer [collapse-protection-duration-ms]]))

(declare-extern [document window Services requestAnimationFrame getComputedStyle] Any)

(defn make-mode-ops! [(cfg Any)] Any
  (let [st       (js/get cfg .st)
        elem     (js/get cfg .elem)
        check-el (js/get cfg .check-el)
        attr     (js/get cfg .attr)
        shared   (js/get cfg .shared)
        dbg      (js/get cfg .dbg)
        dbg1     (js/get cfg .dbg1)
        recon-counter (js/get cfg .reconcile-counter)
        guarded? (js/get cfg .is-guarded)]
    (letfn [(set-hover [value] Any
          (dbg "setHover" {:value value})
          (cond
            (and value (js/get shared .ignore-next-hover))
            (rmattr! elem "gjoa-has-hover")
            value
            (let [cr (- (js/get st .collapse-until) (Date/now))]
              (if (> cr 0)
                (do
                  (dbg "setHover:revealDropped" {:collapseRemaining cr})
                  (when (js/get st .retry-timer) (clearTimeout (js/get st .retry-timer)))
                  (js/set! st .retry-timer
                    (setTimeout (fn [] Any
                      (js/set! st .retry-timer nil)
                      (when (not (has? elem "gjoa-has-hover"))
                        (let [wanted (or (js/get st .flash-timer)
                                         (js/call elem .matches ":hover")
                                         (some-> st (js/get .strip) (js/call .matches ":hover")))]
                          (dbg "setHover:retry" {:stillWanted wanted})
                          (when wanted (set-hover true)))))
                      (+ cr 16))))
                (do
                  (attr! elem "gjoa-has-hover" "true")
                  (when (js/get st .retry-timer)
                    (clearTimeout (js/get st .retry-timer))
                    (js/set! st .retry-timer nil)))))
            :else
            (when (has? elem "gjoa-has-hover")
              (rmattr! elem "gjoa-has-hover")
              (js/set! st .collapse-until (+ (Date/now) (collapse-protection-duration-ms))))))

            (clear-flash [] Any
          (when (js/get st .flash-timer) (clearTimeout (js/get st .flash-timer)))
          (js/set! st .flash-timer nil))

            (cancel-watchdog [] Any
          (when (js/get st .watchdog) (clearTimeout (js/get st .watchdog)) (js/set! st .watchdog nil)))

            (flash [duration] Any
          (if (js/get st .flash-timer)
            (do (clearTimeout (js/get st .flash-timer)) (dbg "flash:extend" {:duration duration}))
            (do (dbg "flash:show" {:duration duration})
                (requestAnimationFrame (fn [] Any (set-hover true)))))
          (js/set! st .flash-timer
            (setTimeout (fn [] Any
              (requestAnimationFrame (fn [] Any
                (recon-counter)
                (if (guarded?)
                  (do (dbg1 "flash:hide-blocked") (schedule-watchdog))
                  (set-hover false))
                (js/set! st .flash-timer nil))))
              duration)))

            (reconcile [trigger] Any
          (when (has? check-el attr)
            (let [before {:hover (has? elem "gjoa-has-hover")
                          :flashPending (bool (js/get st .flash-timer))
                          :ignoreNextHover (js/get shared .ignore-next-hover)
                          :openPopups (js/get shared .open-popups)}]
              (js/set! shared .ignore-next-hover false)
              (recon-counter)
              (let [cursor-over (or (js/call elem .matches ":hover")
                                     (some-> st (js/get .strip) (js/call .matches ":hover")))
                    guarded (guarded?)]
                (cond
                  (or guarded cursor-over)
                  (do (when (not (has? elem "gjoa-has-hover"))
                        (attr! elem "gjoa-has-hover" "true"))
                      (schedule-watchdog))
                  (js/get st .flash-timer)
                  (dbg1 "reconcile:flashPending")
                  :else
                  (do (set-hover false) (cancel-watchdog)))
                (dbg "reconcile"
                  {:trigger trigger :before before :cursorOver cursor-over :guarded guarded
                   :after {:hover (has? elem "gjoa-has-hover")
                           :flashPending (bool (js/get st .flash-timer))
                           :ignoreNextHover (js/get shared .ignore-next-hover)}})))))

            (schedule-watchdog [] Any
          (when (not (js/get st .watchdog))
            (js/set! st .watchdog
              (setTimeout (fn [] Any (js/set! st .watchdog nil) (reconcile "hide-watchdog-1s")) 1000))))]
      {:set-hover set-hover :flash flash :reconcile reconcile
       :schedule-watchdog schedule-watchdog :clear-flash clear-flash
       :cancel-watchdog cancel-watchdog})))

(js/export (defn make-compact! [(deps Any)] Any
  (let [sidebar-main (js/get deps .sidebarMain)
        navigator-toolbox (js/get deps .navigatorToolbox)
        urlbar (js/get deps .urlbar)
        doc-el (js/get document .documentElement)

        COMPACT-PREF "gjoa.sidebar.compact"
        HORIZONTAL-COMPACT-PREF "gjoa.toolbar.compact"
        KEEP-HOVER-DURATION 150
        OFFSCREEN-SHOW-DURATION 1000
        FLASH-DURATION 800

        hover-hack-delay (fn [] Any (pref-int "gjoa.compact.hoverHackDelay" 0))

        log (create-logger! "compact")

        vstate {:strip nil :flash-timer nil :urlbar-obs nil
                :collapse-until 0 :retry-timer nil :watchdog nil}
        hstate {:strip nil :flash-timer nil :urlbar-obs nil
                :collapse-until 0 :retry-timer nil :watchdog nil}

        shared {:ignore-next-hover false :open-popups 0 :pin-release-deferred false}

        ;; SYNCHRONOUS menu probe. openPopupAtScreen sets menupopup state before the
        ;; async popupshown that bumps open-popups, so the counter alone loses the race.
        menu-open? (fn [] Any
          (bool (q document
                   "menupopup:is([state='open'],[state='showing'],[open]), panel[panelopen]")))

        ensure-popover (fn [] Any
          (when (not (js/call urlbar .matches ":popover-open")) (js/call urlbar .showPopover)))

        dbg (fn [event data] Any
          (log event
            (Object/assign
              {:compact (has? sidebar-main "data-gjoa-compact")
               :compactHz (has? doc-el "data-gjoa-compact-horizontal")
               :hover (has? sidebar-main "gjoa-has-hover")
               :hoverHz (has? navigator-toolbox "gjoa-has-hover")
               :openPopups (js/get shared .open-popups)
               :flashPending (bool (js/get vstate .flash-timer))}
              data)))

        dbg1 (fn [%1] Any (dbg %1 {}))

        is-ignored-popup (fn [e] Any
          (let [path (some-> e (js/get .composedPath) (js/call .composedPath))
                el (if (and path (aget path 0)) (aget path 0) (js/get e .target))]
            (or (= (js/get el .localName) "tooltip") (= (js/get el .id) "tab-preview-panel"))))

        on-popup-shown (fn [e] Any
          (when (not (is-ignored-popup e))
            (js/set! shared .open-popups (+ (js/get shared .open-popups) 1))
            (let [t (js/get e .target)]
              (dbg "popupshown" {:id (js/get t .id) :tag (js/get t .localName) :_openPopups (js/get shared .open-popups)}))))

        reconcile-counter-if-stale (fn [] Any
          (when (> (js/get shared .open-popups) 0)
            (let [live (q document
                         (str "panel[panelopen='true'], panel[open='true'], "
                              "menupopup[state='open'], menupopup[state='showing'], "
                              "menupopup[open='true']"))]
              (when (not live)
                (dbg "reconcileCounterIfStale:reset" {:stale (js/get shared .open-popups)})
                (js/set! shared .open-popups 0)))))

        is-guarded (fn [] Any
          (bool (or (> (js/get shared .open-popups) 0)
                    ;; #127: `e` (or a future toolbar action) can PIN the overlay open in
                    ;; compact mode — keep it revealed regardless of cursor/menus.
                    (has? sidebar-main "gjoa-pinned")
                    ;; A context menu opened via openPopupAtScreen (tab/group menus / a
                    ;; right-clicked sidebar button) sets state SYNCHRONOUSLY, before the
                    ;; async popupshown that bumps open-popups — and the 0ms mouseleave-
                    ;; collapse check can run in that gap. Query the live menu directly
                    ;; (any open-ish state) so the sidebar never collapses out from under
                    ;; an open menu (#127: right-click a sidebar button keeps it revealed).
                    (menu-open?)
                    (and urlbar (has? urlbar "breakout-extend"))
                    (q document "toolbarbutton[open='true']")
                    (q document ".tabbrowser-tab[multiselected]")
                    (q document "[gjoa-dragging]"))))

        vops (make-mode-ops! {:st vstate :elem sidebar-main :check-el sidebar-main
                             :attr "data-gjoa-compact" :shared shared
                             :dbg dbg :dbg1 dbg1
                             :reconcile-counter reconcile-counter-if-stale
                             :is-guarded is-guarded})
        set-hover (js/get vops .set-hover)
        clear-flash (js/get vops .clear-flash)
        cancel-hide-watchdog (js/get vops .cancel-watchdog)
        flash-sidebar (js/get vops .flash)
        reconcile-compact-state (js/get vops .reconcile)
        schedule-hide-watchdog (js/get vops .schedule-watchdog)

        hops (make-mode-ops! {:st hstate :elem navigator-toolbox
                             :check-el doc-el
                             :attr "data-gjoa-compact-horizontal" :shared shared
                             :dbg dbg :dbg1 dbg1
                             :reconcile-counter reconcile-counter-if-stale
                             :is-guarded is-guarded})
        set-toolbox-hover (js/get hops .set-hover)
        clear-flash-toolbox (js/get hops .clear-flash)
        cancel-hide-watchdog-hz (js/get hops .cancel-watchdog)
        flash-toolbox (js/get hops .flash)
        reconcile-compact-state-horizontal (js/get hops .reconcile)

        on-popup-hidden (fn [e] Any
          (when (not (is-ignored-popup e))
            (js/set! shared .open-popups (Math/max 0 (- (js/get shared .open-popups) 1)))
            (let [t (js/get e .target)]
              (dbg "popuphidden" {:id (js/get t .id) :tag (js/get t .localName) :_openPopups (js/get shared .open-popups)}))
            ;; Release a pin whose clear on-sidebar-leave deferred, once the menu is
            ;; really gone and the pointer is off the sidebar — otherwise a right-click
            ;; that only opened the menu leaves the drawer pinned forever.
            (when (and (js/get shared .pin-release-deferred)
                       (has? sidebar-main "gjoa-pinned")
                       (not (menu-open?))
                       (not (js/call sidebar-main .matches ":hover")))
              (js/set! shared .pin-release-deferred false)
              (rmattr! sidebar-main "gjoa-pinned")
              (dbg1 "popuphidden:pin-release")
              (reconcile-compact-state "popuphidden-pin-release"))))]

    (let [on-sidebar-enter (fn [event] Any
            ;; a fresh sidebar interaction owns the pin; a deferred clear is stale.
            (js/set! shared .pin-release-deferred false)
            (let [target (js/get event .target)
                  target-id (or (js/get target .id) (js/get target .localName))]
              (dbg "onSidebarEnter:entry" {:targetId target-id :_ignoreNextHover (js/get shared .ignore-next-hover) :flashPending (bool (js/get vstate .flash-timer))})
              (when (> (js/get vstate .collapse-until) (Date/now))
                (dbg "onSidebarEnter:cancel-collapse-protection-sync"
                  {:remainingMs (- (js/get vstate .collapse-until) (Date/now)) :targetId target-id})
                (js/set! vstate .collapse-until 0))
              (setTimeout (fn [] Any
                (cond
                  (not (js/call target .matches ":hover"))
                  (do (dbg "onSidebarEnter:abort" {:reason "not-hovered-after-tick" :targetId target-id})
                      (reconcile-compact-state "sidebar-enter-not-hovered"))
                  (js/call target .closest "panel")
                  (dbg "onSidebarEnter:abort" {:reason "from-panel" :targetId target-id})
                  :else
                  (do (clear-flash)
                      (requestAnimationFrame (fn [] Any
                        (cond
                          (js/get shared .ignore-next-hover)
                          (dbg "onSidebarEnter:abort" {:reason "ignore-next-hover-rAF" :targetId target-id})
                          (has? sidebar-main "gjoa-has-hover")
                          (dbg "onSidebarEnter:abort" {:reason "already-has-hover" :targetId target-id})
                          :else
                          (do (dbg "onSidebarEnter:show" {:targetId target-id})
                              (set-hover true))))))))
                (hover-hack-delay))))

          on-sidebar-leave (fn [event] Any
            ;; #127: leaving the sidebar dismisses an `e`-pinned reveal — clearing the pin
            ;; here drops the is-guarded hold so the normal leave→hide path runs. NOT while
            ;; a menu is open: a right-click's openPopupAtScreen fires this in the same
            ;; tick, and this clear runs BEFORE the is-guarded check below ever sees it.
            ;; on-popup-hidden performs the deferred clear.
            (if (menu-open?)
              (js/set! shared .pin-release-deferred true)
              (rmattr! sidebar-main "gjoa-pinned"))
            (let [target (js/get event .target)
                  target-id (or (js/get target .id) (js/get target .localName))
                  exited-window (not (js/get event .relatedTarget))
                  linger-ms (if exited-window OFFSCREEN-SHOW-DURATION KEEP-HOVER-DURATION)]
              (dbg "onSidebarLeave:entry" {:targetId target-id :_ignoreNextHover (js/get shared .ignore-next-hover) :exitedWindow exited-window :lingerMs linger-ms})
              (setTimeout (fn [] Any
                (cond
                  (js/call target .matches ":hover")
                  (dbg "onSidebarLeave:abort" {:reason "still-hovered-after-tick" :targetId target-id})
                  (js/get shared .ignore-next-hover)
                  (dbg "onSidebarLeave:abort" {:reason "ignore-next-hover" :targetId target-id})
                  (is-guarded)
                  (dbg "onSidebarLeave:abort" {:reason "guarded" :targetId target-id})
                  :else
                  (do (dbg "onSidebarLeave:flash" {:targetId target-id :duration linger-ms})
                      (flash-sidebar linger-ms))))
                (hover-hack-delay))))

          on-doc-mouse-leave (fn [e] Any
            (when (and (has? sidebar-main "data-gjoa-compact")
                       (not (has? sidebar-main "gjoa-has-hover"))
                       (not (js/get shared .ignore-next-hover)))
              (let [trigger-width (parseInt
                                    (or (js/call (getComputedStyle doc-el) .getPropertyValue
                                          "--gjoa-compact-trigger-width")
                                        "8")
                                    10)
                    on-left (pref-bool "sidebar.position_start" true)
                    near-edge (if on-left
                                (<= (js/get e .clientX) (* trigger-width 3))
                                (>= (js/get e .clientX) (- (js/get window .innerWidth) (* trigger-width 3))))]
                (when near-edge
                  (dbg "onDocMouseLeave:show" {:clientX (js/get e .clientX) :onLeft on-left})
                  (flash-sidebar OFFSCREEN-SHOW-DURATION)))))

          on-toolbox-enter (fn [event] Any
            (let [target (js/get event .target)]
              (when (> (js/get hstate .collapse-until) (Date/now))
                (js/set! hstate .collapse-until 0))
              (setTimeout (fn [] Any
                (cond
                  (not (js/call target .matches ":hover"))
                  (reconcile-compact-state-horizontal "toolbox-enter-not-hovered")
                  (js/call target .closest "panel") nil
                  :else
                  (do (clear-flash-toolbox)
                      (requestAnimationFrame (fn [] Any
                        (when (and (not (js/get shared .ignore-next-hover))
                                   (not (has? navigator-toolbox "gjoa-has-hover")))
                          (set-toolbox-hover true)))))))
                (hover-hack-delay))))

          on-toolbox-leave (fn [event] Any
            (let [target (js/get event .target)
                  exited-window (not (js/get event .relatedTarget))
                  linger-ms (if exited-window OFFSCREEN-SHOW-DURATION KEEP-HOVER-DURATION)]
              (setTimeout (fn [] Any
                (when (and (not (js/call target .matches ":hover"))
                           (not (js/get shared .ignore-next-hover))
                           (not (is-guarded)))
                  (flash-toolbox linger-ms)))
                (hover-hack-delay))))

          on-doc-mouse-leave-top (fn [e] Any
            (when (and (has? doc-el "data-gjoa-compact-horizontal")
                       (not (has? navigator-toolbox "gjoa-has-hover"))
                       (not (js/get shared .ignore-next-hover)))
              (let [trigger-height (parseInt
                                     (or (js/call (getComputedStyle doc-el) .getPropertyValue
                                           "--gjoa-compact-trigger-width")
                                         "8")
                                     10)]
                (when (<= (js/get e .clientY) (* trigger-height 3))
                  (dbg "onDocMouseLeaveTop:show" {:clientY (js/get e .clientY)})
                  (flash-toolbox OFFSCREEN-SHOW-DURATION)))))

          compact-enable (fn [] Any
            (dbg1 "compactEnable")
            (attr! sidebar-main "data-gjoa-compact" "")
            (when (and urlbar (not (js/get vstate .urlbar-obs)))
              (rmattr! urlbar "popover")
              (js/set! vstate .urlbar-obs
                (js/new MutationObserver (fn [] Any
                  (when (and (has? sidebar-main "data-gjoa-compact")
                             (not (has? doc-el "gjoa-urlbar-floating")))
                    (if (has? urlbar "breakout-extend")
                        (do
                          (dbg1 "urlbar:breakout-open")
                          (attr! urlbar "popover" "manual")
                          (ensure-popover))
                        (do
                          (dbg1 "urlbar:breakout-close")
                          (rmattr! urlbar "popover")
                          (let [cursor-over (or (js/call sidebar-main .matches ":hover")
                                                 (some-> vstate (js/get .strip) (js/call .matches ":hover")))]
                            (if cursor-over
                              (dbg1 "urlbar:breakout-close:keep-open")
                              (do
                                (dbg1 "urlbar:breakout-close:close")
                                (clear-flash)
                                (cancel-hide-watchdog)
                                (when (has? sidebar-main "gjoa-has-hover")
                                  (rmattr! sidebar-main "gjoa-has-hover"))
                                (js/set! vstate .collapse-until
                                  (+ (Date/now) (collapse-protection-duration-ms))))))))))))
              (js/call (js/get vstate .urlbar-obs) .observe urlbar
                {:attributes true :attributeFilter ["breakout-extend"]}))
            (when (or (not (js/get vstate .strip)) (not (js/get (js/get vstate .strip) .isConnected)))
              (js/set! vstate .strip (xul-new "box"))
              (js/set! (js/get vstate .strip) .id "gjoa-hover-strip")
              (js/call (js/get sidebar-main .parentNode) .appendChild (js/get vstate .strip))
              (on! (js/get vstate .strip) "mouseenter" (fn [] Any
                (dbg "hoverStrip:mouseenter"
                  {:_ignoreNextHover (js/get shared .ignore-next-hover)
                   :flashPending (bool (js/get vstate .flash-timer))
                   :hasHover (has? sidebar-main "gjoa-has-hover")})
                (if (js/get shared .ignore-next-hover)
                  (dbg "hoverStrip:abort" {:reason "ignore-next-hover-sync"})
                  (flash-sidebar OFFSCREEN-SHOW-DURATION)))))
            (on! sidebar-main "mouseover" on-sidebar-enter)
            (on! sidebar-main "mouseleave" on-sidebar-leave)
            (on! doc-el "mouseleave" on-doc-mouse-leave))

          compact-disable (fn [] Any
            (dbg1 "compactDisable")
            (clear-flash)
            (cancel-hide-watchdog)
            (rmattr! sidebar-main "data-gjoa-compact")
            (rmattr! sidebar-main "gjoa-has-hover")
            (when (js/get vstate .urlbar-obs) (js/call (js/get vstate .urlbar-obs) .disconnect))
            (js/set! vstate .urlbar-obs nil)
            (when urlbar
              (attr! urlbar "popover" "manual")
              (ensure-popover))
            (when (js/get vstate .strip)
              (js/call (js/get vstate .strip) .remove)
              (js/set! vstate .strip nil))
            (off! sidebar-main "mouseover" on-sidebar-enter)
            (off! sidebar-main "mouseleave" on-sidebar-leave)
            (off! doc-el "mouseleave" on-doc-mouse-leave))

          compact-enable-horizontal (fn [] Any
            (when (not (has? doc-el "data-gjoa-compact-horizontal"))
              (dbg1 "compactEnableHorizontal")
              (attr! doc-el "data-gjoa-compact-horizontal" "")
              (when (and urlbar (not (js/get hstate .urlbar-obs)))
                (rmattr! urlbar "popover")
                (js/set! hstate .urlbar-obs
                  (js/new MutationObserver (fn [] Any
                    (when (and (has? doc-el "data-gjoa-compact-horizontal")
                               (not (has? doc-el "gjoa-urlbar-floating")))
                      (if (has? urlbar "breakout-extend")
                          (do
                            (attr! urlbar "popover" "manual")
                            (ensure-popover))
                          (rmattr! urlbar "popover"))))))
                (js/call (js/get hstate .urlbar-obs) .observe urlbar
                  {:attributes true :attributeFilter ["breakout-extend"]}))
              (when (or (not (js/get hstate .strip)) (not (js/get (js/get hstate .strip) .isConnected)))
                (js/set! hstate .strip (xul-new "box"))
                (js/set! (js/get hstate .strip) .id "gjoa-hover-strip-top")
                (js/call doc-el .appendChild (js/get hstate .strip))
                (on! (js/get hstate .strip) "mouseenter"
                (fn [] Any (when (not (js/get shared .ignore-next-hover))
                   (flash-toolbox OFFSCREEN-SHOW-DURATION)))))
              (on! navigator-toolbox "mouseover" on-toolbox-enter)
              (on! navigator-toolbox "mouseleave" on-toolbox-leave)
              (on! doc-el "mouseleave" on-doc-mouse-leave-top)))

          compact-disable-horizontal (fn [] Any
            (when (has? doc-el "data-gjoa-compact-horizontal")
              (dbg1 "compactDisableHorizontal")
              (clear-flash-toolbox)
              (cancel-hide-watchdog-hz)
              (rmattr! doc-el "data-gjoa-compact-horizontal")
              (rmattr! navigator-toolbox "gjoa-has-hover")
              (when (js/get hstate .urlbar-obs) (js/call (js/get hstate .urlbar-obs) .disconnect))
              (js/set! hstate .urlbar-obs nil)
              (when urlbar
                (attr! urlbar "popover" "manual")
                (ensure-popover))
              (when (js/get hstate .strip)
                (js/call (js/get hstate .strip) .remove)
                (js/set! hstate .strip nil))
              (off! navigator-toolbox "mouseover" on-toolbox-enter)
              (off! navigator-toolbox "mouseleave" on-toolbox-leave)
              (off! doc-el "mouseleave" on-doc-mouse-leave-top)))]

      (let [apply-compact-for-current-mode (fn [] Any
              (let [vertical (pref-bool "sidebar.verticalTabs" true)]
                (if vertical
                  (when (and (pref-bool COMPACT-PREF false)
                             (not (has? sidebar-main "data-gjoa-compact")))
                    (compact-enable))
                  (when (and (pref-bool HORIZONTAL-COMPACT-PREF false)
                             (not (has? doc-el "data-gjoa-compact-horizontal")))
                    (compact-enable-horizontal)))))

            compact-toggle (fn [] Any
              (let [vertical (pref-bool "sidebar.verticalTabs" true)]
                (if vertical
                  (let [active (has? sidebar-main "data-gjoa-compact")]
                    (dbg "compactToggle:vertical" {:wasActive active})
                    (if active
                      (do (compact-disable) (set-pref-bool! COMPACT-PREF false))
                      (do (js/set! shared .ignore-next-hover true)
                          (compact-enable)
                          (set-pref-bool! COMPACT-PREF true)
                          (let [safety-timer (setTimeout (fn [] Any (reconcile-compact-state "safety-timer-400ms")) 400)
                                handler (fn [e] Any
                                          (when (and (identical? (js/get e .target) sidebar-main) (= (js/get e .propertyName) "transform"))
                                            (off! sidebar-main "transitionend" handler)
                                            (clearTimeout safety-timer)
                                            (reconcile-compact-state "transitionend-transform")))]
                            (on! sidebar-main "transitionend" handler)))))
                  (let [active (has? doc-el "data-gjoa-compact-horizontal")]
                    (dbg "compactToggle:horizontal" {:wasActive active})
                    (if active
                      (do (compact-disable-horizontal) (set-pref-bool! HORIZONTAL-COMPACT-PREF false))
                      (do (js/set! shared .ignore-next-hover true)
                          (compact-enable-horizontal)
                          (set-pref-bool! HORIZONTAL-COMPACT-PREF true)
                          (let [safety-timer (setTimeout (fn [] Any (reconcile-compact-state-horizontal "safety-timer-400ms-hz")) 400)
                                handler (fn [e] Any
                                          (when (and (identical? (js/get e .target) navigator-toolbox) (= (js/get e .propertyName) "transform"))
                                            (off! navigator-toolbox "transitionend" handler)
                                            (clearTimeout safety-timer)
                                            (reconcile-compact-state-horizontal "transitionend-transform-hz")))]
                            (on! navigator-toolbox "transitionend" handler))))))))

            compact-observer {:observe (fn [] Any
              (let [vertical (pref-bool "sidebar.verticalTabs" true)]
                (when vertical
                  (let [enabled (pref-bool COMPACT-PREF false)
                        active (has? sidebar-main "data-gjoa-compact")]
                    (when (and enabled (not active)) (compact-enable))
                    (when (and (not enabled) active) (compact-disable))))))}

            compact-observer-hz {:observe (fn [] Any
              (let [vertical (pref-bool "sidebar.verticalTabs" true)]
                (when (not vertical)
                  (let [enabled (pref-bool HORIZONTAL-COMPACT-PREF false)
                        active (has? doc-el "data-gjoa-compact-horizontal")]
                    (when (and enabled (not active)) (compact-enable-horizontal))
                    (when (and (not enabled) active) (compact-disable-horizontal))))))}

            vertical-tabs-observer {:observe (fn [] Any
              (let [vertical (pref-bool "sidebar.verticalTabs" true)]
                (dbg "verticalTabs:change" {:vertical vertical})
                (if vertical
                  (compact-disable-horizontal)
                  (compact-disable))
                (apply-compact-for-current-mode)))}

            on-pfx-dismiss (fn [] Any
              (js/set! shared .ignore-next-hover true)
              (set-hover false)
              (clear-flash)
              (setTimeout (fn [] Any (js/set! shared .ignore-next-hover false))
                (+ KEEP-HOVER-DURATION 100)))

            on-pfx-flash (fn [] Any (when (has? sidebar-main "data-gjoa-compact")
                            (flash-sidebar FLASH-DURATION)))

            on-sizemode-change (fn [] Any (reconcile-compact-state "sizemodechange"))

            on-window-blur (fn [%1] Any (when (identical? (js/get %1 .target) window)
                              (reconcile-compact-state "window-blur")))

            pin-sidebar (fn [] Any
              (attr! sidebar-main "gjoa-has-hover" "true")
              (clear-flash))

            pin-toolbox (fn [] Any
              (attr! navigator-toolbox "gjoa-has-hover" "true")
              (clear-flash-toolbox))

            destroy (fn [] Any
              (off! document "popupshown" on-popup-shown)
              (off! document "popuphidden" on-popup-hidden)
              (off! sidebar-main "gjoa-dismiss" on-pfx-dismiss)
              (off! sidebar-main "gjoa-flash" on-pfx-flash)
              (off! window "sizemodechange" on-sizemode-change)
              (off! window "blur" on-window-blur)
              (js/call (js/get Services .prefs) .removeObserver COMPACT-PREF compact-observer)
              (js/call (js/get Services .prefs) .removeObserver HORIZONTAL-COMPACT-PREF compact-observer-hz)
              (js/call (js/get Services .prefs) .removeObserver "sidebar.verticalTabs" vertical-tabs-observer)
              (cancel-hide-watchdog)
              (cancel-hide-watchdog-hz)
              (clear-flash)
              (clear-flash-toolbox)
              (when (js/get vstate .retry-timer)
                (clearTimeout (js/get vstate .retry-timer)))
              (when (js/get hstate .retry-timer)
                (clearTimeout (js/get hstate .retry-timer))))]

        (on! document "popupshown" on-popup-shown)
        (on! document "popuphidden" on-popup-hidden)
        (on! sidebar-main "gjoa-dismiss" on-pfx-dismiss)
        (on! sidebar-main "gjoa-flash" on-pfx-flash)
        (on! window "sizemodechange" on-sizemode-change)
        (on! window "blur" on-window-blur)
        (js/call (js/get Services .prefs) .addObserver COMPACT-PREF compact-observer)
        (js/call (js/get Services .prefs) .addObserver HORIZONTAL-COMPACT-PREF compact-observer-hz)
        (js/call (js/get Services .prefs) .addObserver "sidebar.verticalTabs" vertical-tabs-observer)
        (apply-compact-for-current-mode)

        {:toggle compact-toggle
         :reconcile reconcile-compact-state
         :reconcileHorizontal reconcile-compact-state-horizontal
         :flashSidebar flash-sidebar
         :flashToolbox flash-toolbox
         :pinSidebar pin-sidebar
         :pinToolbox pin-toolbox
         :isCompactVertical (fn [] Any (has? sidebar-main "data-gjoa-compact"))
         :isCompactHorizontal (fn [] Any (has? doc-el "data-gjoa-compact-horizontal"))
         :destroy destroy})))))
