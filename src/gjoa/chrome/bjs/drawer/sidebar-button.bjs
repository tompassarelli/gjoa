#lang beagle/js
(ns gjoa.drawer.sidebar-button
  (:require [gjoa.macros :refer [by-id q xul-id attr! mi sep pref-bool set-pref-bool! on! off! has?]]
            [gjoa.tabs.log :refer [create-logger!]]))

(declare-extern [window undefined getComputedStyle] Any)

(defn install!
  [sidebar-button Any
   sidebar-main Any
   compact Any]
  Any
  (let [og-icon Any (q sidebar-button ".toolbarbutton-icon")
        og-icon-style Any (if og-icon
                        (js/get (getComputedStyle og-icon) .listStyleImage)
                        nil)]

    (js/set! (js/get sidebar-button .style) .display "none")

    (let [button Any (xul-id "toolbarbutton" "gjoa-sidebar-button")]
      (js/set! button .className (js/get sidebar-button .className))
      (attr! button "tooltiptext" "Toggle compact mode (right-click for more)")

      (js/call ["cui-areatype" "widget-id" "widget-type" "removable" "overflows"] .forEach
        (fn [%1 Any] Any (when (has? sidebar-button %1)
           (attr! button %1 (or (js/call sidebar-button .getAttribute %1) "")))))

      ;; Must follow the copy loop — it copies `removable` off the native widget.
      ;; CustomizableUI's buildArea sweeps unregistered removable toolbarbuttons out
      ;; of #nav-bar into the palette; skipintoolbarset is the escape hatch.
      (attr! button "removable" "false")
      (attr! button "skipintoolbarset" "true")

      (when og-icon-style
        (js/set! (js/get button .style) .listStyleImage og-icon-style))

      ;; Order (owner spec 2026-07-11): sidebar-toggle sits immediately RIGHT of
      ;; the refresh (stop-reload) button, INSIDE nav-bar-customization-target's
      ;; left cluster. Horizontal mode then reads [← → ↻ □] …url… [🧩 ☰]: sidebar
      ;; right of refresh, and extensions (last target child) left of the hamburger.
      ;; Because the button is now a target grandchild (not a direct #nav-bar child),
      ;; the `#nav-bar > #gjoa-sidebar-button` order rules stop matching it — per-mode
      ;; CSS positions it from here (see chrome/css/gjoa.uc.css nav-bar layout block).
      ;; Fall back to after the hamburger, then after the native sidebar button.
      (let [nav-bar Any (by-id "nav-bar")
            reload-btn Any (by-id "stop-reload-button")
            panel-ui Any (by-id "PanelUI-button")]
        (cond
          reload-btn
          (js/call reload-btn .after button)
          (and nav-bar panel-ui (identical? (js/get panel-ui .parentNode) nav-bar))
          (js/call panel-ui .after button)
          :else
          (js/call sidebar-button .after button)))

      ;; APPEND only (never prepend): tabs/layout.bjs + drawer/layout.bjs both do
      ;; first-child identity checks on sidebar-main's children. CSS order:-1 renders it first.
      (let [strip-hide-button Any (xul-id "toolbarbutton" "gjoa-strip-hide-button")
            on-strip-hide-click (Fn [] Any) (fn [] Any (set-pref-bool! "gjoa.layout.horizontalSidebarStrip" false))
            on-click (Fn [Any] Any) (fn [%1 Any] Any (when (= (js/get %1 .button) 0)
                         (js/call compact .toggle)))]
        (attr! strip-hide-button "tooltiptext" "Hide strip")
        (on! strip-hide-button "click" on-strip-hide-click)
        (js/call sidebar-main .append strip-hide-button)

        (on! button "click" on-click)

        (let [menu Any (xul-id "menupopup" "gjoa-sidebar-button-menu")]

          (let [compact-item Any (mi "Enable Compact" (fn [] Any (js/call compact .toggle)))

                collapse-item Any (mi "Collapse Layout"
                                (fn [] Any
                                  (try
                                    (let [prev-display Any (js/get (js/get sidebar-button .style) .display)]
                                      (js/set! (js/get sidebar-button .style) .display "")
                                      (js/call sidebar-button .click)
                                      (js/set! (js/get sidebar-button .style) .display prev-display))
                                    (catch (e Any)
                                      (console/error "[GJOA:drawer] collapse layout failed" e)))))

                strip-item Any (mi "Show Strip"
                             (fn [] Any (let [cur Bool (pref-bool "gjoa.layout.horizontalSidebarStrip" false)]
                                (set-pref-bool! "gjoa.layout.horizontalSidebarStrip" (not cur)))))

                sidebar-item Any (mi "Enable Sidebar"
                               (fn [] Any
                                 (try
                                   (cond
                                     (and (js/get window .SidebarController) (js/get (js/get window .SidebarController) .toggle))
                                     (js/call (js/get window .SidebarController) .toggle)
                                     (and (js/get window .SidebarUI) (js/get (js/get window .SidebarUI) .toggle))
                                     (js/call (js/get window .SidebarUI) .toggle)
                                     :else
                                     (let [cmd Any (by-id "cmd_toggleSidebar")]
                                       (if (and cmd (js/get cmd .doCommand))
                                         (js/call cmd .doCommand)
                                         (console/error "[GJOA:drawer] no sidebar-toggle API available"))))
                                   (catch (e Any)
                                     (console/error "[GJOA:drawer] sidebar toggle failed" e)))))

                layout-item Any (mi "Horizontal Tabs"
                              (fn [] Any (let [vertical Bool (pref-bool "sidebar.verticalTabs" true)]
                                 (set-pref-bool! "sidebar.verticalTabs" (not vertical)))))

                customize-item Any (mi "Customize Sidebar"
                                 (fn [] Any
                                   (try
                                     (let [native Any (by-id "toolbar-context-customize-sidebar")]
                                       (if (and native (js/get native .doCommand))
                                         (js/call native .doCommand)
                                         (when (and native (js/get native .click))
                                           (js/call native .click))))
                                     (catch (e Any)
                                       (console/error "gjoa: customize sidebar failed" e)))))
                block-item Any (mi "Disable Blocking"
                             (fn [] Any (when (js/get window .gjoaBlocking) (js/call (js/get window .gjoaBlocking) .toggle))))]

            (js/set! compact-item .id "gjoa-toggle-compact")
            (js/set! collapse-item .id "gjoa-collapse-layout")
            (js/set! strip-item .id "gjoa-toggle-strip")
            (js/set! sidebar-item .id "gjoa-toggle-sidebar")
            (js/set! layout-item .id "gjoa-toggle-tab-layout")
            (js/set! customize-item .id "gjoa-customize-sidebar")
            (js/set! block-item .id "gjoa-toggle-blocking")

            (js/call menu .append compact-item collapse-item strip-item sidebar-item layout-item (sep) block-item customize-item)

            (let [popup-set Any (by-id "mainPopupSet")]
              (when popup-set
                (js/call popup-set .append menu)))

            (attr! button "context" "gjoa-sidebar-button-menu")

            (let [on-popup-showing (Fn [] Any) (fn [] Any
                                    (let [vertical Bool (pref-bool "sidebar.verticalTabs" true)
                                          is-compact Any (if vertical
                                                       (js/call compact .isCompactVertical)
                                                       (js/call compact .isCompactHorizontal))]
                                      (attr! compact-item "label" (if is-compact "Disable Compact" "Enable Compact"))
                                      (js/set! collapse-item .hidden (not vertical))
                                      (when vertical
                                        (let [expanded Bool (has? sidebar-main "sidebar-launcher-expanded")]
                                          (attr! collapse-item "label" (if expanded "Collapse Layout" "Expand Layout"))))
                                      (js/set! strip-item .hidden vertical)
                                      (when (not vertical)
                                        (let [strip-on Bool (pref-bool "gjoa.layout.horizontalSidebarStrip" false)]
                                          (attr! strip-item "label" (if strip-on "Hide Strip" "Show Strip"))))
                                      (let [sidebar-open Any (if (and (js/get window .SidebarController)
                                                                  (not= (js/get (js/get window .SidebarController) .isOpen) undefined))
                                                           (js/get (js/get window .SidebarController) .isOpen)
                                                           (and (not (js/get sidebar-main .hidden))
                                                                (> (js/get (js/call sidebar-main .getBoundingClientRect) .width) 0)))]
                                        (attr! sidebar-item "label" (if sidebar-open "Disable Sidebar" "Enable Sidebar")))
                                      (attr! layout-item "label" (if vertical "Horizontal Tabs" "Vertical Tabs"))
                                      (when (js/get window .gjoaBlocking)
                                        (attr! block-item "label"
                                          (if (js/call (js/get window .gjoaBlocking) .enabled) "Disable Blocking" "Enable Blocking")))
                                      (when (js/call compact .isCompactVertical) (js/call compact .pinSidebar))
                                      (when (js/call compact .isCompactHorizontal) (js/call compact .pinToolbox))))

                  on-popup-hidden (Fn [] Any) (fn [] Any
                                   (js/call compact .reconcile "menu:popuphidden")
                                   (js/call compact .reconcileHorizontal "menu:popuphidden"))]

              (on! menu "popupshowing" on-popup-showing)
              (on! menu "popuphidden" on-popup-hidden)

              {:destroy (fn [] Any
                (off! button "click" on-click)
                (off! strip-hide-button "click" on-strip-hide-click)
                (off! menu "popupshowing" on-popup-showing)
                (off! menu "popuphidden" on-popup-hidden)
                (js/call menu .remove)
                (js/call button .remove)
                (js/call strip-hide-button .remove)
                (js/set! (js/get sidebar-button .style) .display ""))})))))))

(js/export (defn make-sidebar-button! [deps Any] Any
  (let [{:keys [sidebarMain compact]} Any deps
        log Any (create-logger! "drawer/sidebar-button")
        sidebar-main Any sidebarMain
        ;; drawer/layout's heal-once! ran first (index.bjs calls make-layout! before
        ;; this, unguarded), so the native node is already restored where possible.
        native Any (by-id "sidebar-button")]
    (if native
      (install! native sidebar-main compact)
      (do (log "init:no native #sidebar-button after nav-bar repair — skipping custom-button swap")
          {:destroy (fn [] Any (do nil))})))))
