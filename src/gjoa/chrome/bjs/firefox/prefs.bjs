#lang beagle/js
(ns gjoa.firefox.prefs
  (:require [gjoa.macros :refer [pref-bool pref-int pref-str
                                 set-pref-bool! set-pref-int! set-pref-str!]]))
(define-mode strict)

(declare-extern [Services console] Any)

;; guard!/quiet! (gjoa.macros) leak literal ~@ into the gjoa-tabs bundle (a beagle bundler
;; macro-order quirk), so their try/catch is inlined here directly. See @019f0beb-4bdc.

(js/export (defn get-bool [name :- String default-value :- Any] :- Any
  (pref-bool name (or default-value false))))

(js/export (defn set-bool [name :- String value :- Any] :- Any
  (set-pref-bool! name value)))

(js/export (defn get-int [name :- String default-value :- Any] :- Any
  (pref-int name (or default-value 0))))

(js/export (defn set-int [name :- String value :- Any] :- Any
  (set-pref-int! name value)))

(js/export (defn get-string [name :- String default-value :- Any] :- Any
  (pref-str name (or default-value ""))))

(js/export (defn set-string [name :- String value :- Any] :- Any
  (set-pref-str! name value)))

(js/export (defn ensure-vertical-tabs-default [] :- Any
  (let [prefs (.-prefs Services)]
    (try
      (when (not (.prefHasUserValue prefs "sidebar.verticalTabs"))
        (.setBoolPref prefs "sidebar.verticalTabs" true))
      (catch Any _e nil)))))

(js/export (defn apply-menubar-default [doc :- Any] :- Any
  (try
    (let [mb (.getElementById doc "toolbar-menubar")]
      (when mb (.setAttribute mb "autohide" "false")))
    (catch Any _e nil))))

(js/export (defn observe [name :- String handler :- Any] :- Any
  (let [observer {:observe (fn [_subject _topic data]
                    (try (handler data)
                      (catch Any _e (.error console (str "gjoa prefs observer " name ":") _e))))}]
    (try (.addObserver (.-prefs Services) name observer) (catch Any _e nil))
    (fn []
      (try (.removeObserver (.-prefs Services) name observer) (catch Any _e nil))))))
