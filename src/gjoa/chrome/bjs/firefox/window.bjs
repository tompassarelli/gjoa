#lang beagle/js
(ns gjoa.firefox.window
  (:require [gjoa.macros :refer [by-id]]))

(declare-extern [gBrowserInit Services ChromeUtils undefined] Any)

(js/export (def ids Any
  {:sidebar-main        (fn [] Any (by-id "sidebar-container"))
   :navigator-toolbox   (fn [] Any (by-id "navigator-toolbox"))
   :urlbar              (fn [] Any (by-id "urlbar"))
   :urlbar-container    (fn [] Any (by-id "urlbar-container"))
   :nav-bar             (fn [] Any (by-id "nav-bar"))
   :tabs-toolbar        (fn [] Any (by-id "TabsToolbar"))
   :tabs-toolbar-target (fn [] Any (by-id "TabsToolbar-customization-target"))
   :tabbrowser-tabs     (fn [] Any (by-id "tabbrowser-tabs"))
   :main-popup-set      (fn [] Any (by-id "mainPopupSet"))
   :unified-extensions-button (fn [] Any (by-id "unified-extensions-button"))
   :sidebar-button      (fn [] Any (by-id "sidebar-button"))}))

(js/export (defn delayed-startup-finished [] Boolean
  (js/get gBrowserInit .delayedStartupFinished)))

(def state Any {:cached-principal undefined})

(js/export (defn system-principal! [] Any
  (if (= (js/get state .cached-principal) undefined)
    (let [p (js/call (js/get Services .scriptSecurityManager) .getSystemPrincipal)]
      (js/set! state .cached-principal p)
      p)
    (js/get state .cached-principal))))

(js/export (defn import-esm [(url String)] Any
  (js/call ChromeUtils .importESModule url)))
