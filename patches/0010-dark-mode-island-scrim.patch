# gjoa-patch:
#   baseline-firefox: 152.0.1
#   touches:
#     - servo/components/style/properties/computed_value_flags.rs
#     - servo/components/style/style_adjuster.rs
#     - layout/painting/nsDisplayList.cpp
#   depends-on:
#     - rust-field GeckoBackground.background_image | accessor=clone_background_image
#
gjoa dark mode — image-backed "island" detection + dark scrim (sibling to 0009).

A full-bleed raster background-image (a hero photo) with authored light text was
broken by the blanket luminance inversion: the text flipped to near-black over the
untouched dark image. This makes the engine backdrop-aware where bg meets fg.

- computed_value_flags.rs: new INHERITED bit SELF_OR_ANCESTOR_HAS_IMAGE_BACKDROP,
  propagated to a hero's descendants.
- style_adjuster.rs (set_bits): sets it for elements establishing a full-bleed
  RASTER hero (url()/image-set + cover/contain + non-tiled). Gradients, tiled
  textures, and decorative images are excluded.
- specified/color.rs: the foreground-inversion hook PRESERVES an inherited color
  (color/text-shadow/border-color) under an image backdrop so authored light text
  stays light; reset background-color still inverts (solid bgs go dark).
- nsDisplayList.cpp: paints a translucent dark scrim (gjoa.darkmode.scrim.alpha,
  default 140) over a hero's bg images, below content, so text reads on the photo.

Later additions to style_adjuster.rs (same region hook), documented here for
accuracy:
- wave-4 C4: restores authored-DARK background-colors the band map lightened
  (band-bijection recover authored L) and sets an inherited PRESERVED_DARK bit so
  descendant authored-light text is kept light.
- wave-2 M4a SURFACE RAMP-FREEZE: a transformed near-neutral surface whose
  recovered authored L is not dark (>= 0.40) is re-mapped monotonically onto a
  DARK surface ramp [floor, ~0.34], so no transformed surface stays bright (the
  bright-island class) and a black authored surface stays dark instead of the
  band's near-white ceiling. bg-only hook => text/marks untouched; the
  size-dependent large-text halation ceiling stays in the paint-time text solve.

diff --git a/layout/painting/nsDisplayList.cpp b/layout/painting/nsDisplayList.cpp
index 0243566..f8a4069 100644
--- a/layout/painting/nsDisplayList.cpp
+++ b/layout/painting/nsDisplayList.cpp
@@ -3137,6 +3137,63 @@ static nsDisplayBackgroundColor* CreateBackgroundColor(
                                                    aBgSC, aColor);
 }
 
+// gjoa dark mode: paint a translucent dark scrim over a hero photo's background
+// images (but under its content) so the inversion-preserved authored text stays
+// readable against the still-bright image. Gated on content color inversion and
+// on this frame establishing a stretched, non-tiled raster image backdrop.
+static void MaybeAppendDarkScrim(nsDisplayListBuilder* aBuilder,
+                                 nsIFrame* aFrame,
+                                 nsIFrame* aSecondaryReferenceFrame,
+                                 const nsRect& aBackgroundRect,
+                                 const ComputedStyle* aBgSC,
+                                 const nsStyleBorder& aBorder,
+                                 nsDisplayList* aBgItemList) {
+  if (!aFrame->PresContext()->ColorInversion()) {
+    return;
+  }
+
+  // The SELF_OR_ANCESTOR_HAS_IMAGE_BACKDROP ComputedValueFlags bit is only
+  // reachable through ComputedStyle's private Flags(), so re-derive the hero
+  // condition from the bottom background layer: a stretched (cover/contain),
+  // non-tiled url()/image-set raster image, matching style_adjuster.rs.
+  const nsStyleImageLayers::Layer& layer = aBgSC->StyleBackground()->BottomLayer();
+  const bool isRaster = layer.mImage.IsUrl() || layer.mImage.IsImageSet();
+  const bool stretched = layer.mSize.IsCover() || layer.mSize.IsContain();
+  const bool tiled =
+      layer.mRepeat.mXRepeat != StyleImageLayerRepeat::NoRepeat ||
+      layer.mRepeat.mYRepeat != StyleImageLayerRepeat::NoRepeat;
+  if (!isRaster || !stretched || tiled) {
+    return;
+  }
+
+  const uint8_t alpha = (uint8_t)std::clamp(
+      mozilla::Preferences::GetInt("gjoa.darkmode.scrim.alpha", 140), 0, 255);
+
+  Maybe<DisplayListClipState::AutoSaveRestore> clipState;
+  nsRect scrimRect = aBackgroundRect;
+  nsCSSRendering::ImageLayerClipState clip;
+  nsCSSRendering::GetImageLayerClip(
+      aBgSC->StyleBackground()->BottomLayer(), aFrame, aBorder, aBackgroundRect,
+      aBackgroundRect, false, aFrame->PresContext()->AppUnitsPerDevPixel(),
+      &clip);
+
+  scrimRect = scrimRect.Intersect(clip.mBGClipArea);
+  if (clip.mHasAdditionalBGClipArea) {
+    scrimRect = scrimRect.Intersect(clip.mAdditionalBGClipArea);
+  }
+  if (clip.mHasRoundedCorners) {
+    clipState.emplace(aBuilder);
+    clipState->ClipContentDescendants(clip.mBGClipArea, &clip.mRadii);
+  }
+
+  nsDisplayBackgroundColor* scrim =
+      CreateBackgroundColor(aBuilder, aFrame, aSecondaryReferenceFrame,
+                            scrimRect, aBgSC, NS_RGBA(0, 0, 0, alpha));
+  if (scrim) {
+    aBgItemList->AppendToTop(scrim);
+  }
+}
+
 static void DealWithWindowsAppearanceHacks(nsIFrame* aFrame,
                                            nsDisplayListBuilder* aBuilder) {
   if (!XRE_IsParentProcess()) {
@@ -3419,6 +3476,10 @@ AppendedBackgroundType nsDisplayBackgroundImage::AppendBackgroundItemsToTop(
             nsDisplayItem::ContainerASRType::Constant));
   }
 
+  // gjoa dark mode: scrim a hero photo above its images, below frame content.
+  MaybeAppendDarkScrim(aBuilder, aFrame, aSecondaryReferenceFrame,
+                       aBackgroundRect, bgSC, border, &bgItemList);
+
   if (!bgItemList.IsEmpty()) {
     aList->AppendToTop(&bgItemList);
     return AppendedBackgroundType::Background;
diff --git a/servo/components/style/properties/computed_value_flags.rs b/servo/components/style/properties/computed_value_flags.rs
index d13a344..443f449 100644
--- a/servo/components/style/properties/computed_value_flags.rs
+++ b/servo/components/style/properties/computed_value_flags.rs
@@ -123,6 +123,20 @@ bitflags! {
 
         /// Whether grid-auto-flow is author-specified.
         const HAS_AUTHOR_SPECIFIED_GRID_AUTO_FLOW = 1 << 23;
+
+        /// gjoa dark mode: this element or an ancestor establishes a full-bleed
+        /// raster image backdrop (a hero photo). The foreground-inversion hook
+        /// reads this to preserve authored text over the image instead of
+        /// flipping it blind, and the paint stage scrims such backdrops.
+        const SELF_OR_ANCESTOR_HAS_IMAGE_BACKDROP = 1 << 24;
+
+        /// gjoa dark mode: this element or an ancestor has an authored-DARK
+        /// background-color the engine preserved dark under inversion (a dark
+        /// region — masthead, card, top-layer dialog, scrim — on an otherwise
+        /// inverted page; see style_adjuster). The foreground-inversion hook
+        /// preserves authored-light inherited colors under it, so such regions
+        /// keep their authored light-on-dark polarity.
+        const SELF_OR_ANCESTOR_HAS_PRESERVED_DARK_BACKDROP = 1 << 25;
     }
 }
 
@@ -144,6 +158,8 @@ impl ComputedValueFlags {
             | Self::SELF_OR_ANCESTOR_HAS_CONTAIN_STYLE
             | Self::SELF_OR_ANCESTOR_HAS_SIZE_CONTAINER_TYPE
             | Self::IS_IN_APPEARANCE_BASE_SUBTREE
+            | Self::SELF_OR_ANCESTOR_HAS_IMAGE_BACKDROP
+            | Self::SELF_OR_ANCESTOR_HAS_PRESERVED_DARK_BACKDROP
     }
 
     /// Flags that may be propagated to descendants.
diff --git a/servo/components/style/style_adjuster.rs b/servo/components/style/style_adjuster.rs
index 1756b77..e666bf3 100644
--- a/servo/components/style/style_adjuster.rs
+++ b/servo/components/style/style_adjuster.rs
@@ -311,6 +311,177 @@ impl<'a, 'b: 'a> StyleAdjuster<'a, 'b> {
             self.style
                 .add_flags(ComputedValueFlags::SELF_OR_ANCESTOR_HAS_SIZE_CONTAINER_TYPE);
         }
+
+        // gjoa dark mode: flag elements that establish a full-bleed RASTER image
+        // backdrop (a hero photo) so the cascade foreground-inversion hook
+        // preserves authored text over it and the paint stage scrims it — rather
+        // than flipping light hero text to black over an untouched dark image.
+        // Only stretched (cover/contain), non-tiled url()/image-set layers
+        // qualify; gradients are recolored in place, and tiled/decorative images
+        // are excluded (the over-fire ChatGPT's naive "has background-image"
+        // predicate would cause). The bit is inherited, so a hero's descendants
+        // (its text) inherit it.
+        #[cfg(feature = "gecko")]
+        if !display.is_contents() {
+            use crate::values::generics::background::GenericBackgroundSize;
+            use crate::values::generics::image::GenericImage;
+            use crate::values::specified::background::BackgroundRepeatKeyword;
+            let bg = self.style.get_background();
+            // Gecko's Background exposes layers via clone_* accessors, not direct
+            // fields (that's the servo-only path). The clones are cheap here — most
+            // elements have a single `none` image layer.
+            let image_list = bg.clone_background_image();
+            let size_list = bg.clone_background_size();
+            let repeat_list = bg.clone_background_repeat();
+            let images = &image_list.0;
+            let sizes = &size_list.0;
+            let repeats = &repeat_list.0;
+            let mut hero = false;
+            for (i, image) in images.iter().enumerate() {
+                if !matches!(image, GenericImage::Url(..) | GenericImage::ImageSet(..)) {
+                    continue;
+                }
+                // background-size / -repeat lists may be shorter than the image
+                // list; CSS repeats them, so index modulo their length.
+                let size = &sizes[i % sizes.len()];
+                let stretched = matches!(
+                    size,
+                    GenericBackgroundSize::Cover | GenericBackgroundSize::Contain
+                );
+                let r = &repeats[i % repeats.len()];
+                let tiled = !matches!(r.0, BackgroundRepeatKeyword::NoRepeat)
+                    || !matches!(r.1, BackgroundRepeatKeyword::NoRepeat);
+                if stretched && !tiled {
+                    hero = true;
+                    break;
+                }
+            }
+            if hero {
+                self.style
+                    .add_flags(ComputedValueFlags::SELF_OR_ANCESTOR_HAS_IMAGE_BACKDROP);
+            }
+        }
+
+        // gjoa dark mode: PER-REGION dark preservation. The engine's inversion
+        // maps lightness linearly onto [floor, ceiling], so an authored-DARK
+        // background-color (navy masthead, dark card, top-layer cookie dialog,
+        // modal scrim) on an inverted page comes out LIGHT — a region-level
+        // double-invert the page-level pre-paint check cannot see. The band map
+        // is a bijection: a computed L uniquely recovers its authored L
+        // (= (ceiling - L) / band), so a background whose RECOVERED authored
+        // lightness is dark is RESTORED to that authored color (darkening never
+        // sheds chroma in the forward map, so C/H pass through). High-chroma
+        // (brand) backgrounds were never inverted: if dark, they only need the
+        // flag. An element that just became a preserved-dark region also gets
+        // its own already-computed text color repaired — it cascaded BEFORE the
+        // flag existed, so an authored-light color was inverted dark and would
+        // land dark-on-dark; the same bijection recovers it (chroma un-shed by
+        // the ratio the darkening applied). Descendant-declared colors resolve
+        // against the inherited flag in the cascade foreground hook instead.
+        #[cfg(feature = "gecko")]
+        if self.style.device.color_inversion() && !display.is_contents() {
+            use crate::color::{AbsoluteColor, ColorSpace};
+            let ceiling = self.style.device.color_inversion_ceiling();
+            let floor = self.style.device.color_inversion_floor();
+            let band = (ceiling - floor).max(0.01);
+            let bg = self.style.get_background().clone_background_color();
+            let mut preserved_dark = false;
+            if let Some(abs) = bg.as_absolute() {
+                // Translucent-but-visible dark layers (scrims) count as regions;
+                // a near-invisible tint must not flip descendant text handling.
+                if abs.alpha >= 0.3 {
+                    let oklch = abs.to_color_space(ColorSpace::Oklch);
+                    let l = oklch.c0().unwrap_or(0.0);
+                    let c = oklch.c1().unwrap_or(0.0);
+                    if c > 0.08 {
+                        // Brand-preserved: computed IS authored. Dark ⇒ region.
+                        preserved_dark = l < 0.40;
+                    } else {
+                        let l_auth = ((ceiling - l) / band).clamp(0.0, 1.0);
+                        if l_auth < 0.40 && l_auth < l {
+                            let restored = AbsoluteColor::new(
+                                ColorSpace::Oklch,
+                                l_auth,
+                                oklch.c1(),
+                                oklch.c2(),
+                                oklch.alpha(),
+                            );
+                            self.style.mutate_background().set_background_color(
+                                crate::values::computed::Color::Absolute(restored),
+                            );
+                            preserved_dark = true;
+                        } else if l_auth >= 0.40 {
+                            // gjoa dark mode M4a: SURFACE RAMP-FREEZE (the "surface
+                            // half" — M3 shipped only the text solve). The role-blind
+                            // band map maps a near-neutral authored SURFACE that is NOT
+                            // dark onto a LIGHT/MID L_out: a 0.5 grey lands at ~0.55 (a
+                            // bright island — the css-tricks/zdnet class) and a black
+                            // surface lands on the near-white ceiling. Re-map the
+                            // recovered authored L monotonically onto a DARK surface ramp
+                            // [floor, surface_ceiling] so every surface is dark — white
+                            // stays at the floor, a black authored surface stays dark
+                            // (~#2e2e2e) instead of flipping light. That upper bound is
+                            // the ceiling side of the band on the SURFACE. Only
+                            // background-color is seen here, so text/marks are untouched;
+                            // the size-dependent halation ceiling for large TEXT (a
+                            // mark/ground pair property) stays in the paint-time text
+                            // solve. Darken-only: never lift a surface below the ramp.
+                            let surface_ceiling = (floor + 0.18).min(0.36);
+                            let l_surface =
+                                surface_ceiling - l_auth * (surface_ceiling - floor);
+                            if l_surface < l {
+                                // Shed the (already small) chroma by the extra darkening
+                                // ratio, matching the forward band map, so the surface
+                                // stays neutral in gamut.
+                                let c_ramp = if l > 1e-4 { c * (l_surface / l) } else { c };
+                                let ramped = AbsoluteColor::new(
+                                    ColorSpace::Oklch,
+                                    l_surface,
+                                    c_ramp,
+                                    oklch.c2(),
+                                    oklch.alpha(),
+                                );
+                                self.style.mutate_background().set_background_color(
+                                    crate::values::computed::Color::Absolute(ramped),
+                                );
+                            }
+                        }
+                    }
+                }
+            }
+            if preserved_dark {
+                let inherited_already = self
+                    .style
+                    .get_parent_flags()
+                    .contains(ComputedValueFlags::SELF_OR_ANCESTOR_HAS_PRESERVED_DARK_BACKDROP);
+                self.style
+                    .add_flags(ComputedValueFlags::SELF_OR_ANCESTOR_HAS_PRESERVED_DARK_BACKDROP);
+                // Own-text repair — only where the flag NEWLY appears; under an
+                // already-flagged ancestor this element's colors were resolved
+                // with the preserve rule and must not be "recovered" again.
+                if !inherited_already {
+                    let text = self.style.get_inherited_text().clone_color();
+                    let oklch = text.to_color_space(ColorSpace::Oklch);
+                    let l = oklch.c0().unwrap_or(0.0);
+                    let c = oklch.c1().unwrap_or(0.0);
+                    if c <= 0.08 && l > 1e-4 {
+                        let l_auth = ((ceiling - l) / band).clamp(0.0, 1.0);
+                        if l_auth > 0.5 && l < l_auth {
+                            // Darkening shed chroma by l_out/l_in; un-shed it.
+                            let c_auth = (c * (l_auth / l)).min(0.37);
+                            let repaired = AbsoluteColor::new(
+                                ColorSpace::Oklch,
+                                l_auth,
+                                c_auth,
+                                oklch.c2(),
+                                oklch.alpha(),
+                            );
+                            self.style.mutate_inherited_text().set_color(repaired);
+                        }
+                    }
+                }
+            }
+        }
     }
 
     /// Adjust the style for text style.
