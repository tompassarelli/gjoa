# gjoa-patch:
#   baseline-firefox: 153.0.1
#   touches:
#     - layout/base/nsLayoutUtils.h
#     - layout/base/nsLayoutUtils.cpp
#     - layout/generic/nsTextPaintStyle.cpp
#     - layout/generic/nsTextFrame.cpp
#     - layout/painting/nsCSSRendering.cpp
#     - layout/painting/nsDisplayList.cpp
#     - layout/svg/SVGGeometryFrame.cpp
#   depends-on:
#     - cpp-symbol nsPresContext::ColorInversion
#     - cpp-symbol nsLayoutUtils::GetTextColor
#     - cpp-symbol nsLayoutUtils::DarkenColorIfNeeded
#     - cpp-symbol nsCSSRendering::FindEffectiveBackgroundColor
#     - cpp-symbol mozilla::GjoaDarkText::Correct   (created by patch 0013; resolves
#       at build time -- 0012 only adds the #include, applied before 0013 in order)
#
# Dark-mode v2 role-aware layout color resolver and native structural-mark
# correction.
#
# Patch 0009 inverts every resolved absolute color blind at Stylo
# (Color::to_computed_color). That is role-blind: text fg, solid backgrounds,
# borders and SVG fill all get the same WCAG Y->1-Y flip. v2 wants to retone each
# surface differently (freeze a near-paper background, band-solve text fg in tone
# space, etc.). Before any of that, each per-role layout color resolver must (a)
# know which role it is resolving and (b) be gated on the existing per-document
# dark-mode flag mFrame->PresContext()->ColorInversion() (added by 0009).
#
# This patch threads a ColorRole tag through layout-level color resolvers and
# routes them through one choke-point, nsLayoutUtils::ResolveDarkModeRole(frame,
# color, role, optionalBackdrop). Every policy remains behind 0009's
# per-document ColorInversion master switch. Text retains its floor-57 solve.
# Opaque borders and native selection backgrounds receive a bounded APCA
# structural-mark solve [30,60], while native selection text is re-solved through
# the Text role against that frozen selection background. Translucent structural
# marks and authored ::selection colors remain unchanged.
#
# Roles wired:
# - Text:  the GetTextColor<> template tail -- covers ALL 8 callers (text fill,
#          text-decoration-color, text-emphasis-color, caret, text-overflow
#          ellipsis, decoration COLOR_OVERRIDE). A defaulted aRole param means
#          they are gated automatically; the two SVG-text-fill callers pass
#          SvgFill explicitly.
# - Background: the DetermineBackgroundColor result at the CreateBackgroundColor
#          boundary in nsDisplayList (where nsDisplayBackgroundColor::mColor is
#          stored). Wrapped at the call arg, NOT inside CreateBackgroundColor, so
#          0010's already-composited dark scrim (which also calls
#          CreateBackgroundColor) is not double-processed.
# - Border: solid CSS border colors at ConstructBorderRenderer, shared by
#          WebRender and gfx fallback.
# - Selection: only the native LookAndFeel path after its existing scheme-aware
#          lookup and EnsureSufficientContrast pass. Authored ::selection paths
#          return before the resolver.
# - SvgFill: SVGGeometryFrame WebRender fill, plus the two SVG-text-fill paths.
diff --git a/layout/base/nsLayoutUtils.cpp b/layout/base/nsLayoutUtils.cpp
--- a/layout/base/nsLayoutUtils.cpp
+++ b/layout/base/nsLayoutUtils.cpp
@@ -10,6 +10,7 @@
 #include "ActiveLayerTracker.h"
 #include "AnchorPositioningUtils.h"
 #include "DisplayItemClip.h"
+#include "GjoaDarkText.h"
 #include "ImageContainer.h"
 #include "ImageOps.h"
 #include "ImageRegion.h"
@@ -5294,6 +5295,52 @@ nscolor nsLayoutUtils::DarkenColorIfNeeded(nsIFrame* aFrame, nscolor aColor) {
   return ShouldDarkenColors(aFrame) ? DarkenColor(aColor) : aColor;
 }

+// gjoa dark-mode v2: role-aware choke point for layout color resolvers.
+// Every correction remains behind this document's per-document inversion flag
+// (added by patch 0009). Opaque mark/backdrop pairs are corrected in OKLCH/APCA;
+// roles without a policy remain identity.
+nscolor nsLayoutUtils::ResolveDarkModeRole(nsIFrame* aFrame, nscolor aColor,
+                                           ColorRole aRole,
+                                           nscolor aBackdrop) {
+  if (!aFrame || !aFrame->PresContext()->ColorInversion()) {
+    return aColor;
+  }
+  if (NS_GET_A(aBackdrop) != 255) {
+    aBackdrop = nsCSSRendering::FindEffectiveBackgroundColor(aFrame).mColor;
+  }
+  if (NS_GET_A(aBackdrop) != 255) {
+    return aColor;
+  }
+
+  // gjoa dark-mode v2 (M2): role-aware retone, foreground text.
+  // Patch 0009's brand-preserve (c_in > 0.08 => UNCHANGED at Stylo) is ROLE-BLIND,
+  // so a chromatic FOREGROUND (a link, a brand accent) is returned unlifted and
+  // lands illegible on the dark canvas (wave6 §1/§5). For ColorRole::Text under
+  // active inversion, override that exemption pre-paint: re-solve the mark against
+  // the frozen effective backdrop with the same hue-preserving OKLCh/APCA operator
+  // patch 0013 runs (GjoaDarkText::Correct), at the accent floor. Only an OPAQUE
+  // backdrop can be solved (Correct requires a frozen ground); a non-opaque backdrop
+  // falls through unchanged and the actor's accent clause backstops it (wave6 §5).
+  if (aRole == ColorRole::Text) {
+    // M4a: enforce the halation ceiling for LARGE text only (size-gated); body
+    // text keeps its floor lift and is never ceiling-clamped.
+    const nsStyleFont* font = aFrame->StyleFont();
+    const bool large = GjoaDarkText::IsLargeText(
+        font->mFont.size.ToCSSPixels(), font->mFont.weight.ToFloat());
+    return GjoaDarkText::Correct(aColor, aBackdrop, 57.0f, 90.0f, large);
+  }
+
+  // Borders and native selection backgrounds are structural marks, not body
+  // text. Keep them visible without turning every divider or selection wash
+  // into a high-contrast text edge. Translucent authored colors remain
+  // untouched because Correct requires a frozen, opaque pair.
+  if ((aRole == ColorRole::Border || aRole == ColorRole::Selection) &&
+      NS_GET_A(aColor) == 255) {
+    return GjoaDarkText::Correct(aColor, aBackdrop, 30.0f, 60.0f, true);
+  }
+  return aColor;
+}
