{
  "$comment": "Each entry binds a shipped security mitigation to its source and behavioral selector cases. Preflight Gate R asserts every mustMatch regex still hits and re-tests extracted validator regexes against mustReject/mustAccept.",
  "mitigations": {
    "cosmetic-css-injection-unvalidated-selectors": {
      "file": "src/gjoa/toolkit/components/content-classifier/GjoaCosmeticChild.sys.mjs",
      "severity": "high",
      "mustMatch": [
        "const UNSAFE_SELECTOR = /.+/;",
        "UNSAFE_SELECTOR = /[^\\n]*\\\\\\*\\\\/",
        "Array\\.prototype\\.filter\\.call\\(selectors, safeSelector\\)"
      ],
      "extractRegex": {
        "name": "UNSAFE_SELECTOR",
        "from": "const\\s+UNSAFE_SELECTOR\\s*=\\s*(/.*?/);",
        "rejectsWhenMatches": true
      },
      "mustReject": ["a{}", "x*/y", "h1{color:red}@import"],
      "mustAccept": [".ad-banner", "#promo", "div[data-ad] > span"]
    },
    "list-scriptlets-default-off": {
      "file": "src/gjoa/toolkit/components/content-classifier/GjoaCosmeticParent.sys.mjs",
      "severity": "high",
      "mustMatch": [
        "const LIST_SCRIPTLETS_PREF = \"gjoa\\.contentblock\\.scriptlets\\.listDriven\\.enabled\";",
        "Services\\.prefs\\.getBoolPref\\(LIST_SCRIPTLETS_PREF, false\\)"
      ]
    }
  }
}
